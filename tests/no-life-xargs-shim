#!/usr/bin/env bash
# Test double for `xargs`: forwards to the real one, except for the activity walk's worker,
# which it refuses exactly the way xargs refuses a command it cannot find. Put its dir first on
# PATH to make the ref-date walk read nothing while every other phase works, which is the shape
# of any run whose worker interpreter is missing.
set -uo pipefail
real=$(PATH="$(getconf PATH)" command -v xargs)
for a in "$@"; do
  case "$a" in
    *life.sh) echo "xargs: bash: No such file or directory" >&2; exit 127 ;;
  esac
done
exec "$real" "$@"
