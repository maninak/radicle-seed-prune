#!/usr/bin/env bash
# Test double for `rad`, driven by env: RSP_HOME, RSP_NID, RSP_MANIFEST, RSP_NODE_DOWN,
# RSP_NO_ROUTING, RSP_NO_LS, RSP_LS_FAIL, RSP_DELEGATES, RSP_BLOCK_FAIL, RSP_UNSEED_FAIL,
# RSP_SEED_LIST_FAIL. Manifest columns: rid name seeds vis own days size desc
#
# Every policy change is also a line in $RSP_HOME/.stub_policy ("block rad:z..."), and the last
# line for a repo is its policy, which `rad seed` with no arguments lists. A test stands in for
# blocks an earlier run made by writing lines there itself.
set -uo pipefail
# Real rad takes its home from the ENVIRONMENT, so record what we were actually handed: that is
# the only way a test can tell an exported RAD_HOME from one the script merely set as a shell
# variable.
printf '%s\n' "${RAD_HOME:-<unset>}" >> "$RSP_HOME/.stub_radhome"
sub="${1:-}"; shift || true
case "$sub" in
  path) echo "$RSP_HOME" ;;
  self) echo "did:key:$RSP_NID" ;;            # `rad self --did`
  ls)
    [ "${RSP_NO_LS:-0}" = 1 ] && exit 0        # `rad ls` yields nothing: rule D goes blind
    [ "${RSP_LS_FAIL:-0}" = 1 ] && { echo "Error: invalid repository id 'notarid'" >&2; exit 1; }
    priv=0; allf=0
    for a in "$@"; do [ "$a" = --private ] && priv=1; [ "$a" = --all ] && allf=1; done
    while IFS=$'\t' read -r rid name _seeds vis own _days _size desc; do
      [ -z "$rid" ] && continue
      if   [ "$priv" = 1 ]; then [ "$vis" = private ] || continue
      elif [ "$allf" = 0 ]; then [ "$own" = 1 ] || continue   # bare `rad ls` = our own repos
      fi
      # real rad prints a 7-hex head; keep it exact, the script's column walk reads
      # the shape
      # A "\n" in the manifest is a line break in the description, which real rad accepts.
      printf '| %s rad:%s %s abc1234 %s |\n' "$name" "$rid" "$vis" "${desc//\\n/$'\n'}"
    done < "$RSP_MANIFEST"
    ;;
  node)
    case "${1:-}" in
      routing)
        if [ "${RSP_NO_ROUTING:-0}" != 1 ]; then
          while IFS=$'\t' read -r rid name seeds vis own _days _size desc; do
            [ -z "$rid" ] && continue
            n=0; while [ "$n" -lt "${seeds:-0}" ]; do
              printf '{"rid":"rad:%s","nid":"zo%s%02d"}\n' "$rid" "$rid" "$n"; n=$((n+1))
            done
          done < "$RSP_MANIFEST"
        fi
        ;;
      status) [ "${RSP_NODE_DOWN:-0}" = 1 ] && exit 1 || exit 0 ;;
    esac
    ;;
  inspect)
    # `rad inspect rad:<rid> --delegates`. RSP_DELEGATES holds "rid<TAB>nid" lines; a rid with
    # no row prints nothing, which is how a test stands in for a repo whose delegates cannot be
    # read.
    rid=""; want=0
    for a in "$@"; do
      case "$a" in --delegates) want=1 ;; rad:*) rid=${a#rad:} ;; esac
    done
    { [ "$want" = 1 ] && [ -n "$rid" ] && [ -r "${RSP_DELEGATES:-}" ]; } || exit 0
    awk -F'\t' -v r="$rid" '$1==r {printf "did:key:%s (test)\n", $2}' "$RSP_DELEGATES"
    ;;
  # A block that fails is what an apply against a node that has gone away looks like, and the
  # script must not delete a repo it could not block.
  # Real rad says something only when the policy changes, and the script reads that silence as
  # "already blocked", so the stub has to keep quiet the same way.
  block)  [ "${RSP_BLOCK_FAIL:-0}" = 1 ] && exit 1
          grep -qxF -- "${1:-}" "$RSP_HOME/.stub_block" 2>/dev/null \
            || printf "✓ Policy for %s set to 'block'\n" "${1:-}"
          echo "${1:-}" >> "$RSP_HOME/.stub_block"
          echo "block ${1:-}" >> "$RSP_HOME/.stub_policy" ;;
  unseed) [ "${RSP_UNSEED_FAIL:-0}" = 1 ] && exit 1
          echo "${1:-}" >> "$RSP_HOME/.stub_unseed"
          echo "unseed ${1:-}" >> "$RSP_HOME/.stub_policy" ;;
  seed)
    if [ -n "${1:-}" ]; then
      echo "${1:-}" >> "$RSP_HOME/.stub_seed"
      echo "seed ${1:-}" >> "$RSP_HOME/.stub_policy"
      exit 0
    fi
    # A box, one row per repo: "│ rad:z...  <name>  <policy>  <scope> │". Heartwood master
    # leaves the scope off a blocked row; rc.12 prints "all" there, RSP_SEED_SCOPED=1.
    [ "${RSP_SEED_LIST_FAIL:-0}" = 1 ] && { echo "Error: database is locked" >&2; exit 1; }
    echo "╭──────────────────────────────╮"
    echo "│ Repository  Name  Policy  Scope │"
    [ -r "$RSP_HOME/.stub_policy" ] || exit 0
    awk -v scoped="${RSP_SEED_SCOPED:-0}" '
        $1 != "unseed" { policy[$2] = $1 } $1 == "unseed" { delete policy[$2] }
        END { for (r in policy) {
                scope = (policy[r] == "block" && scoped == 0) ? "" : "all"
                printf "│ %s  (name)  %s  %s │\n", r, policy[r], scope } }' \
      "$RSP_HOME/.stub_policy"
    ;;
  *) : ;;
esac
