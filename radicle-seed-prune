set -euo pipefail
# Numbers must not depend on the operator's locale. mawk, which is what a Debian seed runs,
# honours LC_NUMERIC: under a comma locale it prints 2.52e+10 as "2,52e+10", and the next awk
# that reads that value back parses it as 2. That silently zeroes the disk-pressure maths. C
# also fixes sort to byte order, so a plan does not reorder itself between machines.
export LC_ALL=C

VERSION="0.4.0"

# `set -e` on its own exits mute: a command failing anywhere below would end the run with a
# bare non-zero status and nothing to debug from. Name the line, the command, and the status
# instead.
report_error(){
  echo "# ERROR: line $2: [$3] exited $1" >&2
  exit "$1"
}
trap 'report_error "$?" "$LINENO" "$BASH_COMMAND"' ERR

# -------------------------------------------------------------------- config (env-overridable)
RAD="${RAD:-rad}"
RAD_HOME="${RAD_HOME:-$("$RAD" path 2>/dev/null || echo "${HOME:?}/.radicle")}"
# rad reads the home from its ENVIRONMENT: unexported, every rad call below would query the
# default home, come back empty, and silently force a plan of zero repos.
export RAD_HOME
STORAGE="${STORAGE:-$RAD_HOME/storage}"
CONFIG="${CONFIG:-$RAD_HOME/config.json}"
OUR_NID="${OUR_NID:-$("$RAD" self --nid 2>/dev/null || true)}"
SERVICE="${SERVICE:-radicle-node}"          # systemd unit for --restart-node

ABS_SIZE_FLOOR_MB="${ABS_SIZE_FLOOR_MB:-500}"   # rule B absolute floor
REL_PCTL="${REL_PCTL:-95}"                       # rule B relative percentile
OUTLIER_STALE_DAYS="${OUTLIER_STALE_DAYS:-90}"   # rule B staleness  (~3 months)
JUNK_STALE_DAYS="${JUNK_STALE_DAYS:-30}"         # rule A staleness  (~1 month)
STALE_YEARS_DAYS="${STALE_YEARS_DAYS:-730}"      # rule C staleness  (~2 years)
MIN_OTHER_SEEDS="${MIN_OTHER_SEEDS:-3}"          # rules B & C: > 2 other seeds
JUNK_MIN_SEEDS="${JUNK_MIN_SEEDS:-1}"            # rule A word branch: keeps the last copy
# The id branch (a name that is NOTHING but a random hex id) may take the last copy we
# know of: for machine-generated bulk "nobody else seeds it" measures worthlessness, not
# rarity. The word branch keeps its floor, since "my-old-thesis" is a guess, not proof.
JUNK_ID_MIN_SEEDS="${JUNK_ID_MIN_SEEDS:-0}"      # rule A id branch: 0 may take the last copy
FRESH_GUARD_DAYS="${FRESH_GUARD_DAYS:-2}"        # never delete a dir touched this recently

SPAM_MIN_BATCH="${SPAM_MIN_BATCH:-5}"            # repos on one name skeleton to be a batch
SPAM_DESC_AGREE_PCT="${SPAM_DESC_AGREE_PCT:-80}" # % of a batch on ONE description skeleton
SPAM_MIN_SEEDS="${SPAM_MIN_SEEDS:-0}"            # 0 may take the last copy we know of
# Rule D's evidence is not time-based, so this is only a grace period for a batch that turns
# out to be real.
SPAM_STALE_DAYS="${SPAM_STALE_DAYS:-7}"          # about a week
# 0 also accepts plain enumeration batches (name-#), which can reach a version-mirror farm with
# templated descriptions.
SPAM_REQUIRE_ID="${SPAM_REQUIRE_ID:-1}"          # demand a random-id slot (%) in the skeleton

# --- rule E: link farms ---
# Flags repos that link to domains almost no repo's own code links to. See rule E at the top.
LINK_SCAN="${LINK_SCAN:-1}"                      # 0 skips reading file content
# "Many repos link to it" has to mean something on a 200-repo seed and on a 100k-repo one, so
# the bar is a share of storage with an absolute floor under it. Setting LINK_MIN_REPOS above
# the share pins it there.
LINK_MIN_REPOS="${LINK_MIN_REPOS:-8}"            # fewest repos that can make a spam domain
LINK_MIN_REPOS_PCT="${LINK_MIN_REPOS_PCT:-0.4}"  # or this % of storage, whichever is larger
LINK_DELEGATE_CHECK="${LINK_DELEGATE_CHECK:-1}"  # 0 counts links from any peer
LINK_CODE_MAX_PCT="${LINK_CODE_MAX_PCT:-10}"     # a domain stops being spam once this % of its
                                                 # linkers have it in their own code
LINK_CODE_LOOSE_PCT="${LINK_CODE_LOOSE_PCT:-50}" # the looser cap of pass 1, deciding whose
                                                 # code links count at all
LINK_MIN_SCORE="${LINK_MIN_SCORE:-5}"            # spam domains a repo must link to
LINK_STALE_DAYS="${LINK_STALE_DAYS:-7}"          # minimum age, from creation like rule D
LINK_MIN_SEEDS="${LINK_MIN_SEEDS:-0}"            # 0 may take the last copy we know of
# How much of each repo to read. These truncate a blob rather than skipping it, so a link
# sitting near the start of a large file is still seen. A link the file itself encodes (base64,
# an escaped string) is missed either way: the regex below matches plain text only.
LINK_BLOB_PREFIX=65536                           # max bytes read from any single blob
LINK_REPO_BUDGET="${LINK_REPO_BUDGET:-8000000}"  # max bytes read per repo, per pass (all refs,
                                                 # then canonical branches only)

# --- rule F: media dumps ---
# Flags repos whose tracked files are media with no project around them. See rule F at the top.
MEDIA_SCAN="${MEDIA_SCAN:-1}"                    # 0 skips listing repo trees: rule F off
# Extensions judged as media, matched case-insensitively on whatever follows the last dot. An
# extension missing from this list counts as text, so an unfamiliar file spares a repo instead
# of condemning it. SVG is deliberately absent: it is markup, and real projects commit it as an
# asset. Archives are here because zipping a video is a one-command evasion; the cost is that a
# repo holding a release tarball and nothing else reads as a dump, which the seed floor bounds.
MEDIA_EXTS="${MEDIA_EXTS:-\
jpg|jpeg|png|gif|webp|avif|bmp|tif|tiff|heic|heif|ico|psd|\
mp4|m4v|mkv|avi|mov|webm|wmv|flv|mpg|mpeg|3gp|\
mp3|m4a|aac|wav|flac|ogg|opus|wma|\
zip|rar|7z|tar|gz|tgz|bz2|xz|zst}"
# Extensions and bare filenames known to be text. Their only job is to keep the reading below
# to the few files whose kind is genuinely unknown; anything not on either list gets read.
MEDIA_TEXT_EXTS="\
md|markdown|txt|rst|adoc|org|tex|bib|html|htm|xml|svg|css|scss|less|\
js|mjs|cjs|jsx|ts|tsx|vue|svelte|json|jsonc|yaml|yml|toml|ini|cfg|conf|properties|env|\
lock|sum|sh|bash|zsh|fish|ps1|bat|py|rb|pl|lua|php|go|rs|c|h|cc|cpp|hpp|cs|java|kt|kts|\
scala|swift|m|mm|\
clj|ex|exs|erl|hs|ml|nim|zig|dart|r|jl|sql|csv|tsv|patch|diff|gradle|cmake|mk|proto|graphql|\
gitignore|gitattributes|editorconfig|dockerignore|npmrc|nvmrc"
# "manifest" is in here because a Radicle COB op is a tree holding one, and a seed carries
# millions of them.
MEDIA_TEXT_NAMES="\
readme|license|licence|copying|notice|authors|contributors|changelog|changes|\
makefile|dockerfile|justfile|rakefile|gemfile|procfile|vagrantfile|codeowners|manifest|\
.gitignore|.gitattributes|.editorconfig|.env"
# The floor is only there so the rule ignores trivia; it is NOT what tells a dump from a
# project. That is the text budget below. Kept low because image spam is many small files, not
# one big one: a 1 MiB floor would spare fifty hotlink-sized jpegs.
MEDIA_MIN_BYTES="${MEDIA_MIN_BYTES:-65536}"      # media bytes below which a repo is not judged
# Everything that is NOT media, added up, has to stay under this. A project carries more than a
# token file's worth of text; a dump carries none.
MEDIA_TEXT_MAX_BYTES="${MEDIA_TEXT_MAX_BYTES:-2048}"
# The batch path's wider budget, for repos whose media other repos hold too. A README big
# enough to clear this is a document, not a fig leaf, and spares the repo either way.
MEDIA_TEXT_CEIL_BYTES="${MEDIA_TEXT_CEIL_BYTES:-65536}"
MEDIA_MIN_BATCH="${MEDIA_MIN_BATCH:-5}"          # repos holding one blob to call it a campaign
MEDIA_STALE_DAYS="${MEDIA_STALE_DAYS:-7}"        # minimum age, from creation like D and E
MEDIA_MIN_SEEDS="${MEDIA_MIN_SEEDS:-1}"          # 1 keeps the last copy we know of
# How much of each repo to look at. Only the first bytes of a file are ever read, and only
# while the repo could still be a dump, so these bound an already small cost. A file past
# either bound counts as text, which spares the repo.
# A "text" file this big is read too: it may be a video wearing a .md, which would otherwise
# both hide itself and blow the very budget that spares the repo.
MEDIA_SNIFF_TEXT_BYTES=262144
MEDIA_SNIFF_MAX_FILES=200                        # most files read in any one repo
# Most refs a repo can have and still be judged. Reading every peer's refs is what this rule
# costs, and one repo on a real 11k-repo seed has 152k of them: minutes of walking to learn
# that a repo half the network replicates is not a dump. Four repos there are over this cap,
# and the next one down has 2942 refs, so it sits in a wide gap rather than near real repos.
MEDIA_MAX_REFS="${MEDIA_MAX_REFS:-10000}"

# --- rule G: parasite peers ---
# Rule G judges a PEER, not a repo, and blocking a peer is a heavier act than deleting one
# repo: it is a standing judgement about a person, it applies to every repo at once, and they
# are never told. So this rule is built to be nearly impossible to trip by accident, and every
# threshold below buys confidence rather than reach. It reports by default and blocks only
# under --block-peers, so the operator reads the evidence before anyone is blocked.
PARASITE_SCAN="${PARASITE_SCAN:-1}"              # 0 skips the pass: rule G off
# The evidence is one file, byte for byte, pushed into repos the peer does not own. A person
# attaching a screenshot to an issue posts a DIFFERENT file each time; the same oid landing in
# unrelated repos is a campaign, and it is the one thing a single repo cannot manufacture.
PARASITE_MIN_REPOS="${PARASITE_MIN_REPOS:-10}"   # repos one blob must reach to accuse a peer
PARASITE_MIN_BYTES="${PARASITE_MIN_BYTES:-1048576}"
# A peer who writes is a contributor, whatever else they push. This is generous on purpose: it
# is cheap for a real person to clear and costly for a bot to fake, so it errs toward mercy.
PARASITE_TEXT_MAX_BYTES="${PARASITE_TEXT_MAX_BYTES:-16384}"

# Which rules may run at all. One spelling for every rule, because enable/disable is the knob
# an operator reaches for first and it used to be spelled four different ways (a sentinel here,
# a *_SCAN=0 there, and nothing at all for B and C). A letter absent from this string means
# that rule neither scans nor puts anything in the plan.
RULES="${RULES:-ABCDEFG}"
rule_on(){ case "$RULES" in (*"$1"*) return 0 ;; (*) return 1 ;; esac; }

MAX_PRUNE_COUNT="${MAX_PRUNE_COUNT:-1000}"       # runaway guards (abort unless --force)
MAX_PRUNE_GB="${MAX_PRUNE_GB:-80}"
# The fixed caps above only catch a plan that jumps. They cannot catch one that CREEPS: at a
# steady 2.5 GiB a week, a plan could grow for a year without ever touching MAX_PRUNE_GB, and
# under sustained disk pressure the thresholds loosen on their own. So a plan is also measured
# against what this seed normally prunes, taken from the run history it already writes.
RATCHET_FACTOR="${RATCHET_FACTOR:-3}"            # times the usual plan before a run stops
RATCHET_RUNS="${RATCHET_RUNS:-8}"                # past runs the usual is taken from (median)
MAX_SCAN_FAIL_PCT="${MAX_SCAN_FAIL_PCT:-10}"     # abort if this share of storage is unreadable

# --- disk-pressure adaptivity ---
# The thresholds above are the RELAXED (plenty-of-space) values. As free disk on the storage
# filesystem falls from the relax watermark down to the critical one, every knob is
# interpolated toward its AGGRESSIVE value, so the tool self-tightens with no human retuning.
# Set DISK_AWARE=0 to disable and always use the relaxed values. Hard safety floors (>=1 other
# seed, the exclusions) never scale.
DISK_AWARE="${DISK_AWARE:-1}"
PRESSURE_RELAX_PCT="${PRESSURE_RELAX_PCT:-20}"   # >= max(pct,gb) free  -> pressure 0 (relaxed)
PRESSURE_RELAX_GB="${PRESSURE_RELAX_GB:-20}"
PRESSURE_CRIT_PCT="${PRESSURE_CRIT_PCT:-10}"     # <= min(pct,gb) free -> pressure 1 (max)
PRESSURE_CRIT_GB="${PRESSURE_CRIT_GB:-2}"
ABS_SIZE_FLOOR_MB_AGG="${ABS_SIZE_FLOOR_MB_AGG:-50}"     # full-pressure endpoints
REL_PCTL_AGG="${REL_PCTL_AGG:-50}"
OUTLIER_STALE_DAYS_AGG="${OUTLIER_STALE_DAYS_AGG:-14}"
JUNK_STALE_DAYS_AGG="${JUNK_STALE_DAYS_AGG:-7}"
SPAM_STALE_DAYS_AGG="${SPAM_STALE_DAYS_AGG:-1}"
STALE_YEARS_DAYS_AGG="${STALE_YEARS_DAYS_AGG:-60}"
MIN_OTHER_SEEDS_AGG="${MIN_OTHER_SEEDS_AGG:-1}"  # hard floor 1: B and C keep the last copy

AUDIT_DIR="${AUDIT_DIR:-$RAD_HOME/prune-audit}"
# A pruned repo is moved here first and deleted for real one run later. Three verdicts may
# take the last copy the network is known to hold, and for exactly those the documented undo
# ("re-fetch it") is the thing that cannot work, so the only real undo is a copy on this disk.
# The holding cost is small: at the observed 2.5 GiB a week, 30 days is about 10 GiB parked.
QUARANTINE="${QUARANTINE:-1}"                    # 0 deletes outright, with no way back
QUARANTINE_DAYS="${QUARANTINE_DAYS:-30}"         # how long a pruned repo stays recoverable
# A verdict that rests on a corpus (the same template, domain or file across many repos) is
# evidence one repo cannot manufacture, so those rows are summarised once a group gets big
# enough that nobody would read them. Rows resting on a single repo's own metadata are always
# listed in full, however many there are: those are the ones that want human eyes.
PLAN_COLLAPSE_ROWS="${PLAN_COLLAPSE_ROWS:-20}"   # group size at which a corpus verdict folds
PLAN_FULL="${PLAN_FULL:-0}"                      # 1 lists every row whatever the verdict

# Anchor the cwd somewhere any user can read. Launched from a directory the running
# user cannot read (`sudo -u seed` started from /root, say), every `find` below emits
# "Failed to restore initial working directory", which inflates the scan-error count
# and buries the warnings that matter. Relative paths resolve against the caller's cwd
# FIRST, so they still mean what the caller meant.
_abs(){ case $1 in /*) printf '%s' "$1" ;; *) printf '%s/%s' "$PWD" "$1" ;; esac; }
RAD_HOME=$(_abs "$RAD_HOME"); STORAGE=$(_abs "$STORAGE")
CONFIG=$(_abs "$CONFIG");     AUDIT_DIR=$(_abs "$AUDIT_DIR")
case $RAD in */*) RAD=$(_abs "$RAD") ;; esac   # a bare "rad" keeps resolving through PATH
# Where this seed records when it first saw each repo. A repo's ref dates are set by whoever
# pushed them, so rewriting every ref renews rules D, E and F indefinitely. This file cannot
# be reached from outside the seed, and age is taken from whichever of the two is older.
FIRST_SEEN=$(_abs "${FIRST_SEEN:-$AUDIT_DIR/first-seen.tsv}")

cd /

# Parallel workers for the per-repo activity scan. Dynamic default: one per core, less one, so
# the running node keeps a core free. Note the scan is usually IO-bound (a single du over all
# storage), so raising this mostly helps on seeds with ref-heavy (COB-heavy) repos. Override
# via JOBS.
_cores=$(nproc 2>/dev/null || echo 4)
JOBS="${JOBS:-$(( _cores > 1 ? _cores - 1 : 1 ))}"

# Disposable-name patterns. The generic tokens foo/bar/baz match only as a WHOLE name (so
# "BAR_widget" is safe); everything else matches as a boundary-delimited word. JUNK_ID_MIN_LEN
# also treats a name that is NOTHING BUT a random hex id (both letters and digits, so
# "12345678" and "facade" are left alone) as disposable: no human names a repo 08a25d0f666d,
# and it is the one shape of generated bulk that rule D cannot see, because such repos carry no
# description to corroborate with. 0 disables it.
JUNK_WORDS='test|tests|testing|delete|deleted|tmp|temp|scratch|playground|sandbox'
JUNK_WORDS="$JUNK_WORDS|demo|dummy|wip|trash|junk|old|throwaway|hello-?world"
JUNK_WORD_REGEX="(^|[-_.])($JUNK_WORDS)([-_.]|$)"
JUNK_EXACT_REGEX='^(foo|bar|baz)$'
JUNK_ID_MIN_LEN="${JUNK_ID_MIN_LEN:-8}"

# ---------------------------------------------------------------------------------------- args
APPLY=0; FORCE=0; RESTART=0; YES=0; BLOCK_PEERS=0
for a in "$@"; do
  case "$a" in
    --apply)        APPLY=1 ;;
    --yes|-y)       YES=1 ;;
    --force)        FORCE=1 ;;
    --restart-node) RESTART=1 ;;
    # Rule G only ever reports without this. Blocking a peer is a standing judgement
    # about a person that applies to every repo at once, so it takes its own opt-in.
    --block-peers)  BLOCK_PEERS=1 ;;
    --version)      echo "radicle-seed-prune $VERSION"; exit 0 ;;
    --help|-h)      awk 'NR==1{next} /^#/{print; next} {exit}' "$0"; exit 0 ;;
    *) echo "unknown arg: $a (try --help)" >&2; exit 2 ;;
  esac
done

[ -d "$STORAGE" ] || { echo "no storage dir at $STORAGE" >&2; exit 1; }
# Without this, an unreadable storage dir scans zero repos and reports a serene "prune 0
# repos".
{ [ -r "$STORAGE" ] && [ -x "$STORAGE" ]; } \
  || { echo "cannot read storage dir $STORAGE (wrong user?)" >&2; exit 1; }
[ -n "$OUR_NID" ] \
  || echo "# WARN: could not determine our NID; seed counts will include us" >&2

now=$(date +%s)
fresh_cut=$(( now - FRESH_GUARD_DAYS*86400 ))

# disk pressure p in [0,1] on the storage filesystem
read -r disk_total disk_avail < <(df -Pk "$STORAGE" \
  | awk 'NR==2{printf "%.0f %.0f\n", $2*1024, $4*1024}')
: "${disk_total:=0}"; : "${disk_avail:=0}"
relax_free=$(awk -v t="$disk_total" -v p="$PRESSURE_RELAX_PCT" -v g="$PRESSURE_RELAX_GB" \
  'BEGIN{a=t*p/100;b=g*1e9;print (a>b)?a:b}')
crit_free=$(awk  -v t="$disk_total" -v p="$PRESSURE_CRIT_PCT"  -v g="$PRESSURE_CRIT_GB" \
  'BEGIN{a=t*p/100;b=g*1e9;print (a<b)?a:b}')
p=$(awk -v av="$disk_avail" -v r="$relax_free" -v c="$crit_free" -v on="$DISK_AWARE" 'BEGIN{
  if(on=="0"||r<=c){print 0;exit} x=(r-av)/(r-c); if(x<0)x=0; if(x>1)x=1; printf "%.3f",x }')

# interpolate each knob relaxed->aggressive by p
lerp(){ awk -v a="$1" -v b="$2" -v p="$p" 'BEGIN{printf "%d", a+(b-a)*p+0.5}'; }
eff_abs_mb=$(lerp "$ABS_SIZE_FLOOR_MB" "$ABS_SIZE_FLOOR_MB_AGG")
eff_pctl=$(lerp "$REL_PCTL" "$REL_PCTL_AGG")
eff_outlier_days=$(lerp "$OUTLIER_STALE_DAYS" "$OUTLIER_STALE_DAYS_AGG")
eff_junk_days=$(lerp "$JUNK_STALE_DAYS" "$JUNK_STALE_DAYS_AGG")
eff_spam_days=$(lerp "$SPAM_STALE_DAYS" "$SPAM_STALE_DAYS_AGG")
eff_stale_days=$(lerp "$STALE_YEARS_DAYS" "$STALE_YEARS_DAYS_AGG")
eff_seeds=$(lerp "$MIN_OTHER_SEEDS" "$MIN_OTHER_SEEDS_AGG")
[ "$eff_seeds" -lt 1 ] && eff_seeds=1

outlier_cut=$(( now - eff_outlier_days*86400 ))
junk_cut=$(( now - eff_junk_days*86400 ))
spam_cut=$(( now - eff_spam_days*86400 ))
stale_cut=$(( now - eff_stale_days*86400 ))
link_cut=$(( now - LINK_STALE_DAYS*86400 ))
media_cut=$(( now - MEDIA_STALE_DAYS*86400 ))

run_mode=$([ "$APPLY" = 1 ] && echo APPLY || echo DRY-RUN)
echo "# radicle-seed-prune $VERSION  $(date -u +%FT%TZ)   mode=$run_mode"
echo "# home=$RAD_HOME"

# The header is what a reader checks the run against, so every threshold it acted on is printed
# at its effective (post-pressure) value.
free_gb=$(awk  -v a="$disk_avail" 'BEGIN{printf "%.1f",a/1e9}')
free_pct=$(awk -v a="$disk_avail" -v t="$disk_total" 'BEGIN{printf "%.1f",(t>0)?100*a/t:0}')
press_pct=$(awk -v p="$p" 'BEGIN{printf "%.0f",p*100}')
relax_gb=$(awk -v r="$relax_free" 'BEGIN{printf "%.0f",r/1e9}')
crit_gb=$(awk  -v c="$crit_free" 'BEGIN{printf "%.0f",c/1e9}')
echo "# disk: ${free_gb}GB free (${free_pct}%)  pressure=${press_pct}%" \
     "[relax>=${relax_gb}GB crit<=${crit_gb}GB]"

rule_a="A junk(>${eff_junk_days}d, seeds>=${JUNK_MIN_SEEDS};"
rule_a="$rule_a id-names seeds>=${JUNK_ID_MIN_SEEDS})"
rule_b="B size(>${eff_abs_mb}MB & >=P${eff_pctl}, >${eff_outlier_days}d, seeds>=${eff_seeds})"
rule_c="C stale(>${eff_stale_days}d, seeds>=${eff_seeds})"
rule_d="D spam(batch>=${SPAM_MIN_BATCH} & desc>=${SPAM_DESC_AGREE_PCT}%,"
rule_d="$rule_d >${eff_spam_days}d, seeds>=${SPAM_MIN_SEEDS})"
for _r in A B C D; do
  rule_on "$_r" || eval "rule_${_r,}=\"\${rule_${_r,}} [DISABLED: not in RULES]\""
done
echo "# rules: $rule_a  $rule_b  $rule_c  $rule_d"

rule_e="E link-farm(>=${LINK_MIN_SCORE} spam domains, each linked from"
rule_e="$rule_e >=${LINK_MIN_REPOS_PCT}% of repos and from the code of"
rule_e="$rule_e <${LINK_CODE_MAX_PCT}% of them, >${LINK_STALE_DAYS}d,"
rule_e="$rule_e seeds>=${LINK_MIN_SEEDS})"
[ "$LINK_SCAN" = 1 ] || rule_e="$rule_e [DISABLED: LINK_SCAN=0]"
rule_on E     || rule_e="$rule_e [DISABLED: not in RULES]"
echo "# rule $rule_e"

rule_f="F media-dump(>=$((MEDIA_MIN_BYTES/1024))KB of media and"
rule_f="$rule_f <${MEDIA_TEXT_MAX_BYTES}B of anything else, >${MEDIA_STALE_DAYS}d,"
rule_f="$rule_f seeds>=${MEDIA_MIN_SEEDS})"
rule_f="$rule_f  media-batch(that media held by >=${MEDIA_MIN_BATCH} repos,"
rule_f="$rule_f <${MEDIA_TEXT_CEIL_BYTES}B of anything else)"
[ "$MEDIA_SCAN" = 1 ] || rule_f="$rule_f [DISABLED: MEDIA_SCAN=0]"
rule_on F      || rule_f="$rule_f [DISABLED: not in RULES]"
echo "# rule $rule_f"
rule_g="G parasite-peer(one file of theirs in >=${PARASITE_MIN_REPOS} repos they do not own,"
rule_g="$rule_g >=$((PARASITE_MIN_BYTES/1048576))MB media,"
rule_g="$rule_g <${PARASITE_TEXT_MAX_BYTES}B of anything else)"
[ "$PARASITE_SCAN" = 1 ] || rule_g="$rule_g [DISABLED: PARASITE_SCAN=0]"
rule_on G         || rule_g="$rule_g [DISABLED: not in RULES]"
[ "$BLOCK_PEERS" = 1 ] || rule_g="$rule_g [reports only; --block-peers asks per peer]"
echo "# rule $rule_g"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# ------------------------------------------------------------------------------ exclusion sets
jq -r '.web.pinned.repositories[]?' "$CONFIG" 2>/dev/null \
  | sed 's/^rad://' | sort -u > "$tmp/pinned" || true
"$RAD" ls --all --private 2>/dev/null \
  | grep -oE 'rad:z[1-9A-HJ-NP-Za-km-z]+' | sed 's/^rad://' | sort -u > "$tmp/private" || true
"$RAD" ls 2>/dev/null \
  | grep -oE 'rad:z[1-9A-HJ-NP-Za-km-z]+' | sed 's/^rad://' | sort -u > "$tmp/own" || true
cat "$tmp/pinned" "$tmp/private" "$tmp/own" 2>/dev/null | sort -u > "$tmp/excluded"
echo "# excluded: $(wc -l < "$tmp/pinned") pinned," \
     "$(wc -l < "$tmp/private") private, $(wc -l < "$tmp/own") own"

# fail-safe: with no reachable node the exclusion sets and seed counts all come back empty.
# Under --apply that risks deleting our own/pinned repos; in dry-run it forces a plan of zero
# repos, which reads as "nothing to prune" when it means "saw nothing at all". Bail out in BOTH
# modes, up front.
mode=$([ "$APPLY" = 1 ] && echo apply || echo dry-run)
"$RAD" node status >/dev/null 2>&1 \
  || { echo "# ABORT($mode): node unreachable via '$RAD' (home=$RAD_HOME)." >&2; exit 5; }
[ -n "$OUR_NID" ] \
  || { echo "# ABORT($mode): no NID from '$RAD' (home=$RAD_HOME)." >&2; exit 5; }

if [ "$APPLY" = 1 ]; then
  npin_cfg=$(jq -r '.web.pinned.repositories[]?' "$CONFIG" 2>/dev/null | wc -l)
  [ "$npin_cfg" -gt 0 ] && [ "$(wc -l < "$tmp/pinned")" = 0 ] \
    && { echo "# ABORT(apply): pinned in config but none parsed." >&2; exit 5; }
fi

# ------------------------------------------------------------------- rid -> name + description
# One `rad ls --all` feeds both the plan's NAME column and rule D's batch statistics, so parse
# the whole row: "| <name> rad:<rid> <visibility> <head> <description...> |". Take the FIRST
# rad: token, never the last - a description may itself quote an rid (they do: "...used for X
# in rad:z3U9...") and matching the last one files the row under a repo that isn't this one.
# Walk the trailing columns rather than counting fields, because visibility, head and
# description are each independently missing on some rows.
"$RAD" ls --all 2>/dev/null | awk '
  /rad:z[1-9A-HJ-NP-Za-km-z]+/ {
    ridi=0; for (i=1;i<=NF;i++) if ($i ~ /^rad:z[1-9A-HJ-NP-Za-km-z]+$/) { ridi=i; break }
    if (ridi<2) next
    rid=$ridi; sub(/^rad:/,"",rid)
    name=""; for (i=2;i<ridi;i++) name=name (name==""?"":" ") $i   # names with spaces survive
    d=ridi+1
    if ($d=="public" || $d=="private") d++
    if (d<NF && length($d)>=7 && $d ~ /^[0-9a-f]+$/) d++   # the head oid, when the row has one
    desc=""; for (i=d;i<NF;i++) desc=desc (desc==""?"":" ") $i     # NF is the closing box char
    print rid"\t"name"\t"desc
  }' > "$tmp/meta" || true
# Losing this is not fatal but it is not nothing either: the plan's NAME column goes blank and
# rule D has no corpus to reason about, which would look exactly like "no spam here". Say so.
[ -s "$tmp/meta" ] \
  || echo "# WARN: '$RAD ls --all' returned no repos; rule D cannot run." >&2

# -------------------------------------------------------------- rule D: generated-bulk batches
# Skeletonise every name and description in storage - digit runs become #, random-id tokens
# become % - then group repos by name skeleton and keep only the groups whose members also
# agree on one description. Two independent signals; see rule D at the top of this file for why
# each is needed.
awk -F'\t' -v K="$SPAM_MIN_BATCH" -v D="$SPAM_DESC_AGREE_PCT" -v REQID="$SPAM_REQUIRE_ID" \
           -v BATCHES="$tmp/spambatch" '
  # A token is a random id if it is 6+ hex characters with both a letter and a digit. Demanding
  # a letter is what keeps a date or sequence suffix (release-202401) an enumeration rather
  # than an id.
  function cls(t) {
    if (length(t)>=6 && t ~ /^[0-9a-f]+$/ && t ~ /[a-f]/ && t ~ /[0-9]/) return "%"
    if (t ~ /^[0-9]+$/) return "#"
    gsub(/[0-9]+/,"#",t); return t     # ordinary word: only its digits vary (widget2000)
  }
  function skel(s,   i,c,out,tok,n) {
    s=tolower(s); out=""; tok=""; n=length(s)
    for (i=1;i<=n+1;i++) {
      c=(i<=n)?substr(s,i,1):""
      if (c ~ /^[0-9a-z]$/) { tok=tok c; continue }
      if (tok!="") { out=out cls(tok); tok="" }
      out=out c
    }
    gsub(/[[:space:]]+/," ",out); gsub(/^ | $/,"",out); return out
  }
  # Group on the skeleton with # and % collapsed together, because a random hex token comes out
  # all-digits about 2% of the time ("chunk-1-96180521") and that would otherwise split a batch
  # and leave those siblings behind. Whether the batch has a real id slot is then tracked per
  # batch.
  function loose(x) { gsub(/[#%]/,"*",x); return x }
  {
    N++; rid[N]=$1
    sn=skel($2); nl[N]=loose(sn); dl[N]=loose(skel($3))
    if (index(sn,"%")) hasid[nl[N]]=1
    cnt[nl[N]]++; pair[nl[N] SUBSEP dl[N]]++
  }
  END {
    # awk leaves `for (k in ...)` order unspecified, so ties break on the description text
    # itself: without that, two equally common descriptions would pick a winner at random and
    # one seed could produce two different plans.
    for (k in pair) {
      split(k,q,SUBSEP)
      if (pair[k]>best[q[1]] || (pair[k]==best[q[1]] && q[2]<bestd[q[1]]))
        { best[q[1]]=pair[k]; bestd[q[1]]=q[2] }
    }
    for (n in cnt) {
      if (cnt[n] < K)                        continue   # too few to be a template
      if (REQID+0==1 && !(n in hasid))       continue   # no machine-generated id in it
      if (index(n,"*")==0)                   continue   # nothing varies: not a template at all
      if (bestd[n]=="")                      continue   # no description: only ONE signal
      if (best[n]*100 < D*cnt[n])            continue   # members disagree on the description
      good[n]=1
    }
    # Only the members carrying the description the batch agreed on, so a genuine outlier that
    # happens to share the name shape is left alone.
    for (i=1;i<=N;i++)
      if (nl[i] in good && dl[i]==bestd[nl[i]]) { print rid[i]; batchsize[nl[i]]++ }
    for (n in batchsize) printf "%d\t%s\n", batchsize[n], n > BATCHES
  }' "$tmp/meta" > "$tmp/spam" || true
: >> "$tmp/spambatch"                          # awk only creates it when it finds something
nspam=$(wc -l < "$tmp/spam"); nspambatch=$(wc -l < "$tmp/spambatch")
if [ "$nspam" -gt 0 ]; then
  echo "# spam batches: $nspambatch template(s) matching $nspam repos," \
       "before the age and seed checks:"
  sort -k1,1nr "$tmp/spambatch" | head -5 | awk -F'\t' '{printf "#   %5d  %s\n", $1, $2}'
  [ "$nspambatch" -gt 5 ] && echo "#   ...and $((nspambatch - 5)) more"
fi

# --------------------------------------------------------------------- rid -> other-seed count
"$RAD" node routing --json 2>/dev/null \
  | jq -r --arg us "$OUR_NID" 'select(.nid != $us) | (.rid|sub("^rad:";""))' \
  | sort | uniq -c | awk '{print $2"\t"$1}' > "$tmp/seeds" || true
# Every rule requires a minimum other-seed count, so an empty routing table can only ever
# produce an empty plan. Say so, instead of scanning the whole seed to report a misleading
# "prune 0 repos".
[ -s "$tmp/seeds" ] || {
  echo "# ABORT($mode): routing table empty via '$RAD' (home=$RAD_HOME)." >&2
  echo "# Every rule requires a minimum other-seed count, so no repo could qualify." >&2
  exit 5
}

# ----------------------------------------------------------------- scan: size, mtime, activity
# Batch the cheap per-repo work into one process each (size via a single du, mtime via a single
# find), and fan the one unavoidable per-repo call - `git for-each-ref` for last activity -
# across $JOBS workers. Everything then goes into bash maps so the classify loop spawns nothing
# per repo. The scan races a live node: a repo dir can vanish or turn unreadable mid-walk, and
# find/du then exit non-zero. Collect those errors instead of discarding them, and never let
# one abort the run. This counting walk races exactly like the four below it, so it gets the
# same treatment.
scanerr="$tmp/scan-errors"; : > "$scanerr"; : > "$tmp/hosts-fail"
nrepos=$(find "$STORAGE" -mindepth 1 -maxdepth 1 -type d 2>>"$scanerr" | wc -l) || true
echo "# scanning $nrepos repos (size + activity), $JOBS parallel workers..." >&2

find "$STORAGE" -mindepth 1 -maxdepth 1 -type d -print0 2>>"$scanerr" \
  | xargs -0r du -sb --apparent-size 2>>"$scanerr" > "$tmp/du" || true
find "$STORAGE" -mindepth 1 -maxdepth 1 -type d -printf '%f\t%T@\n' 2>>"$scanerr" \
  > "$tmp/mtimes" || true
cat > "$tmp/life.sh" <<'LIFE'
#!/usr/bin/env bash
for d; do
  bl=$(GIT_DIR="$d" git for-each-ref --sort=creatordate \
         --format='%(creatordate:unix)' 2>/dev/null \
       | awk 'NR==1{b=$1} {l=$1} END{ if (NR) printf "%s\t%s", b, l; else printf "0\t0" }')
  printf '%s\t%s\n' "${d##*/}" "${bl:-0	0}"
done
LIFE
find "$STORAGE" -mindepth 1 -maxdepth 1 -type d -print0 2>>"$scanerr" \
  | xargs -0r -P "$JOBS" -n 64 bash "$tmp/life.sh" > "$tmp/lives" || true

# ----------------------------------------------------------------------- rule F: measure trees
# Adds up, per repo, how many bytes of media it carries and how many bytes of everything else.
# Extensions are only a fast path: what a file IS decides, read from its first bytes, so
# renaming a video to .dat does not hide it. Reading is bounded hard: a file is looked at only
# while the repo could still be a dump, and only its first 16 bytes. A repo we could not read
# is reported on fd 4 and dropped, never judged on a partial listing.
: > "$tmp/media"; : > "$tmp/media-fail"
mkdir -p "$tmp/blobs"
if [ "$MEDIA_SCAN" = 1 ] && rule_on F; then
  echo "# measuring repo trees for rule F ($JOBS workers)..." >&2
  cat > "$tmp/media.sh" <<MEDIA
#!/usr/bin/env bash
media_exts='$MEDIA_EXTS'
text_exts='$MEDIA_TEXT_EXTS'
text_names='$MEDIA_TEXT_NAMES'
# The wider of the two budgets: text over it means neither verdict can fire.
text_ceil=$(( MEDIA_TEXT_MAX_BYTES > MEDIA_TEXT_CEIL_BYTES ? MEDIA_TEXT_MAX_BYTES \
                                                           : MEDIA_TEXT_CEIL_BYTES ))
sniff_big=$MEDIA_SNIFF_TEXT_BYTES
sniff_max=$MEDIA_SNIFF_MAX_FILES
max_refs=$MEDIA_MAX_REFS
# One file per worker, so parallel writers appending blob ids cannot interleave a line.
blobs=$tmp/blobs/\$\$
MEDIA
  cat >> "$tmp/media.sh" <<'MEDIA'
# What the first 16 bytes say a file is, as lowercase hex, whatever its name says. Every
# signature below either holds a byte that cannot appear in UTF-8 text or is anchored past the
# start, so no plain text file can match one. Each `?` is one hex digit, so eight of them skip
# 4 bytes.
is_media() {
  case "$1" in
    ffd8ff*)                       return 0 ;;   # jpeg
    89504e470d0a1a0a*)             return 0 ;;   # png
    474946383761*|474946383961*)   return 0 ;;   # gif87a, gif89a
    1a45dfa3*)                     return 0 ;;   # matroska, webm
    ????????66747970*)             return 0 ;;   # "ftyp" at byte 4: mp4, mov, m4a, heic, avif
    52494646????????57454250*)     return 0 ;;   # riff + webp
    52494646????????57415645*)     return 0 ;;   # riff + wave
    52494646????????41564920*)     return 0 ;;   # riff + avi
    4f67675300*)                   return 0 ;;   # ogg
    664c6143*)                     return 0 ;;   # flac
    494433*|fffb*|fff3*|fff2*)     return 0 ;;   # mp3, tagged or a bare frame header
    3026b275*)                     return 0 ;;   # asf, wmv
    49492a00*|4d4d002a*)           return 0 ;;   # tiff, either byte order
    38425053*)                     return 0 ;;   # psd
    504b0304*)                     return 0 ;;   # zip, and the formats built on it
    1f8b*)                         return 0 ;;   # gzip
    526172211a07*)                 return 0 ;;   # rar
    377abcaf271c*)                 return 0 ;;   # 7z
  esac
  return 1
}
# The files the given refs reach, as "<oid> <size> <path>". A branch or tag comes in as
# "<ref>^{tree}", which lists what it holds now and nothing before it. A COB ref comes in
# whole, so its history comes too: a COB gains one commit per op and each commit's tree holds
# only that op's own files, so its tip alone shows the newest comment's attachment and nothing
# earlier. --ignore-missing keeps one broken ref from costing us the rest, and %(rest) hands
# each object's path from rev-list straight through cat-file, which knows the sizes.
files_in() {
  local d=$1; shift
  [ $# -gt 0 ] || return 0
  # The refs go in on stdin, not as arguments: a COB-heavy repo has thousands, and argv has a
  # size limit a ref list can reach. The filter keeps trees and commits out of the reader,
  # which is two thirds of what walking a COB emits and none of what we want.
  printf '%s\n' "$@" \
    | GIT_DIR="$d" git rev-list --objects --ignore-missing --stdin \
        --filter=object:type=blob 2>/dev/null \
    | GIT_DIR="$d" git cat-file \
        --batch-check='%(objectname) %(objecttype) %(objectsize) %(rest)' 2>/dev/null \
    | awk '$2 == "blob" { path = $0; sub(/^[^ ]+ [^ ]+ [^ ]+ /, "", path)
                          printf "%s %.0f %s\n", $1, $3, path }'
  # A lister that dies part-way through a repo emits a SHORT list rather than an error, and a
  # short list reads as a repo holding less: less text, which is the direction that condemns.
  # Say so on the stream instead, and the classifier below drops the repo. 141 is SIGPIPE: the
  # classifier stops reading once the repo has more text than any verdict allows, and that
  # short circuit is not a tear.
  local lister=${PIPESTATUS[1]} reader=${PIPESTATUS[2]}
  case $lister in 0|141) ;; *) echo torn; return ;; esac
  case $reader in 0|141) ;; *) echo torn ;; esac
}
for d; do
  rid=${d##*/}
  # --count stops the read one ref past the cap, which is both how we notice we hit it and
  # what keeps a 152k-ref repo from being read into a variable at all. First, so a repo over
  # the cap costs this one call and nothing else.
  allrefs=$(GIT_DIR="$d" git for-each-ref --count=$(( max_refs + 1 )) \
              --format='%(refname)' 2>/dev/null) || { echo "$rid" >&4; continue; }
  mapfile -t refs <<<"$allrefs"
  [ "${#refs[@]}" -le "$max_refs" ] || { echo "$rid" >&4; continue; }
  # A dump hides as well in an issue attachment as in a commit, so the repo's OWN COBs count
  # too. "Own" is decided by refs/rad/id, the identity document, which the local node writes
  # only after verifying its signatures; a stranger's push can never move it. Their content
  # lands under refs/namespaces/<their-nid>/ and is what the subtraction below drops.
  dids=$(GIT_DIR="$d" git grep -h -oE 'did:key:z[1-9A-HJ-NP-Za-km-z]+' refs/rad/id \
           2>/dev/null \
         | sed 's/^did:key://' | sort -u | tr '\n' ' ')
  # Collect the refs this repo's own delegates control, and only those. That is the canonical
  # branches and tags, which only a delegate can move, plus the delegates' own namespaces and
  # COBs. Any other peer's namespace is left out of the walk entirely: what a stranger pushed
  # is not evidence about this repo, so it must not condemn the repo, and it cannot be used to
  # spare one either. A branch or tag gets the "^{tree}" suffix here, so that files_in lists
  # what it holds now rather than walking its whole history; a COB ref goes in bare, because
  # for a COB the history IS the content.
  ours=""
  for ref in "${refs[@]}"; do
    case $ref in
      refs/heads/*|refs/tags/*) ours="$ours $ref^{tree}"; continue ;;
      refs/cobs/*)              ours="$ours $ref"; continue ;;
      refs/namespaces/*)
        nid=${ref#refs/namespaces/}; nid=${nid%%/*}
        case " $dids " in (*" $nid "*) ;; (*) continue ;; esac ;;
      *) continue ;;
    esac
    case $ref in
      */refs/cobs/*) ours="$ours $ref" ;;
      *)             ours="$ours $ref^{tree}" ;;
    esac
  done
  [ -n "$ours" ] || { printf '%s\t0\t0\n' "$rid"; continue; }
  # Sort into three: known media, known text, and everything else, which gets looked at. A
  # recognised text file bigger than sniff_big is looked at too, or naming a video README.md
  # would both hide it and blow the text budget that spares the repo.
  sums=$(files_in "$d" $ours \
    | awk -v m="$media_exts" -v t="$text_exts" -v tn="$text_names" -v big="$sniff_big" \
          -v ceil="$text_ceil" '
        # index, not a regex: a file literally called "[" would not compile as one.
        function known(list, key) { return index("|" list "|", "|" key "|") > 0 }
        $1 == "torn" { torn = 1; next }
        {
          oid = $1; size = $2 + 0
          if (oid in seen) next
          seen[oid] = 1
          # A path may hold spaces, so take everything past the first two fields rather
          # than the last one: a file called "clip.mp4 0" must not read as the digit name
          # that a COB op payload carries.
          base = $0; sub(/^[^ ]+ [^ ]+ /, "", base)
          sub(/^.*\//, "", base); base = tolower(base)
          ext = ""; if (match(base, /\.[a-z0-9]+$/)) ext = substr(base, RSTART + 1)
          if (ext != "" && known(m, ext))
            { media += size; printf "m %s %.0f\n", oid, size; next }
          # A COB op names its payload 0, 1, 2 and so on; those are JSON, there are millions
          # of them on a seed, and reading each one is most of what this rule costs. Anything
          # over sniff_big is still read, whatever it is called.
          if (size < big && (base ~ /^[0-9]+$/ || known(tn, base) ||
                             (ext != "" && known(t, ext)))) {
            text += size
            # Past the widest budget any verdict allows, nothing still unread can change the
            # answer, so stop the walk here. On a mirror of a real project that is the first
            # few files out of a million. exit runs END, which prints the totals as usual.
            if (text >= ceil) exit 0
            next
          }
          printf "? %s %.0f\n", oid, size; unk += size
        }
        END { if (torn) exit 1
              printf "= %.0f %.0f %.0f\n", media, text, unk }')
  # The awk above prints "=" last, so anything else there means it died part-way and the
  # totals are a fragment. A fragment is not evidence: report the repo, and leave it out of
  # the batch corpus below as well as out of its own verdict.
  read -r tag media text unk <<<"${sums##*$'\n'}"
  [ "$tag" = "=" ] || { echo "$rid" >&4; continue; }
  awk -v rid="$rid" '$1=="m" { printf "%s\t%s\t%s\n", $2, rid, $3 }' <<<"$sums" >> "$blobs"
  # Reading only pays off while the repo could still be a dump: once the text it already has
  # clears the widest budget any path allows, nothing an unread file turns out to be can
  # change the verdict.
  if [ "$text" -lt "$text_ceil" ]; then
    n=0
    while read -r _ oid size; do
      n=$((n+1))
      # Past the cap a file counts as text, sparing the repo: one too big to read through must
      # not be deleted on the strength of the part we did read.
      if [ "$n" -gt "$sniff_max" ]; then text=$((text+size)); continue; fi
      # od closes the pipe after 16 bytes and git dies of SIGPIPE, so a 500MB video costs one
      # pipe buffer rather than 500MB. Stripping the spaces in bash saves a fork per file.
      hex=$(GIT_DIR="$d" git cat-file blob "$oid" 2>/dev/null | od -An -tx1 -N16 -v)
      hex=${hex//[$' \n']/}
      if is_media "$hex"; then
        media=$((media+size)); printf '%s\t%s\t%s\n' "$oid" "$rid" "$size" >> "$blobs"
      else
        text=$((text+size))
      fi
    done < <(awk '$1=="?"' <<<"$sums")
  else
    text=$((text + unk))
  fi
  printf '%s\t%d\t%d\n' "$rid" "$media" "$text"
done
MEDIA
  find "$STORAGE" -mindepth 1 -maxdepth 1 -type d -print0 2>>"$scanerr" \
    | xargs -0r -P "$JOBS" -n 32 bash "$tmp/media.sh" \
        > "$tmp/media" 4> "$tmp/media-fail" || true
  nmediafail=$(sort -u "$tmp/media-fail" | wc -l)
  [ "$nmediafail" = 0 ] \
    || echo "# WARN: rule F left $nmediafail repo(s) unjudged: unreadable, or over" \
            "MEDIA_MAX_REFS ($MEDIA_MAX_REFS) refs." >&2

fi

# --------------------------------------------------------------- rule G: parasite peers, scan
# Records, per repo, what each NON-delegate peer has put there that the repo's own refs do not
# hold. `--not` hands the exclusion to git, which stops walking at the first shared commit, so
# a peer who merely replicates the repo produces no output at all and costs almost nothing.
# One combined listing runs first and most repos end there, because most have no stranger
# media; only where that finds some is the work repeated per peer to learn whose it is.
: > "$tmp/peer"
if [ "$PARASITE_SCAN" = 1 ] && rule_on G; then
  echo "# looking for parasite peers for rule G ($JOBS workers)..." >&2
  cat > "$tmp/peer.sh" <<PEER
#!/usr/bin/env bash
media_exts='$MEDIA_EXTS'
max_refs=$MEDIA_MAX_REFS
PEER
  cat >> "$tmp/peer.sh" <<'PEER'
shopt -s nullglob
# Prints "<oid> <bytes> <path>" for every blob reachable from the refs in $1 but not from any
# ref in $2. Both arrive as newline-separated lists on the named variables, never as arguments,
# because a widely replicated repo has thousands of refs and argv has a size limit.
only_in() {
  printf '%s\n' $1 > "$TMPDIR_PEER/want"
  printf '%s\n' $2 | sed 's/^/^/' >> "$TMPDIR_PEER/want"
  GIT_DIR="$d" git rev-list --objects --ignore-missing --stdin \
      --filter=object:type=blob < "$TMPDIR_PEER/want" 2>/dev/null \
    | GIT_DIR="$d" git cat-file \
        --batch-check='%(objectname) %(objecttype) %(objectsize) %(rest)' 2>/dev/null \
    | awk '$2 == "blob" { path = $0; sub(/^[^ ]+ [^ ]+ [^ ]+ /, "", path)
                          printf "%s %.0f %s\n", $1, $3, path }'
}
# Splits a blob listing into the media bytes and the other bytes it holds. Extension only: rule
# G accuses a person, so it leans on the same file appearing again and again rather than on a
# guess about one file's type, and a sniffer here would cost a read per blob across the seed.
split_bytes() {
  awk -v m="$media_exts" '
    function known(list, key) { return index("|" list "|", "|" key "|") > 0 }
    { oid = $1; size = $2 + 0
      base = $0; sub(/^[^ ]+ [^ ]+ /, "", base); sub(/^.*\//, "", base); base = tolower(base)
      ext = ""; if (match(base, /\.[a-z0-9]+$/)) ext = substr(base, RSTART + 1)
      if (ext != "" && known(m, ext)) { printf "b %s %.0f\n", oid, size; media += size }
      else                                                              other += size }
    END { printf "= %.0f %.0f\n", media, other }'
}
TMPDIR_PEER=$(mktemp -d) || exit 0
trap 'rm -rf "$TMPDIR_PEER"' EXIT
for d; do
  rid=${d##*/}
  # Same trust root as rule F: refs/rad/id is written by the local node only after it verifies
  # the identity document's signatures, so a stranger's push cannot make itself a delegate.
  # This runs before any skip below, because a delegate is never blocked and that protection
  # must not depend on whether the rest of this repo turned out to be worth walking.
  dids=$(GIT_DIR="$d" git grep -h -oE 'did:key:z[1-9A-HJ-NP-Za-km-z]+' refs/rad/id \
           2>/dev/null \
         | sed 's/^did:key://' | sort -u | tr '\n' ' ')
  if [ -z "$dids" ]; then printf 'u\t%s\n' "$rid"; continue; fi
  for nid in $dids; do printf 'd\t%s\n' "$nid"; done
  allrefs=$(GIT_DIR="$d" git for-each-ref --format='%(refname)' 2>/dev/null) || continue
  mapfile -t refs <<<"$allrefs"
  [ "${#refs[@]}" -le "$max_refs" ] || continue
  # OWN is everything the delegates control, and it is the exclusion set. Whole histories go in
  # here rather than tips, because a wider exclusion can only ever spare a peer.
  own=""; strangers=""
  for ref in "${refs[@]}"; do
    case $ref in
      refs/heads/*|refs/tags/*|refs/cobs/*|refs/rad/*) own="$own"$'\n'"$ref"; continue ;;
      refs/namespaces/*) nid=${ref#refs/namespaces/}; nid=${nid%%/*} ;;
      *) continue ;;
    esac
    case " $dids " in
      (*" $nid "*) own="$own"$'\n'"$ref" ;;
      (*)          strangers="$strangers"$'\n'"$nid"$'\t'"$ref" ;;
    esac
  done
  [ -n "$strangers" ] || continue
  # The cheap tier: one listing for every stranger at once. Most repos stop here.
  combined=$(cut -f2 <<<"${strangers#$'\n'}")
  any=$(only_in "$combined" "$own" | split_bytes | awk '$1 == "="{ print ($2 > 0) }')
  [ "$any" = 1 ] || continue
  # Something is there, so pay to learn whose. One listing per peer, and the peers with
  # nothing of their own drop out having cost one walk that ends at the first shared commit.
  for nid in $(cut -f1 <<<"${strangers#$'\n'}" | sort -u); do
    mine=$(awk -F'\t' -v n="$nid" '$1 == n { print $2 }' <<<"${strangers#$'\n'}")
    only_in "$mine" "$own" | split_bytes \
      | awk -v nid="$nid" -v rid="$rid" '
          $1 == "b" { printf "b\t%s\t%s\t%s\t%s\n", nid, rid, $2, $3 }
          $1 == "=" { printf "=\t%s\t%s\t%s\t%s\n", nid, rid, $2, $3 }'
  done
done
PEER
  find "$STORAGE" -mindepth 1 -maxdepth 1 -type d -print0 2>>"$scanerr" \
    | xargs -0r -P "$JOBS" -n 32 bash "$tmp/peer.sh" > "$tmp/peer" || true
fi


# ----------------------------------------------------------------------- rule E: collect hosts
# Collects the hostnames each repo mentions, folded to domains later. Reading file content is
# slow, so LINK_SCAN=0 turns it off, and each repo is walked in two steps: list blob ids and
# sizes without reading them, then read only the ones under the size cap. Where a link sits
# does not matter here: issues, patches, comments and committed files all count.
: > "$tmp/hosts"
if [ "$LINK_SCAN" = 1 ] && rule_on E; then
  echo "# harvesting referenced hosts from repo contents ($JOBS workers)..." >&2
  cat > "$tmp/hosts.sh" <<HOSTS
#!/usr/bin/env bash
ceiling=$LINK_BLOB_PREFIX
budget=$LINK_REPO_BUDGET
HOSTS
  cat >> "$tmp/hosts.sh" <<'HOSTS'
# Reads blob ids on stdin. Prints the hostnames those blobs mention, one per line, without
# repeats.
hosts_of() {
  GIT_DIR="$1" git cat-file --batch 2>/dev/null \
    | head -c "$budget" \
    | grep -aoE 'https?://[A-Za-z0-9._-]+' \
    | sed -E 's#^https?://##' \
    | tr '[:upper:]' '[:lower:]' \
    | sort -u
}
for d; do
  rid=${d##*/}
  # Every file in the repo, wherever it lives. A repo we cannot list is reported on fd 4 rather
  # than returning an empty host list, which would be indistinguishable from a repo with no
  # links.
  GIT_DIR="$d" git cat-file --batch-all-objects \
       --batch-check='%(objectname) %(objecttype) %(objectsize)' 2>/dev/null \
    | awk -v c="$ceiling" '$2=="blob" && $3+0<=c {print $1}' \
    | hosts_of "$d" | sed "s#^#$rid\t#"
  # A repo bigger than the budget closes the pipe early, which kills the lister with SIGPIPE
  # (141). That is the cap doing its job. Any other failure means we could not read the repo.
  st=${PIPESTATUS[0]}
  { [ "$st" = 0 ] || [ "$st" = 141 ]; } || echo "$rid" >&4
  # Same again, restricted to the CANONICAL branches and tags, written to fd 3. Those are the
  # refs only a delegate can move, so a stranger cannot make a host look like this repo's
  # dependency. A host enough repos link to from their own code is a dependency, and stops
  # counting as spam.
  GIT_DIR="$d" git rev-list --objects --branches --tags 2>/dev/null \
    | cut -d' ' -f1 \
    | hosts_of "$d" | sed "s#^#$rid\t#" >&3
done
HOSTS
  find "$STORAGE" -mindepth 1 -maxdepth 1 -type d -print0 2>>"$scanerr" \
    | xargs -0r -P "$JOBS" -n 32 bash "$tmp/hosts.sh" \
        > "$tmp/hosts" 3> "$tmp/hosts-code" 4> "$tmp/hosts-fail" || true
  echo "# harvested $(wc -l < "$tmp/hosts") repo/host pairs over" \
       "$(cut -f1 "$tmp/hosts" | sort -u | wc -l) repos" >&2
  nhostfail=$(sort -u "$tmp/hosts-fail" | wc -l)
  [ "$nhostfail" = 0 ] \
    || echo "# WARN: could not read $nhostfail repo(s); excluded from the plan." >&2
fi

# A repo we could not fully read has an untrustworthy size and age, so exclude it from the plan
# rather than judge it on partial data. find and du name the offending path, so take the
# component right after $STORAGE/ instead of pattern-matching a rid: exact for any rid length,
# and literal even where the path itself holds glob characters.
while IFS= read -r line; do
  rid=${line#*"$STORAGE/"}
  [ "$rid" = "$line" ] && continue          # this error is not about a repo dir
  rid=${rid%%/*}; rid=${rid%%\'*}           # first component, minus find/du's closing quote
  case "$rid" in ?*) printf '%s\n' "$rid" ;; esac
done < "$scanerr" | cat - "$tmp/hosts-fail" | sort -u > "$tmp/scanfail"
nscanerr=$(wc -l < "$scanerr"); nscanfail=$(wc -l < "$tmp/scanfail")
if [ "$nscanerr" -gt 0 ]; then
  echo "# WARN: $nscanerr scan error(s); $nscanfail repo(s) unreadable, excluded:" >&2
  head -3 "$scanerr" | sed 's/^/#   /' >&2
  [ "$nscanerr" -gt 3 ] && echo "#   ...and $((nscanerr - 3)) more" >&2
fi

# ------------------------------------------------------------------- rule E: find spam domains
# A spam domain is one that at least $minrepos repos link to and under LINK_CODE_MAX_PCT% of
# those link to from their own code. The second condition tells a site the spam advertises
# apart from github.com: hundreds of repos link to each, but nearly every github.com linker
# also has it in source or a README. Both are counted from storage on every run, so there is no
# blocklist.
#
# It takes two passes, because a code link only counts when the repo it comes from is not
# itself suspect. Pass 1 marks the suspects: repos rule D already calls generated, plus repos
# that reach LINK_MIN_SCORE against a looser reading of what a spam domain is. Pass 2 is the
# real test and ignores their code links. Otherwise a spammer clears their own domain by
# committing the link in one repo in ten, using repos they already have.
minrepos=$(awk -v n="$nrepos" -v pct="$LINK_MIN_REPOS_PCT" -v floor="$LINK_MIN_REPOS" \
               'BEGIN{ s=n*pct/100; printf "%d", (s>floor)?s:floor }')
: > "$tmp/linkfarm"; : > "$tmp/linktop"
if [ -s "$tmp/hosts" ]; then
  awk -F'\t' -v MINREPOS="$minrepos" -v MINSCORE="$LINK_MIN_SCORE" \
             -v CODEPCT="$LINK_CODE_MAX_PCT" -v LOOSEPCT="$LINK_CODE_LOOSE_PCT" \
             -v TOP="$tmp/linktop" '
    # Count by registrable domain, not by hostname: a wildcard DNS record and one subdomain per
    # repo would otherwise keep every name below the linker bar for free. Three labels when the
    # last is a two-letter country code behind a short one (co.uk, com.br, ne.jp), two
    # otherwise.
    function reg(h,   n,a) {
      n = split(h, a, ".")
      if (n <= 2) return h
      if (length(a[n])==2 && length(a[n-1])<=3) return a[n-2] "." a[n-1] "." a[n]
      return a[n-1] "." a[n]
    }
    FILENAME==ARGV[1] { suspect[$1]=1; next }        # rule D calls these repos generated
    FILENAME==ARGV[2] { d=reg($2); codepair[$1 SUBSEP d]=1; allcode[d]++; next }  # from code
    { d=reg($2); links[d]++; pair[$1 SUBSEP d]=1 }   # one line per repo/domain: counts repos
    END {
      # Pass 1: the same test at the looser cap, used only to add to the suspect list.
      for (h in links)
        if (links[h] >= MINREPOS && (allcode[h]+0)*100 < LOOSEPCT*links[h]) loose[h]=1
      for (k in pair) { split(k,q,SUBSEP); if (q[2] in loose) loosescore[q[1]]++ }
      for (r in loosescore) if (loosescore[r] >= MINSCORE) suspect[r]=1
      # Pass 2: the real test. Only links[] counts every repo, on purpose - the spam repos are
      # exactly the linkers that make a host stand out, so filtering them would erase the
      # signal.
      for (k in codepair) { split(k,q,SUBSEP); if (!(q[1] in suspect)) vouch[q[2]]++ }
      for (h in links)
        if (links[h] >= MINREPOS && (vouch[h]+0)*100 < CODEPCT*links[h])
          { spamdom[h]=1; printf "%d\t%s\n", links[h], h > TOP }
      for (k in pair) { split(k,q,SUBSEP); if (q[2] in spamdom) score[q[1]]++ }
      for (r in score) if (score[r] >= MINSCORE) printf "%s\t%d\n", r, score[r]
    }' "$tmp/spam" "$tmp/hosts-code" "$tmp/hosts" > "$tmp/linkfarm" || true
  # Reported whenever the corpus yields any spam domain, even if no repo then crosses the score
  # bar: what the rule saw is worth knowing on a run where it decides to flag nothing.
  nfarm=$(wc -l < "$tmp/linkfarm"); nspamdom=$(wc -l < "$tmp/linktop")
  if [ "$nspamdom" -gt 0 ]; then
    echo "# spam domains: $nspamdom domain(s) linked from >=$minrepos repos," \
         "<$LINK_CODE_MAX_PCT% from code;"
    echo "#   $nfarm repo(s) link to >=$LINK_MIN_SCORE of them," \
         "before the age and seed checks:"
    sort -k1,1nr "$tmp/linktop" | head -5 | awk -F'\t' '{printf "#   %5d repos  %s\n", $1, $2}'
    [ "$nspamdom" -gt 5 ] && echo "#   ...and $((nspamdom - 5)) more"
  fi
fi

# ---------------------------------------------------------------- rule E: whose links are they
# Any peer may push an issue or a comment to any public repo, and it lands in that repo's
# storage here, so the harvest above counts a stranger's links as the repo's own. Left alone
# that turns rule E into a weapon: five spam links in five issues and somebody else's repo is
# in the plan. Every repo that scored is therefore re-read across the refs its DELEGATES
# control - the canonical branches and each delegate's namespace - and keeps its score only if
# it survives there. A repo whose delegates cannot be read is dropped from the plan, not kept.
if [ "$LINK_DELEGATE_CHECK" = 1 ] && [ -s "$tmp/linkfarm" ]; then
  cut -f2 "$tmp/linktop" | sort -u > "$tmp/spamdomains"
  cat > "$tmp/owned.sh" <<OWNED
#!/usr/bin/env bash
RAD=$(printf %q "$RAD"); STORAGE=$(printf %q "$STORAGE")
ceiling=$LINK_BLOB_PREFIX
budget=$LINK_REPO_BUDGET
OWNED
  cat >> "$tmp/owned.sh" <<'OWNED'
for rid in "$@"; do
  d="$STORAGE/$rid"
  nids=$("$RAD" inspect "rad:$rid" --delegates 2>/dev/null \
         | grep -oE 'z[1-9A-HJ-NP-Za-km-z]{40,}' | tr '\n' ' ')
  [ -n "$nids" ] || { echo "$rid" >&3; continue; }   # no delegate list: ownership unknown
  # The blob filter keeps trees out of the reader below, which only ever wanted blobs.
  GIT_DIR="$d" git for-each-ref --format='%(objectname) %(refname)' 2>/dev/null \
    | awk -v ok="$nids" '
        BEGIN { n=split(ok,a," "); for (i=1;i<=n;i++) keep[a[i]]=1 }
        { if ($2 ~ /^refs\/namespaces\//) { split($2,p,"/"); if (!(p[3] in keep)) next }
          print $1 }' \
    | GIT_DIR="$d" git rev-list --objects --stdin --filter=object:type=blob 2>/dev/null \
    | cut -d' ' -f1 \
    | GIT_DIR="$d" git cat-file \
        --batch-check='%(objectname) %(objecttype) %(objectsize)' 2>/dev/null \
    | awk -v c="$ceiling" '$2=="blob" && $3+0<=c {print $1}' \
    | GIT_DIR="$d" git cat-file --batch 2>/dev/null \
    | head -c "$budget" \
    | grep -aoE 'https?://[A-Za-z0-9._-]+' \
    | sed -E 's#^https?://##' | tr '[:upper:]' '[:lower:]' | sort -u | sed "s#^#$rid\t#"
done
OWNED
  cut -f1 "$tmp/linkfarm" | tr '\n' '\0' \
    | xargs -0r -P "$JOBS" -n 8 bash "$tmp/owned.sh" \
        > "$tmp/owned" 3> "$tmp/owned-fail" || true
  # reg() below must fold exactly as the harvest pass does, or a domain counted there would
  # score differently here. Kept as its own copy so each awk program reads on its own.
  awk -F'\t' -v MINSCORE="$LINK_MIN_SCORE" '
    function reg(h,   n,a) {
      n = split(h, a, ".")
      if (n <= 2) return h
      if (length(a[n])==2 && length(a[n-1])<=3) return a[n-2] "." a[n-1] "." a[n]
      return a[n-1] "." a[n]
    }
    FILENAME==ARGV[1] { spam[$1]=1; next }
    { d=reg($2); if (d in spam) pair[$1 SUBSEP d]=1 }
    END {
      for (k in pair) { split(k,q,SUBSEP); score[q[1]]++ }
      for (r in score) if (score[r] >= MINSCORE) printf "%s\t%d\n", r, score[r]
    }' "$tmp/spamdomains" "$tmp/owned" > "$tmp/linkfarm.owned" || true
  # Two different outcomes, counted apart: a repo whose own peers turned out not to be linking
  # the spam, and a repo we could not attribute at all. Both leave the plan, for different
  # reasons.
  nunreadable=$(sort -u "$tmp/owned-fail" | wc -l)
  nspared=$(( $(wc -l < "$tmp/linkfarm") - $(wc -l < "$tmp/linkfarm.owned") - nunreadable ))
  mv "$tmp/linkfarm.owned" "$tmp/linkfarm"
  [ "$nspared" -le 0 ] \
    || echo "# rule E: $nspared repo(s) spared, the spam links were pushed by peers" \
            "that are not their delegates"
  [ "$nunreadable" = 0 ] \
    || echo "# WARN: rule E: $nunreadable repo(s) spared," \
            "their delegates could not be read" >&2
fi

declare -A SIZE MTIME LIFE BIRTH NAME SEEDS EXCL SCANFAIL SPAM LINKSCORE MEDIA SHARED \
           FIRSTSEEN
while IFS=$'\t' read -r sz path; do SIZE[${path##*/}]=$sz; done < "$tmp/du"
while IFS=$'\t' read -r rid mt;   do MTIME[$rid]=${mt%.*}; done < "$tmp/mtimes"
while IFS=$'\t' read -r rid bt lf; do BIRTH[$rid]=$bt; LIFE[$rid]=$lf; done < "$tmp/lives"
while IFS=$'\t' read -r rid nm _; do NAME[$rid]=$nm; done < "$tmp/meta"
while IFS=$'\t' read -r rid s;    do SEEDS[$rid]=$s; done < "$tmp/seeds"
while read -r r; do [ -n "$r" ] && EXCL[$r]=1; done < "$tmp/excluded"
while read -r r; do [ -n "$r" ] && SCANFAIL[$r]=1; done < "$tmp/scanfail"
while read -r r; do [ -n "$r" ] && SPAM[$r]=1; done < "$tmp/spam"
while IFS=$'\t' read -r rid sc; do [ -n "$rid" ] && LINKSCORE[$rid]=$sc; done < "$tmp/linkfarm"
# When this seed first saw each repo. Every date inside a repo is set by whoever pushed it, so
# a spammer who rewrites all their refs resets the age rules D, E and F measure from. This
# ledger cannot be reached from outside, so those rules use whichever of the two is older.
# The file is appended to on every run, dry or not; without it the tool still works, on ref
# dates alone. Non-numeric timestamps are skipped rather than trusted: this file is appended to
# for years, and a crash mid-write leaves a torn last line that would otherwise reach an
# arithmetic comparison.
[ -r "$FIRST_SEEN" ] && while IFS=$'\t' read -r rid ts; do
  [ -n "$rid" ] || continue
  case $ts in ''|*[!0-9]*) continue ;; esac
  FIRSTSEEN[$rid]=$ts
done < "$FIRST_SEEN"
if mkdir -p "$AUDIT_DIR" 2>/dev/null && { : >> "$FIRST_SEEN"; } 2>/dev/null; then
  for rid in "${!SIZE[@]}"; do
    [ -n "${FIRSTSEEN[$rid]:-}" ] && continue
    FIRSTSEEN[$rid]=$now; printf '%s\t%s\n' "$rid" "$now" >> "$FIRST_SEEN"
  done
else
  echo "# WARN: cannot write $FIRST_SEEN; ages come from ref dates, which a pusher sets." >&2
fi

# The same file published again and again is evidence no single repo can manufacture. Blobs
# MEDIA_MIN_BATCH or more repos hold are a campaign, and per repo this adds up the bytes it
# keeps in them. The EARLIEST holder is left out of its own batch: without that, reposting
# somebody's photos into five repos of your own would put THEIR repo in the plan. Earliest is
# by first-seen, the one date a pusher cannot backdate, so on a seed whose ledger starts today
# the exemption falls to whichever repo sorts first until the ledger has some history.
# `|| true` because with MEDIA_SCAN=0 no worker ran, so the glob below matches no file and
# sort exits non-zero on it, which under `pipefail` would end the run.
{ sort -u "$tmp/blobs"/* 2>/dev/null || true; } \
  | awk -F'\t' -v k="$MEDIA_MIN_BATCH" -v now="$now" -v seenfile="$FIRST_SEEN" '
      BEGIN { while ((getline line < seenfile) > 0) {
                split(line, f, "\t")
                if (f[2] ~ /^[0-9]+$/) seen[f[1]] = f[2]
              } }
      { n++; oid[n]=$1; rid[n]=$2; size[n]=$3; holders[$1]++
        age = ($2 in seen) ? seen[$2] : now
        if (!($1 in first) || age < firstage[$1]) { first[$1]=$2; firstage[$1]=age } }
      END { for (i=1;i<=n;i++)
              if (holders[oid[i]] >= k && rid[i] != first[oid[i]]) shared[rid[i]] += size[i]
            for (r in shared) printf "%s\t%.0f\n", r, shared[r] }' > "$tmp/media-shared"
while IFS=$'\t' read -r rid b; do [ -n "$rid" ] && SHARED[$rid]=$b; done < "$tmp/media-shared"

# Rule F decides here rather than in the scan, so the thresholds it uses sit next to every
# other rule's. A repo whose tree could not be listed never enters the map. MEDIA holds the
# verdict word, so the plan says which of the two paths reached the repo.
while IFS=$'\t' read -r rid mb ob; do
  [ -n "$rid" ] || continue
  [ "$mb" -ge "$MEDIA_MIN_BYTES" ] || continue
  # On its own a repo has to carry no project at all. Where other repos hold the very same
  # files, a token README no longer clears it.
  if   [ "$ob" -lt "$MEDIA_TEXT_MAX_BYTES" ]; then
    MEDIA[$rid]=media-dump
  elif [ "$ob" -lt "$MEDIA_TEXT_CEIL_BYTES" ] \
       && [ "${SHARED[$rid]:-0}" -ge "$MEDIA_MIN_BYTES" ]; then
    MEDIA[$rid]=media-batch
  fi
done < "$tmp/media"
while read -r r; do [ -n "$r" ] && unset 'MEDIA[$r]'; done < "$tmp/media-fail"

# ------------------------------------------------------------------- rule G: judge the peers
# Folds the per-repo evidence into one verdict per peer. The accusation is a single file, byte
# for byte, that this peer put into PARASITE_MIN_REPOS repos it does not own. Totals across
# different files are deliberately NOT enough on their own: someone active on many repos
# accumulates those honestly, while the same oid landing in unrelated repos does not happen by
# accident. A peer who is a delegate anywhere in storage is never accused, because blocking a
# delegate stops the repos they own from replicating (the node filters delegate refs through
# the same block list before it checks the signature threshold).
: > "$tmp/parasites"; nunknown=0
if [ "$PARASITE_SCAN" = 1 ] && rule_on G && [ -s "$tmp/peer" ]; then
  nunknown=$(awk -F'\t' '$1 == "u"' "$tmp/peer" | sort -u | wc -l)
  awk -F'\t' -v k="$PARASITE_MIN_REPOS" -v minb="$PARASITE_MIN_BYTES" \
             -v maxt="$PARASITE_TEXT_MAX_BYTES" -v us="$OUR_NID" '
      $1 == "d" { delegate[$2] = 1; next }
      # One repo can list the same oid twice (two refs, one blob), so count each repo once.
      $1 == "b" { if (!((($2 SUBSEP $4) SUBSEP $3) in pair)) {
                    pair[($2 SUBSEP $4) SUBSEP $3] = 1; spread[$2 SUBSEP $4]++ }
                  next }
      $1 == "=" { media[$2] += $4; other[$2] += $5
                  if ($4 > 0 && !(($2 SUBSEP $3) in hit)) { hit[$2 SUBSEP $3]=1; repos[$2]++ }
                  next }
      END {
        for (key in spread) {
          split(key, f, SUBSEP)
          if (spread[key] > widest[f[1]]) { widest[f[1]] = spread[key]; worst[f[1]] = f[2] }
        }
        for (nid in widest) {
          if (nid == us || nid in delegate) continue
          if (widest[nid] < k || media[nid] < minb || other[nid] >= maxt) continue
          printf "%s\t%d\t%d\t%.0f\t%.0f\t%s\n",
                 nid, widest[nid], repos[nid], media[nid], other[nid], worst[nid]
        }
      }' "$tmp/peer" | sort -k2,2nr > "$tmp/parasites"
fi
nparasite=$(wc -l < "$tmp/parasites")

: > "$tmp/repos"   # rid \t size \t mtime \t life \t birth
for rid in "${!SIZE[@]}"; do
  printf '%s\t%s\t%s\t%s\t%s\n' \
    "$rid" "${SIZE[$rid]}" "${MTIME[$rid]:-0}" "${LIFE[$rid]:-0}" "${BIRTH[$rid]:-0}"
done > "$tmp/repos"
total_repos=$(wc -l < "$tmp/repos")

# percentiles for the relative size cut, and for the header line that prints them
read -r p50 p90 p95 p99 < <(cut -f2 "$tmp/repos" | sort -n | awk '
  {a[NR]=$1} END{
    i50=int(0.50*NR); if(i50<1)i50=1; i90=int(0.90*NR); if(i90<1)i90=1
    i95=int(0.95*NR); if(i95<1)i95=1; i99=int(0.99*NR); if(i99<1)i99=1
    printf "%d %d %d %d\n", a[i50], a[i90], a[i95], a[i99] }')
relcut=$(cut -f2 "$tmp/repos" | sort -n \
  | awk -v p="$eff_pctl" '{a[NR]=$1} END{ i=int(p/100*NR); if(i<1)i=1; print a[i] }')
abscut=$(( eff_abs_mb * 1024 * 1024 ))
echo "# repos=$total_repos  sizes P50=$((p50/1048576))M P90=$((p90/1048576))M" \
     "P95=$((p95/1048576))M P99=$((p99/1048576))M" \
     "rel-cut(P${eff_pctl})=$((relcut/1048576))M  abs-cut=${eff_abs_mb}M"

# ---------------------- classify (map lookups + native bash regex; zero per-repo subprocesses)
: > "$tmp/plan"   # rid \t size \t seeds \t life \t reason \t name \t age_from
: > "$tmp/media-review"
nblind=0; nfresh=0; nnoage=0
while IFS=$'\t' read -r rid sz mt life birth; do
  [ -n "${SCANFAIL[$rid]:-}" ] && { nblind=$((nblind+1)); continue; }  # size and age unusable
  [ -n "${EXCL[$rid]:-}" ] && continue                # pinned / private / own
  [ "$life" = 0 ] && { nnoage=$((nnoage+1)); continue; }               # unknown age: leave it
  [ "$mt" -ge "$fresh_cut" ] && { nfresh=$((nfresh+1)); continue; }     # in-flight fetch

  # Rules D, E and F measure age from here: the older of the repo's own oldest ref date and
  # the day this seed first saw it. A pusher controls the first and cannot reach the second.
  origin=$birth
  [ -n "${FIRSTSEEN[$rid]:-}" ] && [ "${FIRSTSEEN[$rid]}" -lt "$origin" ] \
    && origin=${FIRSTSEEN[$rid]}

  name=${NAME[$rid]:-}; [ -z "$name" ] && name='(?)'
  seeds=${SEEDS[$rid]:-0}

  lname=${name,,}
  # The two branches cannot both match, because no word in JUNK_WORD_REGEX is spellable in
  # [0-9a-f] alone, so a pure-hex name never hits the word regex. Order here is for reporting,
  # not logic. Adding a hex-spellable word to that list (dead, beef, cafe) would break the
  # assumption.
  is_junk=0     # a disposable WORD in the name: a guess, so it keeps the last-copy floor
  is_junkid=0   # the name is ONLY a random hex id: generated, so it may take the last copy
  if [[ $lname =~ $JUNK_WORD_REGEX ]] || [[ $lname =~ $JUNK_EXACT_REGEX ]]; then is_junk=1; fi
  if [ "$JUNK_ID_MIN_LEN" -gt 0 ] && [ "${#lname}" -ge "$JUNK_ID_MIN_LEN" ] \
     && [[ $lname =~ ^[0-9a-f]+$ ]] && [[ $lname =~ [a-f] ]] && [[ $lname =~ [0-9] ]]; then
    is_junkid=1
  fi
  is_big=0; [ "$sz" -gt "$abscut" ] && [ "$sz" -ge "$relcut" ] && is_big=1

  reason=""
  # D, E and F come first, so a repo the corpus shows to be generated bulk or to be selling
  # links, or whose own tree is nothing but media, reads as that rather than as ordinary
  # staleness.
  #
  # They measure $origin. None of their evidence is about time, so the window is only a grace
  # period in case the evidence was wrong, and measured from LAST ACTIVITY that grace period
  # never expires: the spammer appends a COB to their own repos every few days and resets it.
  #
  # $age_from records the date the matching rule measured, so the plan's AGE column explains
  # its own verdict. Without it a spam-batch row touched yesterday prints AGE 1 beside a 7-day
  # minimum.
  age_from=$life
  if   [ -n "${SPAM[$rid]:-}" ] && [ "$origin" != 0 ] && [ "$origin" -lt "$spam_cut" ] \
       && [ "$seeds" -ge "$SPAM_MIN_SEEDS" ]; then
    reason="spam-batch"; age_from=$origin
  elif [ -n "${LINKSCORE[$rid]:-}" ] && [ "$origin" != 0 ] && [ "$origin" -lt "$link_cut" ] \
       && [ "$seeds" -ge "$LINK_MIN_SEEDS" ]; then
    reason="link-farm"; age_from=$origin
  elif [ -n "${MEDIA[$rid]:-}" ] && [ "$origin" != 0 ] && [ "$origin" -lt "$media_cut" ] \
       && [ "$seeds" -ge "$MEDIA_MIN_SEEDS" ]; then
    reason=${MEDIA[$rid]}; age_from=$origin
  elif [ "$is_junkid" = 1 ] && [ "$life" -lt "$junk_cut" ] \
       && [ "$seeds" -ge "$JUNK_ID_MIN_SEEDS" ]; then
    reason="junk-id"
  elif [ "$is_junk" = 1 ] && [ "$life" -lt "$junk_cut" ] \
       && [ "$seeds" -ge "$JUNK_MIN_SEEDS" ]; then
    reason="junk-name"
  elif [ "$is_big" = 1 ] && [ "$life" -lt "$outlier_cut" ] \
       && [ "$seeds" -ge "$eff_seeds" ]; then
    reason="size-outlier"
  elif [ "$life" -lt "$stale_cut" ] && [ "$seeds" -ge "$eff_seeds" ]; then
    reason="stale"
  fi
  # Rule F's evidence is about one repo, so it keeps the last copy we know of. Listing what
  # that floor spared, rather than passing over it in silence, is what stops the floor becoming
  # a standing exemption for anyone who makes sure nobody else seeds their dump. Only repos
  # nothing else prunes are listed, so the line can say they were kept.
  if [ -z "$reason" ] && [ -n "${MEDIA[$rid]:-}" ] && [ "$origin" != 0 ] \
     && [ "$origin" -lt "$media_cut" ] && [ "$seeds" -lt "$MEDIA_MIN_SEEDS" ]; then
    printf '%s\t%s\t%s\n' "$rid" "${MEDIA[$rid]}" "$name" >> "$tmp/media-review"
  fi
  [ -z "$reason" ] && continue
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$rid" "$sz" "$seeds" "$life" "$reason" "$name" "$age_from" >> "$tmp/plan"
done < "$tmp/repos"

# A scan that missed a big share of storage produces a small plan, not an accurate one, and a
# small plan reads like good news. Refuse to report one. Repos that vanished mid-walk never
# reached $tmp/repos at all, unreadable ones did but with untrustworthy numbers; both are blind
# spots.
echo "# skipped: $nblind unreadable, $nfresh written in the last ${FRESH_GUARD_DAYS}d," \
     "$nnoage with no readable refs"
blind=$(( nrepos - total_repos + nblind ))
[ "$blind" -le $(( nrepos * MAX_SCAN_FAIL_PCT / 100 )) ] || {
  echo "# ABORT($mode): could not read $blind of $nrepos repos" \
       "(limit ${MAX_SCAN_FAIL_PCT}%)." >&2
  echo "# A plan from a scan this blind would look small for the wrong reason." >&2
  exit 5
}

# -------------------------------------------------------------------------------------- report
# A disabled rule is filtered out here as well as skipped above, because rules A, B and C cost
# nothing to evaluate and are decided inline: this is the one place every verdict passes.
awk -F'\t' -v rules="$RULES" '
      BEGIN { split("junk-name A junk-id A size-outlier B stale C spam-batch D " \
                    "link-farm E media-dump F media-batch F", m, " ")
              for (i = 1; i < length(m); i += 2) letter[m[i]] = m[i+1] }
      { if (!($5 in letter) || index(rules, letter[$5])) print }' "$tmp/plan" \
  | sort -t$'\t' -k2,2nr > "$tmp/plan.sorted"
nplan=$(wc -l < "$tmp/plan.sorted")
bytes=$(awk -F'\t' '{s+=$2} END{printf "%.0f", s}' "$tmp/plan.sorted")
gib=$(awk -v b="$bytes" 'BEGIN{printf "%.2f", b/1073741824}')

# One awk for the whole table rather than one per row: a plan can run to hundreds of lines.
# It makes two passes: the first counts each verdict so the second knows what to fold.
awk -F'\t' -v now="$now" -v collapse="$PLAN_COLLAPSE_ROWS" -v full="$PLAN_FULL" '
     function size(b,   s, u, a, i) {
       s = b; u = "B"; split("KB MB GB", a, " ")
       for (i = 1; i <= 3 && s >= 1024; i++) { s /= 1024; u = a[i] }
       return sprintf("%.1f%s", s, u)
     }
     # The corpus verdicts. Each one is decided by a pattern across MANY repos, so reading its
     # rows one by one tells a reader nothing the group line does not already say.
     BEGIN { split("spam-batch link-farm media-batch", c, " ")
             for (i in c) corpus[c[i]] = 1 }
     NR == FNR { n[$5]++; b[$5] += $2; next }
     FNR == 1 { for (r in n) if (corpus[r] && !full && n[r] >= collapse) fold[r] = 1
                printf "\n%-34s %9s %6s %8s %-13s %s\n",
                       "RID", "SIZE", "SEEDS", "AGE(d)", "REASON", "NAME" }
     { if ($5 in fold) next
       printf "%-34s %9s %6s %8s %-13s %s\n",
              $1, size($2), $3, int((now - $7) / 86400), $5, $6 }
     END { for (r in fold)
             printf "%-34s %9s %6s %8s %-13s %s\n",
                    sprintf("(%d repos)", n[r]), size(b[r]), "", "", r,
                    "same pattern across many repos; PLAN_FULL=1 lists them"
     }' "$tmp/plan.sorted" "$tmp/plan.sorted"

# Not a plan line: rule F saw the evidence and the seed floor held it back. A human decides.
nreview=$(wc -l < "$tmp/media-review")
if [ "$nreview" -gt 0 ]; then
  echo
  echo "# review: $nreview media dump(s) no other node seeds, kept:"
  head -5 "$tmp/media-review" | awk -F'\t' '{printf "#   %-34s %-12s %s\n", $1, $2, $3}'
  [ "$nreview" -gt 5 ] && echo "#   ...and $((nreview - 5)) more"
fi

echo
echo "# PLAN: prune $nplan repos, reclaim ${gib} GiB"
awk -F'\t' '{ c[$5]++; b[$5]+=$2 }
     END { for (r in c) printf "#   %-13s %5d repos  %8.2f GiB\n",
                               r, c[r], b[r]/1073741824 }' "$tmp/plan.sorted" | sort

# Rule G's verdicts are about peers, so they get their own section rather than a row in the
# plan: nothing here deletes a repo, and blocking one peer touches every repo at once.
if [ "$nparasite" -gt 0 ]; then
  echo
  echo "# PARASITE PEERS: $nparasite (rule G)"
  echo "#   the count is repos reached by ONE file of theirs, not repos they touched"
  while IFS=$'\t' read -r nid widest nrepos mb ob oid; do
    printf '#   %s  %3d repos  %6.1f MB media  %6d B text  blob %s\n' \
           "$nid" "$widest" "$(awk -v b="$mb" 'BEGIN{printf "%.1f", b/1048576}')" \
           "$ob" "${oid:0:12}"
  done < "$tmp/parasites"
  [ "$nunknown" = 0 ] \
    || echo "#   NB: $nunknown repo(s) had an unreadable identity, so a peer who delegates" \
            "one of those was not spared by the delegate check."
  # Printed whether or not --block-peers was passed, so the operator can act on one peer
  # without handing the tool a standing licence over the whole list.
  echo "#   Blocking is permanent, invisible to the peer, and applies to every repo at once."
  echo "#   Check the evidence first, then run whichever of these you agree with:"
  cut -f1 "$tmp/parasites" | sed 's/^/#     rad block /'
  echo "#   Or --apply --block-peers, which asks again for each peer and needs a terminal."
fi

if [ "$APPLY" = 0 ]; then
  echo "# DRY-RUN: nothing changed. Re-run with --apply to execute."
  exit 0
fi

# --apply: the (slow) scan above ran ONCE. In a terminal, ask before deleting;
# non-interactively (cron, a pipe) just apply. --yes skips the prompt. A yes here is the human
# sign-off that lets a run bypass the runaway caps below.
[ "$nplan" = 0 ] && { echo "# nothing to do"; exit 0; }
CONFIRMED=0
if [ "$YES" = 0 ]; then
  prompt="# Apply now? unseed + block + DELETE $nplan repos, reclaiming ${gib} GiB"
  [ "$BLOCK_PEERS" = 1 ] && [ "$nparasite" -gt 0 ] \
    && prompt="$prompt, and BLOCK $nparasite peer(s)"
  prompt="$prompt [y/N] "
  reply=""; asked=1
  if [ -t 0 ]; then                                   # stdin is a terminal
    printf '%s' "$prompt"; IFS= read -r reply || reply=""
  elif { : >/dev/tty; } 2>/dev/null; then             # piped input but a terminal exists
    printf '%s' "$prompt" >/dev/tty; IFS= read -r reply </dev/tty || reply=""
  else
    asked=0                                       # no terminal (cron/CI/pipe): no prompt
  fi
  if [ "$asked" = 1 ]; then
    case "$reply" in
      [yY]|[yY][eE][sS]) CONFIRMED=1; echo "# confirmed." ;;
      *)                 echo "# aborted; nothing changed."; exit 0 ;;
    esac
  fi
fi

# --------------------------------------------------------------------------------------- apply
# Runaway caps guard unattended runs. An interactive yes is a human confirming the exact
# numbers just printed, so a confirmed run bypasses them. --yes and cron still respect them.
if [ "$FORCE" = 0 ] && [ "$CONFIRMED" = 0 ]; then
  over_gb=$(awk -v b="$bytes" -v m="$MAX_PRUNE_GB" 'BEGIN{print (b/1073741824 > m) ? 1 : 0}')
  if [ "$nplan" -gt "$MAX_PRUNE_COUNT" ] || [ "$over_gb" = 1 ]; then
    echo "# ABORT: plan ($nplan repos, ${gib} GiB) trips runaway caps" \
         "(count=$MAX_PRUNE_COUNT gb=$MAX_PRUNE_GB)." >&2
    echo "# Review it, then re-run with --force (unattended), or confirm interactively." >&2
    exit 3
  fi
  # The median of past runs, not the mean: one big first run would otherwise raise the bar
  # permanently and defeat the whole check. Fewer than three past runs is no baseline at all.
  # `|| true` because a seed that has never pruned has no history file at all, and under
  # `set -e` an assignment from a command that failed would end the run right here.
  usual=$(awk -F'\t' -v keep="$RATCHET_RUNS" '
            { for (i = 1; i <= NF; i++) if ($i ~ /^deleted=[0-9]+$/) { sub(/^deleted=/, "", $i)
                                                                      v[++n] = $i + 0 } }
            END { if (n < 3) { print ""; exit }
                  start = (n > keep) ? n - keep + 1 : 1; m = 0
                  for (i = start; i <= n; i++) w[++m] = v[i]
                  # insertion sort: m is at most RATCHET_RUNS, so this stays trivial
                  for (i = 2; i <= m; i++) { x = w[i]; j = i - 1
                    while (j > 0 && w[j] > x) { w[j+1] = w[j]; j-- }
                    w[j+1] = x }
                  print (m % 2) ? w[(m+1)/2] : int((w[m/2] + w[m/2+1]) / 2) }' \
            "$AUDIT_DIR/history.log" 2>/dev/null || true)
  if [ -n "$usual" ] && [ "$usual" -gt 0 ] \
     && [ "$nplan" -gt $(( usual * RATCHET_FACTOR )) ]; then
    echo "# ABORT: plan is $nplan repos where the last $RATCHET_RUNS runs pruned about" \
         "$usual. Something changed; a ${RATCHET_FACTOR}x jump is not a routine week." >&2
    echo "# Review it, then re-run with --force (unattended), or confirm interactively." >&2
    exit 3
  fi
fi

mkdir -p "$AUDIT_DIR"
run_ts=$(date -u +%FT%TZ)
audit="$AUDIT_DIR/prune-$(date -u +%Y%m%dT%H%M%SZ).log"
press_pct=$(awk -v p="$p" 'BEGIN{printf "%.0f",p*100}')
{ printf '# %s  pressure=%s%%  plan=%s repos / %s GiB\n' \
    "$run_ts" "$press_pct" "$nplan" "$gib"
  printf '# rid\tsize_bytes\tother_seeds\tlast_activity_unix\treason\tname\tage_from_unix\n'
  cat "$tmp/plan.sorted"; } > "$audit"
echo "# audit log: $audit"

# Empty the quarantine of anything past its window before pruning, so the disk this run
# reports as reclaimed is disk that actually came back. Under real pressure the window is
# ignored and the whole quarantine goes: a recovery copy is a luxury a full disk cannot buy.
quar="$AUDIT_DIR/quarantine"
if [ "$QUARANTINE" = 1 ]; then
  mkdir -p "$quar" 2>/dev/null || true
  purged=0
  if [ "$DISK_AWARE" = 1 ] \
     && awk -v a="$disk_avail" -v c="$crit_free" 'BEGIN{exit !(a <= c)}'; then
    for d in "$quar"/z*; do
      [ -e "$d" ] || continue
      rm -rf -- "$d" && purged=$((purged+1))
    done
    [ "$purged" = 0 ] \
      || echo "# disk is at the critical watermark: emptied the whole quarantine ($purged)."
  else
    while IFS= read -r d; do
      rm -rf -- "$d" && purged=$((purged+1))
    done < <(find "$quar" -mindepth 1 -maxdepth 1 -type d -name 'z*' \
                  -mtime "+$QUARANTINE_DAYS" 2>/dev/null)
  fi
  [ "$purged" = 0 ] || echo "# purged $purged repo(s) out of quarantine after" \
                            "${QUARANTINE_DAYS}d; they are gone for good now."
fi

if [ "$QUARANTINE" = 1 ]; then
  echo "# unseed + block + quarantine $nplan repos (recoverable for ${QUARANTINE_DAYS}d)..."
else
  echo "# unseed + block + delete $nplan repos..."
fi
deleted=0
while IFS=$'\t' read -r rid sz seeds life reason name; do
  "$RAD" unseed "rad:$rid" >/dev/null 2>&1 || true     # clear any policy FIRST
  "$RAD" block  "rad:$rid" >/dev/null 2>&1 \
    || { echo "#   WARN block failed, skipping delete: $rid" >&2; continue; }
  d="$STORAGE/$rid"
  case "$d" in
    "$STORAGE"/z*)
      if [ "$QUARANTINE" = 1 ]; then
        # A repo pruned twice (re-fetched, pruned again) would otherwise fail to move onto
        # its own older copy, so the older copy goes first.
        rm -rf -- "$quar/$rid" 2>/dev/null
        mv -- "$d" "$quar/$rid" 2>/dev/null && deleted=$((deleted+1)) \
          || echo "#   WARN quarantine failed: $d" >&2
      else
        rm -rf -- "$d" && deleted=$((deleted+1)) \
          || echo "#   WARN delete failed: $d" >&2
      fi ;;
    *) echo "#   SKIP unsafe path: $d" >&2 ;;
  esac
done < "$tmp/plan.sorted"

# The audit log and the GiB total were both written from the PLAN. If deletions failed, saying
# nothing here would leave a record claiming disk was reclaimed that never was.
[ "$deleted" = "$nplan" ] || {
  echo "# WARN: $((nplan - deleted)) of $nplan deletions failed;" \
       "less than ${gib} GiB was reclaimed." >&2
  echo "# The audit log lists the plan, not what actually got deleted." >&2
}

# Rule G's action. A block is permanent, it is invisible to the person blocked, and it applies
# to every repo at once, so it is the one thing here that never happens without a human in the
# room: --block-peers refuses outright when nothing can be asked, and asks again per peer.
# Blocking is what makes it stick, since the node filters every namespaced ref it receives
# through the block list whatever the seeding scope is, so refs dropped here do not come back.
# Dropping them frees no disk until git gc runs, which this tool does not do, so none of it is
# counted as reclaimed.
if [ "$BLOCK_PEERS" = 1 ] && [ "$nparasite" -gt 0 ]; then
  # The answers come in on fd 9, opened once here. Reading them from /dev/stdin instead would
  # find the loop's own input file below, since that loop redirects stdin to read the verdicts.
  asked=1
  if [ -t 0 ]; then exec 9<&0
  elif { : >/dev/tty; } 2>/dev/null; then exec 9</dev/tty
  else asked=0; fi
  if [ "$asked" = 0 ]; then
    echo "# --block-peers needs a terminal: blocking a peer is not a decision to automate." >&2
    echo "# Nobody was blocked. The commands are listed above; run them yourself." >&2
  else
    blocked=0
    while IFS=$'\t' read -r nid widest nrepos mb ob oid; do
      printf '# Block %s? it put %s in %s repos it does not own [y/N] ' \
             "$nid" "${oid:0:12}" "$widest"
      reply=""; IFS= read -r reply <&9 || reply=""
      case "$reply" in [yY]) ;; *) echo "#   skipped $nid"; continue ;; esac
      "$RAD" block "$nid" >/dev/null 2>&1 \
        || { echo "#   WARN block failed, leaving refs alone: $nid" >&2; continue; }
      blocked=$((blocked+1))
      # The evidence goes in the audit log beside the block, because a standing judgement
      # about a person that nobody can later explain is one nobody can later undo either.
      printf 'blocked-peer\t%s\tblob=%s\trepos=%s\tmedia_bytes=%s\tother_bytes=%s\n' \
             "$nid" "$oid" "$widest" "$mb" "$ob" >> "$audit"
      # Only the repos where this peer put content of its own. Where it merely mirrors a repo,
      # its refs hold that repo's own blobs, so removing them would free nothing and the block
      # already stops anything new arriving.
      while IFS=$'\t' read -r _ _ rid _ _; do
        d="$STORAGE/$rid"
        [ -d "$d" ] || continue
        GIT_DIR="$d" git for-each-ref --format='delete %(refname)' \
            "refs/namespaces/$nid/" 2>/dev/null \
          | GIT_DIR="$d" git update-ref --stdin 2>/dev/null \
          || echo "#   WARN could not drop $nid refs from $rid" >&2
      done < <(awk -F'\t' -v n="$nid" '$1 == "=" && $2 == n && $4 > 0' "$tmp/peer")
    done < "$tmp/parasites"
    echo "# blocked $blocked of $nparasite peer(s); run git gc to reclaim their objects."
  fi
fi

if [ "$RESTART" = 1 ]; then
  echo "# restarting $SERVICE (clears the stale inventory-announce warning)..."
  systemctl restart "$SERVICE" 2>&1 || sudo systemctl restart "$SERVICE" 2>&1 \
    || echo "# WARN restart failed; run: sudo systemctl restart $SERVICE" >&2
fi

# one appended line per run: the index into the per-run audit logs
printf '%s\tdeleted=%s\treclaimed_gib=%s\tquarantined=%s\tpressure=%s%%\taudit=%s\n' \
  "$run_ts" "$deleted" "$gib" "$QUARANTINE" "$press_pct" "$(basename "$audit")" \
  >> "$AUDIT_DIR/history.log"

# The GiB figure is what LEAVES storage. With quarantine on it is not free space yet, and
# saying "reclaimed" of disk still occupied is the kind of report that gets believed.
if [ "$QUARANTINE" = 1 ]; then
  echo "# DONE: quarantined $deleted repos, ~${gib} GiB out of storage but still on disk" \
       "for ${QUARANTINE_DAYS}d. Restore one with: mv $quar/<rid> $STORAGE/"
  echo "# Audit: $audit"
else
  echo "# DONE: deleted $deleted repos, reclaimed ~${gib} GiB. Audit: $audit"
fi
[ "$RESTART" = 1 ] \
  || echo "# tip: run 'sudo systemctl restart $SERVICE' once to clear the stale" \
          "inventory-announce log warning."
