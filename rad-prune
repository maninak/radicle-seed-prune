# Verdicts that rest on a repo being left alone. A push after the prune is the evidence they
# lacked, so it lifts the block: one by a delegate, or by any node where the audit log names no
# delegates. A push says nothing against other verdicts, since spam campaigns keep pushing to
# blocked repos.
UNDO_REVIVE_REASONS="junk-name junk-id size-outlier stale"

# What rules F and G and the denied-file search read from each repo, kept between runs and
# reused for unchanged repos (see "the run cache" below).
CACHE="${CACHE:-1}"                              # 0 reads every repo on every run
CACHE_DIR="${CACHE_DIR:-$AUDIT_DIR/cache}"
# A corpus verdict (one template or file across many repos) is evidence one repo cannot
# manufacture, so it is summarised once its group is too big to read. Verdicts resting on one
# repo's own metadata are always listed in full, since those want human eyes.
PLAN_COLLAPSE_ROWS="${PLAN_COLLAPSE_ROWS:-20}"   # group size at which a corpus verdict folds
PLAN_FULL="${PLAN_FULL:-0}"                      # 1 lists every row whatever the verdict
NEAR_PCT="${NEAR_PCT:-20}"     # % of a threshold that still counts as near it; 0 marks none
# Normalised here: the shell compares it to 1 while awk would take PLAN_FULL=true as on,
# unfolding the rows yet still telling the reader to set PLAN_FULL=1.
case "$PLAN_FULL" in 1) ;; *) PLAN_FULL=0 ;; esac
# The header tables are the evidence a corpus verdict rests on, so a reviewer must be able to
# see past the top five. PLAN_FULL lifts these caps too, and a truncated list names it.
top_evidence=5; top_scanerr=3
if [ "$PLAN_FULL" = 1 ]; then top_evidence=1000000; top_scanerr=1000000; fi

# Anchor the cwd somewhere any user can read. From an unreadable cwd (`sudo -u seed` from
# /root) every `find` prints "Failed to restore initial working directory", inflating the
# scan-error count. Relative paths resolve against the caller's cwd first. The trailing slash
# is dropped because `find "$STORAGE"` normalises it away while string concatenation does
# not, and the cache filter compares the two as text.
_abs(){ local p=$1; case $p in /*) : ;; *) p="$PWD/$p" ;; esac; printf '%s' "${p%/}"; }
RAD_HOME=$(_abs "$RAD_HOME"); STORAGE=$(_abs "$STORAGE")
CONFIG=$(_abs "$CONFIG");     AUDIT_DIR=$(_abs "$AUDIT_DIR")
case $RAD in */*) RAD=$(_abs "$RAD") ;; esac   # a bare "rad" keeps resolving through PATH
# When this seed first saw each repo. Ref dates are the pusher's to set, so rewriting every ref
# would renew rules D and F forever. This file cannot be reached from outside the seed, and age
# is the older of the two.
FIRST_SEEN=$(_abs "${FIRST_SEEN:-$AUDIT_DIR/first-seen.tsv}")
# Possibly relative, and read after the cd below. A keep list resolved against / would read as
# empty, and every restored repo would go again.
quar=$(_abs "$quar");             KEEP_FILE=$(_abs "$KEEP_FILE")
DENY_FILE=$(_abs "$DENY_FILE");   DENY_FILES=$(_abs "$DENY_FILES")
CACHE_DIR=$(_abs "$CACHE_DIR")
SELF=$(_abs "$0")   # the run cache hashes this file, and cd would break a relative $0
# The command the output tells the operator to run next. `rad prune` or a bare name only when
# it would run this very file, since another copy on PATH may be another version; else the full
# path, quoted so a copied line still runs.
if command -v rad >/dev/null 2>&1 && [ "$(command -v rad-prune 2>/dev/null)" -ef "$SELF" ]; then
  SELF_CMD="rad prune"
elif [ "$(command -v "${SELF##*/}" 2>/dev/null)" -ef "$SELF" ]; then
  SELF_CMD=${SELF##*/}
else
  SELF_CMD=$(printf '%q' "$SELF")
fi

cd /

# The shell the per-repo workers run with. `bash` need not be on PATH, and a run started as
# `/nix/store/.../bash rad-prune` would lose every worker while the phases still report repos
# nothing read. $BASH is the shell running this script.
BASH_BIN=${BASH:-bash}

# Parallel workers for the per-repo scan: one per core, less one for the node. The scan is
# mostly IO-bound: on an 11k-repo seed 8 workers matched 5 within noise.
_cores=$(nproc 2>/dev/null || echo 4)
JOBS="${JOBS:-$(( _cores > 1 ? _cores - 1 : 1 ))}"

# Seconds between progress lines when output is NOT a terminal (a cron log): about a line a
# minute shows where a run stopped and stays readable a week later. A terminal redraws one line
# instead. 0 turns off all progress, the terminal line included.
PROGRESS_SECS="${PROGRESS_SECS:-60}"
# A non-number would raise the ERR trap in a numeric test, and a printing knob must not stop a
# prune, so anything else means off.
case "$PROGRESS_SECS" in ''|*[!0-9]*) PROGRESS_SECS=0 ;; esac

# Disposable-name patterns. foo/bar/baz match only as a WHOLE name ("BAR_widget" is safe); the
# rest match as a boundary-delimited word. JUNK_ID_MIN_LEN also treats a name that is NOTHING
# BUT a random hex id (letters and digits both, so "12345678" and "facade" are left alone) as
# disposable: no human names a repo 08a25d0f666d, and such repos carry no description, so
# rule D cannot see them. 0 disables it.
JUNK_WORDS='test|tests|testing|delete|deleted|tmp|temp|scratch|playground|sandbox'
JUNK_WORDS="$JUNK_WORDS|demo|dummy|wip|trash|junk|old|throwaway|hello-?world"
JUNK_WORD_REGEX="(^|[-_.])($JUNK_WORDS)([-_.]|$)"
JUNK_EXACT_REGEX='^(foo|bar|baz)$'
JUNK_ID_MIN_LEN="${JUNK_ID_MIN_LEN:-8}"

# Sets $dids to a repo's delegates, space-separated (empty when unreadable), and $iddoc to the
# identity document. $1 = the repo's git dir, $2 = the refs/rad/id revision, newest by default.
# Delegates come only from the document's top-level "delegates" list: the node writes
# refs/rad/id only after verifying its signatures, and the rest of the tree is free text where
# a quoted did:key is not a delegate. Heartwood's canonical JSON puts that list first, so a
# list of plain did:keys is read without a fork; any other layout (a nested "delegates" first,
# escaped did:keys) goes through jq. Sets variables rather than printing, since it runs once
# per repo and a command substitution would fork each time.
read_delegates() {
  local doc list rev=${2:-refs/rad/id} did='"did:key:z[1-9A-HJ-NP-Za-km-z]+"'
  local re_list="^\\{\"delegates\":\\[($did(,$did)*)\\]"
  local re_did='did:key:(z[1-9A-HJ-NP-Za-km-z]+)(.*)'
  dids=""; iddoc=""
  doc=$(GIT_DIR="$1" git cat-file blob "$rev:embeds/radicle.json" 2>/dev/null) || return 0
  # shellcheck disable=SC2034  # read by the activity scan's worker, a heredoc shellcheck skips
  iddoc=$doc
  if [[ $doc =~ $re_list ]]; then
    list=${BASH_REMATCH[1]}
  else
    list=$(jq -r '[.delegates[]? | strings] | join(" ")' <<<"$doc" 2>/dev/null) || return 0
  fi
  while [[ $list =~ $re_did ]]; do
    dids="$dids${dids:+ }${BASH_REMATCH[1]}"
    list=${BASH_REMATCH[2]}
  done
  return 0
}

# Prints, of the ref names on stdin, the branches and tags the repo's delegates ($dids)
# control: the canonical refs/heads and refs/tags, and the same under each delegate's
# namespace. Issues and patches are left out: a COB op's parents are the newest ops, whoever
# wrote them, and a patch op's are the patch's commits, so a delegate replying to a stranger's
# patch puts the stranger's files in the delegate's history. Top level, so a worker can carry a
# copy.
delegate_branches() {
  awk -v dids=" $dids " '
    /^refs\/(heads|tags)\// { print; next }
    /^refs\/namespaces\/[^\/]+\/refs\/(heads|tags)\// {
      split($0, p, "/"); if (index(dids, " " p[3] " ")) print }'
}

# Writes the bytes the hex digits in $1 spell. Top level, so a worker can carry a copy.
unhex() {
  local esc="" i
  for ((i = 0; i < ${#1}; i += 2)); do esc+="\\x${1:i:2}"; done
  printf "$esc"
}

# The ed25519 key a did:key names, as 64 hex digits: after "z" is base58 of the bytes ed 01 and
# the key. Top level, so a worker can carry a copy.
did_key_hex() {
  awk -v s="$1" 'BEGIN {
    a = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"
    for (i = 2; i <= length(s); i++) {
      c = index(a, substr(s, i, 1)) - 1
      for (j = 0; j < n; j++) { c += b[j] * 58; b[j] = c % 256; c = int(c / 256) }
      while (c > 0) { b[n++] = c % 256; c = int(c / 256) }
    }
    for (j = n - 1; j >= 0; j--) printf "%02x", b[j] }' | sed -n 's/^ed01//p'
}

# The blob id a repo id names, as 40 hex digits: the part after "z" is base58 of the 20 bytes
# of the blob that holds the repo's first identity document. Leading zero bytes are put back.
rid_blob_hex() {
  awk -v s="$1" 'BEGIN {
    a = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"
    for (i = 2; i <= length(s); i++) {
      c = index(a, substr(s, i, 1)) - 1
      for (j = 0; j < n; j++) { c += b[j] * 58; b[j] = c % 256; c = int(c / 256) }
      while (c > 0) { b[n++] = c % 256; c = int(c / 256) }
    }
    for (j = n; j < 20; j++) printf "00"
    for (j = n - 1; j >= 0; j--) printf "%02x", b[j] }'
}

# Prints the tree of every issue and patch op the given COB refs reach that a delegate signed,
# once per distinct tree, and "torn" if the refs could not be walked whole or reach more than
# MEDIA_MAX_OPS ops. Reads $dids, writes scratch files under $2.
# A patch op's parents include the patch's commits, which reach the code's history, so commits
# the delegates' branches and tags reach are not walked. A stranger's branch is no such limit,
# since one pointed at an op would hide it and everything before it. Nothing is verified until
# the walk is known to be under the cap, so a repo over it costs no signature checks.
# A delegate's COB ref also reaches strangers' ops, so each op's signature is checked. Anybody
# can write any author line, so it only picks which key to check. A Radicle op carries
# an ed25519 signature over its tree id, the last 64 bytes of an SSH signature block. A passing
# check ties the tree to the delegate; the op's parents are not counted.
delegate_ops() {
  local d=$1 w=$2 nid key tree sig; shift 2
  [ $# -gt 0 ] || return 0
  # Globs, since git skips a tag on a tree or a blob when it expands one, and fails the whole
  # walk on such a tag named outright.
  local code=(--branches --tags)
  local -A der=() signed=()
  for nid in $dids; do
    code+=(--glob="refs/namespaces/$nid/refs/heads/*")
    code+=(--glob="refs/namespaces/$nid/refs/tags/*")
    key=$(did_key_hex "$nid")
    [ ${#key} = 64 ] || continue
    # The DER form openssl reads an ed25519 public key in: a fixed 12-byte header, the key.
    unhex "302a300506032b6570032100$key" > "$w/$nid.der"
    der[$nid]=$w/$nid.der
  done
  # The ops are held back until the walk ends, and none is printed if there were too many.
  printf '%s\n' "$@" \
    | GIT_DIR="$d" git rev-list --stdin --pretty=raw --not "${code[@]}" 2>/dev/null \
    | awk -v max="$MEDIA_MAX_OPS" '
        /^commit / { if (++n > max) { over = 1; exit 1 }
                     if (tree != "" && sig != "") ops[++k] = tree " " nid " " sig
                     tree = ""; nid = ""; sig = ""; insig = 0; next }
        /^tree /   { tree = $2; next }
        /^author / { if (match($0, /@z[1-9A-HJ-NP-Za-km-z]+>/))
                       nid = substr($0, RSTART + 1, RLENGTH - 2)
                     next }
        /^gpgsig -----BEGIN SSH SIGNATURE-----$/ { insig = 1; next }
        insig && /^ -----END SSH SIGNATURE-----$/ { insig = 0; next }
        insig { sig = sig substr($0, 2) }
        END { if (over) exit 1
              if (tree != "" && sig != "") ops[++k] = tree " " nid " " sig
              for (i = 1; i <= k; i++) print ops[i] }' \
    | while read -r tree nid sig; do
        [ -n "${der[$nid]:-}" ] || continue
        # Reactions, labels and status changes repeat a few trees, about ten ops per tree on a
        # busy tracker, at a few ms per check. Only the tree counts, so one valid signature on
        # it is enough.
        [ -z "${signed[$tree]:-}" ] || continue
        printf '%s' "$sig" | base64 -d 2>/dev/null | tail -c 64 > "$w/sig"
        unhex "$tree" > "$w/msg"
        # A bad signature leaves the op uncounted. Leaving the repo unjudged instead would let
        # one bad op shield a dump.
        openssl pkeyutl -verify -pubin -keyform DER -inkey "${der[$nid]}" -rawin \
          -in "$w/msg" -sigfile "$w/sig" >/dev/null 2>&1 || continue
        signed[$tree]=1
        echo "$tree"
      done
  case "${PIPESTATUS[1]} ${PIPESTATUS[2]}" in "0 0") ;; *) echo torn ;; esac
}

# What the first 16 bytes (as lowercase hex) say a file is. Most signatures hold a control byte
# or one invalid in UTF-8, which text does not start with; GIF8, ID3, fLaC, 8BPS, and RIFF or
# ftyp a few bytes in are plain letters a text file can, rarely, start with. Each `?` is one
# hex digit. Top level, so a worker can carry a copy with declare -f.
is_media() {
  case "$1" in
    ffd8ff*)                       return 0 ;;   # jpeg
    89504e470d0a1a0a*)             return 0 ;;   # png
    474946383761*|474946383961*)   return 0 ;;   # gif87a, gif89a
    1a45dfa3*)                     return 0 ;;   # matroska, webm
    ????????66747970*)             return 0 ;;   # "ftyp" at byte 4: mp4, mov, m4a, heic, avif
    52494646????????57454250*)     return 0 ;;   # riff + webp
    52494646????????57415645*)     return 0 ;;   # riff + wave
    52494646????????41564920*)     return 0 ;;   # riff + avi
    4f67675300*)                   return 0 ;;   # ogg
    664c6143*)                     return 0 ;;   # flac
    494433*|fffb*|fff3*|fff2*)     return 0 ;;   # mp3, tagged or a bare frame header
    3026b275*)                     return 0 ;;   # asf, wmv
    49492a00*|4d4d002a*)           return 0 ;;   # tiff, either byte order
    38425053*)                     return 0 ;;   # psd
    474000*|474011*)               return 0 ;;   # mpeg transport stream, opening on PAT or SDT
    000001ba*|000001b3*)           return 0 ;;   # mpeg program stream, mpeg video
  esac
  is_archive "$1"
}

# Whether those first 16 bytes start an archive. An archive counts as media, but a shipped
# binary or release mirror is one too, so the ratio path counts only images, video and audio.
is_archive() {
  case "$1" in
    504b0304*)                     return 0 ;;   # zip, and the formats built on it
    1f8b*)                         return 0 ;;   # gzip
    526172211a07*)                 return 0 ;;   # rar
    377abcaf271c*)                 return 0 ;;   # 7z
  esac
  return 1
}

# ---------------------------------------------------------------------------------------- args
# "quarantine" handles repos an earlier run pruned; for "check-mine" see CHECK_DIR above.
# Everything else is a flag on the prune run.
CMD=""; QVERB=""; QARGS=()
if [ "${1:-}" = quarantine ]; then
  CMD=quarantine; shift
  QVERB="${1:-}"; [ "$#" = 0 ] || shift
  QARGS=("$@"); set --
elif [ "${1:-}" = check-mine ]; then
  CMD=check-mine; shift
fi

# What --help prints. The top-of-file block is a design document hundreds of lines long, so
# printing it answers nothing. Paths and RULES are shown resolved, since the commonest question
# is which home it is about to read.
usage() {
  # The path's last segment, taken in the shell: --help is answered before the
  # missing-command check, so it must not need a command.
  local me=${SELF##*/}
  cat <<HELPTEXT
$me $VERSION
Automatically detect and prune lower-value repos, spam and abuse from a Radicle node's storage.

USAGE
  $me [options]                    plan a prune, and with --apply carry it out
  $me quarantine <verb> [rid...]   deal with what a past run already pruned
  $me check-mine                   say which of your own public repos a seed running
                                         $me would prune or flag, and why; changes nothing

  Dry run by default: with no options it prints the plan and changes nothing.

OPTIONS
  --apply          carry out the plan: unseed, block and quarantine every repo in it, and
                   lift the blocks on repos earlier runs may have pruned by mistake
  --block-peers    block the peers the rules name, asking for each; on its own, prunes
                   nothing
  --yes, -y        answer y to every prompt this run asks, so it needs nobody present
  --force          carry on past the runaway caps, and past the hold on a rule that plans far
                   more repos than usual
  --restart-node   restart the node service afterwards, to flush its inventory
  --version        print the version and exit
  --help, -h       print this and exit

QUARANTINE VERBS
  list             what is held, how long it has been held, and when each entry goes
  restore <rid>... put it back in storage, clear the block, re-seed it, and add it to keep.txt
  delete <rid>...  delete it now instead of waiting; --all deletes everything held
  purge            delete everything already past its window
  files <rid>      print its images, video, audio and archives as rows to append to
                   deny-files.tsv

CONFIGURATION
  Every setting is an environment variable, listed in the README. The comment block at the
  top of this script says why each default has its value.

  RULES=$RULES
  RAD_HOME=$RAD_HOME
  STORAGE=$STORAGE
  AUDIT_DIR=$AUDIT_DIR

A project by Konstantinos Maninakis (maninak) for https://radicle.tools
Source and issues: rad:zxvTkxzouwrYFwycnsctrMT3iM2E
Donate: https://liberapay.com/maninak/donate
HELPTEXT
}

APPLY=0; FORCE=0; RESTART=0; YES=0; BLOCK_PEERS=0
for a in "$@"; do
  case "$a" in
    --apply)        APPLY=1 ;;
    --yes|-y)       YES=1 ;;
    --force)        FORCE=1 ;;
    --restart-node) RESTART=1 ;;
    # Without it rules G and H block nobody, since a block judges a person across all repos.
    --block-peers)  BLOCK_PEERS=1 ;;
    --version)      echo "radicle-seed-prune $VERSION"; exit 0 ;;
    --help|-h)      usage; exit 0 ;;
    *) echo "unknown arg: $a (try --help)" >&2; exit 2 ;;
  esac
done
# check-mine judges your own repos as a stranger's, so it must never act on them.
if [ "$CMD" = check-mine ] && [ $((APPLY + YES + FORCE + RESTART + BLOCK_PEERS)) != 0 ]; then
  echo "check-mine only reports; it takes none of --apply, --yes, --force, --restart-node," \
       "--block-peers" >&2
  exit 2
fi
# ------------------------------------------------------------------------------------- colour
# On a terminal, each colour has one meaning:
#   red     deleted or blocked: the REASON column, an APPLY run, ABORT
#   yellow  read this first: WARN, a NEAR value, a rule waiting on disk pressure
#   cyan    a line to copy: keep and deny lines, rad block, the restore command
#   green   safe or undoing: a DRY RUN, blocks being lifted, a repo that is ok
#   dim     background: the # margin, labels, repo ids, progress, rules that are off
#   bold    the title, section names, counts
# One filter colours lines on the way out, so the code prints plain text, and tests and logs
# read the same text either way.
#
# NO_COLOR turns it off (no-color.org). FORCE_COLOR=1 turns it on where stdout is not a
# terminal, for the tests and the README's example.
colour=0
if [ -n "${NO_COLOR:-}" ]; then colour=0
elif [ "${FORCE_COLOR:-0}" != 0 ]; then colour=1
elif [ -t 1 ] && [ "${TERM:-dumb}" != dumb ]; then colour=1
fi
# Read before the colour filter turns stderr into a pipe. The progress ticker redraws in
# place only on a terminal.
stderr_tty=0
if [ -t 2 ]; then stderr_tty=1; fi

c_dim=$'\033[2m'; c_bold=$'\033[1m'; c_off=$'\033[0m'
c_red=$'\033[31m'; c_yellow=$'\033[33m'; c_green=$'\033[32m'; c_cyan=$'\033[36m'

re_title='^# (rad-prune [^ ]+)  (DRY RUN|APPLY)  (.*)$'
re_label='^(# (home|disk|rules|deny|log|spared|undo|spam|sizes|kept|copies|tip) +)(.*)$'
re_more='^(#  +)(.*)$'
re_flag='^(#[ ]+)(WARN|HELD BACK|ABORT[^ ]*|ERROR:|DRY RUN|DONE|PLAN|REVIEW)( .*)?$'
re_rule='^(# rules  |#        )([A-H] .*)(waiting: .*)$'
re_copy='^(#  +)(rad:z[^ ]+  # .*|did:key:.*|rad block .*|rad:z[^ ]+)$'
re_row='^(z[0-9A-Za-z]+)( +[^ ]+ +[^ ]+ +[^ ]+ )([a-z-]+)( +)([^ ]+)(.*)$'
re_fold='^(\([0-9]+ repos\))( +[^ ]+ +)([a-z-]+)( +)([0-9]+ near)(.*)$'
re_near='^(#  +)([0-9]+ of them cleared a threshold by under [0-9]+%)(.*)$'
re_mine='^# (check-mine)  (.*)$'
re_exit='^(# .*)( \(exit [0-9]+\))$'
re_quar='^(z[0-9A-Za-z]+)( +[^ ]+ +[0-9]+ +)(due|kept|unknown|[0-9]+d)( .*)?$'
re_check='^(would-prune|flagged|unjudged|ok)( +.* )(rad:[^ ]+)(  (.*))?$'
re_cmd='^(.*: )((rad prune|[^ ]+) quarantine [a-z]+.*)$'

# Prints one line in colour, or as it came when unrecognised. The first character picks the
# patterns to try, so a plan row (thousands in a large plan) meets only the row patterns.
colour_line() {
  local line=$1 lead="" m
  local d=$c_dim b=$c_bold o=$c_off
  # The prefix that erases the live bar goes out first, uncoloured.
  if [[ $line =~ ^($'\r'|$'\033'\[K)+ ]]; then
    lead=${BASH_REMATCH[0]}; line=${line#"$lead"}
  fi
  printf '%s' "$lead"
  case $line in
    "#"*) colour_comment "$line" ;;
    z*)
      # A quarantine row's fourth column is a window like 3d, where a plan row has a number.
      if [[ $line =~ $re_quar ]]; then
        m=$c_yellow; [ "${BASH_REMATCH[3]}" = kept ] && m=$c_green
        [[ ${BASH_REMATCH[3]} == *d ]] && m=""
        printf '%s%s%s%s%s%s%s%s\n' "$d" "${BASH_REMATCH[1]}" "$o" "${BASH_REMATCH[2]}" \
               "$m" "${BASH_REMATCH[3]}" "$o" "${BASH_REMATCH[4]}"
      elif [[ $line =~ $re_row ]]; then
        m=${BASH_REMATCH[5]}
        [ "$m" = - ] || m=$c_yellow$b$m$o
        printf '%s%s%s%s%s%s%s%s%s%s\n' "$d" "${BASH_REMATCH[1]}" "$o" "${BASH_REMATCH[2]}" \
               "$c_red" "${BASH_REMATCH[3]}" "$o" "${BASH_REMATCH[4]}" "$m" "${BASH_REMATCH[6]}"
      else
        printf '%s\n' "$line"
      fi ;;
    "("*)
      if [[ $line =~ $re_fold ]]; then
        m=${BASH_REMATCH[5]}
        [ "$m" = "0 near" ] || m=$c_yellow$b$m$o
        printf '%s%s%s%s%s%s%s%s%s%s\n' "$d" "${BASH_REMATCH[1]}" "$o" "${BASH_REMATCH[2]}" \
               "$c_red" "${BASH_REMATCH[3]}" "$o" "${BASH_REMATCH[4]}" "$m" "${BASH_REMATCH[6]}"
      else
        printf '%s\n' "$line"
      fi ;;
    "RID "*) printf '%s%s%s\n' "$b" "$line" "$o" ;;
    would-prune*|flagged*|unjudged*|ok*)
      if [[ $line =~ $re_check ]]; then
        case ${BASH_REMATCH[1]} in
          would-prune)      m=$c_red ;;
          flagged|unjudged) m=$c_yellow ;;
          ok)               m=$c_green ;;
        esac
        printf '%s%s%s%s%s%s%s' "$m$b" "${BASH_REMATCH[1]}" "$o" "${BASH_REMATCH[2]}" \
               "$d" "${BASH_REMATCH[3]}" "$o"
        [ -z "${BASH_REMATCH[4]}" ] || printf '  %s%s%s' "$m" "${BASH_REMATCH[5]}" "$o"
        printf '\n'
      else
        printf '%s\n' "$line"
      fi ;;
    " "*)
      if [[ $line =~ ^(\ +)(Fix:)(.*)$ ]]; then
        printf '%s%s%s%s%s\n' "${BASH_REMATCH[1]}" "$b" "${BASH_REMATCH[2]}" "$o" \
               "${BASH_REMATCH[3]}"
      else
        printf '%s\n' "$line"
      fi ;;
    *) printf '%s\n' "$line" ;;
  esac
}

colour_comment() {
  local line=$1 m
  local d=$c_dim b=$c_bold o=$c_off
  if [[ $line =~ $re_title ]]; then
    m=$c_green; [ "${BASH_REMATCH[2]}" = APPLY ] && m=$c_red
    printf '%s#%s %s%s%s  %s%s%s%s  %s%s%s\n' "$d" "$o" "$b" "${BASH_REMATCH[1]}" "$o" \
           "$b" "$m" "${BASH_REMATCH[2]}" "$o" "$d" "${BASH_REMATCH[3]}" "$o"
  elif [[ $line =~ $re_flag ]]; then
    case ${BASH_REMATCH[2]} in
      WARN|"HELD BACK") m=$c_yellow$b ;;
      ABORT*|ERROR:) m=$c_red$b ;;
      "DRY RUN")     m=$c_green$b ;;
      *)             m=$b ;;
    esac
    # The PLAN line carries the run's two counts, so its text is bold too.
    if [ "${BASH_REMATCH[2]}" = PLAN ]; then
      printf '%s%s%s%s%s%s%s%s%s\n' "$d" "${BASH_REMATCH[1]}" "$o" "$m" "${BASH_REMATCH[2]}" \
             "$o" "$b" "${BASH_REMATCH[3]}" "$o"
    else
      printf '%s%s%s%s%s%s%s\n' "$d" "${BASH_REMATCH[1]}" "$o" "$m" "${BASH_REMATCH[2]}" "$o" \
             "${BASH_REMATCH[3]}"
    fi
  elif [[ $line == "# ["[0-9]* || $line == "# skipped "* || $line == "# cache "* \
          || $line == "# files "* || $line == *"off: not in RULES" ]]; then
    printf '%s%s%s\n' "$d" "$line" "$o"
  elif [[ $line =~ $re_rule ]]; then
    printf '%s%s%s%s%s%s%s\n' "$d" "${BASH_REMATCH[1]}" "$o" "${BASH_REMATCH[2]}" \
           "$c_yellow" "${BASH_REMATCH[3]}" "$o"
  elif [[ $line =~ $re_near ]]; then
    printf '%s%s%s%s%s%s%s\n' "$d" "${BASH_REMATCH[1]}" "$o" "$c_yellow" "${BASH_REMATCH[2]}" \
           "$o" "${BASH_REMATCH[3]}"
  elif [[ $line =~ $re_mine ]]; then
    printf '%s#%s %s%s%s  %s%s%s\n' "$d" "$o" "$b" "${BASH_REMATCH[1]}" "$o" "$d" \
           "${BASH_REMATCH[2]}" "$o"
  elif [[ $line =~ $re_exit ]]; then
    printf '%s%s%s%s\n' "${BASH_REMATCH[1]}" "$d" "${BASH_REMATCH[2]}" "$o"
  elif [[ $line =~ $re_copy ]]; then
    printf '%s%s%s%s%s%s\n' "$d" "${BASH_REMATCH[1]}" "$o" "$c_cyan" "${BASH_REMATCH[2]}" "$o"
  elif [[ $line =~ $re_cmd ]]; then
    printf '%s%s%s%s\n' "${BASH_REMATCH[1]}" "$c_cyan" "${BASH_REMATCH[2]}" "$o"
  elif [[ $line == "# undo   lift "* ]]; then
    printf '%s# undo   %s%s%s%s\n' "$d" "$o" "$c_green" "${line#"# undo   "}" "$o"
  elif [[ $line =~ $re_label ]]; then
    printf '%s%s%s%s\n' "$d" "${BASH_REMATCH[1]}" "$o" "${BASH_REMATCH[3]}"
  elif [[ $line =~ $re_more ]]; then
    printf '%s%s%s%s\n' "$d" "${BASH_REMATCH[1]}" "$o" "${BASH_REMATCH[2]}"
  else
    printf '%s\n' "$line"
  fi
}

# Passes input through colour_line a line at a time. A line still open after 0.1s (a prompt,
# the live bar) goes out as is, so nothing waits on a newline that comes after the answer.
colourise() {
  local line rc
  # Ctrl-C reaches every process on the terminal. Ignoring it lets the last lines through.
  trap '' INT
  while :; do
    line=""; rc=0
    IFS= read -r -t 0.1 line || rc=$?
    if [ "$rc" = 0 ]; then
      colour_line "$line"
    elif [ "$rc" -gt 128 ]; then
      printf '%s' "$line"
    else
      printf '%s' "$line"
      return 0
    fi
  done
}

# Waits at exit for each filter to drain, so the prompt returns after the run's last line.
# At most 30s a filter, so a child holding the pipe cannot keep the run from ending. At about
# 5000 rows/s that still fits a 100k-repo plan.
colour_wait() {
  [ "${#colour_pids[@]}" -gt 0 ] || return 0
  exec 1>&- 2>&- 3>&-
  local pid
  for pid in "${colour_pids[@]}"; do
    for _ in {1..300}; do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
  done
}
# On one terminal both streams share one filter, so a warning keeps its place among lines.
colour_pids=()
if [ "$colour" = 1 ]; then
  if [ -t 1 ] && [ "$stderr_tty" = 1 ]; then
    exec > >(colourise) 2>&1
    colour_pids+=("$!")
  else
    exec > >(colourise)
    colour_pids+=("$!")
    # Warnings sent to a file stay plain unless FORCE_COLOR asks.
    if [ "$stderr_tty" = 1 ] || [ "${FORCE_COLOR:-0}" != 0 ]; then
      exec 2> >(colourise >&2)
      colour_pids+=("$!")
    fi
  fi
  # Replaces check-mine's cleanup trap, so it repeats that cleanup. on_exit replaces it in
  # turn further down, and waits for the filters too.
  trap '[ -z "$CHECK_DIR" ] || rm -rf "$CHECK_DIR"; colour_wait' EXIT
fi

# The scan's report is for an operator, so check-mine hides stdout and prints its answer to
# fd 3 once the plan is made. Warnings still reach stderr.
if [ "$CMD" = check-mine ]; then exec 3>&1 1>/dev/null; fi

# Answered before the preflight, so asking for help never yields a list of missing tools.
case "$QVERB" in
  --help|-h) usage; exit 0 ;;
esac
if [ "$rules_named_e" = 1 ] && [ "$CMD" != quarantine ]; then
  echo "# WARN the link-farm rule (E) was removed in 0.8.0; E in RULES is ignored." >&2
  [ -n "$RULES" ] || echo "# WARN without the E, RULES is empty, so no rule runs." >&2
fi

# A per-repo command failing is normal (a repo can vanish under a live node), so calls below
# discard their errors. A missing binary fails the same way for every repo and reads as
# unreadable storage, so it is named here, before any repo is read.
# The quarantine verbs need these too. `restore` uses dirname, sync and tail via keep_add.
need="basename cut date dirname du grep mkdir mv rm stat sync tail"
# A scan's extra needs. `nproc` is omitted since its one call has a fallback.
if [ "$CMD" != quarantine ]; then
  need="$need awk cat cp df find git head jq mktemp od sed sha1sum sort tail touch tr"
  need="$need iconv uniq wc xargs"
fi
if [ "$QVERB" = files ]; then need="$need awk git jq od"; fi
if [ "$QVERB" = list ]; then need="$need numfmt"; fi
if [ "$CMD" != quarantine ] && rule_on F; then need="$need base64 gzip openssl"; fi
if [ "$CMD" != quarantine ] && rule_on H; then need="$need base64 openssl"; fi
missing=
for c in $need; do
  command -v "$c" >/dev/null 2>&1 || missing="$missing $c"
done
[ -z "$missing" ] || {
  echo "missing required command(s):$missing" >&2
  echo "PATH=$PATH" >&2
  case " $missing " in
    (*" base64 "*|*" gzip "*|*" openssl "*)
      if [ "$CMD" = check-mine ]; then
        echo "check-mine runs the media (F) and malware (H) rules, which need base64, gzip" \
             "and openssl: install them." >&2
      else
        echo "To run without the media rule (F), which needs base64, gzip and openssl, and" \
             "the malware rule (H), which needs base64 and openssl, leave them out of" \
             "RULES." >&2
      fi ;;
  esac
  exit 1
}
# Stranger text goes through `iconv -c` (see HIDDEN_CHARS_SED). An iconv that stops at the
# first non-UTF-8 byte would silently cut every name, description and subject there.
if [ "$CMD" != quarantine ] \
   && [ "$(printf 'a\377b\n' | iconv -f UTF-8 -t UTF-8 -c 2>/dev/null)" != ab ]; then
  echo "iconv here stops at text that is not UTF-8 instead of dropping it. glibc's iconv" \
       "drops it." >&2
  exit 1
fi
# Rules F and H count an op or a founder only once openssl verifies its ed25519 signature.
# An openssl before 3.0 (no pkeyutl -rawin) rejects all of them, so every repo would look
# opless and founderless. Test it on RFC 8032 vector 2: a key, message 72, its signature.
if [ "$CMD" != quarantine ] && { rule_on F || rule_on H; }; then
  vec=$(mktemp -d)
  { unhex 302a300506032b6570032100
    unhex 3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c; } > "$vec/key"
  unhex 72 > "$vec/msg"
  { unhex 92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da
    unhex 085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00; } > "$vec/sig"
  openssl pkeyutl -verify -pubin -keyform DER -inkey "$vec/key" -rawin -in "$vec/msg" \
    -sigfile "$vec/sig" >/dev/null 2>&1 && ed_ok=1 || ed_ok=0
  rm -rf "$vec"
  [ "$ed_ok" = 1 ] || {
    echo "openssl here cannot check ed25519 signatures, which the media (F) and malware (H)" \
         "rules need. OpenSSL 3 can." >&2
    if [ "$CMD" = check-mine ]; then
      echo "check-mine runs both rules, so install OpenSSL 3." >&2
    else
      echo "To run without them, leave F and H out of RULES." >&2
    fi
    exit 1
  }
fi
# rad answers what this seed holds and who else seeds it. Without it the routing table is
# empty and the abort blames seed counts, not the missing binary. `restore` re-seeds with it.
if [ "$CMD" != quarantine ] || [ "$QVERB" = restore ]; then
  command -v "$RAD" >/dev/null 2>&1 \
    || { echo "no rad at '$RAD' (set RAD=/path/to/rad)" >&2; exit 1; }
fi

# The other quarantine verbs touch only the quarantine and must work with storage unmounted.
# `restore` moves a repo back into storage, so it needs it.
if [ "$CMD" != quarantine ] || [ "$QVERB" = restore ]; then
  [ -d "$STORAGE" ] || { echo "no storage dir at $STORAGE" >&2; exit 1; }
  # Else an unreadable storage dir scans zero repos and reports "prune 0 repos".
  { [ -r "$STORAGE" ] && [ -x "$STORAGE" ]; } \
    || { echo "cannot read storage dir $STORAGE (wrong user?)" >&2; exit 1; }
fi
# A pruned repo is unseeded and blocked before it leaves storage, so an unwritable storage
# dir or quarantine would leave the plan blocked yet still in storage. Checked before the
# scan, so nothing is lifted, purged or logged first.
if [ "$CMD" != quarantine ] && [ "$APPLY" = 1 ]; then
  [ -w "$STORAGE" ] \
    || { echo "cannot write storage dir $STORAGE (wrong user?)" >&2; exit 1; }
fi
# Every block a run makes goes in its audit log, since the undo tells this tool's blocks from
# anyone else's by that log alone. So nothing is blocked without a writable audit dir.
if [ "$CMD" != quarantine ] && { [ "$APPLY" = 1 ] || [ "$BLOCK_PEERS" = 1 ]; }; then
  audit_err=$(mkdir -p "$AUDIT_DIR" 2>&1) || true
  { [ -d "$AUDIT_DIR" ] && [ -w "$AUDIT_DIR" ] && [ -x "$AUDIT_DIR" ]; } \
    || { echo "cannot write the audit dir $AUDIT_DIR (wrong user?)" >&2
         [ -z "$audit_err" ] || echo "$audit_err" >&2
         exit 1; }
fi
if [ "$CMD" != quarantine ] && [ "$APPLY" = 1 ] && [ "$QUARANTINE" = 1 ]; then
  quar_err=$(mkdir -p "$quar" 2>&1) || true
  { [ -d "$quar" ] && [ -w "$quar" ] && [ -x "$quar" ]; } \
    || { echo "cannot write the quarantine at $quar (wrong user?)" >&2
         [ -z "$quar_err" ] || echo "$quar_err" >&2
         exit 1; }
fi
# A non-integer setting stops the run before anything reads it. Bash abandons a test on a
# value it cannot parse (2.5, 08), so guards like the blind-scan abort never fire; awk reads
# a word as 0; and 010 is octal. 12 digits keeps every product below within 64 bits and fits
# the README's 999999999999 for turning the ratio path off.
for knob in ABS_SIZE_FLOOR_MB REL_PCTL OUTLIER_STALE_DAYS JUNK_STALE_DAYS STALE_YEARS_DAYS \
            MIN_OTHER_SEEDS JUNK_MIN_SEEDS JUNK_ID_MIN_SEEDS JUNK_ID_MIN_LEN FRESH_GUARD_DAYS \
            SPAM_MIN_BATCH SPAM_DESC_AGREE_PCT SPAM_MIN_SEEDS SPAM_STALE_DAYS \
            MEDIA_MIN_BYTES MEDIA_TEXT_MAX_BYTES MEDIA_TEXT_CEIL_BYTES MEDIA_MIN_BATCH \
            MEDIA_STALE_DAYS MEDIA_MIN_SEEDS MEDIA_MAX_REFS MEDIA_MAX_OPS MEDIA_RATIO_MIN_BYTES \
            PARASITE_MIN_REPOS PARASITE_MIN_BYTES PARASITE_TEXT_MAX_BYTES \
            MAX_PRUNE_COUNT MAX_PRUNE_GB RATCHET_FACTOR RATCHET_RUNS RATCHET_FLOOR \
            MAX_SCAN_FAIL_PCT PRESSURE_RELAX_PCT PRESSURE_RELAX_GB PRESSURE_CRIT_PCT \
            PRESSURE_CRIT_GB ABS_SIZE_FLOOR_MB_AGG REL_PCTL_AGG OUTLIER_STALE_DAYS_AGG \
            JUNK_STALE_DAYS_AGG SPAM_STALE_DAYS_AGG STALE_YEARS_DAYS_AGG MIN_OTHER_SEEDS_AGG \
            QUARANTINE_DAYS UNDO_MAX_COUNT UNDO_MAX_GB PLAN_COLLAPSE_ROWS NEAR_PCT JOBS; do
  case "${!knob}" in
    0) ;;
    ''|0*|*[!0-9]*|?????????????*)
      echo "# $knob must be a whole number of at most 12 digits, not '${!knob}'." >&2
      exit 2 ;;
  esac
done
# Counted in bytes, so 10 digits of GiB would wrap negative and hold every lift for good.
[ "${#UNDO_MAX_GB}" -le 9 ] \
  || { echo "# UNDO_MAX_GB must be at most 9 digits, not '$UNDO_MAX_GB'." >&2; exit 2; }
# Only 1 demands the random-id slot, so "yes" meant as on would quietly loosen rule D.
case $SPAM_REQUIRE_ID in
  0|1) ;;
  *) echo "# SPAM_REQUIRE_ID must be 0 or 1, not '$SPAM_REQUIRE_ID'." >&2; exit 2 ;;
esac
# Only 1 prunes, so a "yes" or "true" meant as on would quietly leave the rule reporting.
case $MALWARE_PRUNE in
  0|1) ;;
  *) echo "# MALWARE_PRUNE must be 0 or 1, not '$MALWARE_PRUNE'." >&2; exit 2 ;;
esac
# An extension is matched after it is lower-cased, so an upper-case entry never matches, and a
# quote would break the worker script the list is written into.
[[ $MEDIA_EXTS =~ ^[a-z0-9]+(\|[a-z0-9]+)*$ ]] || {
  echo "# MEDIA_EXTS must be lower-case letters and digits, |-separated, not '$MEDIA_EXTS'." >&2
  exit 2
}
# A second run that changes storage or the quarantine stops before touching anything, since
# it could delete, as an older copy, a repo the first just quarantined. The lock is the open
# fd $lock_fd, inherited by workers and git, so it holds until all of them exit. The shell
# picks the fd so a later exec of a fixed number cannot close it. flock exits 75 only when
# another process holds the lock; any other failure is reported as itself.
lock_needed=0
if [ "$CMD" = quarantine ]; then
  case $QVERB in restore|delete|purge) lock_needed=1 ;; esac
elif [ "$APPLY" = 1 ] || [ "$BLOCK_PEERS" = 1 ]; then
  lock_needed=1
fi
lock_file="$AUDIT_DIR/run.lock"
if [ "$lock_needed" = 1 ] && [ -d "$AUDIT_DIR" ]; then
  if ! command -v flock >/dev/null 2>&1; then
    echo "# WARN flock is not installed, so nothing stops a second rad prune run changing" \
         "storage or the quarantine while this one does." >&2
  elif ! { exec {lock_fd}>> "$lock_file"; } 2>/dev/null; then
    echo "# WARN cannot open $lock_file, so nothing stops a second rad prune run changing" \
         "storage or the quarantine while this one does." >&2
  else
    lock_rc=0
    lock_err=$(flock -n -E 75 "$lock_fd" 2>&1) || lock_rc=$?
    if [ "$lock_rc" = 75 ]; then
      echo "# ABORT: another rad prune run is changing storage or the quarantine (it holds" \
           "$lock_file). Nothing was touched." >&2
      exit 5
    elif [ "$lock_rc" != 0 ]; then
      echo "# WARN cannot lock $lock_file ($lock_err), so nothing stops a second rad prune" \
           "run changing storage or the quarantine while this one does." >&2
    fi
  fi
fi
[ -n "$OUR_NID" ] \
  || echo "# WARN could not determine our NID; seed counts will include us" >&2

now=$(date +%s)
fresh_cut=$(( now - FRESH_GUARD_DAYS*86400 ))
# Names this run in its audit log, last-run/ and history.log.
run_ts=$(date -u +%FT%TZ)

# --------------------------------------------------------------------- quarantine subcommands
# These verbs need no scan, plan or running node, so they act here and exit. Every
# quarantined repo was unseeded and blocked first, so the node holds no reference to it and
# deleting one by hand loses only the restore.
# Prepends a header saying what the file is, for someone opening the audit dir without the
# README. A file already opening with "#" is left alone, so reworded headers never stack.
# The copy is written beside it and moved over in one step, so a full disk costs only the
# header. Anything but a plain file is skipped, since the move would replace a symlink, or
# /dev/null itself when FIRST_SEEN=/dev/null and run as root. Returns non-zero on failure.
add_header() {  # $1 = file, then one argument per line of the header
  local file=$1 first=""
  shift
  if [ -L "$file" ] || { [ -e "$file" ] && [ ! -f "$file" ]; }; then return 0; fi
  if [ -s "$file" ]; then
    { IFS= read -r first < "$file"; } 2>/dev/null || true
    [[ $first == '#'* ]] && return 0
  fi
  # A leftover or planted $file.new is removed, not written through. cp -p keeps owner and
  # mode, so a root run leaves a file the seed user's cron can still append to. sync before
  # the move, so a crash cannot leave an empty file.
  rm -f -- "$file.new" 2>/dev/null
  if { [ ! -e "$file" ] || cp -p -- "$file" "$file.new" 2>/dev/null; } \
     && { printf '# %s\n' "$@"; [ ! -e "$file" ] || cat "$file"; } > "$file.new" 2>/dev/null \
     && sync -- "$file.new" 2>/dev/null && mv -f "$file.new" "$file" 2>/dev/null; then
    return 0
  fi
  rm -f "$file.new" 2>/dev/null
  return 1
}

# Adds repo id $1 to the keep file, with comment $2 when given. Returns non-zero rather than
# dying, so one failure in "restore a b c" costs a warning and the rest still run.
keep_add() {
  mkdir -p "$(dirname "$KEEP_FILE")" 2>/dev/null || return 1
  # Only a keep file this creates gets a header. An existing one is the operator's and is never
  # rewritten. The id below is what protects the repo, so it goes in regardless.
  if [ ! -e "$KEEP_FILE" ]; then
    add_header "$KEEP_FILE" \
      "Repos rad prune never prunes, one repo id per line. Edit it by hand at any time." \
      "A did:key: line instead clears that identity of the malware rule (H)." \
      "rad prune quarantine restore adds each repo it puts back." \
      || echo "# WARN could not write the header of a new $KEEP_FILE" >&2
  fi
  # Parsed the way a run parses it, so an id already there with a comment or rad: prefix is
  # not added twice.
  sed $'1s/^\xef\xbb\xbf//; s/#.*//; s/rad://' "$KEEP_FILE" 2>/dev/null \
    | grep -oE '^\s*z[1-9A-HJ-NP-Za-km-z]+' | tr -d ' \t' | grep -xF "$1" >/dev/null && return 0
  # A last line saved without its newline, as some editors do, would run into the new id.
  if [ -s "$KEEP_FILE" ] && [ -n "$(tail -c1 "$KEEP_FILE")" ]; then
    echo >> "$KEEP_FILE" 2>/dev/null || return 1
  fi
  printf '%s%s\n' "$1" "${2:+  $2}" >> "$KEEP_FILE" 2>/dev/null || return 1
}
# Repo $1's last verdict and name from the audit logs, for its keep-line comment, so a later
# reader can tell why it is kept. Prints nothing when no log names it.
pruned_as() {
  local f logs=()
  for f in "$AUDIT_DIR"/prune-*.log; do [ -r "$f" ] && logs+=("$f"); done
  [ ${#logs[@]} -gt 0 ] || return 0
  awk -F'\t' -v r="$1" '!/^#/ && $1 == r && $5 != "" { last = $5 " " $6 }
                       END { if (last != "") print last }' "${logs[@]}" \
    | LC_ALL=C tr '\001-\011\013-\037\177' ' '   # no control byte reaches keep.txt
}
# Identities earlier runs blocked as malware (rule H), from their audit logs.
malware_blocked_before() {
  local f logs=()
  for f in "$AUDIT_DIR"/prune-*.log; do [ -r "$f" ] && logs+=("$f"); done
  [ ${#logs[@]} -gt 0 ] || return 0
  awk -F'\t' '$1 == "blocked-malware" { print $2 }' "${logs[@]}" | sort -u
}
# Identities earlier runs pruned malware-op repos for, from their audit logs.
malware_op_nids() {
  local f logs=()
  for f in "$AUDIT_DIR"/prune-*.log; do [ -r "$f" ] && logs+=("$f"); done
  [ ${#logs[@]} -gt 0 ] || return 0
  awk '$1 == "#" && $2 == "malware-op:" {
         n = split($4, d, ",")
         for (i = 1; i <= n; i++) print d[i] }' "${logs[@]}" | sort -u
}
# Node ids this node blocks now: `rad follow` rows whose last column is "block". Fails, with
# rad's error on stderr, when `rad follow` fails.
nodes_blocked_now() {
  local list
  list=$("$RAD" follow) || return 1
  awk '/did:key:z/ {
         gsub(/│/, " "); n = split($0, f, " "); nid = ""
         for (i = 1; i <= n; i++)
           if (f[i] ~ /^did:key:z[1-9A-HJ-NP-Za-km-z]+$/) { nid = substr(f[i], 9); break }
         if (nid != "" && f[n] == "block") print nid }' <<<"$list" | sort -u
}
# Every path below is built from an argument, so only a repo id may name one. Otherwise
# "quarantine delete ../.." would work.
is_rid() { [[ $1 =~ ^z[1-9A-HJ-NP-Za-km-z]+$ ]]; }
# Repo ids in the keep file, parsed as a run parses them. Fails when the file exists but
# cannot be read, since read as empty it would keep nothing.
keep_ids() {
  local line tok toks id
  [ -e "$KEEP_FILE" ] || [ -L "$KEEP_FILE" ] || return 0
  { [ -f "$KEEP_FILE" ] && [ -r "$KEEP_FILE" ]; } || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}; line=${line#$'\xef\xbb\xbf'}
    read -ra toks <<<"${line%%#*}"
    for tok in "${toks[@]}"; do
      # 40 characters or more is an identity, which keeps no repo.
      id=${tok#rad:}
      if is_rid "$id" && [ "${#id}" -lt 40 ]; then printf '%s\n' "$id"; fi
    done
  done < "$KEEP_FILE"
}
# True when keep list $2 keeps quarantined copy $1. Once the repo is back in storage, the
# copy left behind is no longer the kept repo and its window runs as usual.
quar_kept() {
  local rid=${1##*/}
  grep -qxF -- "$rid" <<<"$2" && [ ! -e "$STORAGE/$rid" ]
}

# When a quarantined repo becomes deletable, in seconds. `find -mtime +N` means "older than
# N+1 days", so a repo shown as due would survive the next purge by a day.
quar_cut=$(( now - QUARANTINE_DAYS*86400 + QUAR_SLACK_SECS ))
# Prints every quarantined repo past its window. A kept repo never falls due, and none does
# while the keep file cannot be read.
quar_expired() {
  local d born kept
  if ! kept=$(keep_ids); then
    echo "# WARN cannot read $KEEP_FILE, so nothing is deleted from the quarantine." >&2
    return 0
  fi
  for d in "$quar"/z*; do
    [ -d "$d" ] || continue
    quar_kept "$d" "$kept" && continue
    born=$(stat -c %Y "$d" 2>/dev/null) || continue    # it can vanish under a parallel purge
    [ -n "$born" ] || continue
    [ "$born" -le "$quar_cut" ] && printf '%s\n' "$d"
  done
}
# Deletes what is past its window. An --apply run calls it once nothing can stop the run, so
# a run that stops leaves the quarantine as it found it.
quar_purge_expired() {
  [ "$QUARANTINE" = 1 ] || return 0
  local d purged=0
  while IFS= read -r d; do
    rm -rf -- "$d" && purged=$((purged+1))
  done < <(quar_expired)
  [ "$purged" = 0 ] || echo "# purged $purged repo(s) out of quarantine after" \
                            "${QUARANTINE_DAYS}d; they are gone for good now."
  return 0
}
# Ignores the window once free space hits the critical threshold, since a full disk cannot
# afford recovery copies. Kept repos stay. A function because its two calls sit far apart.
quar_purge_all_if_critical() {
  [ "$QUARANTINE" = 1 ] && [ "$DISK_AWARE" = 1 ] \
    && awk -v a="$free_eff" -v c="$crit_free" 'BEGIN{exit !(a <= c)}' || return 0
  local d purged=0 spared=0 kept
  if ! kept=$(keep_ids); then
    echo "# WARN cannot read $KEEP_FILE, so the quarantine is not emptied." >&2
    return 0
  fi
  for d in "$quar"/z*; do
    [ -e "$d" ] || continue
    if quar_kept "$d" "$kept"; then spared=$((spared+1)); continue; fi
    rm -rf -- "$d" && purged=$((purged+1))
  done
  [ "$purged" = 0 ] \
    || echo "# disk is at the critical free-space threshold: emptied the whole quarantine" \
            "($purged)."
  [ "$purged" = 0 ] || [ "$spared" = 0 ] \
    || echo "#   $spared repo(s) in $KEEP_FILE stay in it."
  return 0
}


if [ "$CMD" = quarantine ]; then
  case "$QVERB" in
    list)
      found=0; total_bytes=0
      # The purge deletes nothing in the keep file, and none at all while it cannot be read.
      if ! kept=$(keep_ids); then
        kept=unreadable
        echo "# WARN cannot read $KEEP_FILE, so nothing is deleted from the quarantine." >&2
      fi
      # Each repo's verdict and name from the audit logs, so a wrong verdict shows without
      # looking ids up. A repo no log names shows -.
      declare -A pruned_why=()
      logs=()
      for f in "$AUDIT_DIR"/prune-*.log; do [ -r "$f" ] && logs+=("$f"); done
      if [ ${#logs[@]} -gt 0 ]; then
        while IFS=$'\t' read -r rid why; do
          pruned_why[$rid]=$why
        done < <(awk -F'\t' '$1 ~ /^z[1-9A-HJ-NP-Za-km-z]+$/ && $5 != "" {
                                last[$1] = sprintf("%-13s %s", $5, $6) }
                              END { for (r in last) print r "\t" last[r] }' "${logs[@]}" \
                   | LC_ALL=C tr '\001-\010\013-\037\177' ' ')  # no control byte reaches a terminal
      fi
      for d in "$quar"/z*; do
        [ -d "$d" ] || continue
        born=$(stat -c %Y "$d" 2>/dev/null) || continue
        [ -n "$born" ] || continue
        [ "$found" = 0 ] && printf '%-34s %8s %8s %10s  %-13s %s\n' RID SIZE 'HELD(d)' \
                                   'DELETED IN' REASON NAME
        held=$(( (now - born) / 86400 ))
        if [ "$kept" = unreadable ]; then
          left=unknown
        elif quar_kept "$d" "$kept"; then
          left=kept
        elif [ "$born" -le "$quar_cut" ]; then
          left=due
        else
          # Rounded up, so "1d" means it goes within a day.
          left="$(( (born - quar_cut + 86399) / 86400 ))d"
        fi
        # Disk use, not file bytes: what deleting it gives back.
        bytes=$(du -sB1 "$d" 2>/dev/null | cut -f1)
        rid=$(basename "$d")
        printf '%-34s %8s %8s %10s  %s\n' "$rid" \
               "$(numfmt --to=iec --suffix=B "${bytes:-0}")" "$held" "$left" \
               "${pruned_why[$rid]:--}"
        found=$((found+1))
        total_bytes=$((total_bytes + ${bytes:-0}))
      done
      if [ "$found" -gt 0 ]; then
        echo
        echo "# $(count "$found" repo repos), $(numfmt --to=iec --suffix=B "$total_bytes")." \
             "To put one back: $SELF_CMD quarantine restore <rid>"
      else
        echo "# nothing in quarantine ($quar)"
      fi
      ;;
    restore)
      [ "${#QARGS[@]}" -gt 0 ] \
        || { echo "usage: $SELF_CMD quarantine restore <rid>..." >&2; exit 2; }
      # Identities an earlier run blocked as malware (rule H), and which the node still blocks.
      # If blocks cannot be listed, all count as still blocked, and rad's error says why.
      hblocked=$(malware_blocked_before)
      hnamed=$( { malware_op_nids; printf '%s\n' "$hblocked"; } | sort -u)
      nblocked=""
      if [ -n "$hblocked" ] && ! nblocked=$(nodes_blocked_now); then
        echo "# WARN '$RAD follow' failed, so a block named below may be lifted already." >&2
        nblocked=$hblocked
      fi
      for rid in "${QARGS[@]}"; do
        rid=${rid#rad:}
        is_rid "$rid" || { echo "# not a repo id: $rid" >&2; continue; }
        [ -d "$quar/$rid" ] || { echo "# not in quarantine: $rid" >&2; continue; }
        # A repo moved back by hand is still unseeded, blocked and condemned, so only the move
        # is skipped. Everything after it is idempotent.
        if [ -e "$STORAGE/$rid" ]; then
          echo "# already back in storage, leaving that copy alone: $rid" >&2
        else
          mv -- "$quar/$rid" "$STORAGE/$rid" \
            || { echo "# restore failed: $rid" >&2; continue; }
        fi
        # Moving the directory back is half the undo, since a blocked repo neither replicates
        # nor comes back. rad seed only rewrites an existing policy row's scope, so on a
        # blocked repo it succeeds and changes nothing. rad unseed deletes the row whatever it
        # holds, dropping the block, so it runs first. rad unblock is missing from older
        # heartwood and adds nothing, since rad seed writes the seeding row anyway.
        "$RAD" unseed "rad:$rid" >/dev/null 2>&1 \
          || echo "#   WARN 'rad unseed rad:$rid' failed; it is still blocked" >&2
        "$RAD" seed "rad:$rid" >/dev/null 2>&1 \
          || echo "#   WARN back on disk but 'rad seed rad:$rid' failed; run it yourself" >&2
        # The comment only explains, so a log it cannot read leaves it out.
        was=$(pruned_as "$rid") || was=""
        keep_add "$rid" "# restored $(date -u +%Y-%m-%d)${was:+, was $was}" \
          || { echo "#   WARN could not write $KEEP_FILE; the next run may prune $rid" >&2
               continue; }
        echo "# restored $rid; added to $KEEP_FILE, so no rule prunes it again and the" \
             "malware rule (H) clears all its delegates"
        # The keep line clears each delegate rule H named, and the operator should see which. A
        # standing block on one is not lifted; the command to lift it is printed.
        read_delegates "$STORAGE/$rid"
        for nid in $dids; do
          grep -qxF "$nid" <<<"$hnamed" || continue
          echo "#   the malware rule (H) named its delegate $nid, and no longer does"
          if grep -qxF "$nid" <<<"$hblocked" && grep -qxF "$nid" <<<"$nblocked"; then
            echo "#   an earlier run blocked its delegate $nid as malware; to lift that block:" \
                 "rad unfollow $nid"
          fi
        done
      done
      # Only where the unit exists, so a node run by hand or by another service manager gets no
      # failing command.
      if systemctl cat "$SERVICE" >/dev/null 2>&1; then
        echo "# restart the node to announce them again: sudo systemctl restart $SERVICE"
      else
        echo "# restart the node to announce them again"
      fi
      ;;
    delete)
      ndel=0
      if [ "${QARGS[0]:-}" = --all ]; then
        # --all leaves kept repos for the next run to put back; deleting one takes naming it.
        # With an unreadable keep file any repo could be kept, so nothing is deleted.
        kept=$(keep_ids) \
          || { echo "# cannot read $KEEP_FILE, so nothing is deleted from the quarantine." >&2
               exit 5; }
        nkept=0
        for d in "$quar"/z*; do
          [ -e "$d" ] || continue
          if quar_kept "$d" "$kept"; then nkept=$((nkept+1)); continue; fi
          rm -rf -- "$d" && ndel=$((ndel+1))
        done
        [ "$nkept" = 0 ] \
          || echo "# left $nkept repo(s) that $KEEP_FILE lists; the next --apply run puts" \
                  "them back, or names any it cannot. To delete one anyway:" \
                  "$SELF_CMD quarantine delete <rid>"
      else
        [ "${#QARGS[@]}" -gt 0 ] \
          || { echo "usage: $SELF_CMD quarantine delete <rid>... | --all" >&2; exit 2; }
        for rid in "${QARGS[@]}"; do
          rid=${rid#rad:}
          is_rid "$rid" || { echo "# not a repo id: $rid" >&2; continue; }
          [ -d "$quar/$rid" ] || { echo "# not in quarantine: $rid" >&2; continue; }
          rm -rf -- "${quar:?}/$rid" && ndel=$((ndel+1))
        done
      fi
      echo "# deleted $ndel repo(s) for good."
      ;;
    purge)
      # The same window a prune run applies, on demand.
      npurge=0
      while IFS= read -r d; do
        rm -rf -- "$d" && npurge=$((npurge+1))
      done < <(quar_expired)
      echo "# purged $npurge repo(s) past the ${QUARANTINE_DAYS}d window."
      ;;
    files)
      # DENY_FILES rows for every media file the repo's delegates put on its branches and tags,
      # history included. The copy check counts these same files, so a row never names a file a
      # stranger pushed.
      [ "${#QARGS[@]}" = 1 ] \
        || { echo "usage: $SELF_CMD quarantine files <rid>" >&2; exit 2; }
      rid=${QARGS[0]#rad:}
      is_rid "$rid" || { echo "# not a repo id: $rid" >&2; exit 2; }
      d="$quar/$rid"
      [ -d "$d" ] || { echo "# not in quarantine: $rid" >&2; exit 1; }
      read_delegates "$d"
      [ -n "$dids" ] || { echo "# cannot read the delegates of $rid" >&2; exit 1; }
      ours=$(GIT_DIR="$d" git for-each-ref --format='%(refname)' | delegate_branches) \
        || { echo "# cannot list the refs of $rid" >&2; exit 1; }
      [ -n "$ours" ] || { echo "# $rid has no branches or tags of its delegates" >&2; exit 1; }
      listing=$(GIT_DIR="$d" git rev-list --objects --stdin --filter=object:type=blob \
                  <<<"$ours" \
                | GIT_DIR="$d" git cat-file \
                    --batch-check='%(objectname) %(objecttype) %(objectsize) %(rest)') \
        || { echo "# cannot read the history of $rid" >&2; exit 1; }
      # Printed only once every file has been read, so a failure appends nothing half-done.
      today=$(date -u +%F); nfiles=0; rows=""
      while read -r oid type size _; do
        [ "$type" = blob ] || continue
        hex=$(od -An -tx1 -N16 -v < <(GIT_DIR="$d" git cat-file blob "$oid" 2>/dev/null))
        hex=${hex//[$' \n']/}
        if [ -z "$hex" ] && [ "$size" != 0 ]; then
          echo "# cannot read file $oid of $rid; no rows printed" >&2
          exit 1
        fi
        if is_media "$hex"; then
          rows+=$(printf '%s\t%s\trad:%s\t%s' "$oid" "$size" "$rid" "$today")$'\n'
          nfiles=$((nfiles + 1))
        fi
      done <<<"$listing"
      printf '%s' "$rows"
      echo "# $nfiles media file(s) on the branches and tags of $rid's delegates, as rows" \
           "to append to $DENY_FILES" >&2
      ;;
    *)
      [ -n "$QVERB" ] && echo "unknown quarantine verb: $QVERB" >&2
      usage >&2
      exit 2 ;;
  esac
  exit 0
fi

# A word list rule H cannot match stops the run. An upper-case letter or hyphen never
# matches, and an empty entry matches the "s" of "it's". Silence would read as no operation.
for knob in MALWARE_STRONG_WORDS MALWARE_WEAK_WORDS; do
  [[ ${!knob} =~ ^[a-z0-9]+(\|[a-z0-9]+)*$ ]] || {
    echo "# $knob must be lower-case letters and digits, |-separated, not '${!knob}'." >&2
    exit 2
  }
done
# Any other value would switch disk pressure on and the critical purge off.
case $DISK_AWARE in
  0|1) ;;
  *) echo "# DISK_AWARE must be 0 or 1, not '$DISK_AWARE'." >&2; exit 2 ;;
esac
# Anything but 1 would read as off, so a typo meant as "on" would delete with no way back.
case $QUARANTINE in
  0|1) ;;
  *) echo "# QUARANTINE must be 0 or 1, not '$QUARANTINE'." >&2; exit 2 ;;
esac
# Only 1 reads as on, so a typo meant as "on" would quietly leave every block in place.
case $UNDO in
  0|1) ;;
  *) echo "# UNDO must be 0 or 1, not '$UNDO'." >&2; exit 2 ;;
esac

# disk pressure p in [0,1] on the storage filesystem
read -r disk_total disk_avail < <(df -Pk "$STORAGE" \
  | awk 'NR==2{printf "%.0f %.0f\n", $2*1024, $4*1024}') || true
: "${disk_total:=0}"; : "${disk_avail:=0}"
# A disk of no size, from a df that failed or printed no number, reads as full, and full
# pressure empties the quarantine.
if [ "$DISK_AWARE" = 1 ] && [ "$disk_total" = 0 ]; then
  echo "# ABORT: cannot read the size of the disk $STORAGE is on (df), so disk pressure is" \
       "unknown. DISK_AWARE=0 runs without disk pressure." >&2
  exit 5
fi
# Pressure counts what this run's purge is about to free as free already, or the run would
# prune a second wave for space the due copies give back. Only a quarantine on the storage
# filesystem counts.
quar_due=0
if [ "$QUARANTINE" = 1 ] && [ -d "$quar" ] \
   && [ "$(stat -L -c %d "$quar")" = "$(stat -L -c %d "$STORAGE")" ]; then
  # Summed line by line: xargs splits a long list over several du calls, each with a total.
  quar_due=$(quar_expired | xargs -r -d '\n' du -sb 2>/dev/null \
               | awk '{ s += $1 } END { printf "%.0f", s }') || true
fi
free_eff=$(awk -v a="$disk_avail" -v q="${quar_due:-0}" 'BEGIN { printf "%.0f", a + q }')
relax_free=$(awk -v t="$disk_total" -v p="$PRESSURE_RELAX_PCT" -v g="$PRESSURE_RELAX_GB" \
  'BEGIN{a=t*p/100;b=g*1e9;print (a>b)?a:b}')
crit_free=$(awk  -v t="$disk_total" -v p="$PRESSURE_CRIT_PCT"  -v g="$PRESSURE_CRIT_GB" \
  'BEGIN{a=t*p/100;b=g*1e9;print (a<b)?a:b}')
# Free-space thresholds set the wrong way round leave no band to interpolate over. The critical
# one still empties the quarantine at or under it, so pressure is full there and none above it.
p=$(awk -v av="$free_eff" -v r="$relax_free" -v c="$crit_free" -v on="$DISK_AWARE" 'BEGIN{
  if(on=="0"){print 0;exit} if(r<=c){print (av<=c)?1:0;exit}
  x=(r-av)/(r-c); if(x<0)x=0; if(x>1)x=1; printf "%.3f",x }')
if [ "$DISK_AWARE" = 1 ] \
   && awk -v r="$relax_free" -v c="$crit_free" 'BEGIN{exit !(r<=c)}'; then
  awk -v r="$relax_free" -v c="$crit_free" 'BEGIN{printf "# WARN the relaxed free-space" \
    " threshold (PRESSURE_RELAX_*, %.1f GB free) is not above the critical one (PRESSURE_CRIT_*," \
    " %.1f GB), so pressure is either 0%% or 100%%.\n", r/1e9, c/1e9}' >&2
fi

# Rules B and C prune for space alone, so they wait while free space is above the relaxed
# threshold, where an honest project pruned is lost for nothing. With DISK_AWARE=0 they act.
space_rules=1
if [ "$DISK_AWARE" = 1 ] && awk -v p="$p" 'BEGIN { exit !(p == 0) }'; then
  space_rules=0
fi
# Rules that may prune this run, as the audit log records them. Waiting rules, and H while
# it only reports, are left out, so the ratchet counts the run as no sample of them. "-"
# means none, since an empty value reads as a log from before rules were recorded.
rules_live=$RULES
[ "$space_rules" = 1 ] || rules_live=${rules_live//[BC]/}
[ "$MALWARE_PRUNE" = 1 ] || rules_live=${rules_live//H/}
[ -n "$rules_live" ] || rules_live=-

# interpolate each knob relaxed->aggressive by p
lerp(){ awk -v a="$1" -v b="$2" -v p="$p" 'BEGIN{printf "%d", a+(b-a)*p+0.5}'; }
eff_abs_mb=$(lerp "$ABS_SIZE_FLOOR_MB" "$ABS_SIZE_FLOOR_MB_AGG")
eff_pctl=$(lerp "$REL_PCTL" "$REL_PCTL_AGG")
eff_outlier_days=$(lerp "$OUTLIER_STALE_DAYS" "$OUTLIER_STALE_DAYS_AGG")
eff_junk_days=$(lerp "$JUNK_STALE_DAYS" "$JUNK_STALE_DAYS_AGG")
eff_spam_days=$(lerp "$SPAM_STALE_DAYS" "$SPAM_STALE_DAYS_AGG")
eff_stale_days=$(lerp "$STALE_YEARS_DAYS" "$STALE_YEARS_DAYS_AGG")
eff_seeds=$(lerp "$MIN_OTHER_SEEDS" "$MIN_OTHER_SEEDS_AGG")
[ "$eff_seeds" -lt 1 ] && eff_seeds=1

outlier_cut=$(( now - eff_outlier_days*86400 ))
junk_cut=$(( now - eff_junk_days*86400 ))
spam_cut=$(( now - eff_spam_days*86400 ))
stale_cut=$(( now - eff_stale_days*86400 ))
media_cut=$(( now - MEDIA_STALE_DAYS*86400 ))
# check-mine first sees every repo now, so a repo with future-dated commits counts as
# created now and a 0-day window would never pass it.
if [ "$CMD" = check-mine ]; then
  spam_cut=$((now + 1)); media_cut=$((now + 1)); junk_cut=$((now + 1))
fi

run_mode=$([ "$APPLY" = 1 ] && echo APPLY || echo DRY-RUN)
[ "$CMD" != check-mine ] || run_mode=CHECK

title_ts=${run_ts%Z}
echo "# rad-prune $VERSION  ${run_mode/-/ }  ${title_ts/T/ } UTC"
# Named first because the plan, per-run log and quarantine live under it, and an operator
# looks for them mid-run.
header_line home "$RAD_HOME   audit $AUDIT_DIR"

# Each rule's main thresholds at their post-pressure value, to check the run against. The
# README names the rest.
free_gb=$(awk  -v a="$disk_avail" 'BEGIN{printf "%.1f",a/1e9}')
free_pct=$(awk -v a="$disk_avail" -v t="$disk_total" 'BEGIN{printf "%.1f",(t>0)?100*a/t:0}')
press_pct=$(awk -v p="$p" 'BEGIN{printf "%.0f",p*100}')
relax_gb=$(awk -v r="$relax_free" 'BEGIN{printf "%.0f",r/1e9}')
crit_gb=$(awk  -v c="$crit_free" 'BEGIN{printf "%.0f",c/1e9}')
due_note=""
[ "${quar_due:-0}" = 0 ] \
  || due_note=$(awk -v q="$quar_due" 'BEGIN{printf ", +%.1f GB due out of quarantine",q/1e9}')
if [ "$DISK_AWARE" = 1 ]; then
  pressure="pressure ${press_pct}% (rises under ${relax_gb} GB free, full at ${crit_gb} GB)"
else
  pressure="pressure off (DISK_AWARE=0)"
fi
header_line disk "${free_gb} GB free (${free_pct}%)${due_note}   $pressure"

# One rule per line. The status has its own column, so an off or waiting rule stands out.
rule_line() {
  local label=$1 letter=$2 name=$3 settings=$4 status=${5:-}
  rule_on "$letter" || status="off: not in RULES"
  if [ -n "$status" ]; then
    printf '# %-6s %s %-13s %-46s  %s\n' "$label" "$letter" "$name" "$settings" "$status"
  else
    printf '# %-6s %s %-13s %s\n' "$label" "$letter" "$name" "$settings"
  fi
}
waiting=""
[ "$space_rules" = 1 ] || waiting="waiting: no disk pressure"
rule_a=">${eff_junk_days}d  seeds>=${JUNK_MIN_SEEDS}"
rule_a="$rule_a  spares imports: history starts >${IMPORT_SPARE_DAYS}d before rad init"
rule_a="$rule_a  random-id names: seeds>=${JUNK_ID_MIN_SEEDS}"
rule_line rules A junk-name "$rule_a"
rule_b=">${eff_abs_mb}MiB & >=P${eff_pctl}  >${eff_outlier_days}d  seeds>=${eff_seeds}"
rule_line "" B size "$rule_b" "$waiting"
rule_line "" C stale ">${eff_stale_days}d  seeds>=${eff_seeds}" "$waiting"
rule_d="batch>=${SPAM_MIN_BATCH}  same desc>=${SPAM_DESC_AGREE_PCT}%  >${eff_spam_days}d"
rule_d="$rule_d  seeds>=${SPAM_MIN_SEEDS}"
rule_line "" D spam-batch "$rule_d"
rule_f=">${MEDIA_STALE_DAYS}d  seeds>=${MEDIA_MIN_SEEDS}"
rule_f="$rule_f  dump: >=$(header_bytes "$MEDIA_MIN_BYTES"),"
rule_f="$rule_f other<$(header_bytes "$MEDIA_TEXT_MAX_BYTES")"
rule_f="$rule_f  ratio: >=$(header_bytes "$MEDIA_RATIO_MIN_BYTES"),"
rule_f="$rule_f other<${MEDIA_RATIO_TEXT_PER_MILLE}/1000 of media"
rule_f="$rule_f  batch: >=${MEDIA_MIN_BATCH} repos,"
rule_f="$rule_f other<$(header_bytes "$MEDIA_TEXT_CEIL_BYTES")"
rule_line "" F media "$rule_f"
rule_g_status=""
[ "$BLOCK_PEERS" = 1 ] || rule_g_status="reports only; --block-peers asks per peer"
rule_g=">=${PARASITE_MIN_REPOS} repos  >=$(header_bytes "$PARASITE_MIN_BYTES") media"
rule_g="$rule_g  other<$(header_bytes "$PARASITE_TEXT_MAX_BYTES")"
rule_line "" G parasite-peer "$rule_g" "$rule_g_status"
rule_h_status=""
# A single repo it flags is only ever reported, so only an identity's repos can be pruned.
if [ "$MALWARE_PRUNE" = 0 ]; then
  rule_h_status="reports only; MALWARE_PRUNE=1 prunes an identity's repos"
else
  rule_h_status="prunes an identity's repos, only reports a single repo"
  [ "$BLOCK_PEERS" = 1 ] || rule_h_status="$rule_h_status; blocks with --block-peers"
fi
rule_h="identity: words>=${MALWARE_MIN_WORDS} in >=${MALWARE_MIN_REPOS} &"
rule_h="$rule_h >=${MALWARE_MIN_SHARE_PCT}% of its repos"
rule_line "" H malware "$rule_h" "$rule_h_status"

# ------------------------------------------------------------------------------------ progress
# A phase waits on xargs silently, for minutes on a big seed, and a slow walk looks hung, so
# operators kill working runs. Workers already append a row per finished repo, so a ticker
# counts those rows.
#
# On a terminal one line redraws in place. Elsewhere (cron, pipe, log) the same reading is
# printed sparsely as plain lines. Both go to stderr, so the plan on stdout stays clean.
#
# The count is against the phase's own repos. A phase the run cache mostly answers would
# otherwise sit near zero against all 11k and look stuck.

# Redraw interval for a terminal. A constant: nobody has a wish to state about it.
progress_redraw_secs=1
# The bar at full width. printf prints a slice as wide as the percentage in a field of the
# full width, padding with spaces.
progress_bar_full='===================='
progress_bar_cells=${#progress_bar_full}
# The time left is projected from repos done so far, and one repo can cost a thousand times
# another (152k refs held a phase for minutes). Projected too early, the estimate climbs then
# collapses, so it shows only after this many repos...
progress_min_done=100
# ...and at least 1 in this many of the phase's repos. Past both, the estimate on the seed
# was within a third of the real time.
progress_min_share=5
# Seconds with no repo finishing, after which the estimate gives way to elapsed time, since
# a slow repo makes the earlier projection false.
progress_stall_secs=15
# How many walks this run does, so a line can say which one it is on. The two scan walks
# always run; F and G add one each when RULES holds them.
progress_phases=2
for _r in F G; do rule_on "$_r" && progress_phases=$((progress_phases + 1)); done
# The prune is a walk too, and silence between the confirmation and DONE looks like a hang.
# A run that aborts before it, or answers "n", reads one phase short.
if [ "$APPLY" = 1 ]; then
  progress_phases=$((progress_phases + 1))
fi

# Seconds as a short duration such as 2m05s.
duration() {
  local s=$1
  if [ "$s" -lt 60 ]; then printf '%ds' "$s"
  else                     printf '%dm%02ds' "$((s / 60))" "$((s % 60))"
  fi
}

# The time left, rounded to 10 seconds under a minute and to 30 above it, so the number
# does not tick up and down at every redraw.
time_left() {
  local s=$1
  if   [ "$s" -lt 10 ]; then printf '<10s left'
  elif [ "$s" -lt 60 ]; then printf '~%s left' "$(duration $(( (s + 5) / 10 * 10 )))"
  else                       printf '~%s left' "$(duration $(( (s + 15) / 30 * 30 )))"
  fi
}

progress_pid=""
progress_phase=""
progress_total=0
progress_started=0
progress_n=0
progress_files=()
# $1 = what to call the phase, $2 = repos it will read, $3... = the files its workers append a
# row to per finished repo.
progress_start() {
  local phase=$1 total=$2
  shift 2
  progress_phase=$phase; progress_total=$total; progress_started=$SECONDS
  # progress_stop counts these rows again to say what the phase read.
  progress_files=("$@")
  progress_n=$((progress_n + 1))
  progress_pid=""
  [ "$PROGRESS_SECS" -gt 0 ] || return 0
  [ "$total" -gt 0 ] || return 0
  # A log gets a line as each phase starts, since its first reading is PROGRESS_SECS away.
  if [ "$stderr_tty" = 0 ]; then
    printf '# [%d/%d] %-15s started on %d repos\n' "$progress_n" "$progress_phases" \
           "$phase" "$total" >&2
  fi
  local files=("$@") parent=$$ started=$SECONDS n=$progress_n
  local every=$PROGRESS_SECS live=0 cols=80
  if [ "$stderr_tty" = 1 ]; then
    every=$progress_redraw_secs; live=1
    # Held to the terminal width: a wrapped line cannot be redrawn, because the carriage
    # return goes only to the start of its last physical line.
    cols=$(tput cols 2>/dev/null) || cols=80
    case "$cols" in ''|*[!0-9]*) cols=80 ;; esac
  fi
  (
    # The sleep inherits the run's stdout and stderr. Killing only the subshell leaves it
    # holding them open, so a reader piping the run's output waits long after the run ends.
    # ${napper:-} because the signal can arrive before the first sleep, and an unset variable
    # under `set -u` would trip the error trap.
    trap 'kill "${napper:-}" 2>/dev/null || true; exit 0' TERM
    local done_n elapsed pct rest line head tail cells napper="" sure
    local last_n=0 last_change=$started stalled
    while :; do
      sleep "$every" & napper=$!
      wait "$napper" || exit 0
      # The run is gone, so stop before printing into a terminal that has moved on.
      kill -0 "$parent" 2>/dev/null || exit 0
      # A stream file not opened yet is normal at the first tick, so cat's status is dropped.
      done_n=$( { cat "${files[@]}" 2>/dev/null || true; } | wc -l )
      # A count over the total would print past 100% and a negative estimate. Only a bug gets
      # here, and a wrong bar is not worth an abort.
      [ "$done_n" -le "$total" ] || done_n=$total
      elapsed=$(( SECONDS - started ))
      pct=$(( done_n * 100 / total ))
      if [ "$done_n" -gt "$last_n" ]; then
        last_n=$done_n; last_change=$SECONDS
      fi
      stalled=$(( SECONDS - last_change ))
      # The bar counts repos, not time, so 4 of 10 reads 40% while one slow repo may still hold
      # most of the phase. Bar and estimate wait until the count can stand for the time.
      sure=0
      if [ "$done_n" -ge "$progress_min_done" ] \
         && [ $(( done_n * progress_min_share )) -ge "$total" ]; then
        sure=1
      fi
      # A stall drops the share done and the estimate, both measured before the slow repo
      # started. Before the first repo finishes, the elapsed time already says how long
      # nothing has. Once all have finished there is nothing to wait on.
      rest=""
      if [ "$done_n" -gt 0 ] && [ "$done_n" -lt "$total" ] \
         && [ "$stalled" -ge "$progress_stall_secs" ]; then
        sure=0
        rest="last done $(duration "$stalled") ago"
      elif [ "$sure" = 1 ] && [ "$done_n" -lt "$total" ]; then
        rest=$(time_left $(( elapsed * (total - done_n) / done_n )))
      fi
      [ -z "$rest" ] || rest=", $rest"
      if [ "$live" = 1 ]; then
        head=$(printf '  [%d/%d] %s' "$n" "$progress_phases" "$phase")
        if [ "$sure" = 1 ]; then
          tail=$(printf '%3d%% %d/%d repos %s%s' "$pct" "$done_n" "$total" \
                   "$(duration "$elapsed")" "$rest")
        else
          tail=$(printf '%d/%d repos %s%s' "$done_n" "$total" "$(duration "$elapsed")" "$rest")
        fi
        # The bar gives up width first, so the counts fit 80 columns under the longest phase
        # name. Under 5 cells it adds nothing to the percentage.
        cells=$(( cols - ${#head} - ${#tail} - 4 ))
        [ "$cells" -le "$progress_bar_cells" ] || cells=$progress_bar_cells
        if [ "$sure" = 1 ] && [ "$cells" -ge 5 ]; then
          line=$(printf '%s [%-*.*s] %s' "$head" "$cells" "$(( pct * cells / 100 ))" \
                   "$progress_bar_full" "$tail")
        else
          line="$head $tail"
        fi
        printf '\r\033[K%.*s' "$cols" "$line" >&2
      elif [ "$sure" = 1 ]; then
        printf '# [%d/%d] %-15s %d of %d repos (%d%%), %s elapsed%s\n' \
               "$n" "$progress_phases" "$phase" "$done_n" "$total" "$pct" \
               "$(duration "$elapsed")" "$rest" >&2
      else
        printf '# [%d/%d] %-15s %d of %d repos, %s elapsed%s\n' \
               "$n" "$progress_phases" "$phase" "$done_n" "$total" \
               "$(duration "$elapsed")" "$rest" >&2
      fi
    done
  ) &
  progress_pid=$!
}

# Ends the ticker silently. Safe with none running, as the EXIT trap needs: an aborted run
# must not leave a ticker printing, nor claim the phase it died in finished.
progress_kill() {
  [ -n "$progress_pid" ] || return 0
  kill "$progress_pid" 2>/dev/null || true
  wait "$progress_pid" 2>/dev/null || true
  progress_pid=""
  # Clear the redrawn line so no frozen bar stays on screen.
  if [ "$stderr_tty" = 1 ]; then printf '\r\033[K' >&2; fi
}

# Clears the bar first, so a message printed mid-phase starts at column 0.
progress_warn() {
  if [ "$stderr_tty" = 1 ]; then printf '\r\033[K' >&2; fi
  echo "$@" >&2
}

# Ends the phase and prints what it cost, the number an operator tuning JOBS or RULES
# wants.
progress_stop() {
  progress_kill
  local read_n cost
  if [ "$PROGRESS_SECS" -gt 0 ] && [ "$progress_total" -gt 0 ]; then
    cost=$(duration $(( SECONDS - progress_started )))
    # Counted from the rows the workers wrote, so a phase whose workers all died does not
    # read as complete. -1 when the phase named no file, since a bare `cat` would read stdin
    # and hang.
    read_n=-1
    if [ "${#progress_files[@]}" -gt 0 ]; then
      read_n=$( { cat "${progress_files[@]}" 2>/dev/null || true; } | wc -l )
    fi
    if [ "$read_n" -ge 0 ] && [ "$read_n" -lt "$progress_total" ]; then
      read_n="$read_n of $progress_total"
    else
      read_n=$progress_total
    fi
    printf '# [%d/%d] %-15s %6s repos   %s\n' "$progress_n" "$progress_phases" \
           "$progress_phase" "$read_n" "$cost" >&2
  fi
  progress_phase=""; progress_total=0; progress_files=()
}

tmp=$(mktemp -d)
on_exit() {
  local rc=$?
  progress_kill
  rm -rf "$tmp"
  [ -z "$CHECK_DIR" ] || rm -rf "$CHECK_DIR"
  # A cron job keeps only what the run printed, so the exit code is printed, and logged
  # beside what the run did.
  if [ "$APPLY" = 1 ] || [ "$BLOCK_PEERS" = 1 ]; then
    echo "# exit $rc" >&2
    [ -z "${audit:-}" ] || { printf '# exit %s\n' "$rc" >> "$audit"; } 2>/dev/null || true
  fi
  colour_wait
}
trap on_exit EXIT

# ------------------------------------------------------------------------------ exclusion sets
jq -r '.web.pinned.repositories[]?' "$CONFIG" 2>/dev/null \
  | sed 's/^rad://' | sort -u > "$tmp/pinned" || true
# `rad ls` fails the whole listing over one bad storage entry, such as a directory whose
# name is not a repo id. A storage the node cannot list is not pruned by guesswork, so a
# failure stops the run below, once its mode is known.
ls_failed=""
"$RAD" ls --all --private > "$tmp/ls-private" 2> "$tmp/ls-err" \
  || ls_failed="$RAD ls --all --private"
[ -n "$ls_failed" ] || "$RAD" ls > "$tmp/ls-own" 2> "$tmp/ls-err" || ls_failed="$RAD ls"
grep -oE 'rad:z[1-9A-HJ-NP-Za-km-z]+' "$tmp/ls-private" \
  | sed 's/^rad://' | sort -u > "$tmp/private" || true
grep -oE 'rad:z[1-9A-HJ-NP-Za-km-z]+' "$tmp/ls-own" 2>/dev/null \
  | sed 's/^rad://' | sort -u > "$tmp/own" || true
# The keep list, read like the deny list below. Both id spellings are taken, since people
# copy ids by hand from output that prints both. An identity (48 characters) here clears it
# of rule H; its repos are not kept. An unreadable list stops the run, since reading it as
# empty would prune every repo on it again.
: > "$tmp/kept"; : > "$tmp/kept-nids"
keep_unreadable=0
if { [ -e "$KEEP_FILE" ] || [ -L "$KEEP_FILE" ]; } \
   && { [ ! -f "$KEEP_FILE" ] || [ ! -r "$KEEP_FILE" ]; }; then
  keep_unreadable=1
elif [ -e "$KEEP_FILE" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}; line=${line#$'\xef\xbb\xbf'}
    read -ra toks <<<"${line%%#*}"
    for tok in "${toks[@]}"; do
      id=${tok#rad:}; id=${id#did:key:}
      if   [[ $id =~ ^z[1-9A-HJ-NP-Za-km-z]{40,}$ ]]; then printf '%s\n' "$id" >> "$tmp/kept-nids"
      elif [[ $id =~ ^z[1-9A-HJ-NP-Za-km-z]+$ ]];     then printf '%s\n' "$id" >> "$tmp/kept"
      else printf '# WARN %s: %q is neither a repo id nor an identity; it keeps nothing.\n' \
             "$KEEP_FILE" "$tok" >&2
      fi
    done
  done < "$KEEP_FILE"
fi
sort -u -o "$tmp/kept" "$tmp/kept"; sort -u -o "$tmp/kept-nids" "$tmp/kept-nids"
cat "$tmp/pinned" "$tmp/private" "$tmp/own" "$tmp/kept" 2>/dev/null | sort -u > "$tmp/excluded"
# A check judges only the public repos this node is a delegate of. `rad ls` also lists
# repos this node forked, which the publisher cannot change. A pin protects nothing on a
# seed, so pinned repos are judged. Rule F skips the excluded repos (see cache_hits).
# A row's id is its first token, since a description may quote another repo's. An id that
# opens a later line of a description is judged only if its identity document names this
# node as a delegate. Private is read from that document too, since a forged row can claim
# any visibility.
if [ "$CMD" = check-mine ]; then
  : > "$tmp/check-repos"
  while IFS= read -r rid; do
    read_delegates "$STORAGE/$rid"
    case " $dids " in (*" $OUR_NID "*) ;; (*) continue ;; esac
    jq -e '.visibility.type == "private"' <<<"$iddoc" >/dev/null 2>&1 && continue
    printf '%s\n' "$rid" >> "$tmp/check-repos"
  done < <(awk '{ for (i = 1; i <= NF; i++)
                    if ($i ~ /^rad:z[1-9A-HJ-NP-Za-km-z]+$/) { print substr($i, 5); break } }' \
              "$tmp/ls-own")
  find "$STORAGE" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' \
    | grep -vxFf "$tmp/check-repos" > "$tmp/excluded" || true
fi
# Once prefixes are dropped, an identity is 48 characters and a repo id under 40. A token
# that is neither is warned about, since it is a verdict that would otherwise do nothing.
: > "$tmp/deny-rids"; : > "$tmp/deny-nids"
deny_unreadable=0
if { [ -e "$DENY_FILE" ] || [ -L "$DENY_FILE" ]; } \
   && { [ ! -f "$DENY_FILE" ] || [ ! -r "$DENY_FILE" ]; }; then
  deny_unreadable=1
  echo "# WARN cannot read $DENY_FILE; nothing on it is pruned or blocked this run, and no" \
       "block is lifted, since the list may name a repo whose block must stay." >&2
elif [ -e "$DENY_FILE" ]; then
  # Reads a last line with no newline, and strips CR and BOM from files saved on Windows.
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}; line=${line#$'\xef\xbb\xbf'}
    read -ra toks <<<"${line%%#*}"
    for tok in "${toks[@]}"; do
      id=${tok#rad:}; id=${id#did:key:}
      # This node's own identity is dropped, so its block and repos do not depend on `rad ls`
      # listing them as ours. %q because the list may be someone else's and goes to a terminal.
      if   [ "$id" = "$OUR_NID" ]; then
        echo "# WARN $DENY_FILE lists this node's own identity; ignored." >&2
      elif [[ $id =~ ^z[1-9A-HJ-NP-Za-km-z]{40,}$ ]]; then printf '%s\n' "$id" >> "$tmp/deny-nids"
      elif [[ $id =~ ^z[1-9A-HJ-NP-Za-km-z]+$ ]];     then printf '%s\n' "$id" >> "$tmp/deny-rids"
      else printf '# WARN %s: %q is neither a repo id nor an identity; ignored.\n' \
             "$DENY_FILE" "$tok" >&2
      fi
    done
  done < "$DENY_FILE"
fi
sort -u -o "$tmp/deny-rids" "$tmp/deny-rids"; sort -u -o "$tmp/deny-nids" "$tmp/deny-nids"
# Said every run, so a cron log shows the list was read at all.
deny_label=deny
if [ -e "$DENY_FILE" ]; then
  header_line deny "$(count "$(wc -l < "$tmp/deny-rids")" repo repos)," \
                   "$(count "$(wc -l < "$tmp/deny-nids")" identity identities) in $DENY_FILE"
  deny_label=""
fi
# Denied files as "oid \t source" in $tmp/deny-oids, the ids alone in $tmp/deny-oid-list.
# A row whose source repo was restored is dropped here; the file keeps it as a record.
: > "$tmp/deny-oids"; ndenyrestored=0; ndenybad=0
if [ -e "$DENY_FILES" ] && { [ ! -f "$DENY_FILES" ] || [ ! -r "$DENY_FILES" ]; }; then
  echo "# WARN cannot read $DENY_FILES; no repo is pruned as a copy of what it lists." >&2
elif [ -e "$DENY_FILES" ]; then
  declare -A RESTORED=()
  while IFS= read -r r; do RESTORED[$r]=1; done < "$tmp/kept"
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}; line=${line#$'\xef\xbb\xbf'}
    read -r oid bytes src _ <<<"${line%%#*}"
    [ -n "$oid" ] || continue
    oid=${oid,,}; srcid=${src#rad:}
    # A row missing its size column would read its source as the size and slip past the
    # restore check. The source may be someone else's and goes to a terminal.
    if [[ ! $oid =~ ^[0-9a-f]{40}$ ]] || [[ ! $bytes =~ ^([0-9]+|-)$ ]] \
       || [[ ! $src =~ ^[[:graph:]]+$ ]]; then
      ndenybad=$((ndenybad + 1))
      [ "$ndenybad" -gt "$top_evidence" ] \
        || printf '# WARN %s: %q is not "%s"; ignored.\n' "$DENY_FILES" "${line%%#*}" \
                  "<object id> <bytes or -> <source> [date]" >&2
    # An empty key is an error to an associative array, and "rad:" alone would be one.
    elif [ -n "$srcid" ] && [ -n "${RESTORED[$srcid]:-}" ]; then
      ndenyrestored=$((ndenyrestored + 1))
    else
      printf '%s\t%s\n' "$oid" "$src" >> "$tmp/deny-oids"
    fi
  done < "$DENY_FILES"
  [ "$ndenybad" -le "$top_evidence" ] \
    || echo "# WARN ...and $((ndenybad - top_evidence)) more malformed row(s)" \
            "in $DENY_FILES" >&2
fi
sort -u -o "$tmp/deny-oids" "$tmp/deny-oids"
cut -f1 "$tmp/deny-oids" | sort -u > "$tmp/deny-oid-list"
# Said every run, so a cron log shows the file was read and what a copy must hold.
if [ -f "$DENY_FILES" ] && [ -r "$DENY_FILES" ]; then
  copy_min_said=$(awk -v b="$COPY_MIN_BYTES" 'BEGIN {
    if (b >= 1048576) printf "%.1fMiB", b / 1048576; else printf "%.0fKiB", b / 1024 }')
  restored_note=""
  [ "$ndenyrestored" = 0 ] \
    || restored_note=", $(count "$ndenyrestored" row rows) ignored as their source is kept"
  header_line "$deny_label" "$(count "$(wc -l < "$tmp/deny-oid-list")" "file id" "file ids")" \
                            "in $DENY_FILES$restored_note"
  header_line "" "A repo whose delegates' branches and tags hold >=$copy_min_said of these files," \
                 ">=${COPY_MIN_PCT}% of its bytes, is pruned as denied-copy."
fi
# One more walk over storage, only when there is something to find.
if [ -s "$tmp/deny-oid-list" ]; then progress_phases=$((progress_phases + 1)); fi

# With no reachable node the exclusion sets and seed counts come back empty. Under --apply
# that risks deleting own and pinned repos; a dry run would plan zero repos, hiding that it
# saw nothing. So abort in both modes.
mode=${run_mode,,}
# A check needs no live node: rad answers ls and self from disk.
[ "$CMD" = check-mine ] || "$RAD" node status >/dev/null 2>&1 \
  || { echo "# ABORT($mode): node unreachable via '$RAD' (home=$RAD_HOME)." >&2; exit 5; }
[ -n "$OUR_NID" ] \
  || { echo "# ABORT($mode): no NID from '$RAD' (home=$RAD_HOME)." >&2; exit 5; }
# A malformed NID matches none of this node's signed refs, so its own repos could be planned.
[[ $OUR_NID =~ ^z6Mk[1-9A-HJ-NP-Za-km-z]{44}$ ]] \
  || { printf '# ABORT(%s): our node id is malformed: %q\n' "$mode" "$OUR_NID" >&2; exit 5; }
[ -z "$ls_failed" ] \
  || { echo "# ABORT($mode): '$ls_failed' failed (home=$RAD_HOME):" \
            "$(head -c 300 "$tmp/ls-err" | LC_ALL=C tr -c '[:print:]' ' ')" >&2
         echo "# A directory in storage whose name is not a repo id is enough to cause it." \
              "Move any such directory out of storage." >&2
         exit 5; }

[ "$keep_unreadable" = 0 ] \
  || { echo "# ABORT($mode): cannot read $KEEP_FILE, the repos you chose to keep." >&2; exit 5; }
[ -f "$CONFIG" ] && [ -r "$CONFIG" ] \
  || { echo "# ABORT($mode): cannot read $CONFIG, which names the pinned repos." >&2; exit 5; }

if [ "$APPLY" = 1 ]; then
  npin_cfg=$(jq -r '.web.pinned.repositories[]?' "$CONFIG" 2>/dev/null | wc -l)
  [ "$npin_cfg" -gt 0 ] && [ "$(wc -l < "$tmp/pinned")" = 0 ] \
    && { echo "# ABORT(apply): pinned in config but none parsed." >&2; exit 5; }
fi

# Opened by whichever act writes first, since lifting blocks, pruning and blocking peers
# can each happen without the others.
audit=""
open_audit() {
  [ -z "$audit" ] || return 0
  mkdir -p "$AUDIT_DIR"
  local name
  name="$AUDIT_DIR/prune-$(date -u +%Y%m%dT%H%M%SZ).log"
  # Named by the second, so a run opening its log in the same second as another waits for
  # the next, since writing would truncate the other's record. noclobber makes taking the
  # name atomic. Any other failure stops the run, since retrying an unwritable directory would
  # loop forever. $audit is set only once the name is taken, because the exit trap appends.
  until ( set -C; : > "$name" ) 2> "$tmp/audit-err"; do
    if [ ! -e "$name" ] && [ ! -L "$name" ]; then
      echo "# ERROR: cannot create the audit log $name:" \
           "$(head -c 200 "$tmp/audit-err" | LC_ALL=C tr -c '[:print:]' ' ')" >&2
      exit 1
    fi
    sleep 1
    name="$AUDIT_DIR/prune-$(date -u +%Y%m%dT%H%M%SZ).log"
  done
  audit=$name
  { printf '# %s\n' \
      "What one rad prune run removed from storage or blocked, one repo per row, and the" \
      "blocks it lifted, on # unblocked: lines." \
      "A repo in the quarantine can be put back: rad prune quarantine restore <rid>"
    printf '# %s  version=%s  pressure=%s%%  rules=%s\n' \
           "$run_ts" "$VERSION" "$press_pct" "$rules_live"; } > "$audit"
  header_line log "$audit"
}

# ------------------------------------------------------------- undo: this tool's own blocks
# A block this tool made rests on a verdict that can prove wrong after the repo is gone.
# Such a block is lifted at most once per repo, and the current rules judge the repo again.
# Only a block an audit log explains is lifted. A hand-made block is no log's, and a
# deny-list block is a person's verdict.
# This only plans the lifts; undo_apply makes them, past the prompt and the runaway caps.

# True when version $1 is older than version $2. A log from before 0.8.0 names no version, "-",
# which is older than every version.
version_older() {
  [ "$1" = "-" ] && return 0
  [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n1)" = "$1" ]
}
# "32M" as bytes. K, M and G are powers of 1024, and a bare number is bytes already.
size_bytes() {
  case $1 in
    *K) echo $(( ${1%K} * 1024 )) ;;
    *M) echo $(( ${1%M} * 1048576 )) ;;
    *G) echo $(( ${1%G} * 1073741824 )) ;;
    *)  echo "$1" ;;
  esac
}

# Every audit log, oldest first, folded to one row per repo this tool pruned: rid, reason,
# size, when and by which version of the newest prune, the delegates line ("-" if none), and
# 1 when the block is not this tool's to lift: lifted once already, or blocked before the
# prune ("# was-blocked:").
undo_fold() {
  local f logs=()
  for f in "$AUDIT_DIR"/prune-*.log; do [ -r "$f" ] && logs+=("$f"); done
  [ ${#logs[@]} -gt 0 ] || return 0
  awk -F'\t' '
    FNR == 1 { when = "-"; by = "-" }
    # The run stamp, "# <when>  version=<v>  ...", the first dated line of each log.
    /^# [0-9][0-9][0-9][0-9]-/ && when == "-" {
      n = split($0, w, " "); when = w[2]
      for (i = 3; i <= n; i++) if (w[i] ~ /^version=/) by = substr(w[i], 9)
      next
    }
    /^# delegates: rad:z/ { split($0, w, " "); dl[substr(w[3], 5)] = w[4]; next }
    /^# (unblocked|was-blocked): rad:z/ {
      split($0, w, " "); nolift[substr(w[3], 5)] = 1; next
    }
    /^#/ { next }
    $1 ~ /^z[1-9A-HJ-NP-Za-km-z]+$/ && $5 != "" {
      reason[$1] = $5; size[$1] = $2 + 0; at[$1] = when; ver[$1] = by; dl[$1] = "-"
    }
    END { for (r in reason)
            printf "%s\t%s\t%.0f\t%s\t%s\t%s\t%d\n",
                   r, reason[r], size[r], at[r], ver[r], dl[r], nolift[r] + 0 }' "${logs[@]}"
}
undo_fold | sort > "$tmp/undo-fold"
# A log the run cannot read takes its verdicts and its "# unblocked:" lines with it, so a block
# could be lifted twice, or one rad-prune made be taken for somebody else's.
nlogunread=0
for f in "$AUDIT_DIR"/prune-*.log; do
  [ ! -e "$f" ] || [ -r "$f" ] || nlogunread=$((nlogunread + 1))
done
[ "$nlogunread" = 0 ] \
  || echo "# WARN cannot read $nlogunread audit log(s) in $AUDIT_DIR; the blocks they" \
          "record are lifted, or kept, as if those runs never happened." >&2
# rid \t pruned-for verdict, for every repo an earlier undo let back.
undo_lifted_before() {
  local f logs=()
  for f in "$AUDIT_DIR"/prune-*.log; do [ -r "$f" ] && logs+=("$f"); done
  [ ${#logs[@]} -gt 0 ] || return 0
  awk '/^# unblocked: rad:z/ {
         split($0, w, " "); print substr(w[3], 5) "\t" substr(w[5], 8) }' "${logs[@]}"
}
undo_lifted_before | sort -u > "$tmp/undo-lifted-before"

# UNDO_PARDON repos, wrongly pruned as media, are kept from rule F while their entry
# stands. deny.txt still prunes them, as the operator's verdict. An expired entry keeps
# nothing, so it is warned about.
: > "$tmp/undo-pardoned"
for entry in $UNDO_PARDON; do
  prid=${entry%%:*}; until=${entry#*:}
  if version_older "$VERSION" "$until"; then
    printf '%s\n' "$prid" >> "$tmp/undo-pardoned"
  else
    echo "# WARN the UNDO_PARDON entry for rad:$prid, a known mistake, ended at version $until;" \
         "it keeps nothing now. Drop the entry, or fix the rule that still flags the repo." >&2
  fi
done
# Lifted, and not spared: see UNDO_LIFT. Entries end together, so their end is one line.
: > "$tmp/undo-liftonly"
nlift_ended=0
for entry in $UNDO_LIFT; do
  if version_older "$VERSION" "${entry#*:}"; then
    printf '%s\n' "${entry%%:*}" >> "$tmp/undo-liftonly"
  else
    nlift_ended=$((nlift_ended + 1))
  fi
done
[ "$nlift_ended" = 0 ] \
  || echo "# WARN $nlift_ended UNDO_LIFT entries ended at their version and lift nothing now." \
          "Drop them." >&2
npardon_here=0
while IFS= read -r prid; do
  [ -d "$STORAGE/$prid" ] && npardon_here=$((npardon_here + 1))
done < "$tmp/undo-pardoned"
# A known mistake is a repo an earlier release wrongly pruned that rule F now spares.
spared="$(wc -l < "$tmp/pinned") pinned, $(wc -l < "$tmp/private") private,"
spared="$spared $(wc -l < "$tmp/own") own, $(wc -l < "$tmp/kept") in ${KEEP_FILE##*/}"
nkept_nids=$(wc -l < "$tmp/kept-nids")
[ "$nkept_nids" = 0 ] \
  || spared="$spared, $(count "$nkept_nids" identity identities) cleared of the malware rule (H)"
[ "$npardon_here" = 0 ] \
  || spared="$spared, $(count "$npardon_here" "known mistake" "known mistakes")"
header_line spared "$spared"

# The repos this node blocks now, from `rad seed`. rc.12 prints the scope after the
# policy, so the policy is the column before last; heartwood master omits the scope on a
# blocked row, so it is the last. Fails when `rad seed` fails, its error in $tmp/seed-err.
blocked_now() {
  "$RAD" seed > "$tmp/seed-list" 2> "$tmp/seed-err" || return 1
  awk '/rad:z/ {
         gsub(/│/, " "); n = split($0, f, " "); rid = ""
         for (i = 1; i <= n; i++)
           if (f[i] ~ /^rad:z[1-9A-HJ-NP-Za-km-z]+$/) { rid = substr(f[i], 5); break }
         if (rid != "" && (f[n] == "block" || f[n - 1] == "block")) print rid }' \
    "$tmp/seed-list" | sort -u
}
# A failed or empty listing lifts nothing: only a block seen standing is lifted.
: > "$tmp/undo-blocked"
if [ "$UNDO" = 1 ] && [ "$deny_unreadable" = 0 ] && [ -s "$tmp/undo-fold" ]; then
  if blocked_now > "$tmp/undo-blocked"; then
    # Once every block in the logs is lifted or someone else's, an empty listing is expected.
    nliftable=$(awk -F'\t' '$7 == 0' "$tmp/undo-fold" | wc -l)
    [ -s "$tmp/undo-blocked" ] || [ "$nliftable" = 0 ] \
      || echo "# WARN '$RAD seed' listed no blocked repo, while the audit logs name" \
              "$nliftable repo(s) rad-prune pruned and blocked. No block is lifted this run." >&2
  else
    echo "# WARN '$RAD seed' failed, so no block is lifted this run:" \
         "$(head -c 200 "$tmp/seed-err" | LC_ALL=C tr -c '[:print:]' ' ')" >&2
  fi
fi

# Repos pushed to since the prune. node.db keeps each node's latest signed refs announcement
# per repo, blocked ones included, for two weeks by default (gossip_max_age). The node checks
# each signature before storing it, so the node column is who announced it. Only a node
# announcing its own refs counts, since it may claim anything about others. With delegates
# recorded at the prune, the refs must differ from that delegate's then, because nodes
# re-announce what they had. Without them, any own-refs announcement after the prune
# counts, once; a fork can revive a repo that way, and it is pruned again if still junk.
: > "$tmp/undo-revived"
undo_revival() {
  local nodedb="$RAD_HOME/node/node.db" nid key
  awk -F'\t' -v reasons=" $UNDO_REVIVE_REASONS " '
      FILENAME == ARGV[1] { blocked[$1] = 1; next }
      ($1 in blocked) && $7 == 0 && index(reasons, " " $2 " ") { print $1 "\t" $4 "\t" $6 }' \
    "$tmp/undo-blocked" "$tmp/undo-fold" > "$tmp/undo-revive-cand"
  [ -s "$tmp/undo-revive-cand" ] || return 0
  # Dry run only: without sqlite3 this holds every run and would fill a weekly cron log.
  if ! command -v sqlite3 >/dev/null 2>&1; then
    [ "$APPLY" = 1 ] \
      || echo "# undo   sqlite3 is not installed, so a repo pruned for inactivity stays blocked" \
              "when someone pushes to it again." >&2
    return 0
  fi
  if [ ! -r "$nodedb" ]; then
    echo "# WARN cannot read $nodedb; a repo pruned for inactivity stays blocked when" \
         "someone pushes to it again." >&2
    return 0
  fi
  # Joined on today's spellings, rad:z... and z6Mk...; another spelling would match nothing
  # and look like nobody pushed.
  if ! sqlite3 -readonly -separator $'\t' "file:$nodedb?mode=ro" \
         "select count(*), coalesce(sum(repo like 'rad:z%' and node like 'z6Mk%'), 0)
          from announcements where type = 'refs';" \
         > "$tmp/undo-spelling" 2> "$tmp/undo-sql-err"; then
    echo "# WARN could not read $nodedb, so this run unblocks no repo for a push:" \
         "$(head -c 200 "$tmp/undo-sql-err" | LC_ALL=C tr -c '[:print:]' ' ')" >&2
    return 0
  fi
  local nall nspelled
  IFS=$'\t' read -r nall nspelled < "$tmp/undo-spelling"
  if [ "${nall:-0}" -gt 0 ] && [ "${nspelled:-0}" = 0 ]; then
    echo "# WARN $nodedb spells repos and nodes in a way this version does not read, so" \
         "this run unblocks no repo for a push." >&2
    return 0
  fi
  sqlite3 -readonly -separator $'\t' "file:$nodedb?mode=ro" \
    "create temp table cand(rid text, at text, dl text);" \
    ".mode tabs" ".import $tmp/undo-revive-cand cand" \
    "select c.rid, a.node, strftime('%s', c.at), a.timestamp, hex(a.message)
     from cand c join announcements a on a.repo = 'rad:' || c.rid and a.type = 'refs';" \
    > "$tmp/undo-ann" 2> "$tmp/undo-sql-err" \
    || { echo "# WARN could not read $nodedb, so this run unblocks no repo for a push:" \
              "$(head -c 200 "$tmp/undo-sql-err" | LC_ALL=C tr -c '[:print:]' ' ')" >&2
         return 0; }
  [ -s "$tmp/undo-ann" ] || return 0
  # Rows too short for the remotes they declare mean the layout moved, and every repo would
  # then look unpushed.
  if ! awk -F'\t' '{ n = 0; hexd = "0123456789ABCDEF"
                     for (i = 45; i < 49; i++) n = n * 16 + index(hexd, substr($5, i, 1)) - 1
                     if (length($5) >= 48 + n * 108) ok = 1 }
                   END { exit !ok }' "$tmp/undo-ann"; then
    echo "# WARN none of the refs announcements in $nodedb read as this version expects, so" \
         "this run unblocks no repo for a push." >&2
    return 0
  fi
  # Each announcing node's signing key, as the 64 hex digits a refs announcement names
  # remotes by.
  cut -f2 "$tmp/undo-ann" | sort -u | while IFS= read -r nid; do
    key=$(did_key_hex "$nid")
    if [ ${#key} = 64 ]; then printf '%s\t%s\n' "$nid" "${key^^}"; fi
  done > "$tmp/undo-keys"
  # One row per remote in each announcement after a known prune: rid, node, remote key,
  # signed refs. An announcement is a 2-byte length and 20-byte repo id, a 2-byte count, then
  # per remote a 32-byte key, 2-byte length and 20-byte signed refs id. As hex, a remote is
  # 108 digits from the 49th on, its key the first 64 and its refs id the last 40.
  awk -F'\t' '
      {
        rid = $1; nid = $2; pruned = $3 + 0; ts = int($4 / 1000); msg = $5
        if (pruned == 0 || ts <= pruned) next
        n = 0; hexd = "0123456789ABCDEF"
        for (i = 45; i < 49; i++) n = n * 16 + index(hexd, substr(msg, i, 1)) - 1
        if (length(msg) < 48 + n * 108) next
        for (e = 0; e < n; e++) {
          ent = substr(msg, 49 + e * 108, 108)
          print rid "\t" nid "\t" substr(ent, 1, 64) "\t" tolower(substr(ent, 69, 40))
        }
      }' "$tmp/undo-ann" > "$tmp/undo-remotes"
  # A remote revives a repo when it comes from a node not denied, names that node's own key,
  # and differs from the refs the audit log recorded for that node as a delegate. A log with
  # no delegates ("-") takes any such remote.
  awk -F'\t' '
      FILENAME == ARGV[1] { denied[$1] = 1; next }
      FILENAME == ARGV[2] { key[$1] = $2; next }
      FILENAME == ARGV[3] { dl[$1] = $3; next }
      {
        rid = $1; nid = $2; remote = $3; announced = $4
        if (!(nid in key) || (nid in denied) || remote != key[nid]) next
        if (dl[rid] == "-") { print rid; next }
        m = split(dl[rid], pairs, ",")
        for (j = 1; j <= m; j++) {
          split(pairs[j], kv, ":")
          if (kv[1] == nid && kv[2] != announced) { print rid; next }
        }
      }' "$tmp/deny-nids" "$tmp/undo-keys" "$tmp/undo-revive-cand" "$tmp/undo-remotes" \
    | sort -u
}
if [ "$UNDO" = 1 ] && [ -s "$tmp/undo-blocked" ]; then
  undo_revival > "$tmp/undo-revived"
fi

# The size cap (K, M or G) of the UNDO_CHANGED entry withdrawing verdict $1 by version $2;
# fails when none does. Rules B and C now wait for disk pressure, so lifting their blocks
# while they prune only brings repos back to prune again. A delegate's announcement can still
# lift one.
withdrawn_cap() {
  local entry cver creason cmax
  for entry in $UNDO_CHANGED; do
    IFS=: read -r cver creason cmax <<<"$entry"
    [ "$creason" = "$1" ] && version_older "$2" "$cver" || continue
    case $1 in
      size-outlier|stale) [ "$space_rules" = 0 ] || return 1 ;;
    esac
    printf '%s\n' "$cmax"
    return 0
  done
  return 1
}

# Every block with a reason to lift: pass (of the headroom test below), order, rid, why,
# reason, size, when, version, and copy (quarantined or deleted). Pardoned, kept and
# quarantined repos cost no budget and come first; the rest go smallest first, since every
# wrong verdict so far was a small repo. A repo bigger than its entry allows stays blocked.
: > "$tmp/undo-cand"
if [ "$UNDO" = 1 ] && [ -s "$tmp/undo-blocked" ]; then
  declare -A UNDO_BLOCKED=() UNDO_SKIP=() UNDO_DENYNID=() UNDO_REVIVED=() UNDO_PARDONED=()
  declare -A UNDO_LIFTONLY=() UNDO_KEPT=()
  while IFS= read -r r; do UNDO_BLOCKED[$r]=1; done < "$tmp/undo-blocked"
  while IFS= read -r r; do [ -n "$r" ] && UNDO_SKIP[$r]=1; done \
    < <(cat "$tmp/excluded" "$tmp/deny-rids")
  while IFS= read -r r; do [ -n "$r" ] && UNDO_DENYNID[$r]=1; done < "$tmp/deny-nids"
  while IFS= read -r r; do UNDO_REVIVED[$r]=1; done < "$tmp/undo-revived"
  while IFS= read -r r; do UNDO_PARDONED[$r]=1; done < "$tmp/undo-pardoned"
  while IFS= read -r r; do UNDO_LIFTONLY[$r]=1; done < "$tmp/undo-liftonly"
  while IFS= read -r r; do UNDO_KEPT[$r]=1; done < "$tmp/kept"
  while IFS=$'\t' read -r rid reason size at ver dl nolift; do
    [ -n "${UNDO_BLOCKED[$rid]:-}" ] || continue    # lifted already, or the block never held
    [ "$nolift" = 0 ] || continue                   # lifted once, or not this tool's block
    [ ! -e "$STORAGE/$rid" ] || continue            # never left storage, so never pruned
    copy=deleted
    [ "$QUARANTINE" = 1 ] && [ -d "$quar/$rid" ] && copy=quarantined
    # A kept repo is a person's word, which outweighs the verdict and the deny list, so it
    # comes back whatever the budget. Only from the quarantine: a deleted kept repo may be
    # one restored, then blocked and removed by hand, and a restore leaves no audit line.
    if [ -n "${UNDO_KEPT[$rid]:-}" ] && [ "$copy" = quarantined ]; then
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
             1 0 "$rid" kept "$reason" "$size" "$at" "$ver" "$copy" >> "$tmp/undo-cand"
      continue
    fi
    [ -z "${UNDO_SKIP[$rid]:-}" ] || continue       # pinned, private, own or denied
    case $reason in denied|denied-copy) continue ;; esac
    # A delegate added to the deny list since the prune makes the repo a person's verdict too.
    denied_delegate=0
    for pair in ${dl//,/ }; do
      did=${pair%%:*}
      [ -n "$did" ] && [ -n "${UNDO_DENYNID[$did]:-}" ] && denied_delegate=1
    done
    # A log that recorded no delegates leaves the quarantined copy to name them.
    if [ "$dl" = "-" ] && [ -d "$quar/$rid" ]; then
      read_delegates "$quar/$rid"
      for did in $dids; do
        [ -n "${UNDO_DENYNID[$did]:-}" ] && denied_delegate=1
      done
    fi
    [ "$denied_delegate" = 0 ] || continue
    why=""
    # UNDO_PARDON covers repos wrongly pruned as media, UNDO_LIFT as junk-name. A later prune
    # for another reason is a separate verdict.
    pardoned=0
    if [ -n "${UNDO_PARDONED[$rid]:-}" ] && [[ $reason == media-* ]]; then
      why=known-mistake; pardoned=1
    elif [ -n "${UNDO_LIFTONLY[$rid]:-}" ] && [ "$reason" = junk-name ]; then
      why=known-mistake
    fi
    if [ -z "$why" ] && cmax=$(withdrawn_cap "$reason" "$ver"); then
      if [ "$copy" = deleted ] && [ "$size" -gt "$(size_bytes "$cmax")" ]; then
        why=too-big-to-fetch
      else
        why=verdict-withdrawn
      fi
    fi
    if [ -z "$why" ] && [ -n "${UNDO_REVIVED[$rid]:-}" ]; then
      why=active-since-prune
    fi
    [ -n "$why" ] || continue
    order=2
    [ "$copy" = quarantined ] && order=1
    [ "$pardoned" = 0 ] || order=0
    # The headroom test charges B and C lifts against what every other lift leaves, so they
    # go last.
    pass=1
    case "$why:$reason" in verdict-withdrawn:size-outlier|verdict-withdrawn:stale) pass=2 ;; esac
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
           "$pass" "$order" "$rid" "$why" "$reason" "$size" "$at" "$ver" "$copy" \
           >> "$tmp/undo-cand"
  done < "$tmp/undo-fold"
fi
# A kept repo the undo cannot bring back stays in the quarantine, unpurged: its block is
# someone else's or lifted once, UNDO=0, or the listing failed. It is named every run until
# a person acts.
: > "$tmp/kept-stuck"
if [ "$QUARANTINE" = 1 ]; then
  awk -F'\t' 'FILENAME == ARGV[1] { back[$3] = 1; next } !($1 in back)' \
      "$tmp/undo-cand" "$tmp/kept" \
    | while IFS= read -r r; do
        if [ -d "$quar/$r" ] && [ ! -e "$STORAGE/$r" ]; then printf '%s\n' "$r"; fi
      done > "$tmp/kept-stuck"
fi
nstuck=$(wc -l < "$tmp/kept-stuck")
if [ "$nstuck" -gt 0 ]; then
  echo "# WARN $nstuck repo(s) in $KEEP_FILE are still in the quarantine, and this run" \
       "cannot bring them back. Run rad prune quarantine restore with each:" >&2
  head -n "$top_evidence" "$tmp/kept-stuck" | sed 's/^/#   /' >&2
  [ "$nstuck" -le "$top_evidence" ] \
    || echo "#   ...and $((nstuck - top_evidence)) more (PLAN_FULL=1 lists them)" >&2
fi

# Each gets "unblock", "unblock-later" (over this run's count or GiB, disk at the critical
# free-space threshold, or a B or C lift would cause pressure), or "stays-blocked" (too big
# to fetch again). The budget goes on repos that cost a fetch: deleted ones not in
# UNDO_PARDON or the keep file.
: > "$tmp/undo-states"
undo_crit=0
[ "$DISK_AWARE" = 1 ] && awk -v a="$free_eff" -v c="$crit_free" 'BEGIN{exit !(a <= c)}' \
  && undo_crit=1
undo_n=0; undo_bytes=0; undo_max_bytes=$(( UNDO_MAX_GB * 1073741824 ))
# B and C blocks are lifted only because those rules wait while the disk has room, so
# lifted repos must not use it up, or they are pruned again under pressure. Every lift is
# charged its size, and B and C lifts, read last, are held once the room is spent. A
# quarantined repo is charged too, since free space already counts expired copies as freed;
# one still in its window takes no new room, so charging it can hold a B or C lift back too
# early, never too late.
bc_room=$(awk -v a="$free_eff" -v r="$relax_free" 'BEGIN { printf "%.0f", a - r }')
# A repo an earlier run lifted takes room once the node fetches it, so it is charged until it
# is in storage, for at most LIFT_FETCH_DAYS after the lift: one no peer offers by then is not
# coming back, and charging it forever would hold every later B or C lift. The node fetches it
# by itself only under an "allow" default policy, or if kept, which the lift seeds. One blocked
# again is not coming back either.
LIFT_FETCH_DAYS=14      # days; node.db keeps a peer's announcements for two weeks
undo_default=$(jq -r '.node.seedingPolicy.default // "block"' "$CONFIG" 2>/dev/null) \
  || undo_default=block
lift_cut=$(date -u -d "@$(( now - LIFT_FETCH_DAYS * 86400 ))" +%Y%m%dT%H%M%SZ)
undo_lifts_pending() {
  local f stamp logs=()
  for f in "$AUDIT_DIR"/prune-*.log; do
    [ -r "$f" ] || continue
    # A log is named by the time its run started, which no lift in it precedes.
    stamp=${f##*/prune-}; stamp=${stamp%.log}
    if [[ $stamp > "$lift_cut" ]]; then logs+=("$f"); fi
  done
  [ ${#logs[@]} -gt 0 ] || return 0
  awk -v policy="$undo_default" '
    /^# unblocked: rad:z/ { split($0, w, " ")
                            if (policy == "allow" || w[4] == "why=kept") print substr(w[3], 5) }' \
    "${logs[@]}" | sort -u
}
undo_lifts_pending > "$tmp/undo-lifts-pending"
room_used=0
while IFS=$'\t' read -r rid size; do
  [ ! -e "$STORAGE/$rid" ] || continue
  ! grep -qxF -- "$rid" "$tmp/undo-blocked" || continue
  room_used=$((room_used + size))
done < <(awk -F'\t' 'FILENAME == ARGV[1] { lifted[$1] = 1; next }
                     $1 in lifted { print $1 "\t" $3 }' \
           "$tmp/undo-lifts-pending" "$tmp/undo-fold")
bc_held=0
while IFS=$'\t' read -r pass order rid why reason size at ver copy; do
  state=unblock
  if [ "$why" = too-big-to-fetch ]; then
    state=stays-blocked
  elif [ "$undo_crit" = 1 ]; then
    state=unblock-later
  elif [ "$order" = 2 ] && { [ "$undo_n" -ge "$UNDO_MAX_COUNT" ] \
                             || [ $(( undo_bytes + size )) -gt "$undo_max_bytes" ]; }; then
    state=unblock-later
  elif [ "$pass" = 2 ] && [ $(( room_used + size )) -gt "$bc_room" ]; then
    state=unblock-later; bc_held=$((bc_held + 1))
  else
    if [ "$order" = 2 ]; then undo_n=$((undo_n + 1)); undo_bytes=$((undo_bytes + size)); fi
    room_used=$((room_used + size))
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
         "$rid" "$state" "$why" "$reason" "$size" "$at" "$ver" "$copy" >> "$tmp/undo-states"
done < <(sort -t$'\t' -k1,1n -k2,2n -k6,6n "$tmp/undo-cand")

nunblock=$(awk -F'\t' '$2 == "unblock"' "$tmp/undo-states" | wc -l)
nlater=$(awk -F'\t' '$2 == "unblock-later"' "$tmp/undo-states" | wc -l)
nstays=$(awk -F'\t' '$2 == "stays-blocked"' "$tmp/undo-states" | wc -l)

# Said only when a lift is due or waits; a too-big repo stays blocked every run, and a
# weekly line about it is noise.
if [ "$nunblock" -gt 0 ] || [ "$nlater" -gt 0 ]; then
  count_why() { awk -F'\t' -v w="$1" '$2 == "unblock" && $3 == w' "$tmp/undo-states" | wc -l; }
  if [ "$undo_crit" = 1 ]; then
    later_when="once free space is over the critical threshold"
  else
    later_when="over the next runs (UNDO_MAX_COUNT $UNDO_MAX_COUNT, UNDO_MAX_GB $UNDO_MAX_GB GiB"
    later_when="$later_when a run)"
  fi
  undo_label=undo
  if [ "$nunblock" -gt 0 ]; then
    whys=""
    n=$(count_why verdict-withdrawn)
    [ "$n" = 0 ] || whys="$whys, $(count "$n" "withdrawn verdict" "withdrawn verdicts")"
    n=$(count_why known-mistake)
    [ "$n" = 0 ] || whys="$whys, $(count "$n" "known mistake" "known mistakes")"
    n=$(count_why active-since-prune)
    [ "$n" = 0 ] || whys="$whys, $n active again"
    n=$(count_why kept)
    [ "$n" = 0 ] || whys="$whys, $n kept"
    header_line undo "lift $(count "$nunblock" block blocks): ${whys#, }"
    undo_label=""
  fi
  # Each line counts on from the one above; the first says what it counts.
  undo_seen=$nunblock
  if [ "$nlater" != "$bc_held" ]; then
    n=$(( nlater - bc_held ))
    if [ "$undo_seen" = 0 ]; then n=$(count "$n" block blocks); else n="$n more"; fi
    header_line "$undo_label" "$n to lift $later_when"
    undo_label=""; undo_seen=1
  fi
  if [ "$bc_held" != 0 ]; then
    n=$bc_held
    if [ "$undo_seen" = 0 ]; then n=$(count "$n" block blocks); else n="$n more"; fi
    verb="wait"; them="them"; [ "$bc_held" = 1 ] && { verb="waits"; them="it"; }
    header_line "$undo_label" "$n $verb, as lifting $them now would put the disk under" \
                              "pressure, where the size (B) and stale (C) rules prune $them again"
    undo_label=""
  fi
  if [ "$undo_crit" = 1 ]; then
    n=$(awk -F'\t' '$2 == "unblock-later" && $8 == "quarantined"' "$tmp/undo-states" | wc -l)
    are=are; [ "$n" = 1 ] && are=is
    [ "$n" = 0 ] || header_line "" "$n of those $are in the quarantine, which --apply empties at" \
                                   "this free space"
  fi
  if [ "$nstays" = 1 ]; then
    header_line "$undo_label" "1 block stays in place, as the repo is too big to fetch again"
  elif [ "$nstays" -gt 1 ]; then
    header_line "$undo_label" "$nstays blocks stay in place, as those repos are too big to fetch" \
                              "again"
  fi
fi

# Lifts the planned blocks, only once the run is past the prompt and the runaway caps. A
# quarantined repo goes back into storage for a later run to judge; a deleted one loses its
# block, so the node fetches it when a peer next offers it. Neither is re-seeded, since under
# a default policy other than "allow" that is the operator's call. A kept repo is that call
# already made, so it is seeded, as quarantine restore does. Each lift writes a
# "# unblocked:" audit line, which also stops a second lift later.
undo_apply() {
  local rid state why reason size at ver copy lifted=0 failed=0 seeded=0
  undo_failed=0
  [ "$nunblock" -gt 0 ] || return 0
  open_audit
  while IFS=$'\t' read -r rid state why reason size at ver copy; do
    [ "$state" = unblock ] || continue
    if [ "$copy" = quarantined ] \
       && { [ -e "$STORAGE/$rid" ] || ! mv -- "$quar/$rid" "$STORAGE/$rid" 2>/dev/null; }; then
      echo "# WARN could not move rad:$rid back from the quarantine; it stays blocked." >&2
      failed=$((failed + 1)); continue
    fi
    # `rad unseed` drops whatever policy the repo has, here the block just listed. `rad
    # unblock` would write the policy database behind the running node's back.
    if ! "$RAD" unseed "rad:$rid" >/dev/null 2>&1; then
      echo "# WARN could not lift the block on rad:$rid ('$RAD unseed' failed); it stays" \
           "blocked." >&2
      if [ "$copy" = quarantined ] && ! mv -- "$STORAGE/$rid" "$quar/$rid" 2>/dev/null; then
        echo "# WARN could not move rad:$rid back into the quarantine; it stays blocked in" \
             "$STORAGE/$rid until $RAD unseed rad:$rid is run by hand." >&2
      fi
      failed=$((failed + 1)); continue
    fi
    [ "$ver" = "-" ] && ver=0.7.0-or-older
    printf '# unblocked: rad:%s why=%s reason=%s pruned_at=%s pruned_by_version=%s %s\n' \
           "$rid" "$why" "$reason" "$at" "$ver" "local_copy=$copy" 2>/dev/null >> "$audit" \
      || echo "# WARN lifted the block on rad:$rid but could not record it in $audit, so a" \
              "block put back on it later could be lifted again." >&2
    lifted=$((lifted + 1))
    if [ "$why" = kept ]; then
      if "$RAD" seed "rad:$rid" >/dev/null 2>&1; then
        seeded=$((seeded + 1))
      else
        echo "# WARN lifted the block on rad:$rid, which $KEEP_FILE keeps, but" \
             "'$RAD seed rad:$rid' failed; run it yourself." >&2
      fi
    fi
  done < "$tmp/undo-states"
  if [ "$failed" = 0 ]; then
    echo "# undo   unblocked $(count "$lifted" repo repos)."
  else
    echo "# undo   unblocked $(count "$lifted" repo repos), $failed failed (see the warnings above)."
  fi
  undo_failed=$failed
  if [ "$undo_default" != allow ] && [ "$lifted" -gt "$seeded" ]; then
    echo "#   This node's default seeding policy is '$undo_default', so it seeds none of them" \
         "by itself. To seed one, run rad seed with an id from the '# unblocked:' lines of" \
         "$audit"
  fi
}

# Characters in stranger text that the terminal acts on or hides, as UTF-8 bytes, so the
# operator sees what the text holds: C1 controls (an escape sequence could rewrite the
# screen), soft hyphen, combining grapheme joiner, Arabic letter mark, Mongolian vowel
# separator, zero-width and bidi characters U+200B-200F, U+202A-202E, U+2060-206F, and the
# BOM. Run it after `iconv -c` (its nonzero status on dropped bytes is ignored). Then every
# byte belongs to a whole UTF-8 sequence, and since each pattern starts with a lead byte,
# which never occurs as a continuation byte, a match covers whole characters, removing one
# cannot join its neighbours into another, and one pass is enough. Look-alike letters still get
# through; a hidden word only lets a repo go unflagged.
HIDDEN_CHARS_SED=$'s/\xc2[\x80-\x9f]//g
s/\xc2\xad//g
s/\xcd\x8f//g
s/\xd8\x9c//g
s/\xe1\xa0\x8e//g
s/\xe2\x80[\x8b-\x8f\xaa-\xae]//g
s/\xe2\x81[\xa0-\xa4\xa6-\xaf]//g
s/\xef\xbb\xbf//g'
# ------------------------------------------------------------------- rid -> name + description
# One `rad ls --all` feeds the plan's NAME column and rule D, so parse the whole row:
# "| <name> rad:<rid> <visibility> <head> <description...> |". Take the FIRST rad: token,
# since a description may quote another rid. Walk the trailing columns, since visibility,
# head and description are each missing on some rows. Name and description are written by
# delegates and reach the terminal, so control characters go, then HIDDEN_CHARS_SED's.
"$RAD" ls --all 2>/dev/null | LC_ALL=C tr -d '\000-\010\013-\037\177' \
  | { iconv -f UTF-8 -t UTF-8 -c 2>/dev/null || true; } \
  | LC_ALL=C sed "$HIDDEN_CHARS_SED" \
  | awk '
  /rad:z[1-9A-HJ-NP-Za-km-z]+/ {
    ridi=0; for (i=1;i<=NF;i++) if ($i ~ /^rad:z[1-9A-HJ-NP-Za-km-z]+$/) { ridi=i; break }
    if (ridi<2) next
    rid=$ridi; sub(/^rad:/,"",rid)
    name=""; for (i=2;i<ridi;i++) name=name (name==""?"":" ") $i   # names with spaces survive
    d=ridi+1
    if ($d=="public" || $d=="private" || $d=="local") d++
    if (d<NF && length($d)>=7 && $d ~ /^[0-9a-f]+$/) d++   # the head oid, when the row has one
    desc=""; for (i=d;i<NF;i++) desc=desc (desc==""?"":" ") $i     # NF is the closing box char
    print rid"\t"name"\t"desc
  }' > "$tmp/meta" || true
# A line break in a description lets its author forge rows under any id. A real row
# names a repo in storage, so other rows go. A repo listed twice keeps both rows for rule D,
# as members agreeing with nothing, and gets no name, since nothing says which is forged.
find "$STORAGE" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' > "$tmp/stored" 2>/dev/null \
  || true
awk -F'\t' 'FILENAME == ARGV[1] { stored[$1] = 1; next } !($1 in stored) { print $1 }' \
  "$tmp/stored" "$tmp/meta" | sort -u > "$tmp/meta-foreign"
awk -F'\t' 'FILENAME == ARGV[1] { stored[$1] = 1; next } ($1 in stored)' \
  "$tmp/stored" "$tmp/meta" > "$tmp/meta-stored"
mv "$tmp/meta-stored" "$tmp/meta"
# Without its own identity ref a repo has no verified document to tell a real row from a
# forged one, so its rows go, and rules that read a name leave it alone. The ref is a loose
# file or a packed-refs line.
while IFS= read -r rid; do
  if [ -e "$STORAGE/$rid/refs/rad/id" ] \
     || grep -qm1 ' refs/rad/id$' "$STORAGE/$rid/packed-refs" 2>/dev/null; then
    printf '%s\n' "$rid"
  fi
done < "$tmp/stored" > "$tmp/stored-with-id"
awk -F'\t' 'FILENAME == ARGV[1] { hasid[$1] = 1; next } ($1 in hasid)' \
  "$tmp/stored-with-id" "$tmp/meta" > "$tmp/meta-with-id"
nnoid=$(( $(wc -l < "$tmp/meta") - $(wc -l < "$tmp/meta-with-id") ))
[ "$nnoid" = 0 ] \
  || echo "# $nnoid row(s) of '$RAD ls' name a repo with no refs/rad/id of its own;" \
          "those repos are judged without a name." >&2
mv "$tmp/meta-with-id" "$tmp/meta"
cut -f1 "$tmp/meta" | sort | uniq -d > "$tmp/meta-twice"
awk -F'\t' 'FILENAME == ARGV[1] { twice[$1] = 1; next } !($1 in twice)' \
  "$tmp/meta-twice" "$tmp/meta" > "$tmp/meta-named"
if [ -s "$tmp/meta-twice" ]; then
  echo "# WARN '$RAD ls --all' listed $(wc -l < "$tmp/meta-twice") repo(s) twice, such as" \
       "$(head -3 "$tmp/meta-twice" | sed 's/^/rad:/' | xargs). A description with a line" \
       "break in it forges rows, and the repo that wrote them usually sits just above them in" \
       "'$RAD ls --all'. These repos go unnamed this run, so the junk-name (A)," \
       "spam-batch (D) and malware (H) rules pass over them." >&2
fi
if [ -s "$tmp/meta-foreign" ]; then
  echo "# WARN '$RAD ls --all' listed $(wc -l < "$tmp/meta-foreign") repo(s) that are not in" \
       "storage, such as $(head -3 "$tmp/meta-foreign" | sed 's/^/rad:/' | xargs). These are" \
       "rows forged by a line break in a description, or repos removed while '$RAD ls' ran." \
       "They are ignored." >&2
fi
# Without this the NAME column goes blank and rule D finds nothing, which looks like no
# spam. Say so.
[ -s "$tmp/meta" ] \
  || echo "# WARN '$RAD ls --all' returned no repos; the spam-batch (D) and malware (H) rules cannot run." >&2

# -------------------------------------------------------------- rule D: generated-bulk batches
# Skeletonise names and descriptions (digit runs to #, random-id tokens to %), group
# repos by name skeleton, and keep groups whose members also agree on one description.
# Rule D at the top of this file says why both signals are needed.
: > "$tmp/spam"; : > "$tmp/spambatch"
if rule_on D; then
  awk -F'\t' -v K="$SPAM_MIN_BATCH" -v D="$SPAM_DESC_AGREE_PCT" -v REQID="$SPAM_REQUIRE_ID" \
             -v BATCHES="$tmp/spambatch" -v SPARED="$tmp/spamspared" \
             -v seenfile="$FIRST_SEEN" -v now="$now" '
    BEGIN { while ((getline line < seenfile) > 0) {
              split(line, f, "\t")
              if (f[2] ~ /^[0-9]+$/) seen[f[1]] = f[2]
            } }
    FILENAME == ARGV[1] { twice[$1] = 1; next }
    # A random id is 6+ hex characters with a letter and a digit. Requiring a letter keeps
    # a date suffix (release-202401) an enumeration.
    function cls(t) {
      if (length(t)>=6 && t ~ /^[0-9a-f]+$/ && t ~ /[a-f]/ && t ~ /[0-9]/) return "%"
      if (t ~ /^[0-9]+$/) return "#"
      gsub(/[0-9]+/,"#",t); return t     # ordinary word: only its digits vary (widget2000)
    }
    function skel(s,   i,c,out,tok,n) {
      s=tolower(s); out=""; tok=""; n=length(s)
      for (i=1;i<=n+1;i++) {
        c=(i<=n)?substr(s,i,1):""
        if (c ~ /^[0-9a-z]$/) { tok=tok c; continue }
        if (tok!="") { out=out cls(tok); tok="" }
        out=out c
      }
      gsub(/[[:space:]]+/," ",out); gsub(/^ | $/,"",out); return out
    }
    # Group with # and % collapsed, because a random hex token is all digits about 2% of the
    # time ("chunk-1-96180521") and would split a batch. Whether a batch has a real id slot
    # is tracked per batch.
    function loose(x) { gsub(/[#%]/,"*",x); return x }
    {
      N++; rid[N]=$1
      sn=skel($2); nl[N]=loose(sn); dl[N]=loose(skel($3))
      cnt[nl[N]]++
      # Either row of a repo listed twice may be forged, so it agrees with no description and
      # never counts towards the batch size: it can only lower the agreement.
      if ($1 in twice) { forged[N]=1; next }
      real[nl[N]]++
      if (index(sn,"%")) hasid[nl[N]]=1
      pair[nl[N] SUBSEP dl[N]]++
    }
    END {
      # awk leaves `for (k in ...)` order unspecified, so ties break on the description text;
      # otherwise one seed could produce two different plans.
      for (k in pair) {
        split(k,q,SUBSEP)
        if (pair[k]>best[q[1]] || (pair[k]==best[q[1]] && q[2]<bestd[q[1]]))
          { best[q[1]]=pair[k]; bestd[q[1]]=q[2] }
      }
      for (n in cnt) {
        if (real[n] < K)                     continue   # too few to be a template
        if (REQID+0==1 && !(n in hasid))     continue   # no machine-generated id in it
        if (index(n,"*")==0)                 continue   # nothing varies: not a template at all
        if (bestd[n]=="")                    continue   # no description: only ONE signal
        if (best[n]*100 < D*cnt[n])          continue   # members disagree on the description
        good[n]=1
      }
      # Only members carrying the agreed description, so an outlier sharing the name shape is
      # left alone.
      for (i=1;i<=N;i++)
        if (!(i in forged) && nl[i] in good && dl[i]==bestd[nl[i]]) member[i]=1
      # The member this seed saw first is spared as the one the rest copy. Otherwise four
      # repos shaped like an honest project would put that project in the plan. A pusher
      # cannot backdate first-seen. A batch that arrived in one run shares one time, so then
      # none is spared.
      for (i in member) {
        seenat = (rid[i] in seen) ? seen[rid[i]] : now; batch = nl[i]
        if (!(batch in early) || seenat < early[batch]) {
          early[batch] = seenat; firstof[batch] = i; tied[batch] = 0
        } else if (seenat == early[batch]) tied[batch] = 1
      }
      for (i=1;i<=N;i++) {
        if (!(i in member)) continue
        if (firstof[nl[i]] == i && !tied[nl[i]]) { print rid[i] > SPARED; continue }
        print rid[i]; batchsize[nl[i]]++
      }
      for (n in batchsize) printf "%d\t%s\n", batchsize[n], n > BATCHES
    }' "$tmp/meta-twice" "$tmp/meta" > "$tmp/spam" || true
fi
nspam=$(wc -l < "$tmp/spam"); nspambatch=$(wc -l < "$tmp/spambatch")
# Said, so a spammer who pushes one member early to keep it shows up in the output.
if [ -s "$tmp/spamspared" ]; then
  nspamspared=$(wc -l < "$tmp/spamspared")
  spamspared_ids=$(head -3 "$tmp/spamspared" | sed 's/^/rad:/' | xargs)
  if [ "$nspamspared" = 1 ]; then
    header_line spam "spared 1 repo as the first of its batch: $spamspared_ids"
  elif [ "$nspamspared" -le 3 ]; then
    header_line spam "spared $nspamspared repos as the first of their batch: $spamspared_ids"
  else
    header_line spam "spared $nspamspared repos as the first of their batch, such as" \
                     "$spamspared_ids"
  fi
fi
if [ "$nspam" -gt 0 ]; then
  header_line spam "$(count "$nspambatch" template templates) matching $nspam repos," \
                   "before the age and seed checks:"
  sort -k1,1nr "$tmp/spambatch" \
    | awk -F'\t' -v n="$top_evidence" 'NR<=n {printf "#        %5d  %s\n", $1, $2}'
  [ "$nspambatch" -gt "$top_evidence" ] \
    && echo "#        ...and $((nspambatch - top_evidence)) more (PLAN_FULL=1 lists them)"
fi

# --------------------------------------------------------------------- rid -> other-seed count
"$RAD" node routing --json 2>/dev/null \
  | jq -r --arg us "$OUR_NID" 'select(.nid != $us) | (.rid|sub("^rad:";""))' \
  | sort | uniq -c | awk '{print $2"\t"$1}' > "$tmp/seeds" || true
# An empty routing table makes every seed count read 0, so the rules that keep the last copy
# could only spare everything. Abort instead of reporting a misleading plan. A check holds
# every seed floor at 0, so it needs no table.
[ -s "$tmp/seeds" ] || [ "$CMD" = check-mine ] || {
  echo "# ABORT($mode): routing table empty via '$RAD' (home=$RAD_HOME)." >&2
  echo "# Every seed count would read 0, so the rules that keep the last copy could prune" \
       "nothing." >&2
  exit 5
}

# ----------------------------------------------------------------- scan: size, mtime, activity
# Size comes from one du and mtime from one find. The per-repo work (ref dates, delegates) runs
# across $JOBS workers, so the classify loop spawns nothing per repo. The scan races a live
# node, where a repo can vanish or turn unreadable mid-walk and make find or du exit non-zero.
# Collect those errors and never let one abort the run.
scanerr="$tmp/scan-errors"; : > "$scanerr"
nrepos=$(find "$STORAGE" -mindepth 1 -maxdepth 1 -type d 2>>"$scanerr" | wc -l) || true

progress_start "sizes" "$nrepos" "$tmp/du"
find "$STORAGE" -mindepth 1 -maxdepth 1 -type d -print0 2>>"$scanerr" \
  | xargs -0r -P "$JOBS" -n 64 du -sb --apparent-size 2>>"$scanerr" > "$tmp/du" || true
progress_stop
find "$STORAGE" -mindepth 1 -maxdepth 1 -type d -printf '%f\t%T@\n' 2>>"$scanerr" \
  > "$tmp/mtimes" || true

# What storage and the quarantine hold on the disk free space is read from, for history.log,
# in apparent size like the scan so runs compare like for like. A quarantine on another
# filesystem takes nothing from this one's free space.
used_bytes=$(awk -F'\t' '{ s += $1 } END { printf "%.0f", s }' "$tmp/du")
quar_bytes=0
if [ -d "$quar" ] && [ "$(stat -L -c %d "$quar")" = "$(stat -L -c %d "$STORAGE")" ]; then
  # du prints the total even when it cannot read a file, then exits 1.
  quar_bytes=$(du -sb "$quar/" 2>/dev/null | cut -f1) || true
fi
used_gb=$(awk -v s="$used_bytes" -v q="${quar_bytes:-0}" 'BEGIN { printf "%.1f", (s + q) / 1e9 }')
# Free space lost since the last history.log line, minus what storage and the quarantine grew,
# is what something else on the disk took. A line older than DISK_DROP_BASELINE_DAYS, or
# written before these fields existed, is skipped.
last_hist=$(grep -v '^#' "$AUDIT_DIR/history.log" 2>/dev/null | tail -1) || true
prev_free=$(grep -oE 'free_gb=[0-9.]+' <<<"$last_hist" | cut -d= -f2) || true
prev_used=$(grep -oE 'used_gb=[0-9.]+' <<<"$last_hist" | cut -d= -f2) || true
prev_ts=${last_hist%%$'\t'*}
prev_at=$(date -u -d "$prev_ts" +%s 2>/dev/null) || prev_at=0
if [ "$DISK_AWARE" = 1 ] && [ -n "$prev_free" ] && [ -n "$prev_used" ] \
   && [ "$prev_at" -ge $(( now - DISK_DROP_BASELINE_DAYS*86400 )) ]; then
  elsewhere_gb=$(awk -v pf="$prev_free" -v f="$free_gb" -v pu="$prev_used" -v u="$used_gb" \
                   'BEGIN { printf "%.1f", (pf - f) - (u - pu) }')
  if awk -v e="$elsewhere_gb" -v w="$DISK_DROP_WARN_GB" 'BEGIN { exit !(e > w) }'; then
    echo "# WARN free space fell from ${prev_free} to ${free_gb} GB since ${prev_ts}," \
         "${elsewhere_gb} GB more than storage and the quarantine grew by. Something else" \
         "on this disk took it, and pressure=${press_pct}% is read from that one sample of" \
         "free space." >&2
  fi
fi

# Feeds every per-repo worker after the scan, minus repos the cache already answers for, so
# what a rule reads and what it reuses stay visible in one place.
# Biggest-repo-first in smaller chunks was tried and reverted: 56s slower on a 538s run, as the
# giants contend for IO at once and the extra spawns outweigh the tail latency saved.
# batch_size shrinks chunks only for a phase too small to give every worker several.
repos_to_read() {                 # $1 = file listing rids the cache already answers for
  # A shell loop prefixes $STORAGE, not sed, because it is operator-supplied: a '#' or '&' in
  # it breaks the sed expression into a list that excludes nothing, so every repo is walked
  # again AND its cached rows are appended beside the fresh ones.
  local rid
  while IFS= read -r rid; do printf '%s/%s\n' "$STORAGE" "$rid"; done \
    < "$1" > "$tmp/cached-paths"
  find "$STORAGE" -mindepth 1 -maxdepth 1 -type d -print0 2>>"$scanerr" \
    | grep -zvxFf "$tmp/cached-paths"
}
{ printf '#!/usr/bin/env bash\n'; declare -f read_delegates
  printf 'our_nid=%q\n' "$OUR_NID"; printf 'now=%s\n' "$now"; cat <<'LIFE'
# The ref listing goes to a file, since one real repo has 152k refs. It is read for the dates
# and signed refs, and again for the run cache fingerprint.
t=$(mktemp) || exit 1
trap 'rm -f "$t"' EXIT
re_private='"visibility":\{("allow":\[[^]]*\],)?"type":"private"\}\}$'
for d; do
  GIT_DIR="$d" git for-each-ref --sort=creatordate \
    --format='%(creatordate:unix) %(objectname) %(refname)' 2>/dev/null > "$t" || true
  # Only a numeric creatordate counts. refs/rad/sigrefs points at a blob with no creatordate,
  # so awk reads its OBJECT ID as field 1, and that id reaching an arithmetic test would leave
  # every age rule unable to judge the repo. --sort keeps the dated refs in order, so the first
  # is the oldest and the last the newest. The length bound stops an all-decimal object id
  # passing as a 30-digit date. 0 is reserved for refs that would not list. A date over a week
  # past this seed's clock is dropped, or a ref dated 3000 keeps the repo active and out of
  # rules B and C for good; a week covers a fast clock.
  # Refs that list with no usable date print "u", which the run replaces with the day it first
  # saw the repo, or commits dated 1970 would keep the repo out of rules D and F and count it
  # against the scan guard.
  # The same awk lists every node that signed refs here, which only that node can do. The ref
  # name is the last field and holds no space. One awk for both, because this walk reads every
  # repo every run and each process per repo costs about 1ms of CPU.
  read -r birth last signed < <(awk -v ahead=$(( now + 7 * 86400 )) '
      $1 ~ /^[1-9][0-9]*$/ && length($1) <= 11 && $1 + 0 <= ahead { if (b == "") b = $1; l = $1 }
      $NF ~ /^refs\/namespaces\/[^\/]+\/refs\/rad\/sigrefs$/ {
        split($NF, p, "/"); signed = signed " " p[3] }
      END { if (b != "")     printf "%s %s%s\n", b, l, signed
            else if (NR > 0) printf "u u%s\n", signed
            else             printf "0 0%s\n", signed }' \
    "$t")
  refhash=$(sha1sum < "$t"); refhash=${refhash%% *}
  # The delegates, for the deny list.
  read_delegates "$d"
  # Delegates who signed refs of their own here, for rule H. Anybody can be named a delegate,
  # but only that delegate can sign under their own namespace.
  signers=""
  for nid in $signed; do
    case " $dids " in (*" $nid "*) signers="$signers${signers:+,}$nid" ;; esac
  done
  # Ours or private, read from the repo itself so a misread `rad ls` is not the only guard.
  # Ours when this node signed refs here, which nobody else can do; a delegate list naming us
  # is not enough, since anybody can publish one.
  # Private when the document ends on a private visibility as rad writes it. Only the top-level
  # object's last member can end right before the final "}", since a JSON string cannot hold an
  # unescaped quote. A document written otherwise goes to jq if it spells or escapes "private".
  vis=-
  if [[ " $signed " == *" $our_nid "* ]]; then vis=ours
  elif [[ $iddoc =~ $re_private ]]; then vis=private
  elif [[ $iddoc == *private* || $iddoc == *\\* ]] \
       && jq -e '.visibility.type == "private"' <<<"$iddoc" >/dev/null 2>&1; then vis=private
  fi
  # The delegates go last: they may be empty, and `read` with a tab IFS folds an empty field
  # into the next one.
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "${d##*/}" "${birth:-0}" "${last:-0}" "$refhash" \
         "$vis" "${signers:--}" "${dids// /,}"
done
LIFE
} > "$tmp/life.sh"
progress_start "activity" "$nrepos" "$tmp/lives"
find "$STORAGE" -mindepth 1 -maxdepth 1 -type d -print0 2>>"$scanerr" \
  | xargs -0r -P "$JOBS" -n 64 "$BASH_BIN" "$tmp/life.sh" > "$tmp/lives" || true
progress_stop

# ------------------------------------------------------------------------------- the run cache
# Rules F and G and the denied-file search walk every repo's contents, most of a run's cost.
# Their per-repo output is reused for any repo whose refs and size are both unchanged since the
# run that wrote it.
# Refs alone miss objects arriving while no ref moves; size alone misses a branch deleted or
# force-pushed onto objects already there. A needless miss costs only time.
# FILENAME, not NR == FNR: with an empty first file that test also matches the second file's
# first line, and eats a repo.
awk -F'\t' -v du="$tmp/du" \
    'FILENAME == du { n = split($2, a, "/"); size[a[n]] = $1; next }
     { print $1 "\t" $4 "-" (size[$1] + 0) }' "$tmp/du" "$tmp/lives" \
  | sort > "$tmp/keys"

# A change to the script or its settings drops the whole cache, so a tuned threshold cannot
# leave last week's verdicts standing. One comparison is easier to trust than 11,000 keys.
# The settings are found by grepping this file for env vars with a default, so a knob added
# later is covered without being listed here. Hashing the whole environment was rejected:
# systemd's per-start INVOCATION_ID made hand and cron runs invalidate each other, a full
# uncached run each time.
# The skipped names cannot change a verdict: how work is done or printed, which service
# restarts, which bash runs workers (hand and cron may resolve different paths to one shell),
# and the HOME a default RAD_HOME comes from (RAD_HOME is hashed as resolved). HOME also picks
# git's user config, but hashing HOME never covered that file's contents.
skip='JOBS|CACHE|PLAN_FULL|PLAN_COLLAPSE_ROWS|SERVICE|PROGRESS_SECS|BASH|HOME'
# These act only on a built plan or its repos, and no cache-writing worker reads them, so
# lowering a cap for one careful run must not cost a full uncached read.
skip+='|MAX_PRUNE_COUNT|MAX_PRUNE_GB|MAX_SCAN_FAIL_PCT'
skip+='|RATCHET_FACTOR|RATCHET_RUNS|RATCHET_FLOOR'
skip+='|UNDO|UNDO_MAX_COUNT|UNDO_MAX_GB|QUARANTINE|QUARANTINE_DAYS|NEAR_PCT'
# Whether rule H's verdicts join the plan. No worker reads it.
skip+='|MALWARE_PRUNE'
knobs=$(grep -oE '\$\{[A-Z_][A-Z0-9_]*[:-]' "$SELF" 2>/dev/null \
        | tr -d '${:-' | grep -vxE "$skip" | sort -u)
fingerprint=$( { sha1sum < "$SELF"
                 for k in $knobs; do printf '%s=%s\n' "$k" "${!k-}"; done; } \
               | sha1sum | cut -c1-40 )

cache_ok=0
if [ "$CACHE" = 1 ]; then
  [ "$(cat "$CACHE_DIR/fingerprint" 2>/dev/null)" = "$fingerprint" ] && cache_ok=1
  # With $SELF unreadable, the fingerprint rests on knob values alone, and an edited script
  # would reuse the verdicts it was edited to change.
  [ -r "$SELF" ] || { cache_ok=0; echo "# cache  cannot read $SELF, so nothing is reused" >&2; }
  [ "$cache_ok" = 1 ] \
    || echo "# cache  cold, so every repo is read (the script or its settings changed)" >&2
fi

# Stamped here, before any rule runs, with the stale key files removed, so a rule that never
# finishes leaves no key file and its repos are read again. Stamped per rule, a run dying
# between rules would leave a warm-looking cache with keys from the previous settings.
if [ "$CACHE" = 1 ] && [ "$cache_ok" = 0 ] && mkdir -p "$CACHE_DIR" 2>/dev/null; then
  rm -f "$CACHE_DIR"/keys-* 2>/dev/null || true
  # Files left by the link-farm rule (E), which 0.8.0 removed. A new version always runs cold,
  # so this runs once after upgrading. Only beside hosts-code, which only that rule wrote,
  # since CACHE_DIR may be any directory with a "hosts" of its own. Revisit (drop it) once no
  # supported seed can still run a release older than 0.8.0.
  if [ -e "$CACHE_DIR/hosts-code" ]; then
    rm -f "$CACHE_DIR/hosts" "$CACHE_DIR/hosts-code" "$CACHE_DIR/hosts-fail" \
          "$CACHE_DIR/hosts-unwalked" 2>/dev/null || true
  fi
  printf '%s\n' "$fingerprint" > "$CACHE_DIR/fingerprint" 2>/dev/null \
    || echo "# WARN could not write $CACHE_DIR/fingerprint; the cache stays cold" >&2
fi

# One key file per rule, listing the repos IT answered for, so a repo a dying worker never
# finished has no key and is read again next run.
cache_hits() {                      # $1 = rule's cache name; writes the rids it can reuse
  : > "$tmp/cached-$1"
  # A check reads only the repos it judges. The rest count as cached, with no rows.
  if [ "$CMD" = check-mine ]; then
    cut -f1 "$tmp/keys" | grep -xFf "$tmp/excluded" > "$tmp/cached-$1" || true
    return 0
  fi
  [ "$cache_ok" = 1 ] || return 0
  awk -F'\t' -v old="$CACHE_DIR/keys-$1" \
      'FILENAME == old { k[$1] = $2; next } ($1 in k) && k[$1] == $2 { print $1 }' \
      "$CACHE_DIR/keys-$1" "$tmp/keys" > "$tmp/cached-$1" 2>/dev/null || : > "$tmp/cached-$1"
  echo "# cache  $1 reuses $(wc -l < "$tmp/cached-$1") of $(wc -l < "$tmp/keys") repos" >&2
}
# Repos the rule still has to read; its progress line counts against this.
repos_left() {                      # $1 = rule's cache name, after cache_hits has run for it
  echo $(( $(wc -l < "$tmp/keys") - $(wc -l < "$tmp/cached-$1") ))
}
# Dead workers answer for fewer repos than their phase was given, and the rule then judges only
# the rest while the plan looks normal, so warn.
# $1 = what the phase is, $2 = repos it had to read, then the files it writes one line per repo
phase_shortfall() {
  local what=$1 want=$2 got
  shift 2
  got=$(cut -f1 "$@" 2>/dev/null | sort -u | wc -l)
  [ "$got" -ge "$want" ] \
    || echo "# WARN the $what read $got of the $want repos it had to; it judged only those." >&2
}
# Repos per worker call for a phase reading $1 repos. Up to 32 keeps bash startup small on a
# long phase. A small phase gets fewer, so every worker gets about four calls and 10 repos do
# not run one after another on one core while the rest idle.
batch_size() {
  # JOBS=0 is xargs' "as many at once as it likes", which still needs a share per call here.
  local workers=$JOBS
  [ "$workers" -ge 1 ] || workers=1
  local per=$(( ($1 + workers * 4 - 1) / (workers * 4) ))
  [ "$per" -le 32 ] || per=32
  [ "$per" -ge 1 ] || per=1
  echo "$per"
}
cache_reuse() {   # $1 = stream name, $2 = field holding the rid, $3 = rule whose hits to use
  [ "$cache_ok" = 1 ] && [ -s "$CACHE_DIR/$1" ] || return 0
  awk -F'\t' -v f="$2" -v hits="$tmp/cached-$3" \
      'FILENAME == hits { c[$0] = 1; next } ($f in c)' \
      "$tmp/cached-$3" "$CACHE_DIR/$1" 2>/dev/null || true
}
# A failed data write is recorded so the key write below can refuse. Otherwise the keys certify
# rows the data file never got, and the next run reuses a stale measurement. AUDIT_DIR defaults
# to storage's filesystem, which is filling when this runs, so the big data write can hit
# ENOSPC while the small key write fits. Temp files carry the pid, since a dry run takes no
# lock and may write the cache while --apply does.
cache_failed=""
cache_save() {                      # $1 = stream name, $2 = file holding this run's version
  [ "$CACHE" = 1 ] || return 0
  mkdir -p "$CACHE_DIR" 2>/dev/null || { cache_failed="$cache_failed $1"; return 0; }
  cat "$2" > "$CACHE_DIR/$1.new.$$" 2>/dev/null && mv "$CACHE_DIR/$1.new.$$" "$CACHE_DIR/$1" \
    || { cache_failed="$cache_failed $1"
         rm -f "$CACHE_DIR/$1.new.$$" 2>/dev/null
         echo "# WARN could not write the run cache at $CACHE_DIR" >&2; }
}
cache_save_keys() {                 # $1 = rule's cache name, $2 = rids it answered for
  [ "$CACHE" = 1 ] || return 0
  # Any failed stream drops this rule's keys, so the next run reads those repos again. A lost
  # cache costs one slow run; a key outliving its data can prune on evidence two runs old.
  if [ -n "$cache_failed" ]; then
    rm -f "$CACHE_DIR/keys-$1" 2>/dev/null || true
    echo "# WARN cache write failed ($cache_failed); next run re-reads every repo" >&2
    return 0
  fi
  mkdir -p "$CACHE_DIR" 2>/dev/null || return 0
  awk -F'\t' -v ans="$2" 'FILENAME == ans { a[$0] = 1; next } ($1 in a)' \
      "$2" "$tmp/keys" \
    > "$CACHE_DIR/keys-$1.new.$$" 2>/dev/null \
    && mv "$CACHE_DIR/keys-$1.new.$$" "$CACHE_DIR/keys-$1" \
    || { rm -f "$CACHE_DIR/keys-$1.new.$$" 2>/dev/null
         echo "# WARN could not write the run cache at $CACHE_DIR" >&2; return 0; }
}

# ----------------------------------------------------------------------- rule F: measure trees
# Per repo, the bytes of media and of everything else. Extensions are a fast path only; a
# file's first 16 bytes decide, so renaming a video to .dat does not hide it, and they are read
# only while the repo could still be a dump. A repo that could not be read goes to fd 4 and is
# never judged on a partial listing.
: > "$tmp/media"; : > "$tmp/media-fail"
mkdir -p "$tmp/blobs"
if rule_on F; then
  cat > "$tmp/media.sh" <<MEDIA
#!/usr/bin/env bash
$(declare -f read_delegates is_media is_archive unhex did_key_hex delegate_ops)
media_exts='$MEDIA_EXTS'
text_exts='$MEDIA_TEXT_EXTS'
text_names='$MEDIA_TEXT_NAMES'
# The wider of the two budgets: text over it means neither verdict can fire.
text_ceil=$(( MEDIA_TEXT_MAX_BYTES > MEDIA_TEXT_CEIL_BYTES ? MEDIA_TEXT_MAX_BYTES \
                                                           : MEDIA_TEXT_CEIL_BYTES ))
sniff_big=$MEDIA_SNIFF_TEXT_BYTES
sniff_max=$MEDIA_SNIFF_MAX_FILES
text_max=$MEDIA_TEXT_MAX_BYTES
max_refs=$MEDIA_MAX_REFS
MEDIA_MAX_OPS=$MEDIA_MAX_OPS
tip_bytes=$MEDIA_TIP_BYTES
archive_exts='$MEDIA_ARCHIVE_EXTS'
source_exts='$MEDIA_SOURCE_EXTS'
build_names='$MEDIA_BUILD_NAMES'
media_min=$MEDIA_MIN_BYTES
# One file per worker, so parallel writers appending blob ids cannot interleave a line.
blobs=$tmp/blobs/\$\$
# Where delegate_ops writes the keys and signatures it hands to openssl.
work=$tmp/ops.\$\$
mkdir -p "\$work"
MEDIA
  cat >> "$tmp/media.sh" <<'MEDIA'
# The files the given trees hold, as "<oid> <size> <path>". A branch or tag comes in as
# "<ref>^{tree}", listing what it holds now. An issue or patch comes in as its ops' trees, as
# each op's commit holds only that op's files and the tip alone misses earlier attachments. A
# missing tree fails the walk and the repo goes unjudged, since skipping it reads as a repo
# holding less. %(rest) carries each path from rev-list through cat-file.
files_in() {
  local d=$1; shift
  [ $# -gt 0 ] || return 0
  # Refs go in on stdin, since a COB-heavy repo has thousands and argv has a size limit. The
  # filter keeps trees and commits, two thirds of a COB walk, out of the reader.
  printf '%s\n' "$@" \
    | GIT_DIR="$d" git rev-list --objects --stdin --filter=object:type=blob 2>/dev/null \
    | GIT_DIR="$d" git cat-file \
        --batch-check='%(objectname) %(objecttype) %(objectsize) %(rest)' 2>/dev/null \
    | awk '$2 == "blob" { path = $0; sub(/^[^ ]+ [^ ]+ [^ ]+ /, "", path)
                          printf "%s %.0f %s\n", $1, $3, path }'
  # A lister dying part-way emits a SHORT list, which reads as less text, the direction that
  # condemns, so print "torn" and the classifier drops the repo. 141 is SIGPIPE from the
  # classifier stopping once text exceeds every budget, which is no tear. The awk's own status
  # is checked too: a gigabyte tree entry name can get it killed for memory, and the git stages
  # before it then exit 141, which alone would read as no tear.
  local lister=${PIPESTATUS[1]} reader=${PIPESTATUS[2]} shaper=${PIPESTATUS[3]}
  case $lister in 0|141) ;; *) echo torn; return ;; esac
  case $reader in 0|141) ;; *) echo torn; return ;; esac
  case $shaper in 0|141) ;; *) echo torn ;; esac
}
# Totals for the given trees of repo $d, as "= <media> <text> <unknown> <av>" on the last line,
# after a line per file still to read ("? <oid> <size>", or "z" for compressed data) and per
# media file ("m <oid> <size>"). av is media that is not an archive.
# A known text file over sniff_big is read too, or a video named README.md would both hide
# itself and blow the text budget that spares the repo.
measure() {
  files_in "$d" "$@" \
    | awk -v m="$media_exts" -v t="$text_exts" -v tn="$text_names" -v big="$sniff_big" \
          -v ceil="$text_ceil" -v arc="$archive_exts" '
        # index, not a regex: a file literally called "[" would not compile as one.
        function known(list, key) { return index("|" list "|", "|" key "|") > 0 }
        $1 == "torn" { torn = 1; next }
        {
          oid = $1; size = $2 + 0
          if (oid in seen) next
          seen[oid] = 1
          # A path may hold spaces, so take everything past the first two fields, not $NF.
          # "clip.mp4 0" must not read as the digit name of a COB op.
          base = $0; sub(/^[^ ]+ [^ ]+ /, "", base)
          sub(/^.*\//, "", base); base = tolower(base)
          ext = ""; if (match(base, /\.[a-z0-9]+$/)) ext = substr(base, RSTART + 1)
          # A .csv.gz or .json.gz is read before it is judged. By .gz alone a gzipped CSV would
          # count as media, and by its inner name a video called clip.csv.gz would pass as
          # text.
          if (ext == "gz" && match(base, /\.[a-z0-9]+\.gz$/) &&
              known(t, substr(base, RSTART + 1, RLENGTH - 4)))
            { printf "z %s %.0f\n", oid, size; unk += size; next }
          if (ext != "" && known(m, ext) && size > 0) {
            media += size; if (!known(arc, ext)) av += size
            printf "m %s %.0f\n", oid, size; next
          }
          # COB op payloads (0, 1, 2 and so on) are JSON and number in the millions, so reading
          # them would be most of the cost of this rule. Anything over sniff_big is still read.
          if (size < big && (base ~ /^[0-9]+$/ || known(tn, base) ||
                             (ext != "" && known(t, ext)))) {
            text += size
            # Past the widest budget no unread file can change the verdict, so stop. On the
            # mirror of a real project that is a few files in. exit still runs END.
            if (text >= ceil) exit 0
            next
          }
          printf "? %s %.0f\n", oid, size; unk += size
        }
        END { if (torn) exit 1
              printf "= %.0f %.0f %.0f %.0f\n", media, text, unk, av }'
}
for d; do
  rid=${d##*/}
  # --count stops one ref past the cap, which detects the cap and keeps a 152k-ref repo out of
  # a variable. First, so a repo over the cap costs only this call.
  allrefs=$(GIT_DIR="$d" git for-each-ref --count=$(( max_refs + 1 )) \
              --format='%(refname)' 2>/dev/null) || { echo "$rid" >&4; continue; }
  mapfile -t refs <<<"$allrefs"
  [ "${#refs[@]}" -le "$max_refs" ] || { echo "$rid" >&4; continue; }
  # A dump hides as well in an issue attachment as in a commit, so the repo's OWN COBs count.
  # Own is decided by refs/rad/id, which the node writes only after verifying its signatures,
  # so a stranger's push cannot move it. Without readable delegates the repo goes unjudged,
  # since its uncounted issues and branches mean less text, which reads as a dump.
  read_delegates "$d"
  [ -n "$dids" ] || { echo "$rid" >&4; continue; }
  # Only refs the delegates control: canonical branches and tags, plus the delegates' own
  # namespaces and COBs. Another peer's push is no evidence about this repo, so it can neither
  # condemn nor spare it. Branches and tags get "^{tree}" so files_in lists what they hold now.
  # COB refs go to delegate_ops, which returns the trees of ops a delegate signed, because a
  # COB's history also holds what everybody else wrote.
  # $tips is the branches and tags without refs/rad/ metadata, the files a person calls the
  # project's.
  ours=""; tips=""; cobs=()
  for ref in "${refs[@]}"; do
    case $ref in
      refs/heads/*|refs/tags/*) ours="$ours $ref^{tree}"; tips="$tips $ref^{tree}"; continue ;;
      refs/cobs/*)              cobs+=("$ref"); continue ;;
      refs/namespaces/*)
        nid=${ref#refs/namespaces/}; nid=${nid%%/*}
        case " $dids " in (*" $nid "*) ;; (*) continue ;; esac ;;
      *) continue ;;
    esac
    case $ref in
      */refs/cobs/*)                cobs+=("$ref") ;;
      */refs/heads/*|*/refs/tags/*) ours="$ours $ref^{tree}"; tips="$tips $ref^{tree}" ;;
      *)                            ours="$ours $ref^{tree}" ;;
    esac
  done
  if [ -z "${ours// /}" ] && [ "${#cobs[@]}" = 0 ]; then
    printf '%s\t0\t0\t0\t-\t-\t-\t0\t0\n' "$rid"; continue
  fi
  sums=$(measure $ours)
  read -r tag media text unk av <<<"${sums##*$'\n'}"
  # COBs only while the branches leave room for a verdict. Past text_ceil they cannot change
  # it, and checking op signatures is most of the cost of a repo with thousands of ops.
  if [ "$tag" = "=" ] && [ "$text" -lt "$text_ceil" ] && [ "${#cobs[@]}" -gt 0 ]; then
    ops=$(delegate_ops "$d" "$work" "${cobs[@]}")
    case $'\n'$ops$'\n' in (*$'\n'torn$'\n'*) echo "$rid" >&4; continue ;; esac
    sums=$(measure $ours $ops)
    read -r tag media text unk av <<<"${sums##*$'\n'}"
  fi
  # measure prints "=" last, so anything else means it died part-way. A fragment is no
  # evidence, so report the repo and keep it out of the batch corpus and its own verdict.
  [ "$tag" = "=" ] || { echo "$rid" >&4; continue; }
  # The media this repo holds, as rows for the batch corpus.
  held=$(awk -v rid="$rid" '$1=="m" { printf "%s\t%s\t%s\n", $2, rid, $3 }' <<<"$sums")
  # Once text clears the widest budget, no unread file can change the verdict.
  if [ "$text" -lt "$text_ceil" ]; then
    n=0; unread=0
    while read -r kind oid size; do
      n=$((n+1))
      # The biggest files are read first, so the cap leaves only the smallest unread.
      if [ "$n" -gt "$sniff_max" ]; then unread=$((unread+size)); continue; fi
      # od closes the pipe after 16 bytes and git dies of SIGPIPE, so a 500MB video costs a few
      # pipe buffers. Stripping spaces in bash saves a fork per file.
      hex=""; unpacked=""
      if [ "$kind" = z ]; then
        # A compressed file is judged by what it unpacks to. Only its first 64 KiB is unpacked,
        # because a few KiB of gzip can unpack to gigabytes, and only 512 unpacked bytes are
        # kept: enough to see a media signature, or the NUL bytes no text file has.
        unpacked=$(GIT_DIR="$d" git cat-file blob "$oid" 2>/dev/null | head -c 65536 \
                     | gzip -dc 2>/dev/null | head -c 512 | od -An -tx1 -v)
        unpacked=${unpacked//[$' \n']/}
        hex=${unpacked:0:32}
      fi
      # A file that does not unpack is judged by its own bytes.
      if [ -z "$hex" ]; then
        hex=$(GIT_DIR="$d" git cat-file blob "$oid" 2>/dev/null | od -An -tx1 -N16 -v)
        hex=${hex//[$' \n']/}
      fi
      if is_media "$hex"; then
        media=$((media+size))
        is_archive "$hex" || av=$((av+size))
        held="$held${held:+$'\n'}$oid"$'\t'"$rid"$'\t'"$size"
      elif [[ $unpacked =~ ^(..)*00 ]] \
           && [[ $unpacked != fffe* && $unpacked != feff* && $unpacked != 0000feff* ]]; then
        # Binary behind a text name, such as a tar of videos named notes.txt.gz, counts as
        # media like an archive. UTF-16 and UTF-32 text holds NULs too, and counts as text when
        # it opens with a byte-order mark.
        media=$((media+size))
        held="$held${held:+$'\n'}$oid"$'\t'"$rid"$'\t'"$size"
      else
        text=$((text+size))
      fi
    done < <(awk '$1=="?" || $1=="z"' <<<"$sums" | sort -k3,3nr)
    # Files past the cap may be media or text. Counting them as text could hide a dump behind
    # its smallest files, so that is done only where it cannot change the verdict: text stays
    # under MEDIA_TEXT_MAX_BYTES with them in, the text read already clears the widest budget,
    # or as media they would still leave the repo under MEDIA_MIN_BYTES. Otherwise the repo
    # goes unjudged, since a project must not be judged on what nobody read.
    if [ "$unread" -gt 0 ]; then
      if [ $(( text + unread )) -lt "$text_max" ] || [ "$text" -ge "$text_ceil" ] \
         || [ $(( media + unread )) -lt "$media_min" ]; then
        text=$(( text + unread ))
      else
        echo "$rid" >&4; continue
      fi
    fi
  else
    text=$((text + unk))
  fi
  # Only a repo with room for a batch verdict adds to the batch corpus. Counting a listing cut
  # short would make a stock icon common or rare by how a project's files sort.
  if [ "$text" -lt "$text_ceil" ] && [ -n "$held" ]; then
    printf '%s\n' "$held" >> "$blobs"
  fi
  # The files at the branch and tag tips, by path: whether a source and a build file are there,
  # and, for the ratio path, the non-media file count, the READMEs among them, and the media
  # bytes. measure cannot tell, because rev-list names a blob once by the first path it met, so
  # an empty Makefile may go by another empty file's name and two copies of one README count
  # once. Listed only where a verdict could still fire. A failed listing leaves the repo
  # unjudged, since a missed name condemns. "-" means not listed.
  src=0; build=0; others=-; readmes=-; tipmedia=-
  if [ "$text" -lt "$text_ceil" ] && [ "$media" -ge "$media_min" ] && [ -n "${tips// /}" ]
  then
    # Each distinct tree is listed once, since delegates mostly hold the same branches. -z, or
    # ls-tree quotes a non-ASCII name and "café/main.py" ends in a quote. Streamed into awk, as
    # a thousand releases of one big tree list it a thousand times.
    trees=$(GIT_DIR="$d" git rev-parse $tips 2>/dev/null) || { echo "$rid" >&4; continue; }
    printf '%s\n' "$held" | cut -f1,3 > "$work/media-oids"
    # A line is "<mode> <type> <oid>", a tab, and the path; "!" is a tree that did not list.
    read -r src build others readmes tipmedia < <(
      for t in $(sort -u <<<"$trees"); do
        GIT_DIR="$d" git ls-tree -r -z "$t" 2>/dev/null || printf '!\0'
      done | tr '\0' '\n' \
        | awk -F'\t' -v src="$source_exts" -v bld="$build_names" -v cap="$tip_bytes" '
        function known(list, key) { return index("|" list "|", "|" key "|") > 0 }
        FILENAME == ARGV[1] { media[$1] = $2; next }
        $0 == "!" { failed = 1; next }
        (listed += length($0) + 1) > cap { failed = 1; exit }
        {
          split($1, head, " "); oid = head[3]; path = substr($0, index($0, "\t") + 1)
          if (oid in media) {
            if (!(oid in weighed)) { weighed[oid] = 1; m += media[oid] }
            next
          }
          base = path; sub(/^.*\//, "", base); base = tolower(base)
          ext = ""; if (match(base, /\.[a-z0-9]+$/)) ext = substr(base, RSTART + 1)
          if (ext != "" && known(src, ext)) s = 1
          if (known(bld, base)) b = 1
          if (path in seen) next
          seen[path] = 1
          # A README.html is a page and a README.sh a script, both something somebody built.
          if (base ~ /^readme(\.(md|markdown|txt|rst|adoc|org))?$/) r++; else o++
        }
        END { if (failed) print "-"; else printf "%d %d %d %d %.0f\n", s, b, o, r, m }' \
        "$work/media-oids" -)
    case $tipmedia in
      (''|-) echo "$rid" >&4; continue ;;
    esac
  fi
  printf '%s\t%d\t%d\t%d\t%s\t%s\t%s\t%d\t%d\n' \
         "$rid" "$media" "$text" "$av" "$others" "$readmes" "$tipmedia" "$src" "$build"
done
MEDIA
  cache_hits media
  # Both files, because an unreadable repo writes only to the failure one, and a phase of them
  # would otherwise look stalled.
  to_read=$(repos_left media)
  progress_start "media (F)" "$to_read" "$tmp/media" "$tmp/media-fail"
  repos_to_read "$tmp/cached-media" \
    | xargs -0r -P "$JOBS" -n "$(batch_size "$to_read")" "$BASH_BIN" "$tmp/media.sh" \
        > "$tmp/media" 4> "$tmp/media-fail" || true
  progress_stop
  phase_shortfall "media rule (F)" "$to_read" "$tmp/media" "$tmp/media-fail"
  # Reused rows go back beside fresh ones so everything downstream, the media-batch corpus
  # above all, sees every repo. A repo gone from storage has no key this run, so its rows
  # cannot come back.
  cache_reuse "media" 1 media      >> "$tmp/media"
  cache_reuse "media-fail" 1 media >> "$tmp/media-fail"
  cache_reuse "blobs" 2 media       > "$tmp/blobs/cached"
  cache_save  "media" "$tmp/media"
  cache_save  "media-fail" "$tmp/media-fail"
  # Through a real file, since cache_save checks cat's status and cat succeeds even when the
  # sort feeding it died, saving a truncated corpus as complete. A failed sort leaves the
  # media-batch verdict nothing to count and marks the cache failed, so the next run reads
  # every repo again.
  if sort -u "$tmp/blobs"/* 2>/dev/null > "$tmp/blobs-all"; then
    cache_save "blobs" "$tmp/blobs-all"
  else
    : > "$tmp/blobs-all"; cache_failed="$cache_failed blobs"
    echo "# WARN could not sort the media files repos share; no repo is pruned as" \
         "media-batch this run." >&2
  fi
  # Each repo read yields a measurement or a failure line, so these list every repo rule F
  # answered for.
  cut -f1 "$tmp/media" "$tmp/media-fail" | sort -u > "$tmp/answered-media"
  cache_save_keys media "$tmp/answered-media"
  nmediafail=$(sort -u "$tmp/media-fail" | wc -l)
  # A repo too big to judge one week usually is the next, and a weekly repeat stops being read,
  # so only repos the last run did not list warn. The last run's file is replaced only at the
  # end. Up to 0.7.0 it was media-unjudged.tsv; without it the first run after upgrading would
  # call every repo new.
  sort -u "$tmp/media-fail" \
    | grep -vxFf <(cat "$AUDIT_DIR/last-run/F-media-unjudged.tsv" \
                       "$AUDIT_DIR/last-run/media-unjudged.tsv" 2>/dev/null \
                     | grep -v '^#' | cut -f1) \
    > "$tmp/media-fail-new" || true
  nmedianew=$(wc -l < "$tmp/media-fail-new")
  # The file listing them all is named where it is written, near the end, since a run that
  # aborts in between never creates it.
  if [ "$nmedianew" -gt 0 ]; then
    {
      if [ "$nmediafail" = 1 ]; then
        echo "# WARN the media rule (F) could not judge 1 repo, new since the last run, and" \
             "did not prune it."
      else
        echo "# WARN the media rule (F) could not judge $nmediafail repos ($nmedianew new" \
             "since the last run) and pruned none of them."
      fi
      which="Each was"; [ "$nmediafail" = 1 ] && which="It was"
      echo "#      $which unreadable or over a limit such as MEDIA_MAX_REFS ($MEDIA_MAX_REFS)" \
           "refs or MEDIA_MAX_OPS ($MEDIA_MAX_OPS) issue and patch ops. New:"
      # Two ids a line, since a column of them buries the lines around it.
      head -n "$top_evidence" "$tmp/media-fail-new" \
        | awk 'NR % 2 { first = $1; next } { printf "#      %-32s %s\n", first, $1 }
               END { if (NR % 2) print "#      " first }'
      [ "$nmedianew" -le "$top_evidence" ] \
        || echo "#      ...and $((nmedianew - top_evidence)) more (PLAN_FULL=1 lists them)"
    } >&2
  elif [ "$nmediafail" -gt 0 ]; then
    echo "# the media rule (F) could not judge $(count "$nmediafail" repo repos)," \
         "all listed by the last run too." >&2
  fi

fi

# ------------------------------------------------------------- copies of denied files: check
# Which repos hold the files DENY_FILES lists. First the object store is asked for every listed
# id at once. That covers every ref and leftover but proves nothing, since any peer's push
# lands there. At about 15us an id per repo, 10,000 ids over 11,000 repos is about half an hour
# of CPU, again whenever the list changes. A store holding COPY_MIN_BYTES of listed media is
# then walked across its delegates' branch and tag history, which ties a file to the delegates.
# A listed file those branches do not reach condemns nothing, or a push could get a repo
# pruned.
: > "$tmp/copy"; : > "$tmp/copy-fail"; : > "$tmp/copy-done"; : > "$tmp/copies"
: > "$tmp/copy-disowned"; : > "$tmp/deny-oids-owned"
if [ -s "$tmp/deny-oid-list" ]; then
  cat > "$tmp/copy.sh" <<COPY
#!/usr/bin/env bash
set -o pipefail
$(declare -f read_delegates delegate_branches is_media is_archive)
ids='$tmp/deny-oid-list'
max_refs=$MEDIA_MAX_REFS
min_bytes=$COPY_MIN_BYTES
COPY
  cat >> "$tmp/copy.sh" <<'COPY'
t=$(mktemp) || exit 1
trap 'rm -f "$t" "$t.hits" "$t.n" "$t.walk"' EXIT
# Rows carry the rid in field 2 for the run cache: "h" a listed file the delegates' branches
# reach, with its size; "n" a listed id that counts for nothing, with why; "p" a repo whose
# listed files no such branch reaches; "=" the end of a repo, with the bytes its delegates'
# branches reach. Rows print only once a repo is checked to the end, so a failure leaves just
# its name on fd 4.
for d; do
  rid=${d##*/}
  # Every listed id the store holds, by any route. A missing one prints "<oid> missing".
  GIT_DIR="$d" git cat-file --batch-check='%(objectname) %(objecttype) %(objectsize)' \
    < "$ids" > "$t" 2>/dev/null || { echo "$rid" >&4; continue; }
  # An id naming a commit, a tree or a tag is a row copied from the wrong place.
  awk -v rid="$rid" '$2 != "blob" && $2 != "missing" {
                       printf "n\t%s\t%s\ta %s, not a file\n", rid, $1, $2 }' "$t" > "$t.n"
  # A row naming a text file by mistake would make every holder of that file a copy, so a
  # listed file must read as media. That is checked before any walk, costing one read per
  # holder. An empty read of a non-empty file is a broken store.
  : > "$t.hits"; broken=0; stored=0
  while read -r oid size; do
    hex=$(od -An -tx1 -N16 -v < <(GIT_DIR="$d" git cat-file blob "$oid" 2>/dev/null))
    hex=${hex//[$' \n']/}
    if [ -z "$hex" ] && [ "$size" != 0 ]; then broken=1; break; fi
    if is_media "$hex"; then
      echo "$oid" >> "$t.hits"; stored=$((stored + size))
    else
      printf 'n\t%s\t%s\tnot a known media format\n' "$rid" "$oid" >> "$t.n"
    fi
  done < <(awk '$2 == "blob" { print $1, $3 }' "$t")
  [ "$broken" = 0 ] || { echo "$rid" >&4; continue; }
  # The branches hold no more listed media than the store, so a store under the bar is no copy
  # and is not walked. Otherwise a stock icon shared with a denied repo sends every holder
  # through a walk on each list change.
  if [ "$stored" -lt "$min_bytes" ]; then
    [ ! -s "$t.n" ] || cat "$t.n"; printf '=\t%s\t0\n' "$rid"; echo "$rid" >&3; continue
  fi
  # --count stops one past rule F's cap, keeping a 152k-ref repo out of a variable. Over it,
  # the repo goes unjudged as in rule F.
  allrefs=$(GIT_DIR="$d" git for-each-ref --count=$(( max_refs + 1 )) \
              --format='%(refname)' 2>/dev/null) || { echo "$rid" >&4; continue; }
  [ "$(wc -l <<<"$allrefs")" -le "$max_refs" ] || { echo "$rid" >&4; continue; }
  read_delegates "$d"
  ours=$(delegate_branches <<<"$allrefs")
  # Whole histories, since a file committed then deleted still reaches every node that fetches
  # the repo. The awk keeps the listed files and totals every file's bytes, which the share of
  # the listed files is measured against.
  printf '=\t%s\t0\n' "$rid" > "$t.walk"
  if [ -n "$ours" ]; then
    # No --ignore-missing: a ref whose commit is gone would drop out of the walk, and its bytes
    # out of the share, leaving the repo judged on the rest.
    GIT_DIR="$d" git rev-list --objects --stdin \
        --filter=object:type=blob <<<"$ours" 2>/dev/null \
      | GIT_DIR="$d" git cat-file \
          --batch-check='%(objectname) %(objecttype) %(objectsize) %(rest)' 2>/dev/null \
      | awk -v hits="$t.hits" -v rid="$rid" '
          FILENAME == hits { listed[$1] = 1; next }
          $2 != "blob"     { next }
          { total += $3 }
          $1 in listed     { printf "h\t%s\t%s\t%s\n", rid, $1, $3 }
          END              { printf "=\t%s\t%.0f\n", rid, total }' "$t.hits" - > "$t.walk"
    # A torn listing shrinks the total and raises the listed share, so the repo goes unjudged.
    case "${PIPESTATUS[*]}" in (*[1-9]*) echo "$rid" >&4; continue ;; esac
  fi
  cat "$t.n"
  grep -q '^h' "$t.walk" || printf 'p\t%s\t%s\n' "$rid" "$(wc -l < "$t.hits")"
  cat "$t.walk"; echo "$rid" >&3
done
COPY
  # Cached rows answer for the list they were checked against. A changed list re-checks every
  # repo here and leaves the rest of the cache warm. Folding the list into the fingerprint
  # would drop the whole cache, a full cold run for every row added.
  copy_set=$(sha1sum < "$tmp/deny-oid-list" | cut -c1-40)
  copy_set_saved=1
  if [ "$CACHE" = 1 ] && [ "$(cat "$CACHE_DIR/copy-set" 2>/dev/null)" = "$copy_set" ]; then
    cache_hits copy
  else
    : > "$tmp/cached-copy"
    # Old keys go before the new list is saved, so a run dying in between re-checks everything.
    # Keys saved when the list could not be written would be reused under the old one.
    copy_set_saved=0
    if [ "$CACHE" = 1 ] && mkdir -p "$CACHE_DIR" 2>/dev/null \
       && rm -f "$CACHE_DIR/keys-copy" 2>/dev/null \
       && printf '%s\n' "$copy_set" > "$CACHE_DIR/copy-set" 2>/dev/null; then
      copy_set_saved=1
    fi
  fi
  to_read=$(repos_left copy)
  progress_start "copies" "$to_read" "$tmp/copy-done" "$tmp/copy-fail"
  repos_to_read "$tmp/cached-copy" \
    | xargs -0r -P "$JOBS" -n "$(batch_size "$to_read")" "$BASH_BIN" "$tmp/copy.sh" \
        > "$tmp/copy" 3> "$tmp/copy-done" 4> "$tmp/copy-fail" || true
  progress_stop
  phase_shortfall "search for copies of denied files" "$to_read" \
    "$tmp/copy-done" "$tmp/copy-fail"
  cache_reuse "copy" 2 copy >> "$tmp/copy"
  cache_save  "copy" "$tmp/copy"
  # Only a repo with its closing row was checked to the end. Others stay uncached and are
  # retried next run.
  awk -F'\t' '$1 == "=" { print $2 }' "$tmp/copy" | sort -u > "$tmp/answered-copy"
  if [ "$copy_set_saved" = 1 ]; then cache_save_keys copy "$tmp/answered-copy"; fi

  # A listed file some repo held before every repo it is listed from is not the sources' own: a
  # denied fork lists files its honest upstream and other forks hold too. Such a file counts
  # against no repo, and the run names its earliest holder. First-seen cannot be backdated, but
  # it dates the repo, not the file, so an old repo given the file later disowns it too until
  # deny.txt names that repo or its delegate. Only repos holding COPY_MIN_BYTES of listed files
  # are read, so only they can disown one.
  #
  # 1. Repos that cannot be the original: the ones deny.txt prunes, by id or delegate. A
  #    pinned, private, own or kept repo it spares can be one, including those found private or
  #    ours only on disk.
  awk -F'\t' 'FILENAME == ARGV[1] { denied[$1] = 1; next }
              $5 == "ours" || $5 == "private" { next }
              { n = split($7, d, ",")
                for (i = 1; i <= n; i++) if (d[i] in denied) print $1 }' \
    "$tmp/deny-nids" "$tmp/lives" | sort -u - "$tmp/deny-rids" > "$tmp/copy-denied"
  grep -vxFf "$tmp/excluded" "$tmp/copy-denied" > "$tmp/copy-untrusted" || true
  # 2. oid \t first-seen of its oldest source \t its sources, for each listed file whose every
  #    source is a repo the ledger dates. Free text dates nothing, so its files keep counting.
  awk -F'\t' -v seenfile="$FIRST_SEEN" '
      BEGIN { while ((getline line < seenfile) > 0) {
                split(line, f, "\t")
                if (f[1] != "" && f[2] ~ /^[0-9]+$/) seen[f[1]] = f[2]
              } }
      { src = $2; sub(/^rad:/, "", src) }
      !(src in seen)                            { undated[$1] = 1; next }
      index(" " srcs[$1] " ", " " src " ")      { next }
      { srcs[$1] = srcs[$1] (srcs[$1] == "" ? "" : " ") src
        if (!($1 in oldest) || seen[src] < oldest[$1]) oldest[$1] = seen[src] }
      END { for (o in srcs) if (!(o in undated)) printf "%s\t%s\t%s\n", o, oldest[o], srcs[o] }' \
    "$tmp/deny-oids" > "$tmp/copy-source-dates"
  # 3. oid \t earliest holder \t sources, for each of those files some other repo held first. A
  #    tie proves nothing, since every repo present when the ledger started shares its first
  #    day. Ties go by name so the same storage always names the same holder.
  awk -F'\t' -v seenfile="$FIRST_SEEN" -v untrusted="$tmp/copy-untrusted" '
      BEGIN { while ((getline line < seenfile) > 0) {
                split(line, f, "\t")
                if (f[1] != "" && f[2] ~ /^[0-9]+$/) seen[f[1]] = f[2]
              }
              while ((getline line < untrusted) > 0) skip[line] = 1 }
      FILENAME == ARGV[1] { oldest[$1] = $2; srcs[$1] = $3; next }
      $1 != "h" || !($3 in oldest) || !($2 in seen) || ($2 in skip) { next }
      seen[$2] >= oldest[$3]                         { next }
      !($3 in first)                                 { first[$3] = $2; next }
      seen[$2] < seen[first[$3]]                     { first[$3] = $2; next }
      seen[$2] == seen[first[$3]] && $2 < first[$3]  { first[$3] = $2 }
      END { for (o in first) printf "%s\t%s\t%s\n", o, first[o], srcs[o] }' \
    "$tmp/copy-source-dates" "$tmp/copy" | sort > "$tmp/copy-disowned"
  awk -F'\t' 'FILENAME == ARGV[1] { gone[$1] = 1; next } !($1 in gone)' \
    "$tmp/copy-disowned" "$tmp/deny-oids" > "$tmp/deny-oids-owned"

  # rid \t listed bytes \t total bytes \t % \t files \t source \t other sources, for every repo
  # whose delegates' branches hold a listed file. Only ids on this run's list count, in case a
  # cached row from a longer list gets past the re-check a list change triggers. The source
  # named is where most of its files came from, ties by name for a stable plan. A file listed
  # from a repo never counts against that repo, so a source back in storage with its block
  # lifted is not its own copy.
  awk -F'\t' -v src="$tmp/deny-oids-owned" '
      FILENAME == src            { if (!($1 in from)) from[$1] = $2
                                   source = $2; sub(/^rad:/, "", source); own[$1, source] = 1
                                   next }
      $1 == "=" && $3 > 0        { total[$2] = $3 }
      $1 == "h" && (($3, $2) in own) { next }
      $1 == "h" && ($3 in from)  { held[$2] += $4; files[$2]++; per[$2 SUBSEP from[$3]]++ }
      END {
        for (key in per) {
          split(key, k, SUBSEP); nsrc[k[1]]++
          if (per[key] > most[k[1]] || (per[key] == most[k[1]] && k[2] < top[k[1]]))
            { most[k[1]] = per[key]; top[k[1]] = k[2] }
        }
        for (r in held) if (r in total)
          printf "%s\t%.0f\t%.0f\t%d\t%d\t%s\t%d\n", r, held[r], total[r],
                 int(held[r] * 100 / total[r]), files[r], top[r], nsrc[r] - 1
      }' "$tmp/deny-oids-owned" "$tmp/copy" | sort -t$'\t' -k2,2nr -k1,1 > "$tmp/copies"

  # Sorted into a file first: head leaving a long pipe early would fail it under pipefail.
  sort -u -o "$tmp/copy-fail" "$tmp/copy-fail"
  ncopyfail=$(wc -l < "$tmp/copy-fail")
  if [ "$ncopyfail" -gt 0 ]; then
    echo "# WARN could not check $ncopyfail repo(s) for copies of denied files: unreadable," \
         "or over MEDIA_MAX_REFS ($MEDIA_MAX_REFS) refs. None of them is pruned as one:" >&2
    head -n "$top_evidence" "$tmp/copy-fail" | sed 's/^/#   /' >&2
    [ "$ncopyfail" -le "$top_evidence" ] \
      || echo "#   ...and $((ncopyfail - top_evidence)) more (PLAN_FULL=1 lists them)" >&2
  fi
  # A listed file in an issue, a patch, a stranger's push or a leftover needs a human to tell
  # whose it is. A repo in the keep file was already looked at, so it is not named again.
  awk -F'\t' -v kept="$tmp/kept" 'FILENAME == kept { k[$1] = 1; next }
                                  $1 == "p" && !($2 in k) { printf "%s\t%s\n", $2, $3 }' \
      "$tmp/kept" "$tmp/copy" | sort -u > "$tmp/copy-planted"
  nplanted=$(wc -l < "$tmp/copy-planted")
  if [ "$nplanted" -gt 0 ]; then
    echo "# WARN $nplanted repo(s) hold $copy_min_said or more of listed files, but not on" \
         "their own branches or tags, so they are not pruned as copies. Check them by hand:" >&2
    head -n "$top_evidence" "$tmp/copy-planted" \
      | awk -F'\t' '{ printf "#   %-34s %d file(s)\n", $1, $2 }' >&2
    [ "$nplanted" -le "$top_evidence" ] \
      || echo "#   ...and $((nplanted - top_evidence)) more (PLAN_FULL=1 lists them)" >&2
  fi
  # A listed id that counts for nothing is a row somebody should fix. Sorted first, so the
  # same storage names the same repo for it on every run.
  awk -F'\t' '$1 == "n" { printf "%s\t%s\t%s\n", $3, $2, $4 }' "$tmp/copy" | sort -u \
    | awk -F'\t' '!($1 in seen) { seen[$1] = 1; print }' > "$tmp/copy-notmedia"
  nnotmedia=$(wc -l < "$tmp/copy-notmedia")
  if [ "$nnotmedia" -gt 0 ]; then
    echo "# WARN $nnotmedia id(s) in $DENY_FILES count for nothing: they are not files, or" \
         "do not start like any image, video, audio or archive format this tool knows." \
         "Check those rows:" >&2
    head -n "$top_evidence" "$tmp/copy-notmedia" \
      | awk -F'\t' '{ printf "#   %s  %s (in %s)\n", $1, $3, $2 }' >&2
    [ "$nnotmedia" -le "$top_evidence" ] \
      || echo "#   ...and $((nnotmedia - top_evidence)) more (PLAN_FULL=1 lists them)" >&2
  fi
  # Enough listed media on a repo's own branches but under the share. Padding the branches with
  # bytes is how a copy would get there, so a person should look unless the keep file says one
  # already has.
  awk -F'\t' -v kept="$tmp/kept" -v b="$COPY_MIN_BYTES" -v p="$COPY_MIN_PCT" '
      FILENAME == kept { k[$1] = 1; next }
      $2 >= b && $4 < p && !($1 in k)' "$tmp/kept" "$tmp/copies" > "$tmp/copy-under"
  nunder=$(wc -l < "$tmp/copy-under")
  if [ "$nunder" -gt 0 ]; then
    echo "# WARN $nunder repo(s) hold enough listed files on their own branches to be" \
         "copies, but too small a share of the repo. Check them by hand:" >&2
    head -n "$top_evidence" "$tmp/copy-under" \
      | awk -F'\t' 'BEGIN { fmt = "#   %-34s %.1f MiB in %d file(s), "
                            fmt = fmt "%d%% of the bytes on its branches\n" }
                    { printf fmt, $1, $2 / 1048576, $5, $4 }' >&2
    [ "$nunder" -le "$top_evidence" ] \
      || echo "#   ...and $((nunder - top_evidence)) more (PLAN_FULL=1 lists them)" >&2
  fi
  ndisowned=$(wc -l < "$tmp/copy-disowned")
  if [ "$ndisowned" -gt 0 ]; then
    echo "# WARN $ndisowned listed file(s) were on this seed, in a repo it saw before every" \
         "repo they are listed from, so they count against no repo. If that repo holds them as" \
         "a copy, add it or its delegate to $DENY_FILE. If they are its own, drop their rows" \
         "from $DENY_FILES. Check them:" >&2
    head -n "$top_evidence" "$tmp/copy-disowned" \
      | awk -F'\t' '{ printf "#   %s  first in %s, listed from %s\n", $1, $2, $3 }' >&2
    [ "$ndisowned" -le "$top_evidence" ] \
      || echo "#   ...and $((ndisowned - top_evidence)) more (PLAN_FULL=1 lists them)" >&2
  fi
fi

# --------------------------------------------------------------- rule G: parasite peers, scan
# Per repo, what each NON-delegate peer added that the repo's own refs lack. The walk stops at
# the first shared commit, so a peer who only replicates costs almost nothing. One combined
# listing runs first and most repos end there; only where it finds media is the work repeated
# per peer to learn whose it is.
: > "$tmp/peer"
if rule_on G; then
  cat > "$tmp/peer.sh" <<PEER
#!/usr/bin/env bash
$(declare -f read_delegates)
media_exts='$MEDIA_EXTS'
max_refs=$MEDIA_MAX_REFS
PEER
  cat >> "$tmp/peer.sh" <<'PEER'
# Prints "<oid> <bytes> <path>" for every blob reachable from the refs in $2 but not from any
# in $3 (newline-separated). Passed on stdin, since a widely replicated repo has thousands of
# refs and argv has a size limit. `^ref` is rev-list's "not this one".
only_in() {
  local d=$1 want=$2 exclude=$3
  { printf '%s\n' $want; printf '^%s\n' $exclude; } \
    | GIT_DIR="$d" git rev-list --objects --ignore-missing --stdin \
        --filter=object:type=blob 2>/dev/null \
    | GIT_DIR="$d" git cat-file \
        --batch-check='%(objectname) %(objecttype) %(objectsize) %(rest)' 2>/dev/null \
    | awk '$2 == "blob" { path = $0; sub(/^[^ ]+ [^ ]+ [^ ]+ /, "", path)
                          printf "%s %.0f %s\n", $1, $3, path }'
  # A listing that died halfway still looks plausible, and a short one lowers the peer's
  # non-media total, the last bar an accusation must clear, so a torn listing returns failure.
  case "${PIPESTATUS[*]}" in (*[1-9]*) return 1 ;; esac
  return 0
}
# Splits a blob listing into media and other bytes, by extension only. Rule G accuses a person,
# so it relies on the same file recurring, and a sniffer would cost a read per blob seed-wide.
split_bytes() {
  awk -v m="$media_exts" '
    function known(list, key) { return index("|" list "|", "|" key "|") > 0 }
    { oid = $1; size = $2 + 0
      base = $0; sub(/^[^ ]+ [^ ]+ /, "", base); sub(/^.*\//, "", base); base = tolower(base)
      ext = ""; if (match(base, /\.[a-z0-9]+$/)) ext = substr(base, RSTART + 1)
      if (ext != "" && known(m, ext)) { printf "b %s %.0f\n", oid, size; media += size }
      else                                                              other += size }
    END { printf "= %.0f %.0f\n", media, other }'
}
# Judges one repo. Returns 0 once it has printed all it has to say (possibly nothing), and
# non-zero on a torn git listing, so the caller leaves the repo unanswered.
walk_repo() {
  local d=$1 rid=$2 dids nid allrefs ref own strangers combined media_here mine
  local refs=()
  # refs/rad/id is written only after the node verifies the identity's signatures, so a
  # stranger's push cannot make itself a delegate. Read before any skip, so a delegate's
  # protection does not depend on whether the repo is worth walking.
  read_delegates "$d"
  # Every row carries the rid in field 2, the one field the run cache reuses rows by.
  if [ -z "$dids" ]; then printf 'u\t%s\n' "$rid"; return 0; fi
  for nid in $dids; do printf 'd\t%s\t%s\n' "$rid" "$nid"; done
  # --count stops one past the cap, keeping a 152k-ref repo out of a variable. It shares rule
  # F's MEDIA_MAX_REFS, since both pay the same cost of walking every peer's refs.
  allrefs=$(GIT_DIR="$d" git for-each-ref --count=$(( max_refs + 1 )) \
              --format='%(refname)' 2>/dev/null) || return 1
  mapfile -t refs <<<"$allrefs"
  [ "${#refs[@]}" -le "$max_refs" ] || return 0
  # OWN is everything the delegates control, the exclusion set. Whole histories, since a wider
  # exclusion can only spare a peer.
  own=""; strangers=""; combined=""
  for ref in "${refs[@]}"; do
    case $ref in
      refs/heads/*|refs/tags/*|refs/cobs/*|refs/rad/*) own="$own"$'\n'"$ref"; continue ;;
      refs/namespaces/*) nid=${ref#refs/namespaces/}; nid=${nid%%/*} ;;
      *) continue ;;
    esac
    case " $dids " in
      (*" $nid "*) own="$own"$'\n'"$ref" ;;
      (*)          strangers="$strangers"$'\n'"$nid"$'\t'"$ref"
                   combined="$combined"$'\n'"$ref" ;;
    esac
  done
  [ -n "$strangers" ] || return 0
  # One listing for every stranger at once; most repos stop here. To a file, so the exit status
  # survives. A peer who only mirrors the repo lists nothing.
  only_in "$d" "$combined" "$own" > "$blobs" || return 1
  [ -s "$blobs" ] || return 0
  media_here=$(split_bytes < "$blobs" | awk '$1 == "=" { print $2 }')
  [ "${media_here:-0}" -gt 0 ] || return 0
  # Media is there, so list per peer to learn whose. A peer with nothing of its own costs one
  # walk that ends at the first shared commit.
  for nid in $(cut -f1 <<<"${strangers#$'\n'}" | sort -u); do
    mine=$(awk -F'\t' -v n="$nid" '$1 == n { print $2 }' <<<"${strangers#$'\n'}")
    only_in "$d" "$mine" "$own" > "$blobs" || return 1
    split_bytes < "$blobs" \
      | awk -v nid="$nid" -v rid="$rid" '
          $1 == "b" { printf "b\t%s\t%s\t%s\t%s\n", rid, nid, $2, $3 }
          $1 == "=" { printf "=\t%s\t%s\t%s\t%s\n", rid, nid, $2, $3 }'
  done
  return 0
}
blobs=$(mktemp) || exit 1
trap 'rm -f "$blobs"' EXIT
for d; do
  # The marker says this repo was judged to the end. A killed worker or torn listing leaves it
  # out, so the cache reads the repo again next run instead of banking partial totals. Rows
  # already printed are harmless, since nothing reuses rows of a repo with no key. It goes to
  # the plan stream, which the cache reads, and to fd 3, one line per repo for the ticker.
  walk_repo "$d" "${d##*/}" \
    && { printf 'x\t%s\n' "${d##*/}"; printf '%s\n' "${d##*/}" >&3; }
done
PEER
  cache_hits peer
  to_read=$(repos_left peer)
  progress_start "parasite (G)" "$to_read" "$tmp/peer-done"
  repos_to_read "$tmp/cached-peer" \
    | xargs -0r -P "$JOBS" -n "$(batch_size "$to_read")" "$BASH_BIN" "$tmp/peer.sh" \
        > "$tmp/peer" 3> "$tmp/peer-done" || true
  progress_stop
  phase_shortfall "parasite-peer rule (G)" "$to_read" "$tmp/peer-done"
  # Reused rows go back beside the fresh ones, because the verdict is corpus-wide: a peer's
  # spread counts across all storage, and a delegate row in any repo clears that peer.
  cache_reuse "peer" 2 peer >> "$tmp/peer"
  cache_save  "peer" "$tmp/peer"
  # Only the end-of-repo marker counts as an answer, since delegate rows print before the walk
  # and would count a repo whose worker died mid-walk.
  awk -F'\t' '$1 == "x" { print $2 }' "$tmp/peer" | sort -u > "$tmp/answered-peer"
  cache_save_keys peer "$tmp/answered-peer"
fi

# A repo we could not fully read has an untrustworthy size and age, so it leaves the plan.
# find and du name the failing path; its component after $STORAGE/ is the rid. Unlike matching
# a rid pattern, that is exact for any rid length and literal where the path holds glob chars.
while IFS= read -r line; do
  rid=${line#*"$STORAGE/"}
  [ "$rid" = "$line" ] && continue          # this error is not about a repo dir
  rid=${rid%%/*}; rid=${rid%%\'*}           # first component, minus find/du's closing quote
  case "$rid" in ?*) printf '%s\n' "$rid" ;; esac
done < "$scanerr" | sort -u > "$tmp/scanfail"
nscanerr=$(wc -l < "$scanerr"); nscanfail=$(wc -l < "$tmp/scanfail")
if [ "$nscanerr" -gt 0 ]; then
  echo "# WARN $nscanerr scan error(s); $nscanfail repo(s) unreadable, excluded:" >&2
  head -n "$top_scanerr" "$scanerr" | sed 's/^/#   /' >&2
  [ "$nscanerr" -gt "$top_scanerr" ] \
    && echo "#   ...and $((nscanerr - top_scanerr)) more (PLAN_FULL=1 lists them)" >&2
fi

declare -A SIZE MTIME LIFE BIRTH NAME SEEDS EXCL SCANFAIL SPAM MEDIA SHARED \
           FIRSTSEEN MEDIABYTES DELEGATES SIGNERS DENY_RID DENY_NID COPY COPYHELD COPYPCT COPYROW \
           MALWARE_OP
while IFS=$'\t' read -r sz path; do SIZE[${path##*/}]=$sz; done < "$tmp/du"
while IFS=$'\t' read -r rid mt;   do MTIME[$rid]=${mt%.*}; done < "$tmp/mtimes"
# Anything not a plain number becomes 0, which the classify loop reads as "age unknown" and
# leaves alone. This backs up the worker's filter: a non-number in an arithmetic test would
# leave a repo unjudgeable or judged on nonsense.
ncoerced=0
declare -A UNDATED=()
while IFS=$'\t' read -r rid bt lf _ _ sg dl; do
  [ "$bt" = u ] && { UNDATED[$rid]=1; bt=0; lf=0; }
  case $bt in ''|*[!0-9]*) bt=0; ncoerced=$((ncoerced + 1)) ;; esac
  case $lf in ''|*[!0-9]*) lf=0; ncoerced=$((ncoerced + 1)) ;; esac
  BIRTH[$rid]=$bt; LIFE[$rid]=$lf; DELEGATES[$rid]=$dl; SIGNERS[$rid]=$sg
done < "$tmp/lives"
# Repos the scan found ours or private that nothing above excluded. `rad ls` lists only repos
# this node seeds and can read. A stopped seed explains an own one, but a release that changes
# its table would explain them all, so they are kept and named.
awk -F'\t' 'FILENAME == ARGV[1] { gone[$1] = 1; next }
            ($5 == "ours" || $5 == "private") && !($1 in gone) { print $1 "\t" $5 }' \
  "$tmp/excluded" "$tmp/lives" | sort > "$tmp/unlisted"
# A check judges its own repos by design, and this would exclude them.
if [ "$CMD" != check-mine ] && [ -s "$tmp/unlisted" ]; then
  nunlisted=$(wc -l < "$tmp/unlisted")
  echo "# WARN $nunlisted repo(s) are ours or private on disk, but '$RAD ls' did not list" \
       "them; they are kept. 'rad seed' the ones marked ours that you want, 'rad rm' what you" \
       "do not, or add them to $KEEP_FILE:" >&2
  head -n "$top_evidence" "$tmp/unlisted" | sed 's/^/#   /; s/\t/  /' >&2
  [ "$nunlisted" -le "$top_evidence" ] \
    || echo "#   ...and $((nunlisted - top_evidence)) more (PLAN_FULL=1 lists them)" >&2
  cut -f1 "$tmp/unlisted" | sort -u - "$tmp/excluded" > "$tmp/excluded.new"
  mv "$tmp/excluded.new" "$tmp/excluded"
fi
while read -r r; do DENY_RID[$r]=1; done < "$tmp/deny-rids"
while read -r r; do DENY_NID[$r]=1; done < "$tmp/deny-nids"
# Non-zero means the worker's filter let something through, and those repos escape every age
# rule. Unwarned, that reads like a clean scan.
[ "$ncoerced" = 0 ] \
  || echo "# WARN $ncoerced repo date(s) were not numbers and were read as unknown," \
          "so those repos are outside the age rules; the ref scan may be broken" >&2
while IFS=$'\t' read -r rid nm _; do NAME[$rid]=$nm; done < "$tmp/meta-named"
while IFS=$'\t' read -r rid s;    do SEEDS[$rid]=$s; done < "$tmp/seeds"
while read -r r; do [ -n "$r" ] && EXCL[$r]=1; done < "$tmp/excluded"
declare -A PARDON=()
while read -r r; do [ -n "$r" ] && PARDON[$r]=1; done < "$tmp/undo-pardoned"
while read -r r; do [ -n "$r" ] && SCANFAIL[$r]=1; done < "$tmp/scanfail"
while read -r r; do [ -n "$r" ] && SPAM[$r]=1; done < "$tmp/spam"
# When this seed first saw each repo. Every date inside a repo is the pusher's to set, so a
# spammer who rewrites their refs resets the ages rules D and F measure. This ledger is out of
# their reach, so those rules use the older of the two. It is appended every run, dry or not,
# and without it the tool falls back on ref dates. Non-numeric timestamps are skipped, because
# a crash mid-write leaves a torn last line that would reach an arithmetic test.
[ -r "$FIRST_SEEN" ] && while IFS=$'\t' read -r rid ts; do
  [ -n "$rid" ] || continue
  case $ts in ''|*[!0-9]*) continue ;; esac
  FIRSTSEEN[$rid]=$ts
done < "$FIRST_SEEN"
if mkdir -p "$AUDIT_DIR" 2>/dev/null && { : >> "$FIRST_SEEN"; } 2>/dev/null; then
  add_header "$FIRST_SEEN" \
    "The day this seed first saw each repo: repo id, then Unix time. It tells the spam-batch" \
    "(D) and media (F) rules how old a repo really is, and the search for copies of denied" \
    "files which repo held a listed file first. Deleting it leaves the rules only the commit" \
    "dates, which whoever pushed the repo can set to anything, and makes the listed files" \
    "set aside count against their copies again." \
    || echo "# WARN could not add a header to $FIRST_SEEN; its rows are unaffected." >&2
  for rid in "${!SIZE[@]}"; do
    [ -n "${FIRSTSEEN[$rid]:-}" ] && continue
    FIRSTSEEN[$rid]=$now; printf '%s\t%s\n' "$rid" "$now" >> "$FIRST_SEEN"
  done
else
  echo "# WARN cannot write $FIRST_SEEN; ages come from ref dates, which a pusher sets." >&2
fi
# A repo whose refs carry no usable date dates from the day this seed first saw it, for both
# age and last activity. One first seen this run reads as new, which no rule prunes.
for rid in "${!UNDATED[@]}"; do
  BIRTH[$rid]=${FIRSTSEEN[$rid]:-$now}; LIFE[$rid]=${FIRSTSEEN[$rid]:-$now}
done

# A file published in MEDIA_MIN_BATCH or more repos is a campaign, which no single repo can
# fake. Per repo, this sums the bytes it keeps in such files. Only repos with too little text
# to be spared are holders (the worker writes no others), so a stock icon makes no campaign.
# The earliest holder is left out of its own batch, or reposting somebody's photos into five
# repos of your own would put THEIR repo in the plan. Earliest is by first-seen, which a pusher
# cannot backdate. A same-run tie goes to the storage dir the node made first (to the second),
# since a pusher can grind a rid to sort anywhere. Without creation times, sort order wins.
# Known limit: copies that reached this seed before the original count as first holders, and
# storage moved with cp or rsync takes creation times in copy order.
# The blob list is sorted, and exists only when rule F ran.
: > "$tmp/media-births"
if [ -s "$tmp/blobs-all" ]; then
  cut -f2 "$tmp/blobs-all" | sort -u \
    | (cd "$STORAGE" && xargs -r stat -c '%n %W' --) > "$tmp/media-births" 2>/dev/null || true
  awk '$2 ~ /^[1-9][0-9]*$/ { found = 1; exit } END { exit !found }' "$tmp/media-births" \
    || echo "# WARN cannot read when the node stored each repo (stat %W), so repos first" \
            "seen in the same run tie for a shared media file by repo id, which a pusher" \
            "can choose." >&2
fi
{ [ ! -e "$tmp/blobs-all" ] || cat "$tmp/blobs-all"; } \
  | awk -F'\t' -v k="$MEDIA_MIN_BATCH" -v now="$now" -v seenfile="$FIRST_SEEN" \
        -v birthfile="$tmp/media-births" '
      BEGIN { while ((getline line < seenfile) > 0) {
                split(line, f, "\t")
                if (f[2] ~ /^[0-9]+$/) seen[f[1]] = f[2]
              }
              while ((getline line < birthfile) > 0) {
                split(line, f, " ")
                if (f[2] ~ /^[1-9][0-9]*$/) born[f[1]] = f[2]
              } }
      function earlier(o, r, age) {
        if (age != firstage[o]) return age < firstage[o]
        return (r in born) && (first[o] in born) && born[r] < born[first[o]]
      }
      { n++; oid[n]=$1; rid[n]=$2; size[n]=$3; holders[$1]++
        age = ($2 in seen) ? seen[$2] : now
        if (!($1 in first) || earlier($1, $2, age)) { first[$1]=$2; firstage[$1]=age } }
      END { for (i=1;i<=n;i++)
              if (holders[oid[i]] >= k && rid[i] != first[oid[i]]) shared[rid[i]] += size[i]
            for (r in shared) printf "%s\t%.0f\n", r, shared[r] }' > "$tmp/media-shared"
while IFS=$'\t' read -r rid b; do [ -n "$rid" ] && SHARED[$rid]=$b; done < "$tmp/media-shared"

# Rule F decides here, beside the other rules' thresholds. A repo whose tree could not be
# listed never enters the map. MEDIA holds the verdict word, so the plan says which path
# matched. mb and ob are media and other bytes, av the image, video and audio bytes. At the
# tips, others counts files that are neither media nor a README, readmes the READMEs, and
# tipmedia is media bytes ("-" for all three when not listed). src and build say whether a
# source or build file was seen.
while IFS=$'\t' read -r rid mb ob av others readmes tipmedia src build; do
  [ -n "$rid" ] || continue
  [ "$mb" -ge "$MEDIA_MIN_BYTES" ] || continue
  MEDIABYTES[$rid]=$mb
  name=${NAME[$rid]:-}
  # A seed's logo, under a name shaped like its hostname. wallpapers.png is hostname-shaped
  # too but names a file. A repo with no name this run (left out of `rad ls`, or listed twice)
  # may be such a logo.
  if [ -z "$name" ] && [ "$mb" -lt "$MEDIA_HOST_MAX_BYTES" ]; then continue; fi
  if [[ ${name,,} =~ $MEDIA_HOST_NAME_RE ]] && [ "$mb" -lt "$MEDIA_HOST_MAX_BYTES" ]; then
    case "|$MEDIA_EXTS|" in
      (*"|${BASH_REMATCH[2]}|"*) ;;
      (*) continue ;;
    esac
  fi
  # Alone, a repo must carry no project at all: next to no text, or only a README beside a lot
  # of media. Where other repos hold the same files, a token README no longer clears it. An
  # archive is a release more often than a dump, so any archive spares it the ratio path. The
  # ratio weighs only tip media, so a repo whose branch holds a README and whose issues hold
  # screen recordings stays a project.
  archives=$((mb - av))
  is_ratio=0
  if [ "$others" = 0 ] && [ "$readmes" -le "$MEDIA_RATIO_MAX_FILES" ] \
     && [ "$archives" = 0 ] && [ "$tipmedia" -ge "$MEDIA_RATIO_MIN_BYTES" ] \
     && [ $((ob * 1000)) -lt $((tipmedia * MEDIA_RATIO_TEXT_PER_MILLE)) ]; then
    is_ratio=1
  fi
  if [ "$src" = 0 ] && [ "$build" = 0 ] && [ "$ob" -lt "$MEDIA_TEXT_MAX_BYTES" ]; then
    MEDIA[$rid]=media-dump
  elif [ "$src" = 0 ] && [ "$build" = 0 ] && [ "$is_ratio" = 1 ]; then
    MEDIA[$rid]=media-ratio
  elif [ "$build" = 0 ] && [ "$ob" -lt "$MEDIA_TEXT_CEIL_BYTES" ] \
       && [ "${SHARED[$rid]:-0}" -ge "$MEDIA_MIN_BYTES" ]; then
    MEDIA[$rid]=media-batch
  fi
done < "$tmp/media"
# No unset pass over media-fail: every worker path that writes a rid there skips that repo's
# totals, so it never reaches MEDIA.

# A copy of denied files has to clear both bars. Both measures are kept for every holder so
# NEAR can name the close bar, and the whole row is kept for the report. Only digits pass,
# since these reach arithmetic in the classify loop.
while IFS= read -r row; do
  IFS=$'\t' read -r rid held _ pct _ <<<"$row"
  [[ $held =~ ^[0-9]+$ && $pct =~ ^[0-9]+$ ]] || continue
  COPYHELD[$rid]=$held; COPYPCT[$rid]=$pct; COPYROW[$rid]=$row
  if [ "$held" -ge "$COPY_MIN_BYTES" ] && [ "$pct" -ge "$COPY_MIN_PCT" ]; then COPY[$rid]=1; fi
done < "$tmp/copies"

# ------------------------------------------------------------------- rule G: judge the peers
# One verdict per peer. The accusation is one file, byte for byte, that this peer put into
# PARASITE_MIN_REPOS repos it is not a delegate of. Totals across different files are not
# enough: an active peer builds those up honestly, while one oid in unrelated repos is no
# accident. A delegate anywhere in storage is never accused, because blocking a delegate stops
# their repos replicating (the node filters delegate refs through the block list before
# checking the signature threshold).
: > "$tmp/parasites"; nunknown=0
if rule_on G && [ -s "$tmp/peer" ]; then
  nunknown=$(awk -F'\t' '$1 == "u"' "$tmp/peer" | sort -u | wc -l)
  awk -F'\t' -v k="$PARASITE_MIN_REPOS" -v minb="$PARASITE_MIN_BYTES" \
             -v maxt="$PARASITE_TEXT_MAX_BYTES" -v us="$OUR_NID" '
      $1 == "d" { delegate[$3] = 1; next }
      # One repo can list the same oid twice (two refs, one blob), so count each repo once.
      $1 == "b" { if (!((($3 SUBSEP $4) SUBSEP $2) in pair)) {
                    pair[($3 SUBSEP $4) SUBSEP $2] = 1; spread[$3 SUBSEP $4]++ }
                  next }
      # One row per peer and repo. A duplicate would double the byte totals of that peer,
      # which are two of the three bars an accusation must clear.
      $1 == "=" { if (($3 SUBSEP $2) in seen) next
                  seen[$3 SUBSEP $2] = 1
                  media[$3] += $4; other[$3] += $5
                  if ($4 > 0) repos[$3]++
                  next }
      END {
        for (key in spread) {
          split(key, f, SUBSEP)
          if (spread[key] > widest[f[1]]) { widest[f[1]] = spread[key]; worst[f[1]] = f[2] }
        }
        for (nid in widest) {
          if (nid == us || nid in delegate) continue
          if (widest[nid] < k || media[nid] < minb || other[nid] >= maxt) continue
          printf "%s\t%d\t%d\t%.0f\t%.0f\t%s\n",
                 nid, widest[nid], repos[nid], media[nid], other[nid], worst[nid]
        }
      }' "$tmp/peer" | sort -k2,2nr > "$tmp/parasites"
fi
nparasite=$(wc -l < "$tmp/parasites")

# -------------------------------------------------------- rule H: malware operations, judge
# Rows, one per repo hit, sorted: nid, repos hit, repos it signed, rid, words matched, name.
: > "$tmp/malware"
if rule_on H; then
  # Per repo whose name or description uses a malware word: rid, the words, whether one is
  # strong, and the name. Words match whole after splitting on non-alphanumerics, since "rat"
  # as a substring sits in a thousand names. A miss is retried without one trailing "s".
  awk -F'\t' -v strong="$MALWARE_STRONG_WORDS" -v weak="$MALWARE_WEAK_WORDS" '
    function known(list, key) { return index("|" list "|", "|" key "|") > 0 }
    function malware(word) { return word != "" && (known(strong, word) || known(weak, word)) }
    {
      text = tolower($2 " " $3); gsub(/[^a-z0-9]+/, " ", text); n = split(text, w, " ")
      split("", seen); found = ""; isstrong = 0
      for (i = 1; i <= n; i++) {
        word = w[i]
        if (!malware(word) && word ~ /s$/) word = substr(word, 1, length(word) - 1)
        if ((word in seen) || !malware(word)) continue
        seen[word] = 1; found = found (found == "" ? "" : ",") word
        if (known(strong, word)) isstrong = 1
      }
      if (found != "") printf "%s\t%s\t%d\t%s\n", $1, found, isstrong, $2
    }' "$tmp/meta-named" > "$tmp/malware-words"
  # Identities rule H leaves out. A delegate of a pinned, kept or own repo is vouched for by
  # this seed, even one who never signed there, as the deny list would not block them either.
  # A private repo vouches for nobody: its delegates chose this seed. A keep-list identity was
  # cleared by a person, and a deny-list one is already dealt with. A check leaves out nobody,
  # since it asks what another seed would do with this node's repos.
  # $tmp/malware-vouched holds the vouched ones, whose signed refs spare a repo. Deny-list
  # identities are not among them, so signing refs in an operation's repo cannot shield it.
  { cat "$tmp/pinned" "$tmp/own" "$tmp/kept"
    awk -F'\t' '$2 == "ours" { print $1 }' "$tmp/unlisted"; } | sort -u > "$tmp/vouched"
  { awk -F'\t' 'FILENAME == ARGV[1] { vouched[$1] = 1; next }
                ($1 in vouched) { n = split($7, d, ",")
                                  for (i = 1; i <= n; i++) print d[i] }' \
      "$tmp/vouched" "$tmp/lives"
    cat "$tmp/kept-nids"
    echo "$OUR_NID"; } | sort -u > "$tmp/malware-vouched"
  sort -u "$tmp/malware-vouched" "$tmp/deny-nids" > "$tmp/malware-skip"
  if [ "$CMD" = check-mine ]; then : > "$tmp/malware-vouched"; : > "$tmp/malware-skip"; fi
  # The founder of each matching repo: the delegate in its first identity revision whose key
  # signed that commit. Any cloner can be added as a co-delegate and signs refs of their own,
  # so only a founder's repos count as theirs. Being listed is not enough, since the document's
  # author lists whoever they like, and pre-1.7 signed refs name no repo and can be copied.
  # Radicle signs that commit with ed25519 over its tree id (see delegate_ops). A repo whose
  # first revision does not read, or whose signature fits no listed key, counts for nobody.
  # The signature covers only the tree, so the commit can be copied elsewhere still validly
  # signed. The rid is the document blob's id, so a copy that does not hold the document its
  # own id names counts for nobody too.
  # An identity that only joins repos others created is never named, the price of not naming
  # whoever was added to an operation's repos after cloning them.
  : > "$tmp/malware-founders"
  mkdir -p "$tmp/founder"
  nforeign=0; foreign=""
  nchecked=0; nfounded=0
  while IFS=$'\t' read -r rid _; do
    d="$STORAGE/$rid"
    root=$(GIT_DIR="$d" git rev-list --max-parents=0 refs/rad/id 2>/dev/null | tail -n 1) \
      || root=""
    [ -n "$root" ] || continue
    read_delegates "$d" "$root"
    docblob=$(GIT_DIR="$d" git rev-parse "$root:embeds/radicle.json" 2>/dev/null) || docblob=""
    # A first revision with no document credits nobody either, but is no copy to report.
    if [ -z "$docblob" ]; then
      dids=""
    elif [ "$docblob" != "$(rid_blob_hex "$rid")" ]; then
      dids=""
      nforeign=$((nforeign+1)); foreign=${foreign:-$rid}
    fi
    [ -n "$dids" ] && nchecked=$((nchecked+1))
    roottree=$(GIT_DIR="$d" git rev-parse "$root^{tree}") || continue
    unhex "$roottree" > "$tmp/founder/msg"
    # The commit header's signature block. With none the file stays empty and no key matches.
    GIT_DIR="$d" git cat-file commit "$root" | sed '/^$/q' \
      | sed -n '/^gpgsig -----BEGIN SSH SIGNATURE-----$/,/^ -----END SSH SIGNATURE-----$/p' \
      | sed '1d; $d' | tr -d ' \n' | base64 -d > "$tmp/founder/sshsig" 2>/dev/null || true
    tail -c 64 "$tmp/founder/sshsig" > "$tmp/founder/sig"
    # The SSH signature names its key. After "SSHSIG" and a version, at byte 10, come the key's
    # length (51), its type's length (11), "ssh-ed25519", 32, then the key. Only the listed
    # delegate with that key is checked, so one openssl call per repo. od fails on a signature
    # too short, which matches no key.
    keyfield=$(od -An -tx1 -v -j10 -N55 "$tmp/founder/sshsig" 2>/dev/null | tr -d ' \n') \
      || keyfield=""
    signkey=""
    if [ "${keyfield:0:46}" = 000000330000000b7373682d6564323535313900000020 ]; then
      signkey=${keyfield:46}
    fi
    signer=""
    for nid in $dids; do
      if [ -n "$signkey" ] && [ "$(did_key_hex "$nid")" = "$signkey" ]; then
        signer=$nid
        break
      fi
    done
    founder=""
    if [ -n "$signer" ]; then
      unhex "302a300506032b6570032100$signkey" > "$tmp/founder/key"
      if openssl pkeyutl -verify -pubin -keyform DER -inkey "$tmp/founder/key" -rawin \
           -in "$tmp/founder/msg" -sigfile "$tmp/founder/sig" >/dev/null 2>&1; then
        founder=$signer
        nfounded=$((nfounded+1))
      fi
    fi
    printf '%s\t%s\n' "$rid" "$founder" >> "$tmp/malware-founders"
  done < "$tmp/malware-words"
  [ "$nforeign" = 0 ] \
    || echo "# WARN $nforeign repo(s) start from another repo's first identity revision," \
            "copied, such as rad:$foreign. That is how someone would try to get a stranger" \
            "named by the malware rule (H), so it counts them for nobody." >&2
  # Every first revision is signed the same way, so none checking out means the way changed.
  [ "$nchecked" = 0 ] || [ "$nfounded" -gt 0 ] \
    || echo "# WARN no signature on the first identity revision of $nchecked repo(s) the" \
            "malware rule (H) matched checks out for a listed delegate. Radicle may sign" \
            "them differently now, so the rule names nobody this run." >&2
  # Each identity's repos, counted only where it is a delegate and signed refs, so being named
  # co-delegate of a malware repo does not count. A matching repo counts only for its founder,
  # and one it did not found leaves its share untouched. Then the bars.
  awk -F'\t' -v minwords="$MALWARE_MIN_WORDS" -v minrepos="$MALWARE_MIN_REPOS" \
      -v share="$MALWARE_MIN_SHARE_PCT" '
    FILENAME == ARGV[1] { skip[$1] = 1; next }
    FILENAME == ARGV[2] { words[$1] = $2; strong[$1] = $3; name[$1] = $4; next }
    FILENAME == ARGV[3] { founder[$1] = $2; next }
    $6 != "-" {
      n = split($6, signer, ",")
      for (i = 1; i <= n; i++) {
        d = signer[i]
        if (d in skip) continue
        if (($1 in words) && founder[$1] != d) continue
        repos[d]++
        if (!($1 in words)) continue
        hits[d]++; row[d, hits[d]] = $1 "\t" words[$1] "\t" name[$1]
        if (strong[$1]) anystrong[d] = 1
        nw = split(words[$1], w, ",")
        for (j = 1; j <= nw; j++)
          if (!((d, w[j]) in counted)) { counted[d, w[j]] = 1; distinct[d]++ }
      }
    }
    END {
      for (d in hits) {
        if (!(d in anystrong) || distinct[d] < minwords || hits[d] < minrepos) continue
        if (hits[d] * 100 < repos[d] * share) continue
        for (i = 1; i <= hits[d]; i++)
          printf "%s\t%d\t%d\t%s\n", d, hits[d], repos[d], row[d, i]
      }
    }' "$tmp/malware-skip" "$tmp/malware-words" "$tmp/malware-founders" "$tmp/lives" \
    | sort -t$'\t' -k1,1 -k4,4 > "$tmp/malware"
fi
nmalware=$(cut -f1 "$tmp/malware" | sort -u | wc -l)
# Under MALWARE_PRUNE=1 a named identity is treated as a deny-list did:key: line would be.
# Every repo it is a DELEGATE of is pruned; a repo it only pushed into is not. A repo is
# spared when excluded, or when an identity this rule leaves out signed refs in it. Being
# named is not enough, since anybody can name this seed's identity in their document. A named
# identity that is a delegate of a spared repo is not blocked, as that would stop the repo's
# updates.
# $tmp/malware-op: rid \t named delegates. $tmp/malware-block: identities to block.
: > "$tmp/malware-op"; : > "$tmp/malware-block"; : > "$tmp/malware-nids-kept"
if [ "$MALWARE_PRUNE" = 1 ] && [ "$nmalware" -gt 0 ]; then
  cut -f1 "$tmp/malware" | sort -u > "$tmp/malware-nids"
  awk -F'\t' -v kept="$tmp/malware-nids-kept" '
    FILENAME == ARGV[1] { named[$1] = 1; next }
    FILENAME == ARGV[2] { skip[$1] = 1; next }
    FILENAME == ARGV[3] { excl[$1] = 1; next }
    {
      hit = ""
      nd = split($7, dl, ",")
      for (i = 1; i <= nd; i++) if (dl[i] in named) hit = hit (hit == "" ? "" : ",") dl[i]
      if (hit == "") next
      spared = ($1 in excl)
      # Signed refs older than Radicle 1.7 name no repo, so copies of those a vouched identity
      # signed can earn a repo this spare. That is accepted: a spare only leaves a repo alone.
      ns = split($6, sg, ",")
      for (i = 1; i <= ns; i++) if (sg[i] in skip) spared = 1
      if (!spared) { print $1 "\t" hit; next }
      nh = split(hit, h, ",")
      for (i = 1; i <= nh; i++) print h[i] > kept
    }' "$tmp/malware-nids" "$tmp/malware-vouched" "$tmp/excluded" "$tmp/lives" \
    | sort > "$tmp/malware-op"
  sort -u -o "$tmp/malware-nids-kept" "$tmp/malware-nids-kept"
  grep -vxFf "$tmp/malware-nids-kept" "$tmp/malware-nids" > "$tmp/malware-block" || true
  while IFS=$'\t' read -r rid nids; do MALWARE_OP[$rid]=$nids; done < "$tmp/malware-op"
fi
nmalware_block=$(wc -l < "$tmp/malware-block")
# Blocks an earlier run made as malware that rule H now finds wrong. rad-prune never lifts a
# block on a person, so it names each one every run while `rad follow` lists it:
#   - an identity rule H names that delegates a repo it spares, whose updates the block stops.
#   - an identity rule H now clears: a keep-list line, or a kept, pinned or own repo it
#     delegates.
# Hand-made blocks are the operator's, and deny-list identities are meant to stay blocked, so
# neither is named. rad unfollow deletes the policy row whatever it holds, so it lifts the
# block. rad unblock is missing from older heartwood. If blocks cannot be listed, all are
# named.
if rule_on H && [ "$CMD" != check-mine ]; then
  malware_blocked_before > "$tmp/malware-blocked-before"
  sort -u "$tmp/malware-nids-kept" "$tmp/malware-vouched" \
    | grep -xFf "$tmp/malware-blocked-before" | grep -vxFf "$tmp/deny-nids" \
    > "$tmp/malware-unblock" || true
  if [ -s "$tmp/malware-unblock" ]; then
    if nodes_blocked_now > "$tmp/nodes-blocked" 2> "$tmp/follow-err"; then
      grep -xFf "$tmp/nodes-blocked" "$tmp/malware-unblock" > "$tmp/malware-unblock-now" \
        || true
      mv "$tmp/malware-unblock-now" "$tmp/malware-unblock"
    else
      echo "# WARN '$RAD follow' failed, so the identities below may be unblocked already:" \
           "$(head -c 200 "$tmp/follow-err" | LC_ALL=C tr -c '[:print:]' ' ')" >&2
    fi
  fi
  while IFS= read -r nid; do
    if grep -qxF "$nid" "$tmp/malware-nids-kept"; then
      echo "# WARN an earlier run blocked $nid as malware, and it is a delegate of a repo" \
           "the malware rule (H) spares, whose updates the block stops. Lift it with:" \
           "rad unfollow $nid" >&2
    else
      echo "# WARN an earlier run blocked $nid as malware, and the malware rule (H)" \
           "clears it now. Lift that block with: rad unfollow $nid" >&2
    fi
  done < "$tmp/malware-unblock"
fi

: > "$tmp/repos"   # rid \t size \t mtime \t life \t birth
for rid in "${!SIZE[@]}"; do
  printf '%s\t%s\t%s\t%s\t%s\n' \
    "$rid" "${SIZE[$rid]}" "${MTIME[$rid]:-0}" "${LIFE[$rid]:-0}" "${BIRTH[$rid]:-0}"
done > "$tmp/repos"
total_repos=$(wc -l < "$tmp/repos")

# percentiles for the relative size cut, and for the header line that prints them
read -r p50 p90 p95 p99 < <(cut -f2 "$tmp/repos" | sort -n | awk '
  {a[NR]=$1} END{
    i50=int(0.50*NR); if(i50<1)i50=1; i90=int(0.90*NR); if(i90<1)i90=1
    i95=int(0.95*NR); if(i95<1)i95=1; i99=int(0.99*NR); if(i99<1)i99=1
    printf "%.0f %.0f %.0f %.0f\n", a[i50], a[i90], a[i95], a[i99] }')   # %d caps at 2 GiB
relcut=$(cut -f2 "$tmp/repos" | sort -n \
  | awk -v p="$eff_pctl" '{a[NR]=$1} END{ i=int(p/100*NR); if(i<1)i=1; print a[i] }')
abscut=$(( eff_abs_mb * 1024 * 1024 ))
# Said only when the size rule (B) acts this run: these are the numbers it cuts on.
if rule_on B && [ "$space_rules" = 1 ]; then
  header_line sizes "$total_repos repos  P50=$((p50/1048576))M P90=$((p90/1048576))M" \
                    "P95=$((p95/1048576))M P99=$((p99/1048576))M" \
                    "rel-cut(P${eff_pctl})=$((relcut/1048576))M  abs-cut=${eff_abs_mb}M"
fi

# ------------------------------------------------------------------ near-threshold markers
# A verdict that cleared its thresholds by a hair is the one a reviewer should read first.
# These helpers append a word to $near and always succeed, so no branch can end on a failed
# test and trip `set -e`. They are pure bash arithmetic, so a marker costs nothing per repo.
near_age() {   # $1 = the date the rule measured, $2 = the instant it had to be older than
  [ "$NEAR_PCT" -gt 0 ] && [ "$2" -lt "$now" ] \
    && [ $(( (now - $1) * 100 )) -lt $(( (now - $2) * (100 + NEAR_PCT) )) ] \
    && near="$near+age"
  return 0
}
near_min() {   # $1 = the value measured, $2 = the minimum it had to reach, $3 = its label
  [ "$NEAR_PCT" -gt 0 ] && [ "$2" -gt 0 ] \
    && [ $(( $1 * 100 )) -lt $(( $2 * (100 + NEAR_PCT) )) ] \
    && near="$near+$3"
  return 0
}
near_max() {   # $1 = the value measured, $2 = the maximum it had to stay under, $3 = its label
  [ "$NEAR_PCT" -gt 0 ] && [ "$2" -gt 0 ] \
    && [ $(( $1 * 100 )) -gt $(( $2 * (100 - NEAR_PCT) )) ] \
    && near="$near+$3"
  return 0
}

# The plan row's columns, spelled once for both files that carry them out of the run, so the
# two headers cannot disagree.
plan_header(){
  printf '# rid\tsize_bytes\tother_seeds\tlast_activity_unix\treason\tname'
  printf '\tage_from_unix\tnear_threshold\n'
}

# Rule A's word branch spares an imported project: oldest commit more than IMPORT_SPARE_DAYS
# before its `rad init`. Prints that gap in seconds, or nothing when either date does not read.
# Author dates survive a rebase or a conversion from another VCS. It walks every commit on the
# branches: 22 s on a 1.3M-commit mirror without a commit-graph, under a second for most.
# Backdating commits spares a repo, which is harmless: rule A catches forgotten repos, not
# people trying to keep one. --no-show-signature, since log.showSignature in the caller's
# config would print a line before the date.
import_gap() {   # $1 = rid
  local d="$STORAGE/$1" init oldest
  # A git log that dies part-way lists only some roots, and a later oldest root can make an
  # import read as new, so a failed listing gives no gap.
  init=$(GIT_DIR="$d" git log --no-show-signature --format=%ct --max-parents=0 refs/rad/id \
           2>/dev/null) || return 0
  oldest=$(GIT_DIR="$d" git log --no-show-signature --branches --format=%at --max-parents=0 \
             2>/dev/null) || return 0
  init=$(awk 'NR == 1 || $1 < m { m = $1 } END { print m }' <<<"$init")
  oldest=$(awk 'NR == 1 || $1 < m { m = $1 } END { print m }' <<<"$oldest")
  # Anything but digits would end the classify loop part-way through inside $(( )).
  [[ $init =~ ^[0-9]+$ && $oldest =~ ^[0-9]+$ ]] || return 0
  echo $(( init - oldest ))
}
import_cut=$(( IMPORT_SPARE_DAYS * 86400 ))
: > "$tmp/imports"   # rid \t name, for every repo the import spare kept
: > "$tmp/import-blind"   # junk-named repos whose commit dates did not read

# ------------------------------------------------ rule H: malware operations, one repo, judge
# The first file path at the tips of the canonical branches and tags, or else the first commit
# subject, that holds a strong word whole or with one trailing "s". Canonical refs only, since
# a peer's namespace is anybody's to push to. Each distinct tree is listed once, branches
# first, up to MALWARE_TREES, so thousands of tags cannot push the branches out. Paths and
# subjects are author-written and the match reaches the terminal, so control characters go
# first. awk stops at the first match and head at MALWARE_BYTES. The listing then dies on the
# broken pipe, whose status the caller ignores. Path quoting and subject encoding are pinned,
# since git reads both from the caller's config and the same repo would read differently per
# user.
malware_evidence() {   # $1 = rid
  local d="$STORAGE/$1" tree
  { GIT_DIR="$d" git for-each-ref --format='%(objectname)^{tree}' refs/heads refs/tags \
        2>/dev/null \
      | GIT_DIR="$d" git cat-file --batch-check='%(objectname)' 2>/dev/null \
      | grep -E '^[0-9a-f]{40,64}$' | awk '!seen[$0]++' | head -n "$MALWARE_TREES" \
      | while read -r tree; do
          GIT_DIR="$d" git -c core.quotePath=true ls-tree -r --name-only "$tree" 2>/dev/null \
            | sed 's/^/path: /' \
            || break
        done
    GIT_DIR="$d" git log --no-show-signature --encoding=UTF-8 --branches --tags \
      --format='subject: %s' -n "$MALWARE_SUBJECTS" 2>/dev/null
  } | head -c "$MALWARE_BYTES" | LC_ALL=C tr -d '\000-\010\011\013-\037\177' \
    | { iconv -f UTF-8 -t UTF-8 -c 2>/dev/null || true; } \
    | LC_ALL=C sed "$HIDDEN_CHARS_SED" \
    | awk -v strong="$MALWARE_STRONG_WORDS" '
      function known(list, key) { return key != "" && index("|" list "|", "|" key "|") > 0 }
      {
        text = tolower($0); gsub(/[^a-z0-9]+/, " ", text); n = split(text, w, " ")
        for (i = 1; i <= n; i++) {
          word = w[i]
          if (!known(strong, word) && word ~ /s$/) word = substr(word, 1, length(word) - 1)
          if (!known(strong, word)) continue
          # Cut a long line around the word so the part shown holds it. The leading space
          # makes the first character a word boundary too.
          at = match(" " tolower($0), "[^a-z0-9]" word "s?([^a-z0-9]|$)")
          from = (at > 60) ? at - 40 : 1
          print (from > 1 ? "..." : "") substr($0, from, 100); exit
        }
      }'
}
# Rows: rid, the words in its name and description, the path or subject found, and the name.
# Repos the identity judge named are left to it. Repos with signed refs from an identity that
# judge leaves out are skipped. Naming that identity is not enough, since anybody can.
: > "$tmp/malware-repos"
: > "$tmp/malware-undated"   # the same rows, for repos whose commit dates did not read
if rule_on H; then
  malware_cut=$(( MALWARE_ORIGINAL_DAYS * 86400 ))
  cut -f4 "$tmp/malware" | sort -u > "$tmp/malware-named"
  while IFS=$'\t' read -r rid found isstrong rname; do
    [ "$isstrong" = 1 ] || continue
    [ -z "${EXCL[$rid]:-}" ] && [ -z "${DENY_RID[$rid]:-}" ] || continue
    grep -qxF "$rid" "$tmp/malware-named" && continue
    [ -z "${MALWARE_OP[$rid]:-}" ] || continue
    skipped=0
    IFS=, read -ra signers <<<"${SIGNERS[$rid]:-}"
    for sg in "${signers[@]}"; do grep -qxF "$sg" "$tmp/malware-vouched" && skipped=1; done
    # A listed identity among its delegates, signed or not, has the deny list prune it.
    IFS=, read -ra dels <<<"${DELEGATES[$rid]:-}"
    for dl in "${dels[@]}"; do [ -n "${DENY_NID[$dl]:-}" ] && skipped=1; done
    [ "$skipped" = 0 ] || continue
    evidence=$(malware_evidence "$rid") || true
    [ -n "$evidence" ] || continue
    # The first commit's date is the pusher's, so backdating keeps a repo off this list. That
    # misses an operation, and never names an honest repo.
    gap=$(import_gap "$rid")
    row=$(printf '%s\t%s\t%s\t%s' "$rid" "$found" "$evidence" "$rname")
    if [ -z "$gap" ]; then printf '%s\n' "$row" >> "$tmp/malware-undated"; continue; fi
    [ "$gap" -le "$malware_cut" ] || continue
    printf '%s\n' "$row" >> "$tmp/malware-repos"
  done < "$tmp/malware-words"
fi
nmalware_repos=$(wc -l < "$tmp/malware-repos")
nmalware_undated=$(wc -l < "$tmp/malware-undated")
if [ "$nmalware_undated" -gt 0 ]; then
  echo "# WARN $nmalware_undated repo(s) hold a strong malware word in the name or" \
       "description and in a file path or commit subject, but the malware rule (H) could not" \
       "read their commit dates to tell an original from a mirror. Read them. Adding a line below to" \
       "$DENY_FILE prunes and blocks its repo. In $KEEP_FILE the line keeps the repo and" \
       "clears all its delegates of the malware rule (H):" >&2
  head -n "$top_evidence" "$tmp/malware-undated" \
    | while IFS=$'\t' read -r rid found evidence rname; do
        printf '#   rad:%s  # %s (%s; %s)\n' "$rid" "$rname" "$found" "$evidence"
      done >&2
  [ "$nmalware_undated" -gt "$top_evidence" ] \
    && echo "#   ...and $((nmalware_undated - top_evidence)) more (PLAN_FULL=1 lists them)" >&2
fi

# ---------- classify (map lookups + native bash regex; git only for rule A's import spare)
: > "$tmp/plan"   # rid \t size \t seeds \t life \t reason \t name \t age_from \t near
: > "$tmp/check-judged"
: > "$tmp/media-review"
nblind=0; nfresh=0; nnoage=0
: > "$tmp/deny-kept"        # rid \t why, for every denied repo an exclusion kept
: > "$tmp/deny-nids-kept"   # listed identities that delegate one of those kept repos
: > "$tmp/deny-why"         # rid \t why, for every denied repo in the plan
: > "$tmp/copy-why"         # the $tmp/copies row of every copy in the plan
while IFS=$'\t' read -r rid sz mt life birth; do
  # The deny list comes first, as it needs nothing the checks below establish: no readable
  # size, no age, no settled fetch. A listed identity condemns only repos it is a DELEGATE of,
  # or anyone could get a repo pruned by commenting on it from a listed identity.
  denied=""
  [ -n "${DENY_RID[$rid]:-}" ] && denied="listed"
  IFS=, read -ra dls <<<"${DELEGATES[$rid]:-}"
  # A repo listed by id keeps "listed" as its cause even when a delegate is listed too.
  for nid in "${dls[@]}"; do
    [ -z "$denied" ] || break
    [ -n "${DENY_NID[$nid]:-}" ] && denied="delegate $nid"
  done
  if [ -n "$denied" ]; then
    if [ -n "${EXCL[$rid]:-}" ]; then
      printf '%s\t%s\n' "$rid" "$denied" >> "$tmp/deny-kept"
      # Blocking a delegate stops their repos' updates, this kept one included, so its listed
      # delegates are spared the block.
      for nid in "${dls[@]}"; do
        [ -n "${DENY_NID[$nid]:-}" ] && printf '%s\n' "$nid" >> "$tmp/deny-nids-kept"
      done
    else
      dname=${NAME[$rid]:-}; [ -z "$dname" ] && dname='(?)'
      # Column 7 is the date age was measured from. The deny list measures none, so 0, which
      # the plan prints as "-".
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$rid" "${sz:-0}" "${SEEDS[$rid]:-0}" "$life" "denied" "$dname" 0 "" \
        >> "$tmp/plan"
      printf '%s\t%s\n' "$rid" "$denied" >> "$tmp/deny-why"
    fi
    continue
  fi
  # A copy of files a denied repo carried. No age or settled fetch needed: the evidence is
  # files on its own delegates' branches, and a leak's copy is worth catching the week it
  # lands. It is the tool's inference, not a person's verdict, so it gets its own reason, which
  # the runaway caps and the ratchet count.
  if [ -n "${COPY[$rid]:-}" ]; then
    if [ -n "${EXCL[$rid]:-}" ]; then
      # "quarantine restore" is a person overruling this, which needs no weekly warning. A
      # pinned, private or own repo is named.
      grep -qxF "$rid" "$tmp/kept" \
        || printf '%s\t%s\n' "$rid" "copy of denied files" >> "$tmp/deny-kept"
    else
      dname=${NAME[$rid]:-}; [ -z "$dname" ] && dname='(?)'
      near=""
      near_min "${COPYHELD[$rid]}" "$COPY_MIN_BYTES" bytes
      near_min "${COPYPCT[$rid]}" "$COPY_MIN_PCT" share
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$rid" "${sz:-0}" "${SEEDS[$rid]:-0}" "$life" "denied-copy" "$dname" 0 \
        "${near:+${near#+}}" >> "$tmp/plan"
      printf '%s\n' "${COPYROW[$rid]}" >> "$tmp/copy-why"
    fi
    continue
  fi
  [ -n "${SCANFAIL[$rid]:-}" ] && { nblind=$((nblind+1)); continue; }  # size and age unusable
  [ -n "${EXCL[$rid]:-}" ] && continue                # pinned / private / own
  # Freshness before age: a repo mid-fetch has no refs yet and would count as ageless against
  # the scan guard below.
  [ "$mt" -ge "$fresh_cut" ] && { nfresh=$((nfresh+1)); continue; }   # in-flight fetch
  [ "$life" = 0 ] && { nnoage=$((nnoage+1)); continue; }               # unknown age: leave it
  # A check calls a repo ok only when it reached the rules below.
  [ "$CMD" != check-mine ] || printf '%s\n' "$rid" >> "$tmp/check-judged"

  # Rules D and F measure age from the older of the repo's oldest ref date and the day this
  # seed first saw it. A pusher controls the first and cannot reach the second.
  origin=$birth
  [ -n "${FIRSTSEEN[$rid]:-}" ] && [ "${FIRSTSEEN[$rid]}" -lt "$origin" ] \
    && origin=${FIRSTSEEN[$rid]}

  name=${NAME[$rid]:-}; [ -z "$name" ] && name='(?)'
  seeds=${SEEDS[$rid]:-0}

  lname=${name,,}
  # No word in JUNK_WORD_REGEX is spellable in [0-9a-f], so a pure-hex name never hits it and
  # the two flags cannot both be set. A hex-spellable word (dead, beef, cafe) would break that.
  is_junk=0     # a disposable WORD in the name: a guess, so it keeps the last-copy floor
  is_junkid=0   # the name is ONLY a random hex id: generated, so it may prune the last copy
  if [[ $lname =~ $JUNK_WORD_REGEX ]] || [[ $lname =~ $JUNK_EXACT_REGEX ]]; then is_junk=1; fi
  if [ "$JUNK_ID_MIN_LEN" -gt 0 ] && [ "${#lname}" -ge "$JUNK_ID_MIN_LEN" ] \
     && [[ $lname =~ ^[0-9a-f]+$ ]] && [[ $lname =~ [a-f] ]] && [[ $lname =~ [0-9] ]]; then
    is_junkid=1
  fi
  # A disposable word in the name of a project older than its `rad init` is no evidence it was
  # thrown away. Asked of every repo the word branch would otherwise prune, since it reads
  # history. Rules D and F may still prune some first.
  gap=""; is_import=0
  if [ "$is_junk" = 1 ] && rule_on A && [ "$life" -lt "$junk_cut" ] \
     && [ "$seeds" -ge "$JUNK_MIN_SEEDS" ]; then
    gap=$(import_gap "$rid")
    if [ -z "$gap" ]; then printf '%s\n' "$rid" >> "$tmp/import-blind"
    elif [ "$gap" -gt "$import_cut" ]; then is_import=1; fi
  fi
  is_big=0; [ "$sz" -gt "$abscut" ] && [ "$sz" -ge "$relcut" ] && is_big=1

  reason=""
  # H, D and F come first, so a malware-named repo, generated bulk or a media-only tree reads
  # as that and not as staleness. H leads, so a spam batch that is also malware reads as
  # malware.
  # H asks no age or seed count: its evidence is the repo's name and content, and a copy of a
  # malware toolkit nobody else seeds is not worth keeping. The quarantine is its undo, and the
  # guards above still keep a fetch in flight from being judged.
  # D and F measure $origin. Their evidence is not about time, so the window is only a grace
  # period, and measured from last activity it would never expire: a spammer resets it by
  # appending a COB every few days.
  # $age_from is the date the matching rule measured, so the AGE column explains the verdict.
  # Without it a spam-batch row touched yesterday prints AGE 1 beside a 7-day minimum.
  # Each branch asks rule_on first, so a rule left out of RULES cannot claim a repo whose row
  # is then dropped, hiding it from the rules still running.
  age_from=$life
  near=""
  # The map is filled only under MALWARE_PRUNE=1.
  if   rule_on H && [ -n "${MALWARE_OP[$rid]:-}" ]; then
    reason="malware-op"
  elif rule_on D && [ -n "${SPAM[$rid]:-}" ] && [ "$origin" != 0 ] \
       && [ "$origin" -lt "$spam_cut" ] && [ "$seeds" -ge "$SPAM_MIN_SEEDS" ]; then
    reason="spam-batch"; age_from=$origin
    near_age "$origin" "$spam_cut"; near_min "$seeds" "$SPAM_MIN_SEEDS" seeds
  # A pardon (UNDO_PARDON) undoes a wrong media verdict, so it spares the repo rule F only.
  # Under pressure B and C weigh it like any other. Revisit when an entry targets another rule.
  elif rule_on F && [ -n "${MEDIA[$rid]:-}" ] && [ -z "${PARDON[$rid]:-}" ] \
       && [ "$origin" != 0 ] \
       && [ "$origin" -lt "$media_cut" ] && [ "$seeds" -ge "$MEDIA_MIN_SEEDS" ]; then
    reason=${MEDIA[$rid]}; age_from=$origin
    near_age "$origin" "$media_cut"; near_min "$seeds" "$MEDIA_MIN_SEEDS" seeds
    near_min "${MEDIABYTES[$rid]}" "$MEDIA_MIN_BYTES" media
  elif rule_on A && [ "$is_junkid" = 1 ] && [ "$life" -lt "$junk_cut" ] \
       && [ "$seeds" -ge "$JUNK_ID_MIN_SEEDS" ]; then
    reason="junk-id"
    near_age "$life" "$junk_cut"; near_min "$seeds" "$JUNK_ID_MIN_SEEDS" seeds
  elif rule_on A && [ "$is_junk" = 1 ] && [ "$life" -lt "$junk_cut" ] \
       && [ "$seeds" -ge "$JUNK_MIN_SEEDS" ] && [ "$is_import" = 0 ]; then
    reason="junk-name"
    near_age "$life" "$junk_cut"; near_min "$seeds" "$JUNK_MIN_SEEDS" seeds
    near_max "${gap:-0}" "$import_cut" import
  elif rule_on B && [ "$space_rules" = 1 ] && [ "$is_big" = 1 ] \
       && [ "$life" -lt "$outlier_cut" ] && [ "$seeds" -ge "$eff_seeds" ]; then
    reason="size-outlier"
    near_age "$life" "$outlier_cut"; near_min "$seeds" "$eff_seeds" seeds
    # Both size bars have to be cleared, so the tighter of the two is the one worth reporting.
    if [ "$abscut" -gt "$relcut" ]; then near_min "$sz" "$abscut" size
    else                                 near_min "$sz" "$relcut" size; fi
  elif rule_on C && [ "$space_rules" = 1 ] && [ "$life" -lt "$stale_cut" ] \
       && [ "$seeds" -ge "$eff_seeds" ]; then
    reason="stale"
    near_age "$life" "$stale_cut"; near_min "$seeds" "$eff_seeds" seeds
  fi
  # What a raised MEDIA_MIN_SEEDS spared, listed because a hidden seed floor is a standing
  # exemption for anyone who keeps their dump unseeded elsewhere. Empty at the default of 0.
  # Only repos nothing else prunes are listed, so the line can say they were kept.
  if [ -z "$reason" ] && rule_on F && [ -n "${MEDIA[$rid]:-}" ] && [ "$origin" != 0 ] \
     && [ "$origin" -lt "$media_cut" ] && [ "$seeds" -lt "$MEDIA_MIN_SEEDS" ]; then
    printf '%s\t%s\t%s\n' "$rid" "${MEDIA[$rid]}" "$name" >> "$tmp/media-review"
  fi
  # Listed only when no other rule matched the repo, so the list can say it was kept.
  if [ -z "$reason" ] && [ "$is_import" = 1 ]; then
    printf '%s\t%s\n' "$rid" "$name" >> "$tmp/imports"
  fi
  [ -z "$reason" ] && continue
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$rid" "$sz" "$seeds" "$life" "$reason" "$name" "$age_from" "${near:+${near#+}}" \
    >> "$tmp/plan"
done < "$tmp/repos"

# A scan that missed much of storage gives a small plan, which reads like good news, so refuse.
# Three ways to miss a repo: it vanished mid-walk, find or du failed on it, or its refs would
# not list, leaving it ageless. Ageless counts at the same limit as the others. It is no
# background rate: four weekly runs over a 12.5k-repo seed each reported zero.
skipped=""
[ "$nblind" = 0 ] || skipped="$skipped, $nblind unreadable"
[ "$nnoage" = 0 ] || skipped="$skipped, $nnoage with no readable refs"
[ "$nfresh" = 0 ] \
  || skipped="$skipped, $nfresh written in the last $(count "$FRESH_GUARD_DAYS" day days)"
[ -z "$skipped" ] || echo "# skipped ${skipped#, }"
# A failed history read makes rule A treat the repo as not imported. Named for a hand check.
nimportblind=$(wc -l < "$tmp/import-blind")
if [ "$nimportblind" -gt 0 ]; then
  echo "# WARN could not read the commit dates of $nimportblind junk-named repo(s), so the" \
       "junk-name rule (A) treats them as not imported:" >&2
  head -n "$top_evidence" "$tmp/import-blind" | sed 's/^/#   /' >&2
  [ "$nimportblind" -gt "$top_evidence" ] \
    && echo "#   ...and $((nimportblind - top_evidence)) more (PLAN_FULL=1 lists them)" >&2
fi
# Two people's words disagree here, and the keep wins, because a prune cannot be undone. Named,
# so a person settles it.
ndenykept=$(wc -l < "$tmp/deny-kept")
if [ "$ndenykept" -gt 0 ]; then
  echo "# WARN $ndenykept repo(s) on the deny list or holding copies of" \
       "denied files are kept anyway, because they are pinned, private, our own or in" \
       "$KEEP_FILE:" >&2
  head -n "$top_evidence" "$tmp/deny-kept" | sed 's/^/#   /; s/\t/  /' >&2
  [ "$ndenykept" -gt "$top_evidence" ] \
    && echo "#   ...and $((ndenykept - top_evidence)) more (PLAN_FULL=1 lists them)" >&2
fi
# A repo can reach $tmp/repos without being one of the directories counted at the top of the
# walk, so this subtraction can come out below zero and must not then credit the scan.
vanished=$(( nrepos - total_repos )); [ "$vanished" -lt 0 ] && vanished=0
blind=$(( vanished + nblind + nnoage ))
[ "$blind" -le $(( nrepos * MAX_SCAN_FAIL_PCT / 100 )) ] || {
  echo "# ABORT($mode): could not judge $blind of $nrepos repos" \
       "(limit ${MAX_SCAN_FAIL_PCT}%):" \
       "$vanished vanished, $nblind unreadable," \
       "$nnoage with no readable refs." >&2
  echo "# A plan from a scan this blind would look small for the wrong reason." >&2
  echo "# The three counts come from find, du and git, so check those first. To let a run go" \
       "ahead over a storage that is genuinely like this: MAX_SCAN_FAIL_PCT=<percent>." >&2
  exit 5
}

# -------------------------------------------------------------------------------------- report
sort -t$'\t' -k2,2nr "$tmp/plan" > "$tmp/plan.sorted"
nplan=$(wc -l < "$tmp/plan.sorted")
bytes=$(awk -F'\t' '{s+=$2} END{printf "%.0f", s}' "$tmp/plan.sorted")
gib=$(awk -v b="$bytes" 'BEGIN{printf "%.2f", b/1073741824}')

# ---------------------------------------------------------------------------------- the check
# A check stops here, before anything acts on the plan, and says per repo what the rule saw
# and what would change the verdict. It never says how close a repo came to a threshold, which
# would let a spam template be tuned until it passes.
# check_biggest: the 5 biggest files at the tips of repo $1's branches and tags, as
# "bytes \t ref \t path", from the canonical refs and this node's namespace. Rule F also
# counts attachments and other delegates' branches, which this does not list. %.0f, because
# mawk prints 2 GiB or more as 2.1e+09, which sort -n misreads. Names are delegate-pushed and
# reach the terminal. quotePath off still escapes control characters but not UTF-8 C1 ones,
# which a ref name may hold too, so those go with the rest HIDDEN_CHARS_SED removes.
check_biggest() {
  local d="$STORAGE/$1" ref short
  { GIT_DIR="$d" git for-each-ref --format='%(refname)' refs/heads refs/tags \
      "refs/namespaces/$OUR_NID/refs/heads" "refs/namespaces/$OUR_NID/refs/tags" 2>/dev/null \
      || true; } \
    | while IFS= read -r ref; do
        short=${ref#refs/namespaces/"$OUR_NID"/}; short=${short#refs/heads/}
        short=${short#refs/tags/}
        { GIT_DIR="$d" git -c core.quotePath=false ls-tree -r -l "$ref" 2>/dev/null \
            || true; } \
          | awk -F'\t' -v ref="$short" '{ split($1, f, " ")
                                          printf "%.0f\t%s\t%s\n", f[4], ref, $2 }'
      done \
    | { iconv -f UTF-8 -t UTF-8 -c 2>/dev/null || true; } \
    | LC_ALL=C sed "$HIDDEN_CHARS_SED" \
    | sort -t$'\t' -k1,1nr | awk -F'\t' '!seen[$3]++ && n++ < 5'
}
check_pruned=0
check_flagged=0
check_unjudged=0
check_ok=0
check_report() {
  local rid name reason nrepos width=0 status what sev
  local -A VERDICT=() JUDGED=() UNREAD=() FLAGGED=()
  while IFS=$'\t' read -r rid _ _ _ reason _; do VERDICT[$rid]=$reason; done < "$tmp/plan.sorted"
  while IFS= read -r rid; do JUDGED[$rid]=1; done < "$tmp/check-judged"
  while IFS=$'\t' read -r rid _; do UNREAD[$rid]=1; done < "$tmp/media-fail"
  while IFS=$'\t' read -r rid _; do FLAGGED[$rid]=1; done \
    < <(cat "$tmp/malware-repos" "$tmp/malware-undated")
  nrepos=$(wc -l < "$tmp/check-repos")
  if [ "$nrepos" = 0 ]; then
    echo "# Nothing to check: no public repo in $STORAGE names this node's identity" \
         "($OUR_NID) as a delegate."
    return 0
  fi
  echo "# check-mine  $(count "$nrepos" "public repo" "public repos") of yours, judged as a" \
       "seed judges a repo once it is old enough"
  echo "# rules  A junk-name, D spam-batch, F media, H malware   not checked: B size, C stale," \
       "G parasite-peer, deny lists"
  echo "#        A seed also looks for media batches across every repo it holds, so it can find" \
       "one this check misses."
  # The names share a column, so the ids line up under each other.
  while IFS= read -r rid; do
    name=${NAME[$rid]:-(?)}
    [ "${#name}" -le "$width" ] || width=${#name}
  done < "$tmp/check-repos"
  [ "$width" -le 32 ] || width=32

  # Each block goes to its severity's file, so the report opens with what needs fixing. Name
  # order within a severity.
  : > "$tmp/check-1"; : > "$tmp/check-2"; : > "$tmp/check-3"; : > "$tmp/check-4"
  while IFS= read -r rid; do
    name=${NAME[$rid]:-(?)}
    reason=${VERDICT[$rid]:-}
    # A seed never prunes a repo for these words alone but lists it for its operator, who may
    # add it to the deny list. This tells the publisher.
    if [ -z "$reason" ] && [ -n "${FLAGGED[$rid]:-}" ]; then
      check_flagged=$((check_flagged + 1))
      sev=2; status=flagged; what="possible malware"
    elif [ -z "$reason" ] && { [ -n "${UNREAD[$rid]:-}" ] || [ -z "${JUDGED[$rid]:-}" ]; }; then
      check_unjudged=$((check_unjudged + 1))
      sev=3; status=unjudged; what=""
    elif [ -z "$reason" ]; then
      check_ok=$((check_ok + 1))
      sev=4; status=ok; what=""
    else
      check_pruned=$((check_pruned + 1))
      sev=1; status=would-prune; what=$reason
    fi
    {
      printf '%-12s %-*s  rad:%s  %s\n' "$status" "$width" "$name" "$rid" "$what" \
        | sed 's/ *$//'
      check_why "$rid" "$reason" "$status" | fold -s -w 87 | sed 's/ *$//; s/^/             /'
      case $reason in media-*)
        check_biggest "$rid" > "$tmp/check-biggest"
        [ -s "$tmp/check-biggest" ] || echo "                none"
        # Names are read as input, never via -v, which would turn "\033" into an escape.
        awk -F'\t' '{
          if      ($1 >= 1048576) printf "%20.1f MiB  %s  %s\n", $1 / 1048576, $2, $3
          else if ($1 >= 1024)    printf "%20.0f KiB  %s  %s\n", $1 / 1024, $2, $3
          else                    printf "%20.0f B    %s  %s\n", $1, $2, $3 }' \
          "$tmp/check-biggest" ;;
      esac
    } >> "$tmp/check-$sev"
  done < <(while IFS= read -r rid; do printf '%s\t%s\n' "${NAME[$rid]:-}" "$rid"; done \
             < "$tmp/check-repos" | sort | cut -f2)
  echo
  cat "$tmp/check-1" "$tmp/check-2" "$tmp/check-3" "$tmp/check-4"
  echo
  local tally=""
  [ "$check_pruned" = 0 ]   || tally="$tally, $check_pruned would be pruned"
  [ "$check_flagged" = 0 ]  || tally="$tally, $check_flagged flagged"
  [ "$check_unjudged" = 0 ] || tally="$tally, $check_unjudged unjudged"
  [ "$check_ok" = 0 ]       || tally="$tally, $check_ok ok"
  if [ $((check_pruned + check_flagged)) = 0 ]; then
    echo "# ${tally#, }"
  else
    echo "# ${tally#, } (exit 6)"
  fi
}
# What a seed sees and what the publisher can do, as plain lines check_report wraps. $1 = rid,
# $2 = verdict, $3 = status. Called from check_report only, whose UNREAD and FLAGGED maps it
# reads.
check_why() {
  local rid=$1 reason=$2 status=$3
  case $status in
    flagged)
      echo "Its name or description, and a file path or commit subject, use a word such as" \
           "stealer, keylogger or botnet. A seed lists it for its operator to read, and" \
           "prunes it only if the operator adds it to the deny list."
      echo "Fix: if it is not malware, name and describe it without these words, or ask" \
           "the seeds you rely on to keep it."
      return 0 ;;
    unjudged)
      if [ -n "${UNREAD[$rid]:-}" ]; then
        echo "The media rule (F) could not judge it: it has more refs, issue and patch ops or" \
             "files of unknown type than the rule's limits allow, or git could not read part" \
             "of it."
      else
        echo "It could not be read, or it changed while the check ran. Run the check again."
      fi
      return 0 ;;
    ok) return 0 ;;
  esac
  [ -z "${FLAGGED[$rid]:-}" ] \
    || echo "Its name or description, and a file path or commit subject, also use a" \
            "word such as stealer, keylogger or botnet, so seeds list it for review."
  case $reason in
    media-dump)
      echo "It holds images, video, audio or archives, no source or build file, and" \
           "under $(header_bytes "$MEDIA_TEXT_MAX_BYTES") of anything else."
      echo "Fix: add what the media belongs to, such as its source, its build files or" \
           "pages that use it, or host the media elsewhere and link to it." ;;
    media-ratio)
      echo "Its branches and tags hold images, video or audio, and besides them nothing" \
           "but a README."
      echo "Fix: add what the media belongs to, such as its source, its build files or" \
           "pages that use it, or host the media elsewhere and link to it." ;;
    media-batch)
      echo "It holds the same media files as $((MEDIA_MIN_BATCH - 1)) or more other" \
           "repos of yours, and little else."
      echo "Fix: keep each media file in one repo, or host it elsewhere and link to it." ;;
    spam-batch)
      echo "Its name and description follow one template that $SPAM_MIN_BATCH or more" \
           "repos on this node share."
      echo "Fix: give it a name and a description of its own." ;;
    malware-op)
      echo "An identity among its delegates founded repos named or described like a malware" \
           "operation, with words such as stealer, botnet or panel. A seed that prunes" \
           "malware (MALWARE_PRUNE=1) prunes every repo that identity is a delegate of."
      echo "Fix: if it is not malware, name and describe those repos without these words," \
           "or ask the seeds you rely on to keep it." ;;
    junk-name|junk-id)
      if [ "$reason" = junk-id ]; then
        echo "Its name is nothing but a random id."
      else
        echo "Its name reads like a throwaway, such as test, demo or tmp."
      fi
      echo "A seed prunes it once nobody has pushed to it for $JUNK_STALE_DAYS days."
      echo "Fix: give it a name that says what it is." ;;
  esac
  case $reason in media-*)
    echo "Biggest files on its branches and tags. The media rule (F) also counts the" \
         "delegates' issue and patch attachments and the other delegates' branches, not listed" \
         "here:" ;;
  esac
}
if [ "$CMD" = check-mine ]; then
  check_report >&3
  [ $((check_pruned + check_flagged)) = 0 ] || exit 6
  exit 0
fi

# Repos the newest run that planned them blocked but could not remove ("# prune-failed:"),
# so still in storage under rad-prune's own block.
prune_failed_before() {
  local f logs=()
  for f in "$AUDIT_DIR"/prune-*.log; do [ -r "$f" ] && logs+=("$f"); done
  [ ${#logs[@]} -gt 0 ] || return 0
  awk -F'\t' '
    /^# prune-failed: rad:z/ { split($0, w, " "); failed[substr(w[3], 5)] = 1; next }
    /^#/ { next }
    $1 ~ /^z[1-9A-HJ-NP-Za-km-z]+$/ && $5 != "" { failed[$1] = 0 }
    END { for (r in failed) if (failed[r]) print r }' "${logs[@]}"
}
prune_failed_before > "$tmp/prune-failed-before"
# A run that plans such a repo again retries the removal under its block. Once the repo is
# kept, pinned, private or your own, or its verdict is withdrawn or named by UNDO_PARDON or
# UNDO_LIFT, the block is lifted here, since the undo's other lifts cover only repos that left
# storage. Missing from the plan alone is no reason: a rule left out of RULES or an unreadable
# repo is missing too. The deny list keeps it blocked, as does a lift already made once. No
# fetch, so no budget and no disk check.
: > "$tmp/undo-failed"
if [ "$UNDO" = 1 ] && [ -s "$tmp/prune-failed-before" ]; then
  # The verdicts whose block the undo would lift were the repo out of storage, judged the same
  # way: size (B) or stale (C) only while those rules wait.
  while IFS=$'\t' read -r rid reason _ _ ver _; do
    grep -qxF -- "$rid" "$tmp/prune-failed-before" || continue
    if withdrawn_cap "$reason" "$ver" >/dev/null; then
      printf '%s\n' "$rid"
    elif [[ $reason == media-* ]] && grep -qxF -- "$rid" "$tmp/undo-pardoned"; then
      printf '%s\n' "$rid"
    elif [ "$reason" = junk-name ] && grep -qxF -- "$rid" "$tmp/undo-liftonly"; then
      printf '%s\n' "$rid"
    fi
  done < "$tmp/undo-fold" > "$tmp/undo-failed-spared"
  awk -F'\t' '
      FILENAME == ARGV[1] { failed[$1] = 1; next }
      FILENAME == ARGV[2] { blocked[$1] = 1; next }
      FILENAME == ARGV[3] { spared[$1] = 1; next }
      FILENAME == ARGV[4] { spared[$1] = 1; next }
      FILENAME == ARGV[5] { planned[$1] = 1; next }
      FILENAME == ARGV[6] { denied[$1] = 1; next }
      FILENAME == ARGV[7] { deniednid[$1] = 1; next }
      ($1 in failed) && ($1 in blocked) && ($1 in spared) && !($1 in planned) \
        && !($1 in denied) && $2 !~ /^denied/ && $7 == 0 {
        n = split($6, pairs, ",")
        for (i = 1; i <= n; i++) { split(pairs[i], kv, ":"); if (kv[1] in deniednid) next }
        print $1 "\tunblock\tprune-failed\t" $2 "\t" $3 "\t" $4 "\t" $5 "\t" $6 \
              "\tin-storage" }' \
    "$tmp/prune-failed-before" "$tmp/undo-blocked" "$tmp/excluded" "$tmp/undo-failed-spared" \
    "$tmp/plan.sorted" "$tmp/deny-rids" "$tmp/deny-nids" "$tmp/undo-fold" \
    | while IFS=$'\t' read -r rid state why reason size at ver dl copy; do
        [ -d "$STORAGE/$rid" ] || continue
        # A log with no delegates recorded leaves the repo to name them.
        denied_delegate=0
        if [ "$dl" = "-" ]; then
          read_delegates "$STORAGE/$rid"
          for did in $dids; do grep -qxF "$did" "$tmp/deny-nids" && denied_delegate=1; done
        fi
        if [ "$denied_delegate" = 0 ]; then
          printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
                 "$rid" "$state" "$why" "$reason" "$size" "$at" "$ver" "$copy"
        fi
      done > "$tmp/undo-failed"
fi
nfailedlift=$(wc -l < "$tmp/undo-failed")
if [ "$nfailedlift" -gt 0 ]; then
  cat "$tmp/undo-failed" >> "$tmp/undo-states"
  nunblock=$((nunblock + nfailedlift))
  echo "# undo   unblock $(count "$nfailedlift" repo repos) still in storage, blocked by a run" \
       "that could not remove them, and now kept, pinned, private, your own, a known mistake or under a" \
       "verdict a later rad-prune release no longer trusts"
fi

# ------------------------------------------------------------------------- the history ratchet
# Each rule's share of the plan is measured against the median of what it pruned in the last
# RATCHET_RUNS applied runs in which it could prune, and a rule over RATCHET_FACTOR times that
# is held back. Per rule, so one rule's wave holds back only that rule; a whole-plan ratchet
# would make the other rules' sound verdicts wait for a human too.
#
# The past comes from the audit logs history.log names, which list every verdict an applied run
# acted on with its reason. Worked out here so a dry run can show it; whether it holds anything
# back is decided at apply time, where --force and an interactive yes both get past it.
#
# The rule of each verdict. spam-family is rule D's old name, still in older audit logs. A
# reason missing here is ratcheted under its own name, so the ratchet sees every new verdict.
RULE_OF_REASON="junk-name:A junk-id:A size-outlier:B stale:C"
RULE_OF_REASON="$RULE_OF_REASON spam-batch:D spam-family:D"
RULE_OF_REASON="$RULE_OF_REASON media-dump:F media-ratio:F media-batch:F"
RULE_OF_REASON="$RULE_OF_REASON malware-op:H"
# rule \t verdict count in the file named by $1, one line per rule.
count_by_rule() {
  awk -F'\t' -v map="$RULE_OF_REASON" '
    BEGIN { n = split(map, pairs, " ")
            for (i = 1; i <= n; i++) { split(pairs[i], kv, ":"); rule[kv[1]] = kv[2] } }
    # A denied repo is the verdict of a person, so it never counts towards a hold.
    !/^#/ && NF >= 5 && $5 != "denied" { c[($5 in rule) ? rule[$5] : $5]++ }
    END { for (r in c) printf "%s\t%d\n", r, c[r] }' "$1" | sort
}

# Unreadable logs are skipped before the last RATCHET_RUNS are taken, so the baseline is the
# most recent readable past. Warned about, since with fewer than three logs nothing is held.
grep -oE 'audit=[^[:space:]]+' "$AUDIT_DIR/history.log" 2>/dev/null | sed 's/^audit=//' \
  > "$tmp/ratchet-named" || true
while IFS= read -r log; do
  [ -r "$AUDIT_DIR/$log" ] && printf '%s\n' "$AUDIT_DIR/$log"
done < "$tmp/ratchet-named" > "$tmp/ratchet-readable" || true
tail -n "$RATCHET_RUNS" "$tmp/ratchet-readable" > "$tmp/ratchet-logs"
nratchet=$(wc -l < "$tmp/ratchet-logs")
tail -n "$RATCHET_RUNS" "$tmp/ratchet-named" > "$tmp/ratchet-recent"
nrecent=$(wc -l < "$tmp/ratchet-recent")
ngone=0
while IFS= read -r log; do
  [ -r "$AUDIT_DIR/$log" ] || ngone=$((ngone + 1))
done < "$tmp/ratchet-recent"
[ "$ngone" = 0 ] \
  || echo "# WARN cannot read $ngone of the $nrecent most recent audit logs history.log" \
          "names. They tell an unattended run what each rule usually prunes, so it now goes" \
          "by $nratchet, older ones filling in, and with fewer than 3 holds nothing back." >&2

# rule \t repos, one line per past run and rule this run plans. A run in which a rule pruned
# nothing counts as 0, because that is part of what the rule usually does. A run in which the
# rule was off or held back is no sample: counted as 0 it would pull the usual down every week
# the rule waits, until even an ordinary week is held.
# Audit logs older than 0.8.0 do not say which rules were on, and are read as all of them.
# A repo re-pruned by the same rule after this tool's undo let it back, or after a failed
# removal, is no sign of a rule gone wrong, so it does not count towards a hold (the runaway
# caps still count it). Size (B) and stale (C) count as one rule here: under pressure the
# size rule loosens and, checked first, can claim a lifted stale repo. Any other repo counts,
# such as one restored by hand or a lifted one another rule now prunes, since a rule going
# wrong would show first on those.
awk -F'\t' -v map="$RULE_OF_REASON" '
  BEGIN { n = split(map, pairs, " ")
          for (i = 1; i <= n; i++) { split(pairs[i], kv, ":"); rule[kv[1]] = kv[2] } }
  function rule_of(reason) { return (reason in rule) ? rule[reason] : reason }
  function family(r) { return (r == "B" || r == "C") ? "BC" : r }
  FILENAME == ARGV[1] { lifted[$1, family(rule_of($2))] = 1; next }
  FILENAME == ARGV[2] { failed[$1] = 1; next }
  !($1 in failed) && !(($1, family(rule_of($5))) in lifted)' \
  "$tmp/undo-lifted-before" "$tmp/prune-failed-before" "$tmp/plan.sorted" \
  > "$tmp/plan.new-verdicts"
count_by_rule "$tmp/plan.new-verdicts" > "$tmp/ratchet-planned"
# The past leaves out every repeat, or one undo wave re-pruned weekly would set a usual that
# lets the next real wave through. Each row is kept only in the oldest log naming its repo:
# log name \t row. The glob sorts logs oldest first, by the time in their names. A row that
# does not open with a repo id (blocked-peer, blocked-malware) is a block, not a prune.
first_prunes() {
  local f logs=()
  for f in "$AUDIT_DIR"/prune-*.log; do [ -r "$f" ] && logs+=("$f"); done
  [ ${#logs[@]} -gt 0 ] || return 0
  awk -F'\t' '$1 ~ /^z[0-9A-Za-z]+$/ && NF >= 5 && !($1 in seen) {
                 seen[$1] = 1; n = split(FILENAME, p, "/"); print p[n] "\t" $0 }' "${logs[@]}"
}
first_prunes > "$tmp/ratchet-firsts"
# Newest first, up to RATCHET_RUNS samples per rule however far back. A rule that waits for
# disk pressure most weeks then keeps the usual of its last runs, so each spell of pressure is
# not judged against a floor. Stops once every planned rule has its samples.
: > "$tmp/ratchet-past"
declare -A nsamples=()
nplanned=$(wc -l < "$tmp/ratchet-planned"); nfull=0
while [ "$nfull" -lt "$nplanned" ] && IFS= read -r log; do
  rules_then=$(sed -n '/^# [0-9].*  rules=/ { s/.*  rules=//p; q }' "$log")
  awk -F'\t' -v name="${log##*/}" '$1 == name' "$tmp/ratchet-firsts" | cut -f2- \
    > "$tmp/ratchet-onelog-firsts"
  count_by_rule "$tmp/ratchet-onelog-firsts" > "$tmp/ratchet-onelog"
  while IFS=$'\t' read -r letter _; do
    case $letter in
      [A-Z]) [ -z "$rules_then" ] || [[ $rules_then == *$letter* ]] || continue ;;
    esac
    grep -q "^# held back: rule $letter," "$log" && continue
    [ "${nsamples[$letter]:-0}" -lt "$RATCHET_RUNS" ] || continue
    nsamples[$letter]=$(( ${nsamples[$letter]:-0} + 1 ))
    [ "${nsamples[$letter]}" -lt "$RATCHET_RUNS" ] || nfull=$((nfull + 1))
    past=$(awk -F'\t' -v l="$letter" '$1 == l { print $2 }' "$tmp/ratchet-onelog")
    printf '%s\t%s\n' "$letter" "${past:-0}" >> "$tmp/ratchet-past"
  done < "$tmp/ratchet-planned"
done < <(tac "$tmp/ratchet-readable")

# rule \t planned \t usual \t limit, for every rule this run would hold back. Fewer than
# three past runs is no baseline, so nothing is held. --force holds nothing either, so no hold
# is listed that will not happen.
#
# A rule with fewer than three samples of its own has a usual of 0, so RATCHET_FLOOR is its
# limit. Otherwise its median would come from one or two runs, and a single forced run that
# let a held wave through would set a limit three times that wave.
: > "$tmp/held"
if [ "$nratchet" -ge 3 ] && [ "$FORCE" = 0 ]; then
  while IFS=$'\t' read -r letter planned; do
    usual=$(awk -F'\t' -v l="$letter" '$1 == l { print $2 }' "$tmp/ratchet-past" | sort -n \
            | awk '{ v[NR] = $1 }
                   END { if (NR < 3) print 0
                         else if (NR % 2) print v[(NR + 1) / 2]
                         else print int((v[NR / 2] + v[NR / 2 + 1]) / 2) }')
    limit=$(( usual * RATCHET_FACTOR ))
    [ "$limit" -ge "$RATCHET_FLOOR" ] || limit=$RATCHET_FLOOR
    if [ "$planned" -gt "$limit" ]; then
      printf '%s\t%s\t%s\t%s\n' "$letter" "$planned" "$usual" "$limit" >> "$tmp/held"
    fi
  done < "$tmp/ratchet-planned"
fi

# One awk for the whole table, since a plan can run to hundreds of rows. Two passes: the first
# counts each verdict so the second knows what to fold.
awk -F'\t' -v now="$now" -v collapse="$PLAN_COLLAPSE_ROWS" -v full="$PLAN_FULL" '
     function size(b,   s, u, a, i) {
       s = b; u = "B"; split("KB MB GB", a, " ")
       for (i = 1; i <= 3 && s >= 1024; i++) { s /= 1024; u = a[i] }
       return sprintf("%.1f%s", s, u)
     }
     # Corpus verdicts are decided by a pattern across many repos, so their rows one by one
     # say nothing the group line does not.
     BEGIN { split("spam-batch media-batch", c, " ")
             for (i = 1; i in c; i++) corpus[c[i]] = 1 }
     NR == FNR { n[$5]++; b[$5] += $2; if ($8 != "") near[$5]++; next }
     FNR == 1 { for (r in n) if (corpus[r] && !full && n[r] >= collapse) fold[r] = 1
                printf "\n%-34s %9s %6s %8s %-13s %-15s %s\n",
                       "RID", "SIZE", "SEEDS", "AGE(d)", "REASON", "NEAR", "NAME" }
     { if ($5 in fold) next
       printf "%-34s %9s %6s %8s %-13s %-15s %s\n",
              $1, size($2), $3, ($7 == 0 ? "-" : int((now - $7) / 86400)), $5,
              ($8 == "" ? "-" : $8), $6 }
     # In the order c was split: `for (r in fold)` order is unspecified, and a plan that
     # prints differently each run cannot be diffed.
     END { for (i = 1; i in c; i++) if (c[i] in fold)
             printf "%-34s %9s %6s %8s %-13s %-15s %s\n",
                    sprintf("(%d repos)", n[c[i]]), size(b[c[i]]), "", "", c[i],
                    sprintf("%d near", near[c[i]] + 0),
                    "same pattern across many repos; PLAN_FULL=1 lists them"
     }' "$tmp/plan.sorted" "$tmp/plan.sorted"

# Not a plan line: rule F saw the evidence and the seed floor held it back. A human decides.
nreview=$(wc -l < "$tmp/media-review")
if [ "$nreview" -gt 0 ]; then
  echo
  echo "# REVIEW $(count "$nreview" "media dump" "media dumps") no other node seeds, not pruned"
  head -n "$top_evidence" "$tmp/media-review" \
    | awk -F'\t' '{printf "#        %-34s %-12s %s\n", $1, $2, $3}'
  [ "$nreview" -gt "$top_evidence" ] \
    && echo "#        ...and $((nreview - top_evidence)) more (PLAN_FULL=1 lists them)"
fi
nimports=$(wc -l < "$tmp/imports")
if [ "$nimports" -gt 0 ]; then
  echo
  header_line spared "$(count "$nimports" "junk-named repo" "junk-named repos") as imports," \
                   "with history from before their rad init:"
  head -n "$top_evidence" "$tmp/imports" | awk -F'\t' '{printf "#        %-34s %s\n", $1, $2}'
  [ "$nimports" -gt "$top_evidence" ] \
    && echo "#        ...and $((nimports - top_evidence)) more (PLAN_FULL=1 lists them)"
fi
# What each copy holds and where its files came from, which the plan row cannot say.
ncopies=$(wc -l < "$tmp/copy-why")
if [ "$ncopies" -gt 0 ]; then
  echo
  header_line copies "$(count "$ncopies" repo repos) in the plan hold denied files:"
  head -n "$top_evidence" "$tmp/copy-why" \
    | awk -F'\t' '{ others = ($7 > 0) ? sprintf(" and %d other source(s)", $7) : ""
                    printf "#        %-34s %.1f MiB in %d file(s), %d%% of the bytes on its" \
                           " branches, from %s%s\n", $1, $2 / 1048576, $5, $4, $6, others }'
  [ "$ncopies" -gt "$top_evidence" ] \
    && echo "#        ...and $((ncopies - top_evidence)) more (PLAN_FULL=1 lists them)"
fi

echo
# Promise only what the run delivers, worded like the DONE line. Under quarantine no disk is
# freed today, so "reclaim" would overclaim.
if [ "$QUARANTINE" = 1 ]; then
  header_line PLAN "prune $(count "$nplan" repo repos), ${gib} GiB"
else
  header_line PLAN "prune $(count "$nplan" repo repos), reclaim ${gib} GiB"
fi
awk -F'\t' '{ c[$5]++; b[$5]+=$2 }
     END { for (r in c) printf "#          %-13s %5d %-5s  %8.2f GiB\n",
                               r, c[r], (c[r] == 1 ? "repo" : "repos"), b[r]/1073741824 }' "$tmp/plan.sorted" | sort
# Points at the rows to read first; on a plan of hundreds of rows nobody scrolls to NEAR.
nnear=$(awk -F'\t' '$8 != ""' "$tmp/plan.sorted" | wc -l)
[ "$nnear" = 0 ] \
  || header_line "" "$nnear of them cleared a threshold by under ${NEAR_PCT}%, named in the" \
                    "NEAR column."
if [ "$QUARANTINE" = 1 ] && [ "$nplan" -gt 0 ]; then
  header_line "" "Pruned repos wait in the quarantine for" \
                 "$(count "$QUARANTINE_DAYS" day days), then a later --apply run deletes them."
fi
# Printed by a dry run too, which is when an operator decides whether to let a wave through.
if [ -s "$tmp/held" ]; then
  header_line "" "HELD BACK as these rules planned far more repos than usual. --force or a yes" \
                 "at the prompt lets them through:"
  while IFS=$'\t' read -r letter planned usual limit; do
    echo "#          $(rule_label "$letter"): $planned repos planned, usually $usual a run" \
         "(limit $limit)"
  done < "$tmp/held"
fi

# What deny_block_ahead blocks under --apply. A block has no plan row, so a dry run shows it
# only here.
: > "$tmp/deny-ahead"
while IFS= read -r id; do
  [ -d "$STORAGE/$id" ] || grep -qxF "$id" "$tmp/excluded" || printf 'rad:%s\n' "$id"
done < "$tmp/deny-rids" >> "$tmp/deny-ahead"
grep -vxF -f "$tmp/deny-nids-kept" "$tmp/deny-nids" >> "$tmp/deny-ahead" || true
if [ -s "$tmp/deny-ahead" ]; then
  header_line "" "The deny list blocks $(count "$(wc -l < "$tmp/deny-ahead")" id ids)," \
                 "unless already blocked:"
  head -n "$top_evidence" "$tmp/deny-ahead" | sed 's/^/#          /'
  nmore=$(( $(wc -l < "$tmp/deny-ahead") - top_evidence ))
  [ "$nmore" -le 0 ] || echo "#          ...and $nmore more (PLAN_FULL=1 lists them)"
fi

# The identities of rule H, each with the repos that matched, as "#   <indent>" lines.
malware_identities() {
  local indent=$1 nid nhit nall
  for nid in $(cut -f1 "$tmp/malware" | sort -u); do
    grep "^$nid"$'\t' "$tmp/malware" > "$tmp/malware-one"
    IFS=$'\t' read -r _ nhit nall _ < "$tmp/malware-one"
    printf '#%s%s: %d of its %d repos match:\n' "$indent" "$nid" "$nhit" "$nall"
    head -n "$top_evidence" "$tmp/malware-one" \
      | while IFS=$'\t' read -r _ _ _ rid found rname; do
          printf '#%s  rad:%s  # %s (%s)\n' "$indent" "$rid" "$rname" "$found"
        done
    if [ "$nhit" -gt "$top_evidence" ]; then
      echo "#$indent  ...and $((nhit - top_evidence)) more (PLAN_FULL=1 lists them)"
    fi
  done
}

# Under MALWARE_PRUNE=1 rule H's repos are in the plan, so this says how to block or clear
# their identities.
if [ "$nmalware" -gt 0 ] && [ "$MALWARE_PRUNE" = 1 ]; then
  header_line "" "The malware rule (H) named $(count "$nmalware" identity identities). The" \
                 "repos they are a delegate of are in the plan as malware-op, unless pinned," \
                 "private, our own, kept, signed by an identity this seed vouches for, still" \
                 "arriving or undated:"
  malware_identities "          "
  header_line "" "last-run/H-malware-identities.tsv lists every matching repo. An identity's" \
                 "did:key: line in $KEEP_FILE clears it of the malware rule (H)."
  if [ "$nmalware_block" -gt 0 ]; then
    header_line "" "--apply --block-peers blocks these once it prunes their repos, asking for" \
                   "each. To block one yourself, run its line:"
    sed 's/^/#          rad block /' "$tmp/malware-block"
  fi
fi

# Rule G's verdicts are about peers: nothing here deletes a repo, and blocking a peer touches
# every repo at once, so they get their own section.
if [ "$nparasite" -gt 0 ]; then
  echo
  echo "# REVIEW $(count "$nparasite" "parasite peer" "parasite peers") the parasite-peer rule" \
       "(G) found"
  header_line "" "The count is repos reached by ONE file of theirs, not repos they touched."
  while IFS=$'\t' read -r nid widest _npeerrepos mb ob oid; do
    printf '#          %s  %3d repos  %6.1f MiB media  %6d B other  blob %s\n' \
           "$nid" "$widest" "$(awk -v b="$mb" 'BEGIN{printf "%.1f", b/1048576}')" \
           "$ob" "${oid:0:12}"
  done < "$tmp/parasites"
  if [ "$nunknown" = 1 ]; then
    header_line "" "1 repo had an unreadable identity, so a peer who is a delegate of it was" \
                   "not spared by the delegate check."
  elif [ "$nunknown" -gt 1 ]; then
    header_line "" "$nunknown repos had an unreadable identity, so a peer who is a delegate of" \
                   "one of them was not spared by the delegate check."
  fi
  # Printed even without --block-peers, so the operator can act on one peer without giving
  # the tool a standing licence over the whole list.
  header_line "" "Blocking is permanent, invisible to the peer, and applies to every repo at" \
                 "once."
  header_line "" "To block a peer, run its line, or pass --block-peers to be asked for each one" \
                 "(--yes answers for all):"
  cut -f1 "$tmp/parasites" | sed 's/^/#          rad block /'
fi

# By default a person decides about a rule H identity. The deny list both prunes its repos
# and blocks it, so the review points there.
if [ "$nmalware" -gt 0 ] && [ "$MALWARE_PRUNE" = 0 ]; then
  echo
  echo "# REVIEW $(count "$nmalware" identity identities) the malware rule (H) named." \
       "Nothing is pruned or blocked."
  malware_identities "        "
  header_line "" "last-run/H-malware-identities.tsv lists every matching repo."
  header_line "" "A line below in $DENY_FILE prunes every repo the identity is a delegate of," \
                 "except private ones, and blocks the identity unless it is a delegate of a private" \
                 "repo."
  header_line "" "The same line in $KEEP_FILE clears the identity and keeps none of its repos."
  cut -f1 "$tmp/malware" | sort -u | sed 's/^/#          did:key:/'
fi
# The deny and keep lists read what follows a # as a comment, so the evidence rides along
# when a line is copied.
if [ "$nmalware_repos" -gt 0 ]; then
  echo
  echo "# REVIEW $(count "$nmalware_repos" repo repos) the malware rule (H) flagged for you to" \
       "check, not pruned"
  head -n "$top_evidence" "$tmp/malware-repos" \
    | while IFS=$'\t' read -r rid found evidence rname; do
        printf '#        rad:%s  # %s (%s; %s)\n' "$rid" "$rname" "$found" "$evidence"
      done
  if [ "$nmalware_repos" -gt "$top_evidence" ]; then
    echo "#        ...and $((nmalware_repos - top_evidence)) more in" \
         "last-run/H-malware-repos.tsv (PLAN_FULL=1 lists them)"
  fi
  header_line "" "Copy a line into $KEEP_FILE to keep its repo, or into $DENY_FILE to prune" \
                 "and block it. A line in ${KEEP_FILE##*/} also stops the malware rule (H)" \
                 "naming any delegate of that repo, even one who never signed it."
fi

# The report above is trimmed to fit a terminal. The lists behind it go out whole here, so the
# evidence outlives the scroll buffer and tools can read it. A dry run writes them too, since
# that is when somebody judges the verdicts.
#
# Overwritten every run: per-run copies grow without bound on a weekly cron, and a run that
# changes anything leaves a dated audit log anyway.
#
# Every write is checked and none may end the run. This directory is on the storage filesystem,
# which is often filling when this runs, so a full disk must cost the report, not the reclaim.
lastrun="$AUDIT_DIR/last-run"
staging="$lastrun.new"

# Each file opens with what it holds and the run that wrote it. Without that, a plan.tsv read
# a month later has no date, mode or rules, and a run that aborts before here leaves the
# previous run's files looking current.
lr_head() {  # each argument is one line saying what the file holds
  printf '# %s\n' "$@"
  printf '# %s  version=%s  mode=%s  rules=%s  storage=%s\n' \
         "$run_ts" "$VERSION" "$run_mode" "$rules_live" "$STORAGE"
}

lr_ok=1
rm -rf "$staging" 2>/dev/null
mkdir -p "$staging" 2>/dev/null || lr_ok=0
if [ "$lr_ok" = 1 ]; then
  { lr_head "Every repo the last run planned to prune. A dry run prunes none of them;" \
            "what an applying run removed is in its prune-*.log."
    plan_header
    cat "$tmp/plan.sorted"; } > "$staging/plan.tsv" 2>/dev/null || lr_ok=0
  { lr_head "Name patterns the spam-batch rule (D) found shared by many repos," \
            "and how many repos match each."
    printf '# repos\ttemplate\n'
    sort -k1,1nr "$tmp/spambatch"; } \
    > "$staging/D-spam-batch-templates.tsv" 2>/dev/null || lr_ok=0
  # verdict: which of rule F's verdicts the repo matched, not a size.
  { lr_head "Media dumps the media rule (F) found but kept, because fewer than" \
            "MEDIA_MIN_SEEDS other nodes seed them. Nothing here was pruned."
    printf '# rid\tverdict\tname\n'
    cat "$tmp/media-review"; } > "$staging/F-media-kept-few-seeds.tsv" 2>/dev/null || lr_ok=0
  { lr_head "Junk-named repos, like demo or test, that the junk-name rule (A) kept because" \
            "their history starts well before they came to Radicle. None were pruned."
    printf '# rid\tname\n'
    cat "$tmp/imports"; } > "$staging/A-junk-name-kept-imports.tsv" 2>/dev/null || lr_ok=0
  # A block is permanent and the peer is never told, so its evidence must outlive the
  # terminal.
  { lr_head "Peers the parasite-peer rule (G) found pushing one file into many repos they" \
            "are not a delegate of, with the evidence. Only --block-peers blocks them."
    printf '# peer_nid\trepos_sharing_blob\trepos_touched\tmedia_bytes\ttext_bytes\tblob\n'
    cat "$tmp/parasites"; } > "$staging/G-parasite-peers.tsv" 2>/dev/null || lr_ok=0
  # The terminal shows only the first few repos of each, and these are what a verdict rests on.
  if [ "$MALWARE_PRUNE" = 1 ]; then
    h_ids="Their repos are in plan.tsv as malware-op."
  else
    h_ids="Nothing here is pruned or blocked unless you add it to deny.txt."
  fi
  { lr_head "Identities the malware rule (H) named, one row per repo of theirs that" \
            "matched. $h_ids"
    printf '# nid\trepos_hit\trepos_signed\trid\twords\tname\n'
    cat "$tmp/malware"; } > "$staging/H-malware-identities.tsv" 2>/dev/null || lr_ok=0
  { lr_head "Single repos the malware rule (H) named, with the words it found and where." \
            "None is pruned unless you add its rad: line to deny.txt."
    printf '# rid\twords\tevidence\tname\n'
    cat "$tmp/malware-repos"; } > "$staging/H-malware-repos.tsv" 2>/dev/null || lr_ok=0
  # A malware-op row's own name may match nothing, so the identity is all that explains it.
  { lr_head "Repos in the plan as malware-op, with the named identities among their delegates."
    printf '# rid\tidentities\n'
    awk -F'\t' 'FILENAME == ARGV[1] { if ($5 == "malware-op") planned[$1] = 1; next }
                 $1 in planned' "$tmp/plan.sorted" "$tmp/malware-op"; } \
    > "$staging/H-malware-op-repos.tsv" 2>/dev/null || lr_ok=0
  # Without these, the run's warning names a count and nothing to look at.
  { lr_head "Repos the media rule (F) could not check: unreadable, over MEDIA_MAX_REFS refs" \
            "or MEDIA_MAX_OPS ops, or with too many files of unknown type to read. It did not" \
            "prune them. The other rules still judged them."
    printf '# rid\tsize_bytes\n'
    sort -u "$tmp/media-fail" | while IFS= read -r rid; do
      printf '%s\t%s\n' "$rid" "${SIZE[$rid]:-}"
    done; } > "$staging/F-media-unjudged.tsv" 2>/dev/null || lr_ok=0
  # plan.tsv still lists a held rule's repos, since --force or a yes may yet prune them. This
  # says which rules wait on that.
  { lr_head "Rules an unattended run holds back for planning far more repos than usual." \
            "Their repos are in plan.tsv; only --force or a y at the prompt prunes them."
    printf '# rule\tplanned\tusual\tlimit\n'
    cat "$tmp/held"; } > "$staging/held.tsv" 2>/dev/null || lr_ok=0
  # The repos counted under "# undo", one per row, to check why one is or is not unblocked.
  # Like plan.tsv this is the plan; what a lift did is in the audit log's "# unblocked:" lines.
  { lr_head "Blocks rad-prune made that this run plans to lift, holds for a later run, or" \
            "leaves blocked, and why. An --apply run lifts the rows marked unblock once it goes" \
            "ahead."
    printf '# rid\tstate\twhy\treason\tbytes_when_pruned\tpruned_at\t%s\t%s\n' \
           pruned_by_version local_copy
    awk -F'\t' -v OFS='\t' '$7 == "-" { $7 = "0.7.0-or-older" } { print }' \
      "$tmp/undo-states"; } > "$staging/unprune-plan.tsv" 2>/dev/null || lr_ok=0
  # Which deny-list line each denied repo was pruned for.
  { lr_head "Repos in the plan because of deny.txt, with the line that names each."
    printf '# rid\tcause\n'
    cat "$tmp/deny-why"; } > "$staging/deny-repos.tsv" 2>/dev/null || lr_ok=0
  { lr_head "Repos in the plan for holding copies of files listed in deny-files.tsv:" \
            "how much of each repo they make up, and where they came from."
    printf '# rid\tdenied_bytes\tbranch_bytes\tpct\tfiles\tsource\tother_sources\n'
    cat "$tmp/copy-why"; } > "$staging/deny-copies.tsv" 2>/dev/null || lr_ok=0
  # Every listed file each copy holds, to trace a wrong copy. A file listed from the copy
  # itself is its own and counts nowhere in its verdict.
  { lr_head "Each listed file that each repo in deny-copies.tsv holds."
    printf '# rid\toid\tbytes\n'
    awk -F'\t' -v why="$tmp/copy-why" -v src="$tmp/deny-oids-owned" '
        FILENAME == why  { copy[$1] = 1; next }
        FILENAME == src  { listed[$1] = 1
                           source = $2; sub(/^rad:/, "", source); own[$1, source] = 1
                           next }
        $1 == "h" && (($3, $2) in own) { next }
        $1 == "h" && ($2 in copy) && ($3 in listed) { print $2 "\t" $3 "\t" $4 }' \
        "$tmp/copy-why" "$tmp/deny-oids-owned" "$tmp/copy" | sort; } \
    > "$staging/deny-copy-files.tsv" 2>/dev/null || lr_ok=0
  { lr_head "Everything the last run could not read."
    cat "$scanerr"; } > "$staging/scan-errors.txt" 2>/dev/null || lr_ok=0
fi

# One mv, so a reader never sees this run's files mixed with the last run's, and a run that
# dies mid-write leaves the previous evidence whole.
if [ "$lr_ok" = 1 ]; then
  rm -rf "$lastrun" 2>/dev/null
  mv -T "$staging" "$lastrun" 2>/dev/null || lr_ok=0
fi
if [ "$lr_ok" = 1 ]; then
  # Listed here, not beside each count, because only here are they known to be written.
  lastrun_files="plan.tsv"
  [ "$nunblock" = 0 ] && [ "$nlater" = 0 ] || lastrun_files="$lastrun_files, unprune-plan.tsv"
  [ "${nmediafail:-0}" = 0 ] || lastrun_files="$lastrun_files, F-media-unjudged.tsv"
  [ "$nmalware" = 0 ] || lastrun_files="$lastrun_files, H-malware-identities.tsv"
  [ "$nmalware_repos" = 0 ] || lastrun_files="$lastrun_files, H-malware-repos.tsv"
  header_line files "$lastrun/   $lastrun_files"
else
  rm -rf "$staging" 2>/dev/null
  # Loses no verdict, but loses the only copy of its evidence, so it is said out loud.
  echo "# WARN could not write $lastrun; this run's evidence is only what is above." >&2
fi

blocked=0

# A repo's delegates and the sigrefs each had pushed, as "<did>:<oid>,<did>:<oid>", "-" for
# a delegate with nothing pushed, and "-" alone when the identity document did not read. The
# audit log keeps it beside the prune, for revival on a later run.
prune_delegates() {
  local did oid line=""
  local -A sigrefs=()
  read_delegates "$1"
  [ -n "$dids" ] || { echo "-"; return 0; }
  while read -r did oid; do
    sigrefs[$did]=$oid
  done < <(GIT_DIR="$1" git for-each-ref --format='%(refname) %(objectname)' \
             'refs/namespaces/*/refs/rad/sigrefs' 2>/dev/null \
           | sed -n 's|^refs/namespaces/\([^/]*\)/refs/rad/sigrefs |\1 |p')
  for did in $dids; do
    line="$line${line:+,}$did:${sigrefs[$did]:--}"
  done
  echo "$line"
}

# Blocks this run meant to make and could not. Any one makes the run exit 1.
block_failed=0

# Deny-list ids no repo in storage stands for (repos not fetched yet, and identities), blocked
# now so the node never fetches or follows them. A repo still in storage is left to the prune,
# and one the prune moved out was blocked then, so blocking it again here logs nothing.
# Excluded repos are left alone, and so is an identity that is a delegate of one. `rad block`
# prints only when it changes a policy, which keeps a standing list out of every week's audit
# log.
deny_block_ahead() {
  local id said nblocked=0
  while IFS= read -r id; do
    [ -d "$STORAGE/$id" ] && continue
    grep -qxF "$id" "$tmp/excluded" && continue
    said=$("$RAD" block "rad:$id" 2>"$tmp/block-err") \
      || { echo "# WARN could not block denied repo rad:$id: $(head -1 "$tmp/block-err")" >&2
           block_failed=$((block_failed+1)); continue; }
    [ -n "$said" ] || continue
    open_audit; printf 'blocked-denied\trad:%s\n' "$id" >> "$audit"
    nblocked=$((nblocked+1))
  done < "$tmp/deny-rids"
  while IFS= read -r id; do
    if grep -qxF "$id" "$tmp/deny-nids-kept"; then
      echo "# WARN not blocking $id, a delegate of a kept repo; rad unfollow it if blocked." >&2
      continue
    fi
    said=$("$RAD" block "$id" 2>"$tmp/block-err") \
      || { echo "# WARN could not block denied identity $id: $(head -1 "$tmp/block-err")" >&2
           block_failed=$((block_failed+1)); continue; }
    [ -n "$said" ] || continue
    open_audit; printf 'blocked-denied\t%s\n' "$id" >> "$audit"
    nblocked=$((nblocked+1))
  done < "$tmp/deny-nids"
  [ "$nblocked" = 0 ] || echo "# blocked $nblocked id(s) from $DENY_FILE"
  return 0
}

# Blocks for rules G and H. A block is permanent, invisible to the person blocked, and covers
# every repo, so neither rule blocks without a human: --block-peers refuses when nobody can be
# asked, and asks per peer. The node filters every namespaced ref it receives through the
# block list whatever the seeding scope, so refs dropped here do not come back. Dropping them
# frees no disk until git gc, which this tool does not run, so none of it counts as reclaimed.
# Rule H's identities are blocked only by an --apply run (see malware_block_named).
hpending=0
[ "$APPLY" = 0 ] || hpending=$nmalware_block
if [ "$BLOCK_PEERS" = 1 ] && [ $((nparasite + hpending)) -gt 0 ]; then
  # --yes stands in for every answer, which makes this usable from cron. Blocking with nobody
  # present therefore takes both flags, --block-peers to look and --yes to act. Without --yes
  # the answers come in on fd 9, opened once here: /dev/stdin would be the verdict file the
  # loop below redirects in.
  asked=1
  if [ "$YES" = 1 ]; then :
  elif [ -t 0 ]; then exec 9<&0
  elif { : >/dev/tty; } 2>/dev/null; then exec 9</dev/tty
  else asked=0; fi
  if [ "$asked" = 0 ]; then
    echo "# --block-peers has nobody to ask: no terminal, and no --yes standing in." >&2
    echo "# Nobody was blocked. The commands are listed above; run them yourself." >&2
  fi
  if [ "$asked" = 1 ] && [ "$nparasite" -gt 0 ]; then
    while IFS=$'\t' read -r nid widest _npeerrepos mb ob oid; do
      if [ "$YES" = 1 ]; then
        printf '# Blocking %s (--yes): it put %s in %s repos it is not a delegate of\n' \
               "$nid" "${oid:0:12}" "$widest"
        reply=y
      else
        printf '# Block %s? it put %s in %s repos it is not a delegate of [y/N] ' \
               "$nid" "${oid:0:12}" "$widest"
        reply=""; IFS= read -r reply <&9 || reply=""
      fi
      case "$reply" in [yY]) ;; *) echo "#   skipped $nid"; continue ;; esac
      "$RAD" block "$nid" >/dev/null 2>&1 \
        || { echo "#   WARN block failed, leaving refs alone: $nid" >&2
             block_failed=$((block_failed+1)); continue; }
      blocked=$((blocked+1))
      open_audit
      # The evidence goes beside the block: a judgement about a person that nobody can later
      # explain is one nobody can later undo.
      printf 'blocked-peer\t%s\tblob=%s\trepos=%s\tmedia_bytes=%s\tother_bytes=%s\n' \
             "$nid" "$oid" "$widest" "$mb" "$ob" >> "$audit"
      # Only repos where this peer put content of its own: where it mirrors a repo, its refs
      # hold that repo's blobs, so dropping them frees nothing. Excluded repos are left alone,
      # since "never touched" must hold for every action.
      while IFS=$'\t' read -r _ rid _ _ _; do
        d="$STORAGE/$rid"
        [ -d "$d" ] || continue
        grep -qxF "$rid" "$tmp/excluded" && { echo "#   kept $rid: excluded"; continue; }
        GIT_DIR="$d" git for-each-ref --format='delete %(refname)' \
            "refs/namespaces/$nid/" 2>/dev/null \
          | GIT_DIR="$d" git update-ref --stdin 2>/dev/null \
          || echo "#   WARN could not drop $nid refs from $rid" >&2
      done < <(awk -F'\t' -v n="$nid" '$1 == "=" && $3 == n && $4 > 0' "$tmp/peer")
    done < "$tmp/parasites"
    echo "# blocked $blocked of $nparasite peer(s); run git gc to reclaim their objects."
  fi
fi
# Rule H's identities, under MALWARE_PRUNE=1 and --block-peers. Called by an --apply run past
# the runaway caps and the ratchet, it blocks only an identity with a repo still planned as
# malware-op, so a run that holds those repos back blocks nobody. Their pushes into other
# repos are no evidence, so the block is the whole act.
malware_block_named() {
  local nid nhit nall words why reply nnow said hblocked=0 halready=0
  [ "$BLOCK_PEERS" = 1 ] && [ "$nmalware_block" -gt 0 ] && [ "${asked:-0}" = 1 ] || return 0
  awk -F'\t' 'FILENAME == ARGV[1] { if ($5 == "malware-op") planned[$1] = 1; next }
              $1 in planned { n = split($2, d, ","); for (i = 1; i <= n; i++) print d[i] }' \
    "$tmp/plan.sorted" "$tmp/malware-op" | sort -u \
    | grep -xFf - "$tmp/malware-block" > "$tmp/malware-block-now" || true
  nnow=$(wc -l < "$tmp/malware-block-now")
  [ "$nnow" = "$nmalware_block" ] \
    || echo "# not blocking $((nmalware_block - nnow)) identity(s) the malware rule (H)" \
            "named: this run prunes none of their repos."
  [ "$nnow" -gt 0 ] || return 0
  while IFS= read -r nid; do
    read -r nhit nall words < <(awk -F'\t' -v n="$nid" '
        $1 == n { hit = $2; all = $3; m = split($5, w, ",")
                  for (i = 1; i <= m; i++) if (!(w[i] in seen)) {
                    seen[w[i]] = 1; words = words (words == "" ? "" : ",") w[i] } }
        END { print hit, all, words }' "$tmp/malware")
    why="$nhit of its $nall repos read like a malware operation ($words)"
    if [ "$YES" = 1 ]; then
      printf '# Blocking %s (--yes): %s\n' "$nid" "$why"
      reply=y
    else
      printf '# Block %s? %s [y/N] ' "$nid" "$why"
      reply=""; IFS= read -r reply <&9 || reply=""
    fi
    # Later runs no longer name an identity whose repos are gone, so a skipped block is never
    # asked for again.
    case "$reply" in
      [yY]) ;;
      *) echo "#   skipped $nid; no later run asks again. To block it: rad block $nid"
         continue ;;
    esac
    said=$("$RAD" block "$nid" 2>/dev/null) \
      || { echo "# WARN could not block $nid, and no later run will try again." \
                "Block it yourself: rad block $nid" >&2
           block_failed=$((block_failed+1)); continue; }
    # rad block prints only when it changes the policy. An identity already blocked gets no
    # blocked-malware row, which would later read as this tool's block and advise lifting it.
    [ -n "$said" ] || { halready=$((halready+1)); continue; }
    hblocked=$((hblocked+1))
    open_audit
    printf 'blocked-malware\t%s\trepos_hit=%s\trepos_signed=%s\twords=%s\n' \
           "$nid" "$nhit" "$nall" "$words" >> "$audit"
  done < "$tmp/malware-block-now"
  if [ "$halready" = 0 ]; then
    echo "# blocked $hblocked of $nnow identity(s) the malware rule (H) named."
  else
    echo "# blocked $hblocked of $nnow identity(s) the malware rule (H) named;" \
         "$halready of them already blocked."
  fi
}

if [ "$APPLY" = 0 ]; then
  if [ "$blocked" -gt 0 ]; then
    echo "# DRY RUN no repo was pruned. $(count "$blocked" peer peers) blocked, as answered" \
         "above."
  else
    echo "# DRY RUN nothing changed. Add --apply to carry out this plan."
  fi
  [ "$block_failed" = 0 ] || exit 1
  exit 0
fi

# --apply: the slow scan ran once. In a terminal, ask before deleting; non-interactively
# (cron, a pipe) just apply. --yes skips the prompt.
#
# Asks $1 at the terminal and sets reply. Returns 1 when there is no terminal to ask.
ask() {
  reply=""
  if [ -t 0 ]; then                                   # stdin is a terminal
    printf '%s' "$1"; IFS= read -r reply || reply=""
  elif { : >/dev/tty; } 2>/dev/null; then             # piped input but a terminal exists
    printf '%s' "$1" >/dev/tty; IFS= read -r reply </dev/tty || reply=""
  else
    return 1
  fi
}

# An empty plan still purges the quarantine of what is past its window, or of everything at
# the critical free-space threshold: a seed that has caught up plans nothing most weeks, and
# its quarantined disk would otherwise never come back.
if [ "$nplan" = 0 ]; then
  # Lifting a block changes the node as much as pruning, so a person present is asked. A no
  # stops the run here, purging nothing, since that run is the one they will look into.
  if [ "$YES" = 0 ] && [ "$nunblock" -gt 0 ] \
     && ask "# Apply now? unblock $nunblock repo(s) an earlier run blocked [y/N] "; then
    case "$reply" in
      [yY]|[yY][eE][sS]) echo "# confirmed." ;;
      # Not 1 for a failed rule G block above: the person who said no saw its WARN.
      *)                 echo "# aborted; no block was lifted, and the quarantine was left as it is."
                         exit 0 ;;
    esac
  fi
  undo_apply
  quar_purge_expired
  quar_purge_all_if_critical
  deny_block_ahead
  malware_block_named
  echo "# nothing to prune"
  # A lift that failed leaves a repo blocked that should not be, which wants a person.
  [ "$undo_failed" = 0 ] || exit 1
  [ "$block_failed" = 0 ] || exit 1
  exit 0
fi
# A yes here is the human sign-off that bypasses the ratchet and the runaway caps below.
CONFIRMED=0
if [ "$YES" = 0 ]; then
  # A human says yes to this line, so it must not overclaim: under quarantine nothing is
  # deleted today.
  if [ "$QUARANTINE" = 1 ]; then
    prompt="# Apply now? unseed + block + quarantine $nplan repos, ${gib} GiB"
    prompt="$prompt (deleted for good in ${QUARANTINE_DAYS}d)"
  else
    prompt="# Apply now? unseed + block + DELETE $nplan repos, reclaiming ${gib} GiB"
  fi
  [ "$nunblock" = 0 ] || prompt="$prompt, and unblock $nunblock repo(s) an earlier run blocked"
  prompt="$prompt [y/N] "
  if ask "$prompt"; then
    case "$reply" in
      [yY]|[yY][eE][sS]) CONFIRMED=1; echo "# confirmed." ;;
      # Not 1 for a failed rule G block above: the person who said no saw its WARN.
      *)                 echo "# aborted; no repos were pruned or unblocked."; exit 0 ;;
    esac
  fi
fi

# --------------------------------------------------------------------------------------- apply
# The ratchet's verdict, worked out with the plan above. An interactive yes confirms the
# exact numbers just printed, so it bypasses the ratchet; --yes and cron do not. Held rules
# leave the plan and every number below is recounted, so the caps, audit log and DONE line
# all describe what is pruned.
nheld=0
if [ "$CONFIRMED" = 0 ] && [ -s "$tmp/held" ]; then
  while IFS=$'\t' read -r letter planned usual limit; do
    echo "# HELD BACK $(rule_label "$letter"): $planned repos planned, usually $usual a run" \
         "(limit $limit). None of them is pruned this run." >&2
  done < "$tmp/held"
  echo "# Review them in the plan above, then re-run with --force (unattended), or confirm" \
       "interactively. The rest of the plan goes ahead, unless the runaway caps stop it." >&2
  awk -F'\t' -v map="$RULE_OF_REASON" -v heldfile="$tmp/held" '
      BEGIN { n = split(map, pairs, " ")
              for (i = 1; i <= n; i++) { split(pairs[i], kv, ":"); rule[kv[1]] = kv[2] }
              while ((getline line < heldfile) > 0) { split(line, f, "\t"); held[f[1]] = 1 } }
      !((($5 in rule) ? rule[$5] : $5) in held)' "$tmp/plan.sorted" > "$tmp/plan.kept"
  mv "$tmp/plan.kept" "$tmp/plan.sorted"
  # Counted from the plan, since a held rule's re-pruned repos leave it too (see the ratchet).
  nheld=$(( nplan - $(wc -l < "$tmp/plan.sorted") ))
  nplan=$(wc -l < "$tmp/plan.sorted")
  bytes=$(awk -F'\t' '{s+=$2} END{printf "%.0f", s}' "$tmp/plan.sorted")
  gib=$(awk -v b="$bytes" 'BEGIN{printf "%.2f", b/1073741824}')
fi

# Runaway caps guard unattended runs, measured on what the ratchet left so a held wave does
# not stop the rest of the plan. Bypassed the same two ways as the ratchet. Denied repos are
# left out, because the caps catch a rule gone wrong and the deny list is a person's verdict.
# Counted in, one listed identity with a thousand repos would stop every unattended run.
if [ "$FORCE" = 0 ] && [ "$CONFIRMED" = 0 ]; then
  nruled=$(awk -F'\t' '$5 != "denied"' "$tmp/plan.sorted" | wc -l)
  ruled_bytes=$(awk -F'\t' '$5 != "denied" { s += $2 } END { printf "%.0f", s }' \
                  "$tmp/plan.sorted")
  ruled_gib=$(awk -v b="$ruled_bytes" 'BEGIN{printf "%.2f", b/1073741824}')
  over_gb=$(awk -v b="$ruled_bytes" -v m="$MAX_PRUNE_GB" \
              'BEGIN{print (b/1073741824 > m) ? 1 : 0}')
  if [ "$nruled" -gt "$MAX_PRUNE_COUNT" ] || [ "$over_gb" = 1 ]; then
    echo "# ABORT: the rules plan $nruled repos, ${ruled_gib} GiB, over the runaway caps" \
         "(MAX_PRUNE_COUNT=$MAX_PRUNE_COUNT, MAX_PRUNE_GB=$MAX_PRUNE_GB)." \
         "Nothing was pruned." >&2
    echo "# Review it, then re-run with --force (unattended), or confirm interactively." >&2
    # A failed rule G block above exits non-zero here too, as 3 rather than 1.
    exit 3
  fi
fi

# Past the caps and the prompt the run goes ahead, so the quarantine gives up what is past
# its window, and everything if the disk is critical. A run the caps stop or a human turns
# down leaves it, since somebody will look into that run. A ratchet-held rule's repos stay in
# storage, so the purge runs as usual; otherwise a rule held week after week would hold the
# disk too. The purge runs before this run's own copies go in, so they keep their full
# window. Lifts go first, so a repo due back from the quarantine is not purged on its way out.
undo_apply
quar_purge_expired
quar_purge_all_if_critical

if [ "$nplan" = 0 ]; then
  deny_block_ahead
  malware_block_named
  echo "# nothing pruned: every verdict in the plan was held back (see HELD BACK above)." >&2
  [ "$undo_failed" = 0 ] || exit 1
  [ "$block_failed" = 0 ] || exit 1
  exit 4
fi

# Repos blocked before this run prunes them carry somebody else's block, which the undo
# leaves alone. If the listing fails, every repo is recorded as blocked already: a block kept
# by mistake is the safe side.
was_blocked_ok=1
blocked_now > "$tmp/blocked-before" || was_blocked_ok=0
# A repo a failed removal left in storage is under rad-prune's own block (see
# prune_failed_before), not somebody else's. A person who has since replaced that block with
# their own is not told apart.
[ "$was_blocked_ok" = 1 ] \
  || echo "# WARN '$RAD seed' failed, so every repo this run prunes is recorded as blocked by" \
          "somebody else, which no later run lifts, unless an earlier failed prune left that" \
          "block:" \
          "$(head -c 200 "$tmp/seed-err" | LC_ALL=C tr -c '[:print:]' ' ')" >&2

open_audit
# Held rules' rows are not in the plan below, so the log names them: the ratchet reads these
# logs, and a reader needs to tell a held rule from a quiet week.
{ printf '# plan=%s repos / %s GiB\n' "$nplan" "$gib"
  if [ "$nheld" -gt 0 ]; then
    while IFS=$'\t' read -r letter planned usual limit; do
      printf '# held back: rule %s, %s repos (usual %s, limit %s)\n' \
             "$letter" "$planned" "$usual" "$limit"
    done < "$tmp/held"
  fi
  # The deny-list line each denied repo was pruned for, so a bad line can be traced.
  sed 's/^/# denied: /; s/\t/ /' "$tmp/deny-why"
  # The identities each malware-op repo was pruned for, since its own name may match
  # nothing. A repo the ratchet held is not in this run's plan.
  awk -F'\t' 'FILENAME == ARGV[1] { if ($5 == "malware-op") planned[$1] = 1; next }
              $1 in planned { print "# malware-op: " $1 " " $2 }' \
    "$tmp/plan.sorted" "$tmp/malware-op"
  # How much of each copy is listed files, and from which source.
  awk -F'\t' -v plan="$tmp/plan.sorted" '
      FILENAME == plan { kept[$1] = 1; next }
      $1 in kept { printf "# denied-copy: %s %s bytes in %s file(s), %s%% of the bytes" \
                          " on its branches, from %s\n", $1, $2, $5, $4, $6 }' \
      "$tmp/plan.sorted" "$tmp/copy-why"
  # Before the plan rows and before any repo is touched: a row without this line later reads
  # as this tool's own block, and a failed write here stops the run first.
  awk -F'\t' -v ok="$was_blocked_ok" '
      FILENAME == ARGV[1] { blocked[$1] = 1; next }
      FILENAME == ARGV[2] { ours[$1] = 1; next }
      $1 in ours { next }
      ok == 0 || ($1 in blocked) { print "# was-blocked: rad:" $1 }' \
    "$tmp/blocked-before" "$tmp/prune-failed-before" "$tmp/plan.sorted"
  plan_header
  cat "$tmp/plan.sorted"; } >> "$audit"

if [ "$QUARANTINE" = 1 ]; then
  echo "# unseed + block + quarantine $nplan repos (recoverable for ${QUARANTINE_DAYS}d)..."
  # Brings back a quarantine deleted by hand while the scan ran, which the README allows.
  mkdir -p "$quar" 2>/dev/null || true
else
  echo "# unseed + block + delete $nplan repos..."
fi
# Marks a repo left in storage under rad-prune's own block. Without it, the next run reads
# the block as somebody else's and no undo lifts it.
mark_prune_failed() {
  { printf '# prune-failed: rad:%s\n' "$1" >> "$audit"; } 2>/dev/null \
    || progress_warn "#   WARN could not record in $audit that $1 was not removed, so a" \
                     "later run will read its block as somebody else's"
}
deleted=0
undated=0
# One line per repo really gone from storage, for the ticker. Counting attempts would show a
# full count above the WARN below.
: > "$tmp/pruned"
ticks_ok=1
progress_start "pruning" "$nplan" "$tmp/pruned"
while IFS=$'\t' read -r rid _; do
  # Emptied per repo, so a silent failure is not reported with the last repo's message. If
  # $tmp is unwritable, the redirections below fail too and no repo is touched.
  : > "$tmp/prune-err" 2>/dev/null || true
  # A storage entry not named as a repo id has nothing to unseed or block, and a path built
  # from it may point outside storage.
  if ! is_rid "$rid"; then
    progress_warn "#   SKIP not a repo id, left alone: $STORAGE/$rid"
    continue
  fi
  # Who can bring the repo back by pushing, and what each had pushed, read while it is still
  # here. A later run lifts the block when a delegate's node announces something new.
  # Unrecorded, any node's announcement would bring it back, so the repo is left untouched.
  delegates_line=$(prune_delegates "$STORAGE/$rid")
  { printf '# delegates: rad:%s %s\n' "$rid" "$delegates_line" >> "$audit"; } 2>/dev/null \
    || { progress_warn "#   WARN not pruned, could not record its delegates in $audit: $rid"
         continue; }
  "$RAD" unseed "rad:$rid" >/dev/null 2>&1 || true     # clear any policy FIRST
  "$RAD" block  "rad:$rid" >/dev/null 2>&1 \
    || { progress_warn "#   WARN block failed, skipping delete: $rid"
         # This run made no block, but one an earlier failed prune left may still stand.
         grep -qxF "$rid" "$tmp/prune-failed-before" && mark_prune_failed "$rid"
         continue; }
  d="$STORAGE/$rid"
  case "$d" in
    "$STORAGE"/z*)
      if [ "$QUARANTINE" = 1 ]; then
        # A repo pruned twice would fail to move onto its own older copy, so that copy goes
        # first, but only while the repo is still in storage, or that copy is the only one.
        if [ -d "$d" ]; then rm -rf -- "${quar:?}/$rid" 2>/dev/null; fi
        if mv -- "$d" "$quar/$rid" 2>"$tmp/prune-err"; then
          deleted=$((deleted+1))
          printf '%s\n' "$rid" >> "$tmp/pruned" || ticks_ok=0
          # The purge measures the window by directory mtime and mv keeps the old one, so
          # the copy is dated to this run's start: the run QUARANTINE_DAYS later then finds
          # it due however long this one took. An undated copy's window may already be past:
          # rules B and C pick repos untouched for 90 to 730 days by ref dates, so this loop
          # cannot tell. The repo has left storage either way, so this is a shortened undo,
          # not a failed prune.
          touch -d "@$now" "$quar/$rid" 2>/dev/null \
            || { undated=$((undated+1))
                 progress_warn "#   WARN $rid kept its own date in quarantine, so its window" \
                               "runs from that date and may already have passed"; }
        else
          # The tool's message names the path; the rid is the fallback for a silent failure.
          err=$(head -1 "$tmp/prune-err" 2>/dev/null) || true
          progress_warn "#   WARN quarantine failed: ${err:-$rid}"
          mark_prune_failed "$rid"
        fi
      else
        if rm -rf -- "$d" 2>"$tmp/prune-err"; then
          deleted=$((deleted+1))
          printf '%s\n' "$rid" >> "$tmp/pruned" || ticks_ok=0
        else
          err=$(head -1 "$tmp/prune-err" 2>/dev/null) || true
          progress_warn "#   WARN delete failed: ${err:-$rid}"
          mark_prune_failed "$rid"
        fi
      fi ;;
    *) progress_warn "#   SKIP unsafe path: $d" ;;
  esac
done < "$tmp/plan.sorted"
progress_stop
# $deleted is counted in this shell, so this costs only the progress line. Said so the
# short count is not read as failed prunes.
[ "$ticks_ok" = 1 ] \
  || echo "# WARN could not write $tmp/pruned; the pruning line above undercounts." >&2

# The GiB that really left storage; the plan's figure includes failed removals. Without a
# list of removed repos the plan's figure stands, and the WARN above says so.
gone_gib=$gib
if [ "$ticks_ok" = 1 ]; then
  gone_bytes=$(awk -F'\t' 'FILENAME == ARGV[1] { gone[$1] = 1; next }
                           $1 in gone { s += $2 } END { printf "%.0f", s }' \
                 "$tmp/pruned" "$tmp/plan.sorted")
  gone_gib=$(awk -v b="$gone_bytes" 'BEGIN{printf "%.2f", b/1073741824}')
fi

# The audit log was written from the plan, so failed deletions must be said here, or the
# log claims disk that was never reclaimed.
[ "$deleted" = "$nplan" ] || {
  if [ "$ticks_ok" = 1 ]; then
    echo "# WARN $((nplan - deleted)) of $nplan deletions failed;" \
         "${gone_gib} of the planned ${gib} GiB left storage." >&2
  else
    echo "# WARN $((nplan - deleted)) of $nplan deletions failed;" \
         "less than the planned ${gib} GiB left storage." >&2
  fi
  echo "# The audit log lists the plan, not what got deleted." >&2
}

deny_block_ahead
malware_block_named

if [ "$RESTART" = 1 ]; then
  echo "# restarting $SERVICE (clears the stale inventory-announce warning)..."
  systemctl restart "$SERVICE" 2>&1 || sudo systemctl restart "$SERVICE" 2>&1 \
    || echo "# WARN restart failed; run: sudo systemctl restart $SERVICE" >&2
fi

# one appended line per run: the index into the per-run audit logs
add_header "$AUDIT_DIR/history.log" \
  "One line per applying run that went ahead with its plan: when, repos pruned, GiB moved" \
  "out of storage, quarantine on or off, disk pressure, the name of that run's own log, and free" \
  "space and what storage and the quarantine held on that disk when it started. Unattended" \
  "runs read it to learn what each rule usually prunes." \
  || echo "# WARN could not add a header to $AUDIT_DIR/history.log." >&2
hist_fmt='%s\tdeleted=%s\treclaimed_gib=%s\tquarantine=%s\tpressure=%s%%\taudit=%s'
hist_fmt+='\tfree_gb=%s\tused_gb=%s\n'
printf "$hist_fmt" \
  "$run_ts" "$deleted" "$gone_gib" "$([ "$QUARANTINE" = 1 ] && echo on || echo off)" \
  "$press_pct" "$(basename "$audit")" "$free_gb" "$used_gb" \
  >> "$AUDIT_DIR/history.log"

# The GiB figure is what leaves storage. Under quarantine it is not free space yet, so
# "reclaimed" would be false.
if [ "$QUARANTINE" = 1 ]; then
  header_line DONE "quarantined $(count "$deleted" repo repos), ~${gone_gib} GiB out of storage" \
                   "but still on disk for $(count "$QUARANTINE_DAYS" day days)."
  # An operator reads the line above to judge whether the undo still holds, so the repos it
  # is not true of are named right under it.
  if [ "$undated" = 1 ] && [ "$deleted" = 1 ]; then
    header_line "" "It kept its own date, so its window runs from it and may already have" \
                   "passed."
  elif [ "$undated" = 1 ]; then
    header_line "" "1 of them kept its own date, so its window runs from it and may already" \
                   "have passed."
  elif [ "$undated" -gt 1 ]; then
    header_line "" "$undated of them kept their own date, so their window runs from it and" \
                   "may already have passed."
  fi
  # Both lines are about what this run put there, so neither prints when it put nothing.
  if [ "$deleted" -gt 0 ]; then
    header_line "" "See them with: $SELF_CMD quarantine list"
    header_line "" "Put one back with: $SELF_CMD quarantine restore <rid>"
    # The GiB above stay occupied until the window passes. --all empties the whole
    # quarantine, more than this run put in, so the line says so.
    header_line "" "To free the disk now, giving up the undo for this run and every earlier" \
                   "one: $SELF_CMD quarantine delete --all"
  fi
else
  header_line DONE "deleted $(count "$deleted" repo repos), reclaimed ~${gone_gib} GiB."
fi
header_line "" "audit $audit"
# Only after a run that removed something, which leaves the warning, and only where the unit
# exists, since otherwise the command would fail.
if [ "$RESTART" = 0 ] && [ "$deleted" -gt 0 ] \
   && systemctl cat "$SERVICE" >/dev/null 2>&1; then
  header_line tip "run 'sudo systemctl restart $SERVICE' once to clear the stale" \
                  "inventory-announce log warning."
fi
[ "$nheld" = 0 ] \
  || echo "# $nheld repo(s) held back are still in storage; see HELD BACK above." >&2
# A failed removal, lift or block each wants a person sooner than a held-back rule, so it
# wins over exit 4.
[ "$deleted" = "$nplan" ] || exit 1
[ "$undo_failed" = 0 ] || exit 1
[ "$block_failed" = 0 ] || exit 1
# Non-zero so an unattended caller sees verdicts waiting on a human. Not 3, which means the
# caps stopped the whole run.
[ "$nheld" = 0 ] || exit 4
