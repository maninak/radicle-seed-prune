MIN_OTHER_SEEDS_AGG="${MIN_OTHER_SEEDS_AGG:-1}"  # hard floor 1: B and C keep the last copy

AUDIT_DIR="${AUDIT_DIR:-$RAD_HOME/prune-audit}"
# A pruned repo is moved here first and deleted once its window passes. Some verdicts may prune
# the last known copy, which re-fetching cannot undo. A week lets a weekly cron run be looked
# at once while the parked disk stays small.
QUARANTINE="${QUARANTINE:-1}"                    # 0 deletes outright, with no way back
QUARANTINE_DAYS="${QUARANTINE_DAYS:-7}"          # days a pruned repo stays recoverable
# Seconds of QUARANTINE_DAYS a purge may cut short. A copy is dated to the start of the run
# that pruned it, and the next run on that schedule starts within seconds either side, or an
# hour early across a daylight-saving change. Missing by one second would keep it an extra
# cycle.
QUAR_SLACK_SECS=10800
quar="$AUDIT_DIR/quarantine"
