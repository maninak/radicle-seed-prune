set -euo pipefail
# Numbers must not depend on locale: mawk (Debian's awk) honours LC_NUMERIC, so a comma locale
# prints 2.52e+10 as "2,52e+10", the next awk parses it as 2, and disk-pressure maths reads
# zero. C also fixes sort to byte order, so a plan does not reorder between machines.
export LC_ALL=C

VERSION="0.8.0-dev"

# `set -e` alone exits with no message, so name the line, command and status. Always exit 1:
# the failed command's own status could be 3, 4 or 5, which a caller reads as the caps, the
# ratchet or a refusal to guess.
report_error(){
  echo "# ERROR: line $2: [$3] exited $1" >&2
  exit 1
}
trap 'report_error "$?" "$LINENO" "$BASH_COMMAND"' ERR

# -------------------------------------------------------------------- config (env-overridable)
RAD="${RAD:-rad}"
RAD_HOME="${RAD_HOME:-$("$RAD" path 2>/dev/null || echo "${HOME:?}/.radicle")}"
# rad reads the home from its environment. Unexported, every rad call would query the default
# home and silently plan zero repos.
export RAD_HOME
STORAGE="${STORAGE:-$RAD_HOME/storage}"
CONFIG="${CONFIG:-$RAD_HOME/config.json}"
# `--did` rather than `--nid`, which rad 1.10 deprecates and will remove.
OUR_NID="${OUR_NID:-$("$RAD" self --did 2>/dev/null || true)}"
OUR_NID=${OUR_NID#did:key:}
SERVICE="${SERVICE:-radicle-node}"          # systemd unit for --restart-node

# `check-mine` shows a publisher which of their own public repos a seed running this tool would
# prune. It uses a directory of its own, so the operator's audit trail, lists, ledger and cache
# are untouched. It runs rules A, D, F and H, which judge a repo's name and content, with their
# windows at 0 so a new repo shows the verdict it gets once old or idle enough. Seed floors are
# 0, since this node's routing table is not a seed's, and disk pressure is off. Rule H acts as
# with MALWARE_PRUNE=1. Set before the settings below, which keep a value already set.
CHECK_DIR=""
if [ "${1:-}" = check-mine ]; then
  CHECK_DIR=$(mktemp -d)
  trap 'rm -rf "$CHECK_DIR"' EXIT
  AUDIT_DIR=$CHECK_DIR
  unset KEEP_FILE FIRST_SEEN CACHE_DIR
  CACHE=0; UNDO=0; DISK_AWARE=0; RULES=ADFH; MALWARE_PRUNE=1
  SPAM_STALE_DAYS=0; MEDIA_STALE_DAYS=0; FRESH_GUARD_DAYS=0
  SPAM_MIN_SEEDS=0; MEDIA_MIN_SEEDS=0; JUNK_MIN_SEEDS=0; JUNK_ID_MIN_SEEDS=0
fi

ABS_SIZE_FLOOR_MB="${ABS_SIZE_FLOOR_MB:-500}"   # rule B absolute floor
REL_PCTL="${REL_PCTL:-95}"                       # rule B relative percentile
OUTLIER_STALE_DAYS="${OUTLIER_STALE_DAYS:-90}"   # rule B staleness  (~3 months)
JUNK_STALE_DAYS="${JUNK_STALE_DAYS:-30}"         # rule A staleness  (~1 month)
STALE_YEARS_DAYS="${STALE_YEARS_DAYS:-730}"      # rule C staleness  (~2 years)
MIN_OTHER_SEEDS="${MIN_OTHER_SEEDS:-3}"          # rules B & C: > 2 other seeds
JUNK_MIN_SEEDS="${JUNK_MIN_SEEDS:-1}"            # rule A word branch: keeps the last copy
# A repo whose oldest commit is this much older than its `rad init` is a project kept elsewhere
# first. Of 55 repos rule A pruned by name, the 11 restored by hand were 29.5 to 4748 days
# apart; the disposable ones 0 to 7.1.
IMPORT_SPARE_DAYS=14                             # rule A word branch: days before rad init
# The id branch may prune the last copy we know of, since for machine-generated bulk nobody
# else seeding it measures worthlessness. The word branch keeps a floor, since
# "my-old-thesis" is a guess.
JUNK_ID_MIN_SEEDS="${JUNK_ID_MIN_SEEDS:-0}"      # rule A id branch: 0 may prune the last copy
FRESH_GUARD_DAYS="${FRESH_GUARD_DAYS:-2}"        # never delete a dir touched this recently

SPAM_MIN_BATCH="${SPAM_MIN_BATCH:-5}"            # repos on one name skeleton to be a batch
SPAM_DESC_AGREE_PCT="${SPAM_DESC_AGREE_PCT:-80}" # % of a batch on ONE description skeleton
SPAM_MIN_SEEDS="${SPAM_MIN_SEEDS:-0}"            # 0 may prune the last copy we know of
# Rule D's evidence is not time-based; this is a grace period for a batch that turns out real.
SPAM_STALE_DAYS="${SPAM_STALE_DAYS:-7}"          # about a week
# 0 also accepts plain enumeration batches (name-#), which can reach a version-mirror farm with
# templated descriptions.
SPAM_REQUIRE_ID="${SPAM_REQUIRE_ID:-1}"          # demand a random-id slot (%) in the skeleton

# --- rule F: media dumps ---
# Media extensions, matched case-insensitively after the last dot. One missing here counts as
# text, so an unfamiliar file spares a repo. SVG is left out: it is markup, and real projects
# commit it as an asset. Archives are in because zipping a video is a one-command evasion; a
# repo holding only a release tarball then reads as a dump on purpose, and MEDIA_TEXT_MAX_BYTES
# spares one with a project around it.
MEDIA_EXTS="${MEDIA_EXTS:-\
jpg|jpeg|png|gif|webp|avif|bmp|tif|tiff|heic|heif|ico|psd|\
mp4|m4v|mkv|avi|mov|webm|wmv|flv|mpg|mpeg|3gp|\
mp3|m4a|aac|wav|flac|ogg|opus|wma|\
zip|rar|7z|tar|gz|tgz|bz2|xz|zst}"
# Known text extensions and bare names. They only limit sniffing to files of unknown kind;
# anything on neither list is read.
MEDIA_TEXT_EXTS="\
md|markdown|txt|rst|adoc|org|tex|bib|html|htm|xml|svg|css|scss|less|\
js|mjs|cjs|jsx|ts|tsx|vue|svelte|json|jsonc|yaml|yml|toml|ini|cfg|conf|properties|env|\
lock|sum|sh|bash|zsh|fish|ps1|bat|py|rb|pl|lua|php|go|rs|c|h|cc|cpp|hpp|cs|java|kt|kts|\
scala|swift|m|mm|\
clj|ex|exs|erl|hs|ml|nim|zig|dart|r|jl|sql|csv|tsv|patch|diff|gradle|cmake|mk|proto|graphql|\
gitignore|gitattributes|editorconfig|dockerignore|npmrc|nvmrc"
# "manifest" is here because every Radicle COB op tree holds one, and a seed carries millions.
MEDIA_TEXT_NAMES="\
readme|license|licence|copying|notice|authors|contributors|changelog|changes|\
makefile|dockerfile|justfile|rakefile|gemfile|procfile|vagrantfile|codeowners|manifest|\
.gitignore|.gitattributes|.editorconfig|.env"
# The floor only ignores trivia; the text budget tells a dump from a project. Low because
# image spam is many small files: a 1 MiB floor would spare fifty hotlink-sized jpegs.
MEDIA_MIN_BYTES="${MEDIA_MIN_BYTES:-65536}"      # media bytes below which a repo is not judged
# Everything that is NOT media, added up, must stay under this. A project carries more.
MEDIA_TEXT_MAX_BYTES="${MEDIA_TEXT_MAX_BYTES:-2048}"
# The batch path's wider budget. A README this big is a document, and spares the repo anyway.
MEDIA_TEXT_CEIL_BYTES="${MEDIA_TEXT_CEIL_BYTES:-65536}"
MEDIA_MIN_BATCH="${MEDIA_MIN_BATCH:-5}"          # repos holding one blob to call it a campaign
MEDIA_STALE_DAYS="${MEDIA_STALE_DAYS:-7}"        # minimum age, from creation like rule D
MEDIA_MIN_SEEDS="${MEDIA_MIN_SEEDS:-0}"          # 0 may prune the last copy; 1 keeps it
# How much of each repo to read. Only a file's first bytes are read, and only while the repo
# could still be a dump. Biggest files go first, and a repo whose unread files could change its
# verdict goes unjudged. A "text" file this big is read too: it may be a video wearing a .md.
MEDIA_SNIFF_TEXT_BYTES=262144
MEDIA_SNIFF_MAX_FILES=200                        # most files read in any one repo
# Most refs a repo can have and still be judged. One repo on an 11k-repo seed has 152k refs,
# minutes of walking to learn a widely replicated repo is not a dump. Four repos there exceed
# this and the next has 2942 refs, so the cap sits in a wide gap.
MEDIA_MAX_REFS="${MEDIA_MAX_REFS:-10000}"
# Most issue and patch ops a repo can have and still be judged, counting a patch's commits no
# delegate branch holds. Each op naming a delegate's key costs a signature check, and anybody
# can push ops naming any key. On a 13k-repo seed the busiest projects have about 11k, and one
# automated inventory repo 93k.
MEDIA_MAX_OPS="${MEDIA_MAX_OPS:-20000}"
# A tree can name one subtree twice, recursively, so a repo of a few hundred bytes can list as
# millions of paths, all held in memory. A repo whose tip listing (names and object ids)
# exceeds this many bytes is left unjudged.
MEDIA_TIP_BYTES=16777216
# The archives among MEDIA_EXTS. The ratio path leaves them out of the media it weighs and
# spares a repo holding one, since a release tarball sits beside a short README too.
MEDIA_ARCHIVE_EXTS='zip|rar|7z|tar|gz|tgz|bz2|xz|zst'
# A source or build file means somebody meant to build something, and spares a repo from the
# dump and ratio paths. Only a build file spares it from the batch path, since one leak
# campaign shipped a shell script beside its media. Matched by name at branch and tag tips.
MEDIA_SOURCE_EXTS="\
sh|bash|zsh|fish|ps1|bat|py|rb|pl|lua|php|go|rs|c|h|cc|cpp|hpp|cs|java|kt|kts|scala|swift|\
m|mm|clj|ex|exs|erl|hs|ml|nim|zig|dart|r|jl|js|mjs|cjs|jsx|ts|tsx|vue|svelte"
MEDIA_BUILD_NAMES="\
makefile|cmakelists.txt|cargo.toml|package.json|pyproject.toml|setup.py|go.mod|\
build.gradle|build.gradle.kts|settings.gradle|settings.gradle.kts|gradlew|pom.xml|\
meson.build|flake.nix|default.nix|justfile|dockerfile|deps.edn|project.clj|mix.exs|gemfile|\
composer.json|build.zig|build.sbt|gnumakefile|rakefile|build.xml|build.bazel|module.bazel|\
project.godot"
# A seed's branding repo is named after its hostname and holds its logo. A hostname-shaped name
# spares a repo with less media than MEDIA_HOST_MAX_BYTES. On an 11k-repo seed the largest logo
# was 366 KB and dumps went down to 450 KB, so the cap keeps what a made-up hostname can shield
# small. Matched in lower case; the second group is the top-level domain.
MEDIA_HOST_NAME_RE='^([a-z0-9-]+\.)+([a-z]{2,})([^a-z0-9.]|$)'
MEDIA_HOST_MAX_BYTES=1048576
# The ratio path: a repo that is almost all images, video and audio is a dump even when a short
# README puts it over MEDIA_TEXT_MAX_BYTES. On an 11k-repo seed its dumps held 8 to 178 MB of
# media, text at most 0.05% of that. A 1% share reached a real project, and the nearest one
# under the floor held 4.8 MB of slides. Text is summed only to MEDIA_TEXT_CEIL_BYTES, so past
# about 64 MiB of media that budget is the limit. Each dump held one file besides its media, a
# README; a README and a licence is something somebody published.
MEDIA_RATIO_MIN_BYTES="${MEDIA_RATIO_MIN_BYTES:-6291456}"   # images, video, audio; no archives
MEDIA_RATIO_TEXT_PER_MILLE=1       # everything else under this share of them, in 1/1000ths
MEDIA_RATIO_MAX_FILES=1            # READMEs at the tips of branches and tags; nothing else

# --- rule G: parasite peers ---
# Blocking a peer is a standing judgement about a person, applies to every repo, and they are
# never told, so every threshold here buys confidence over reach. Rule G reports by default
# and blocks only under --block-peers. See RULE G at the top for the evidence.
PARASITE_MIN_REPOS="${PARASITE_MIN_REPOS:-10}"   # repos one blob must reach to accuse a peer
PARASITE_MIN_BYTES="${PARASITE_MIN_BYTES:-1048576}"
# A peer who writes this much text of its own is a contributor and is never accused, whatever
# else it pushes. The allowance is generous on purpose, as it is cheap for a real person to
# clear and costly for a bot to fake.
PARASITE_TEXT_MAX_BYTES="${PARASITE_TEXT_MAX_BYTES:-16384}"

# --- rule H: malware operations ---
# Names an identity whose repos are named or described like a malware operation: a stealer, a
# drainer, a botnet and its panel. Over 13k repos on one seed these flag one identity, the
# operation they were built from; security researchers and bulk publishers stay under the bars.
# Word lists are lower case and |-separated; a word matches whole, or with one trailing "s".
MALWARE_STRONG_WORDS="${MALWARE_STRONG_WORDS:-\
hvnc|stealer|crypter|drainer|keylogger|ransomware|botnet|scam}"
MALWARE_WEAK_WORDS="${MALWARE_WEAK_WORDS:-c2|payload|panel|loader|zombie|rat|exploit}"
# One strong word is a topic; three words across repos, at least two of them, are a toolkit.
# The share keeps a prolific developer with one security side project under the bar.
MALWARE_MIN_WORDS=3          # distinct words, strong and weak, across the identity's repos
MALWARE_MIN_REPOS=2          # repos of the identity that hold any word; one is too little
MALWARE_MIN_SHARE_PCT=50     # of the identity's signed repos in storage, the share that hits
# One repo is named on its own when a strong word in its name or description is joined by one
# in a file path at its tips or a commit subject, and its history starts with the repo. Over
# 13k repos, a strong word in a name alone flags three honest repos of six; one in a path or
# subject alone flags one operation among dozens of honest repos; together, two operations and
# one honest repo. A much older history is a mirror of somebody else's project. A repo named
# this way is only reported, since an honest one still matches.
MALWARE_ORIGINAL_DAYS=7      # most days the first commit may predate the repo's `rad init`
MALWARE_SUBJECTS=1000        # newest commit subjects read per repo, to bound a big mirror
MALWARE_TREES=50             # distinct trees at branch and tag tips listed per repo, likewise
MALWARE_BYTES=4194304        # of paths and subjects read per repo in all; a tree can repeat
# 1 prunes every repo of an identity rule H names, as malware-op, and an --apply run with
# --block-peers blocks the identities. Off by default, because one seed's measurements are too
# few to show how often an honest identity is named, and only a person can tell an operation
# from research into one. Revisit when several seeds have run it opt-in.
MALWARE_PRUNE="${MALWARE_PRUNE:-0}"

# Which rules may run. A letter absent here means that rule neither scans nor plans. RULES=
# (set but empty) means none: on a tool that deletes, reading it as "all" fails in the
# direction that cannot be undone.
RULES="${RULES-ABCDFGH}"
# The link-farm rule (E) is gone, and an old cron line may still name it. Stopping would prune
# nothing until somebody read the error, so the letter is dropped, with a warning on every run
# but a quarantine verb.
rules_named_e=0
case "$RULES" in (*E*) rules_named_e=1; RULES=${RULES//E/} ;; esac
# Any other character would match no rule, so RULES=abc would run none of them without a word.
case "$RULES" in
  *[!ABCDFGH]*) echo "# RULES takes the letters ABCDFGH, not '$RULES'." >&2; exit 2 ;;
esac
rule_on(){ case "$RULES" in (*"$1"*) return 0 ;; (*) return 1 ;; esac; }

# A label in a column of its own, then the value. An empty label continues the line above.
header_line() { printf '# %-6s %s\n' "$1" "${*:2}"; }

# A count with its noun: "1 repo", "5 repos".
count() { if [ "$1" = 1 ]; then echo "1 $2"; else echo "$1 $3"; fi; }

# A byte threshold in the largest unit that divides it evenly: 6291456 prints as 6MiB.
header_bytes() {
  local b=$1
  if   [ $((b % 1048576)) = 0 ]; then echo "$((b / 1048576))MiB"
  elif [ $((b % 1024)) = 0 ];    then echo "$((b / 1024))KiB"
  else                                echo "${b}B"
  fi
}

# How the output names a rule: by what it does, and by the letter RULES takes.
rule_label() {
  case $1 in
    A) echo "the junk-name rule (A)" ;;
    B) echo "the size rule (B)" ;;
    C) echo "the stale rule (C)" ;;
    D) echo "the spam-batch rule (D)" ;;
    F) echo "the media rule (F)" ;;
    G) echo "the parasite-peer rule (G)" ;;
    H) echo "the malware rule (H)" ;;
    *) echo "rule $1" ;;
  esac
}

MAX_PRUNE_COUNT="${MAX_PRUNE_COUNT:-1000}"       # runaway guards (abort unless --force)
MAX_PRUNE_GB="${MAX_PRUNE_GB:-80}"
# The fixed caps catch only a plan too big at once. At 2.5 GiB a week a plan could creep for a
# year under MAX_PRUNE_GB, and under disk pressure the thresholds loosen. So each rule's share
# is also compared to what that rule usually prunes, from the audit logs, and a rule far above
# its usual is held back while the others go ahead.
RATCHET_FACTOR="${RATCHET_FACTOR:-3}"            # times a rule's usual haul before it is held
RATCHET_RUNS="${RATCHET_RUNS:-8}"                # a rule's past runs its usual is taken from
# A rule that usually prunes nothing has a usual of 0, which would hold back its first verdict.
# Below this many repos a rule is never held. On radicle.at rule A's weekly median was 13
# (limit 39), and the waves worth stopping ran to hundreds.
RATCHET_FLOOR="${RATCHET_FLOOR:-20}"             # repos per rule, per run
MAX_SCAN_FAIL_PCT="${MAX_SCAN_FAIL_PCT:-10}"     # abort if this share of storage is unreadable

# --- disk-pressure adaptivity --- The thresholds above are the RELAXED values. As free disk on
# the storage filesystem falls from the relaxed free-space threshold to the critical one, each
# is interpolated toward its AGGRESSIVE value below. DISK_AWARE=0 always uses relaxed values.
# Hard safety floors (>=1 other seed, the exclusions) never scale.
DISK_AWARE="${DISK_AWARE:-1}"
PRESSURE_RELAX_PCT="${PRESSURE_RELAX_PCT:-20}"   # >= max(pct,gb) free  -> pressure 0 (relaxed)
PRESSURE_RELAX_GB="${PRESSURE_RELAX_GB:-20}"
PRESSURE_CRIT_PCT="${PRESSURE_CRIT_PCT:-10}"     # <= min(pct,gb) free -> pressure 1 (max)
PRESSURE_CRIT_GB="${PRESSURE_CRIT_GB:-2}"
# GB of free space that may vanish since the last run history.log records, beyond what storage
# and the quarantine grew by, before a warning that something else is filling the disk.
# Pressure reads one sample of free space, so a cache filling the disk for a few hours steers a
# whole run.
DISK_DROP_WARN_GB=10
# Max age in days of that baseline line. history.log gains a line only from a run with a plan,
# and against a months-old line, slow log and cache growth passes DISK_DROP_WARN_GB every week.
# Just over one weekly cycle.
DISK_DROP_BASELINE_DAYS=8
ABS_SIZE_FLOOR_MB_AGG="${ABS_SIZE_FLOOR_MB_AGG:-50}"     # full-pressure endpoints
REL_PCTL_AGG="${REL_PCTL_AGG:-50}"
OUTLIER_STALE_DAYS_AGG="${OUTLIER_STALE_DAYS_AGG:-14}"
JUNK_STALE_DAYS_AGG="${JUNK_STALE_DAYS_AGG:-7}"
SPAM_STALE_DAYS_AGG="${SPAM_STALE_DAYS_AGG:-1}"
