set -euo pipefail
# Numbers must not depend on the operator's locale. mawk, which is what a Debian seed runs,
# honours LC_NUMERIC: under a comma locale it prints 2.52e+10 as "2,52e+10", and the next awk
# that reads that value back parses it as 2. That silently zeroes the disk-pressure maths. C
# also fixes sort to byte order, so a plan does not reorder itself between machines.
export LC_ALL=C

VERSION="0.8.0-dev"

# `set -e` on its own exits mute: a command failing anywhere below would end the run with a
# bare non-zero status and nothing to debug from. Name the line, the command, and the status
# instead.
# Always exit 1: the failed command's own status could be 3, 4 or 5, which a caller reads as the
# caps, the ratchet or a refusal to guess.
report_error(){
  echo "# ERROR: line $2: [$3] exited $1" >&2
  exit 1
}
trap 'report_error "$?" "$LINENO" "$BASH_COMMAND"' ERR

# -------------------------------------------------------------------- config (env-overridable)
RAD="${RAD:-rad}"
RAD_HOME="${RAD_HOME:-$("$RAD" path 2>/dev/null || echo "${HOME:?}/.radicle")}"
# rad reads the home from its ENVIRONMENT: unexported, every rad call below would query the
# default home, come back empty, and silently force a plan of zero repos.
export RAD_HOME
STORAGE="${STORAGE:-$RAD_HOME/storage}"
CONFIG="${CONFIG:-$RAD_HOME/config.json}"
# `--did` rather than `--nid`, which rad 1.10 deprecates and will remove.
OUR_NID="${OUR_NID:-$("$RAD" self --did 2>/dev/null || true)}"
OUR_NID=${OUR_NID#did:key:}
SERVICE="${SERVICE:-radicle-node}"          # systemd unit for --restart-node

ABS_SIZE_FLOOR_MB="${ABS_SIZE_FLOOR_MB:-500}"   # rule B absolute floor
REL_PCTL="${REL_PCTL:-95}"                       # rule B relative percentile
OUTLIER_STALE_DAYS="${OUTLIER_STALE_DAYS:-90}"   # rule B staleness  (~3 months)
JUNK_STALE_DAYS="${JUNK_STALE_DAYS:-30}"         # rule A staleness  (~1 month)
STALE_YEARS_DAYS="${STALE_YEARS_DAYS:-730}"      # rule C staleness  (~2 years)
MIN_OTHER_SEEDS="${MIN_OTHER_SEEDS:-3}"          # rules B & C: > 2 other seeds
JUNK_MIN_SEEDS="${JUNK_MIN_SEEDS:-1}"            # rule A word branch: keeps the last copy
# A repo whose oldest commit is this much older than its `rad init` is a project somebody kept
# before publishing it, whatever its name says. Over the 55 repos rule A pruned by name, the 11
# restored by hand were 29.5 to 4748 days apart; the disposable ones 0 to 7.1.
IMPORT_SPARE_DAYS=14                             # rule A word branch: days before rad init
# The id branch (a name that is NOTHING but a random hex id) may prune the last copy we
# know of: for machine-generated bulk "nobody else seeds it" measures worthlessness, not
# rarity. The word branch keeps its floor, since "my-old-thesis" is a guess, not proof.
JUNK_ID_MIN_SEEDS="${JUNK_ID_MIN_SEEDS:-0}"      # rule A id branch: 0 may prune the last copy
FRESH_GUARD_DAYS="${FRESH_GUARD_DAYS:-2}"        # never delete a dir touched this recently

SPAM_MIN_BATCH="${SPAM_MIN_BATCH:-5}"            # repos on one name skeleton to be a batch
SPAM_DESC_AGREE_PCT="${SPAM_DESC_AGREE_PCT:-80}" # % of a batch on ONE description skeleton
SPAM_MIN_SEEDS="${SPAM_MIN_SEEDS:-0}"            # 0 may prune the last copy we know of
# Rule D's evidence is not time-based, so this is only a grace period for a batch that turns
# out to be real.
SPAM_STALE_DAYS="${SPAM_STALE_DAYS:-7}"          # about a week
# 0 also accepts plain enumeration batches (name-#), which can reach a version-mirror farm with
# templated descriptions.
SPAM_REQUIRE_ID="${SPAM_REQUIRE_ID:-1}"          # demand a random-id slot (%) in the skeleton

# --- rule E: link farms ---
# Flags repos that link to domains almost no repo's own code links to. See rule E at the top.
# "Many repos link to it" has to mean something on a 200-repo seed and on a 100k-repo one, so
# the bar is a share of storage with an absolute floor under it. Setting LINK_MIN_REPOS above
# the share pins it there.
LINK_MIN_REPOS="${LINK_MIN_REPOS:-8}"            # fewest repos that can make a spam domain
LINK_MIN_REPOS_PCT="${LINK_MIN_REPOS_PCT:-0.4}"  # or this % of storage, whichever is larger
LINK_DELEGATE_CHECK="${LINK_DELEGATE_CHECK:-1}"  # 0 counts links from any peer
LINK_CODE_MAX_PCT="${LINK_CODE_MAX_PCT:-10}"     # a domain stops being spam once this % of its
                                                 # linkers have it in their own code
LINK_CODE_LOOSE_PCT="${LINK_CODE_LOOSE_PCT:-50}" # the looser cap of pass 1, deciding whose
                                                 # code links count at all
LINK_MIN_SCORE="${LINK_MIN_SCORE:-5}"            # spam domains a repo must link to
LINK_STALE_DAYS="${LINK_STALE_DAYS:-7}"          # minimum age, from creation like rule D
LINK_MIN_SEEDS="${LINK_MIN_SEEDS:-0}"            # 0 may prune the last copy we know of
# How much of each repo to read. These truncate a blob rather than skipping it, so a link
# sitting near the start of a large file is still seen. A link the file itself encodes (base64,
# an escaped string) is missed either way: the regex below matches plain text only.
LINK_BLOB_PREFIX=65536                           # max bytes read from any single blob
LINK_REPO_BUDGET="${LINK_REPO_BUDGET:-8000000}"  # max bytes read per repo, per pass (all refs,
                                                 # then canonical branches only)

# --- rule F: media dumps ---
# Flags repos whose tracked files are media with no project around them. See rule F at the top.
# Extensions judged as media, matched case-insensitively on whatever follows the last dot. An
# extension missing from this list counts as text, so an unfamiliar file spares a repo instead
# of condemning it. SVG is deliberately absent: it is markup, and real projects commit it as an
# asset. Archives are here because zipping a video is a one-command evasion; the cost is that a
# repo holding a release tarball and nothing else reads as a dump. That is the intended
# reading: MEDIA_TEXT_MAX_BYTES spares a tarball that has a project around it.
MEDIA_EXTS="${MEDIA_EXTS:-\
jpg|jpeg|png|gif|webp|avif|bmp|tif|tiff|heic|heif|ico|psd|\
mp4|m4v|mkv|avi|mov|webm|wmv|flv|mpg|mpeg|3gp|\
mp3|m4a|aac|wav|flac|ogg|opus|wma|\
zip|rar|7z|tar|gz|tgz|bz2|xz|zst}"
# Extensions and bare filenames known to be text. Their only job is to keep the reading below
# to the few files whose kind is genuinely unknown; anything not on either list gets read.
MEDIA_TEXT_EXTS="\
md|markdown|txt|rst|adoc|org|tex|bib|html|htm|xml|svg|css|scss|less|\
js|mjs|cjs|jsx|ts|tsx|vue|svelte|json|jsonc|yaml|yml|toml|ini|cfg|conf|properties|env|\
lock|sum|sh|bash|zsh|fish|ps1|bat|py|rb|pl|lua|php|go|rs|c|h|cc|cpp|hpp|cs|java|kt|kts|\
scala|swift|m|mm|\
clj|ex|exs|erl|hs|ml|nim|zig|dart|r|jl|sql|csv|tsv|patch|diff|gradle|cmake|mk|proto|graphql|\
gitignore|gitattributes|editorconfig|dockerignore|npmrc|nvmrc"
# "manifest" is in here because a Radicle COB op is a tree holding one, and a seed carries
# millions of them.
MEDIA_TEXT_NAMES="\
readme|license|licence|copying|notice|authors|contributors|changelog|changes|\
makefile|dockerfile|justfile|rakefile|gemfile|procfile|vagrantfile|codeowners|manifest|\
.gitignore|.gitattributes|.editorconfig|.env"
# The floor is only there so the rule ignores trivia; it is NOT what tells a dump from a
# project. That is the text budget below. Kept low because image spam is many small files, not
# one big one: a 1 MiB floor would spare fifty hotlink-sized jpegs.
MEDIA_MIN_BYTES="${MEDIA_MIN_BYTES:-65536}"      # media bytes below which a repo is not judged
# Everything that is NOT media, added up, has to stay under this. A project carries more than a
# token file's worth of text; a dump carries none.
MEDIA_TEXT_MAX_BYTES="${MEDIA_TEXT_MAX_BYTES:-2048}"
# The batch path's wider budget, for repos whose media other repos hold too. A README big
# enough to clear this is a document, not a fig leaf, and spares the repo either way.
MEDIA_TEXT_CEIL_BYTES="${MEDIA_TEXT_CEIL_BYTES:-65536}"
MEDIA_MIN_BATCH="${MEDIA_MIN_BATCH:-5}"          # repos holding one blob to call it a campaign
MEDIA_STALE_DAYS="${MEDIA_STALE_DAYS:-7}"        # minimum age, from creation like D and E
MEDIA_MIN_SEEDS="${MEDIA_MIN_SEEDS:-0}"          # 0 may prune the last copy; 1 keeps it
# How much of each repo to look at. Only the first bytes of a file are ever read, and only
# while the repo could still be a dump, so these bound an already small cost. The biggest files
# are read first, and a repo whose unread files could change its verdict goes unjudged.
# A "text" file this big is read too: it may be a video wearing a .md, which would otherwise
# both hide itself and blow the very budget that spares the repo.
MEDIA_SNIFF_TEXT_BYTES=262144
MEDIA_SNIFF_MAX_FILES=200                        # most files read in any one repo
# Most refs a repo can have and still be judged. Reading every peer's refs is what this rule
# costs, and one repo on a real 11k-repo seed has 152k of them: minutes of walking to learn
# that a repo half the network replicates is not a dump. Four repos there are over this cap,
# and the next one down has 2942 refs, so it sits in a wide gap rather than near real repos.
MEDIA_MAX_REFS="${MEDIA_MAX_REFS:-10000}"
# A tree can name one subtree twice, and that one the next twice, so a repo of a few hundred
# bytes can list as millions of paths, or as long ones, each held in memory while the tips are
# read. A repo whose tips list as more bytes than this, names and object ids, is left unjudged.
MEDIA_TIP_BYTES=16777216
# The archives among MEDIA_EXTS. The ratio path leaves them out of the media it weighs, and
# spares a repo holding one: a release tarball or a mirrored binary sits beside a short README
# too.
MEDIA_ARCHIVE_EXTS='zip|rar|7z|tar|gz|tgz|bz2|xz|zst'
# A source file or a build file says somebody meant to build something, and spares a repo from
# the dump and ratio paths. Only a build file spares it from the batch path: one leak campaign
# shipped a shell script beside its media. Matched by name, at the tips of branches and tags.
MEDIA_SOURCE_EXTS="\
sh|bash|zsh|fish|ps1|bat|py|rb|pl|lua|php|go|rs|c|h|cc|cpp|hpp|cs|java|kt|kts|scala|swift|\
m|mm|clj|ex|exs|erl|hs|ml|nim|zig|dart|r|jl|js|mjs|cjs|jsx|ts|tsx|vue|svelte"
MEDIA_BUILD_NAMES="\
makefile|cmakelists.txt|cargo.toml|package.json|pyproject.toml|setup.py|go.mod|\
build.gradle|build.gradle.kts|settings.gradle|settings.gradle.kts|gradlew|pom.xml|\
meson.build|flake.nix|default.nix|justfile|dockerfile|deps.edn|project.clj|mix.exs|gemfile|\
composer.json|build.zig|build.sbt|gnumakefile|rakefile|build.xml|build.bazel|module.bazel|\
project.godot"
# A seed's branding repo is named after the seed's hostname and holds its logo or avatar. A
# name shaped like a hostname spares a repo holding less media than MEDIA_HOST_MAX_BYTES. The
# largest logo on an 11k-repo seed was 366 KB, while dumps there went down to 450 KB, so the
# cap keeps what a made-up hostname can shield small. Matched in lower case; the second group
# is the last label, the top-level domain.
MEDIA_HOST_NAME_RE='^([a-z0-9-]+\.)+([a-z]{2,})([^a-z0-9.]|$)'
MEDIA_HOST_MAX_BYTES=1048576
# The ratio path: a repo that is almost all images, video and audio is a dump even when a short
# README puts it over MEDIA_TEXT_MAX_BYTES. On an 11k-repo seed the dumps it is there for held
# 8 to 178 MB of media, with text at most 0.05% of that. A share of 1% reached a real project,
# and the nearest one under the floor held 4.8 MB of slides. Text is only added up as far as
# MEDIA_TEXT_CEIL_BYTES, so past about 64 MiB of media that budget is the limit, not the share.
# Each of those dumps held one file besides its media, a README. A README and a licence, or a
# page with its pictures, is something somebody published.
MEDIA_RATIO_MIN_BYTES="${MEDIA_RATIO_MIN_BYTES:-6291456}"   # images, video, audio; no archives
MEDIA_RATIO_TEXT_PER_MILLE=1       # everything else under this share of them, in 1/1000ths
MEDIA_RATIO_MAX_FILES=1            # READMEs at the tips of branches and tags; nothing else

# --- rule G: parasite peers ---
# Rule G judges a PEER, not a repo, and blocking a peer is a heavier act than deleting one
# repo: it is a standing judgement about a person, it applies to every repo at once, and they
# are never told. So this rule is built to be nearly impossible to trip by accident, and every
# threshold below buys confidence rather than reach. It reports by default and blocks only
# under --block-peers, so the operator reads the evidence before anyone is blocked.
# The evidence is one file, byte for byte, pushed into repos the peer is not a delegate of.
# A person attaching a screenshot to an issue posts a DIFFERENT file each time; the same oid
# landing in unrelated repos is a campaign, and it is the one thing a single repo cannot
# manufacture.
PARASITE_MIN_REPOS="${PARASITE_MIN_REPOS:-10}"   # repos one blob must reach to accuse a peer
PARASITE_MIN_BYTES="${PARASITE_MIN_BYTES:-1048576}"
# A peer who writes is a contributor, whatever else they push. This is generous on purpose: it
# is cheap for a real person to clear and costly for a bot to fake, so it errs toward mercy.
PARASITE_TEXT_MAX_BYTES="${PARASITE_TEXT_MAX_BYTES:-16384}"

# --- rule H: malware operations ---
# Names an identity whose repos are named or described like a malware operation: a stealer, a
# drainer, a botnet and the panel that runs it. Only a person can tell an operation from
# research into one, so rule H prunes and blocks nothing; it points at the deny list. Measured
# over 13k repos on one seed, these flag one identity, the operation they were built from.
# Security researchers and bulk publishers who hit the weak words stay under the bars. The
# word lists are lower case and |-separated; a word matches whole, or with one trailing "s".
MALWARE_STRONG_WORDS="${MALWARE_STRONG_WORDS:-\
hvnc|stealer|crypter|drainer|keylogger|ransomware|botnet|scam}"
MALWARE_WEAK_WORDS="${MALWARE_WEAK_WORDS:-c2|payload|panel|loader|zombie|rat|exploit}"
# One strong word is a topic; three words across repos, at least two of them, are a toolkit.
# The share keeps a prolific developer with one security side project under the bar.
MALWARE_MIN_WORDS=3          # distinct words, strong and weak, across the identity's repos
MALWARE_MIN_REPOS=2          # repos of the identity that hold any word; one is too little
MALWARE_MIN_SHARE_PCT=50     # of the identity's signed repos in storage, the share that hits
# One repo is named on its own when a strong word in its name or description is joined by one,
# the same or another, in a file path at its tips or a commit subject, and its history starts
# with the repo. Over 13k repos on one seed, a strong word in a name alone flags three honest
# repos of six, and one in a path or a subject alone flags one operation among dozens of honest
# repos; together, two operations and one honest repo. A history much older than the repo is a
# mirror of somebody else's project.
MALWARE_ORIGINAL_DAYS=7      # most days the first commit may predate the repo's `rad init`
MALWARE_SUBJECTS=1000        # newest commit subjects read per repo, to bound a big mirror
MALWARE_TREES=50             # distinct trees at branch and tag tips listed per repo, likewise
MALWARE_BYTES=4194304        # of paths and subjects read per repo in all; a tree can repeat

# Which rules may run at all, one spelling for every rule. A letter absent from this string
# means that rule neither scans nor puts anything in the plan. RULES= (set but empty) means no
# rules at all, not the default: an operator who writes that means none, and on a tool that
# deletes, reading it as "all of them" fails in the one direction that cannot be undone.
RULES="${RULES-ABCDEFGH}"
rule_on(){ case "$RULES" in (*"$1"*) return 0 ;; (*) return 1 ;; esac; }
# How the output names a rule: by what it does, and by the letter RULES takes.
rule_label() {
  case $1 in
    A) echo "the junk-name rule (A)" ;;
    B) echo "the size rule (B)" ;;
    C) echo "the stale rule (C)" ;;
    D) echo "the spam-batch rule (D)" ;;
    E) echo "the link-farm rule (E)" ;;
    F) echo "the media rule (F)" ;;
    G) echo "the parasite-peer rule (G)" ;;
    H) echo "the malware rule (H)" ;;
    *) echo "rule $1" ;;
  esac
}

MAX_PRUNE_COUNT="${MAX_PRUNE_COUNT:-1000}"       # runaway guards (abort unless --force)
MAX_PRUNE_GB="${MAX_PRUNE_GB:-80}"
# The fixed caps above only catch a plan that is too big at once, not one that CREEPS: at a
# steady 2.5 GiB a week, a plan could grow for a year without ever touching MAX_PRUNE_GB, and
# under sustained disk pressure the thresholds loosen on their own. So each rule's share of the
# plan is also measured against what that rule normally prunes here, taken from the audit logs
# the seed already writes, and a rule far above its usual is held back while the others go
# ahead.
RATCHET_FACTOR="${RATCHET_FACTOR:-3}"            # times a rule's usual haul before it is held
RATCHET_RUNS="${RATCHET_RUNS:-8}"                # past runs the usual is taken from (median)
# A rule that usually prunes nothing has a usual of 0, and three times 0 would hold back its
# very first verdict. Below this many repos a rule is never held back, so an ordinary week's
# handful goes through and only a wave waits for a human. Measured on radicle.at: rule A's
# weekly median was 13 (limit 39), and the waves worth stopping ran to hundreds of repos.
RATCHET_FLOOR="${RATCHET_FLOOR:-20}"             # repos per rule, per run
MAX_SCAN_FAIL_PCT="${MAX_SCAN_FAIL_PCT:-10}"     # abort if this share of storage is unreadable

# --- disk-pressure adaptivity --- The thresholds above are the RELAXED (plenty-of-space)
# values. As free disk on the storage filesystem falls from the relaxed free-space threshold
# down to the critical one, every knob is interpolated toward its AGGRESSIVE value, so the tool
# self-tightens with no human retuning. Set DISK_AWARE=0 to disable and always use the relaxed
# values. Hard safety floors (>=1 other seed, the exclusions) never scale.
DISK_AWARE="${DISK_AWARE:-1}"
PRESSURE_RELAX_PCT="${PRESSURE_RELAX_PCT:-20}"   # >= max(pct,gb) free  -> pressure 0 (relaxed)
PRESSURE_RELAX_GB="${PRESSURE_RELAX_GB:-20}"
PRESSURE_CRIT_PCT="${PRESSURE_CRIT_PCT:-10}"     # <= min(pct,gb) free -> pressure 1 (max)
PRESSURE_CRIT_GB="${PRESSURE_CRIT_GB:-2}"
ABS_SIZE_FLOOR_MB_AGG="${ABS_SIZE_FLOOR_MB_AGG:-50}"     # full-pressure endpoints
REL_PCTL_AGG="${REL_PCTL_AGG:-50}"
OUTLIER_STALE_DAYS_AGG="${OUTLIER_STALE_DAYS_AGG:-14}"
JUNK_STALE_DAYS_AGG="${JUNK_STALE_DAYS_AGG:-7}"
SPAM_STALE_DAYS_AGG="${SPAM_STALE_DAYS_AGG:-1}"
STALE_YEARS_DAYS_AGG="${STALE_YEARS_DAYS_AGG:-60}"
MIN_OTHER_SEEDS_AGG="${MIN_OTHER_SEEDS_AGG:-1}"  # hard floor 1: B and C keep the last copy

AUDIT_DIR="${AUDIT_DIR:-$RAD_HOME/prune-audit}"
# A pruned repo is moved here first and deleted for real once its window passes. Three verdicts
# may prune the last copy the network is known to hold, and for exactly those the documented
# undo ("re-fetch it") cannot work, so the only real undo is a copy on this disk.
# A week is long enough for a weekly cron run to be looked at once before its repos go, and
# short enough that the parked disk stays small.
QUARANTINE="${QUARANTINE:-1}"                    # 0 deletes outright, with no way back
QUARANTINE_DAYS="${QUARANTINE_DAYS:-7}"          # days a pruned repo stays recoverable
quar="$AUDIT_DIR/quarantine"
# Repos to never prune, one rid per line, blank lines and #-comments ignored. Written by
# "quarantine restore" and editable by hand: a verdict a human has overruled once should not
# have to be overruled again every week.
KEEP_FILE="${KEEP_FILE:-$AUDIT_DIR/keep.txt}"
# Repos and identities a human has already judged, one per line, blank lines and #-comments
# ignored. A repo id is pruned wherever it turns up and blocked before it ever arrives. An
# identity (did:key:z6Mk...) is blocked as a peer, and every repo it is a delegate of is pruned.
# The verdict is a person's, so no rule's evidence, age or seed count is asked for. Pins, our
# own and private repos, and keep.txt still win, since each of those is a person's word too.
DENY_FILE="$AUDIT_DIR/deny.txt"
# Files a denied repo carried, so a copy of them elsewhere is pruned too. One file per line,
# whitespace-separated: its git object id, its size or -, where it came from (one word, a repo
# id when it is one), and a date; #-comments ignored. A row whose source is a repo id in
# keep.txt is ignored: a restored repo is a verdict taken back, and its files stop condemning.
DENY_FILES="$AUDIT_DIR/deny-files.tsv"
# A copy is a repo whose delegates' branches and tags, history included, hold at least
# COPY_MIN_BYTES of those files, making up at least COPY_MIN_PCT% of all the bytes on those
# branches. Both, because honest repos do share the odd avatar or icon with a leak: the honest
# repos we measured held 0.3 MiB of a denied repo's files at most, and the copies 50 MiB and
# up. The share spares a project that vendored a few listed files. A re-encoded copy has
# different bytes and is not caught.
COPY_MIN_BYTES=5242880                           # bytes of listed files a copy holds
COPY_MIN_PCT=50                                  # % of the branches' bytes those files make up
# --- undoing this tool's own prunes --- A verdict can turn out wrong after its repo is gone: a
# later release stops trusting it, or the repo's delegates push again after a verdict that said
# they had stopped. The block such a verdict left is lifted, once per repo, so the repo can
# come back and the current rules judge it. Only a block an audit log explains is lifted.
UNDO="${UNDO:-1}"                                # 0 lifts no block
UNDO_MAX_COUNT="${UNDO_MAX_COUNT:-200}"          # deleted repos unblocked in one run
UNDO_MAX_GB="${UNDO_MAX_GB:-10}"                 # GiB those repos held when pruned, per run
# Verdicts an older version reached that this one no longer trusts, as version:reason:max. A
# block made under the reason by a version below the one named is lifted; a repo bigger than
# max (K, M or G) when it was pruned stays blocked, since bringing it back costs a fetch of
# that size. Each entry states the share of that verdict known to be wrong. An entry goes two
# minor releases after it went in, so the list empties as seeds upgrade.
#   media-dump, media-batch: 15 of 54 media verdicts checked by hand on radicle.at were wrong,
#   all of them at most 23 MiB; 27 of the 39 right ones were 2.5 MiB to 409 MiB.
UNDO_CHANGED="0.8.0:media-dump:32M 0.8.0:media-batch:32M"
# Repos known to be wrongly pruned that the current rules still flag, as rid:version. Lifted
# whatever the budget, and spared by the rules, until the release named, which is the one that
# has to change the rule that flags it or drop the entry. More than a handful here is a rule
# to fix, not a list to grow.
#   z3przuV9nGYpx5hmgPG65miGhS68Q: a docs repo of screenshots, media-dump.
UNDO_PARDON="z3przuV9nGYpx5hmgPG65miGhS68Q:0.9.0"
# Verdicts that rest on a repo being left alone: no new commit for some number of days. A push
# after the prune is the evidence those verdicts lacked, so it lifts the block: one by a
# delegate, or by any node where the audit log names no delegates. A push says nothing against
# the other verdicts: spam campaigns keep pushing to repos that are already blocked.
UNDO_REVIVE_REASONS="junk-name junk-id size-outlier stale"

# What rules E and F read out of each repo, kept between runs and reused for the repos that
# have not changed. See "the run cache" below for what a repo is keyed on.
CACHE="${CACHE:-1}"                              # 0 reads every repo on every run
CACHE_DIR="${CACHE_DIR:-$AUDIT_DIR/cache}"
# A verdict that rests on a corpus (the same template, domain or file across many repos) is
# evidence one repo cannot manufacture, so those rows are summarised once a group gets big
# enough that nobody would read them. Rows resting on a single repo's own metadata are always
# listed in full, however many there are: those are the ones that want human eyes.
PLAN_COLLAPSE_ROWS="${PLAN_COLLAPSE_ROWS:-20}"   # group size at which a corpus verdict folds
PLAN_FULL="${PLAN_FULL:-0}"                      # 1 lists every row whatever the verdict
# Read once here, because the shell below compares it to 1 while awk would take PLAN_FULL=true
# as on: that would unfold the rows and still tell the reader to set PLAN_FULL=1.
case "$PLAN_FULL" in 1) ;; *) PLAN_FULL=0 ;; esac
# The tables the header prints are the evidence a corpus verdict rests on, so a reviewer who
# only ever sees the top five cannot check the other 153 spam domains that condemned a repo.
# PLAN_FULL already means "list everything", so it lifts these caps too rather than earning a
# knob of its own. Every truncated list below names it, so the way to the rest is on screen.
top_evidence=5; top_scanerr=3
if [ "$PLAN_FULL" = 1 ]; then top_evidence=1000000; top_scanerr=1000000; fi

# Anchor the cwd somewhere any user can read. Launched from a directory the running
# user cannot read (`sudo -u seed` started from /root, say), every `find` below emits
# "Failed to restore initial working directory", which inflates the scan-error count
# and buries the warnings that matter. Relative paths resolve against the caller's cwd
# FIRST, so they still mean what the caller meant.
# The trailing slash is dropped because `find "$STORAGE"` normalises it away while string
# concatenation does not, and the cache filter below compares the two as text.
_abs(){ local p=$1; case $p in /*) : ;; *) p="$PWD/$p" ;; esac; printf '%s' "${p%/}"; }
RAD_HOME=$(_abs "$RAD_HOME"); STORAGE=$(_abs "$STORAGE")
CONFIG=$(_abs "$CONFIG");     AUDIT_DIR=$(_abs "$AUDIT_DIR")
case $RAD in */*) RAD=$(_abs "$RAD") ;; esac   # a bare "rad" keeps resolving through PATH
# Where this seed records when it first saw each repo. A repo's ref dates are set by whoever
# pushed them, so rewriting every ref renews rules D, E and F indefinitely. This file cannot
# be reached from outside the seed, and age is taken from whichever of the two is older.
FIRST_SEEN=$(_abs "${FIRST_SEEN:-$AUDIT_DIR/first-seen.tsv}")
# Set above, possibly relative (from AUDIT_DIR or the operator's own value), and read after
# the cd below. A keep list that resolved against / would read as empty, and every repo a
# person restored would go again.
quar=$(_abs "$quar");             KEEP_FILE=$(_abs "$KEEP_FILE")
DENY_FILE=$(_abs "$DENY_FILE");   DENY_FILES=$(_abs "$DENY_FILES")
CACHE_DIR=$(_abs "$CACHE_DIR")
SELF=$(_abs "$0")   # the run cache hashes this file, and cd would break a relative $0

cd /

# The shell the per-repo workers below are run with. `bash` need not be on PATH, and a run
# started as `/nix/store/.../bash rad-prune` loses every `xargs ... bash worker.sh` worker
# while the phases still report repos nothing read. $BASH is the shell running this script.
BASH_BIN=${BASH:-bash}

# Parallel workers for the per-repo activity scan. Dynamic default: one per core, less one, so
# the running node keeps a core free. Note the scan is largely IO-bound, so raising this mostly
# helps on seeds with ref-heavy (COB-heavy) repos: measured on an 11k-repo seed, 8 workers came
# out the same as 5 inside run-to-run noise. Override via JOBS.
_cores=$(nproc 2>/dev/null || echo 4)
JOBS="${JOBS:-$(( _cores > 1 ? _cores - 1 : 1 ))}"

# Seconds between progress lines when the output is NOT a terminal, which is what a cron run
# appending to a log gets. Sparse on purpose: a weekly run leaves about a line a minute, enough
# to see where a run stopped and few enough to read a week later. A terminal ignores this and
# redraws one line instead. 0 turns off all progress reporting, the terminal line included.
PROGRESS_SECS="${PROGRESS_SECS:-60}"
# Read as a plain count of seconds, because a value the shell cannot compare numerically raises
# the ERR trap and ends the run: a knob about printing must not be able to stop a prune.
# Anything that is not a number means off, which is the direction that loses only the printing.
case "$PROGRESS_SECS" in ''|*[!0-9]*) PROGRESS_SECS=0 ;; esac

# Disposable-name patterns. The generic tokens foo/bar/baz match only as a WHOLE name (so
# "BAR_widget" is safe); everything else matches as a boundary-delimited word. JUNK_ID_MIN_LEN
# also treats a name that is NOTHING BUT a random hex id (both letters and digits, so
# "12345678" and "facade" are left alone) as disposable: no human names a repo 08a25d0f666d,
# and it is the one shape of generated bulk that rule D cannot see, because such repos carry no
# description to corroborate with. 0 disables it.
JUNK_WORDS='test|tests|testing|delete|deleted|tmp|temp|scratch|playground|sandbox'
JUNK_WORDS="$JUNK_WORDS|demo|dummy|wip|trash|junk|old|throwaway|hello-?world"
JUNK_WORD_REGEX="(^|[-_.])($JUNK_WORDS)([-_.]|$)"
JUNK_EXACT_REGEX='^(foo|bar|baz)$'
JUNK_ID_MIN_LEN="${JUNK_ID_MIN_LEN:-8}"

# Sets $dids to a repo's delegates, space-separated, and to nothing when they cannot be read,
# and $iddoc to the identity document they come from. $1 = the repo's git dir. They come from
# the identity document's top-level "delegates" list and nowhere else. refs/rad/id is written
# by the local node only after it verifies the document's signatures, so no stranger can add a
# name. The rest of that ref's tree is free text the delegates wrote, a description or a
# revision's title, and a did:key quoted there is not a delegate. Heartwood writes canonical
# JSON, whose sorted keys put that list first, and a document that opens with a list of plain
# did:keys is read here without a fork. A document written any other way still verifies: a
# "delegates" nested in its payload may come first, or a did:key may be spelled with escapes,
# so jq reads that document's top-level list. Sets variables and prints nothing, because the
# activity scan calls it once per repo in storage and a command substitution would fork for
# each one.
read_delegates() {
  local doc list did='"did:key:z[1-9A-HJ-NP-Za-km-z]+"'
  local re_list="^\\{\"delegates\":\\[($did(,$did)*)\\]"
  local re_did='did:key:(z[1-9A-HJ-NP-Za-km-z]+)(.*)'
  dids=""; iddoc=""
  doc=$(GIT_DIR="$1" git cat-file blob refs/rad/id:embeds/radicle.json 2>/dev/null) || return 0
  iddoc=$doc
  if [[ $doc =~ $re_list ]]; then
    list=${BASH_REMATCH[1]}
  else
    list=$(jq -r '[.delegates[]? | strings] | join(" ")' <<<"$doc" 2>/dev/null) || return 0
  fi
  while [[ $list =~ $re_did ]]; do
    dids="$dids${dids:+ }${BASH_REMATCH[1]}"
    list=${BASH_REMATCH[2]}
  done
  return 0
}

# Prints, of the ref names on stdin, the branches and tags a repo's delegates control: the
# canonical refs/heads and refs/tags, and the same under each delegate's namespace. Reads $dids
# as read_delegates sets it. Issues and patches are left out. A COB op's parents are the newest
# ops already there, whoever wrote them, and a patch op's are the patch's own commits, so a
# delegate who replies to a stranger's patch puts the stranger's files in the history of the
# delegate's own refs. Defined at the top level, so a worker can carry a copy of it.
delegate_branches() {
  awk -v dids=" $dids " '
    /^refs\/(heads|tags)\// { print; next }
    /^refs\/namespaces\/[^\/]+\/refs\/(heads|tags)\// {
      split($0, p, "/"); if (index(dids, " " p[3] " ")) print }'
}

# Writes the bytes the hex digits in $1 spell. Defined at the top level, so a worker can carry
# a copy of it.
unhex() {
  local esc="" i
  for ((i = 0; i < ${#1}; i += 2)); do esc+="\\x${1:i:2}"; done
  printf "$esc"
}

# The ed25519 key a did:key names, as 64 hex digits. The part after "z" is base58 of the bytes
# ed 01 followed by the key. Defined at the top level, so a worker can carry a copy of it.
did_key_hex() {
  awk -v s="$1" 'BEGIN {
    a = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"
    for (i = 2; i <= length(s); i++) {
      c = index(a, substr(s, i, 1)) - 1
      for (j = 0; j < n; j++) { c += b[j] * 58; b[j] = c % 256; c = int(c / 256) }
      while (c > 0) { b[n++] = c % 256; c = int(c / 256) }
    }
    for (j = n - 1; j >= 0; j--) printf "%02x", b[j] }' | sed -n 's/^ed01//p'
}

# Prints the tree of every issue and patch op the given COB refs reach that one of the repo's
# delegates signed, one per line, and "torn" if the refs could not be walked whole.
# Reads $dids as read_delegates sets it, and writes scratch files under $2.
# An op's parents are the newest ops already there, whoever wrote them, and a patch op's are
# also the patch's own commits, so a delegate's COB ref reaches strangers' files. The author
# line names a key, but anybody can write any author line, so it only picks which key to check.
# A Radicle op carries an ed25519 signature over its tree id, in an SSH signature block whose
# last 64 bytes are the signature itself. A check that passes ties the tree to the delegate,
# and the tree is all that is counted: the op's parents are not.
delegate_ops() {
  local d=$1 w=$2 nid key tree sig; shift 2
  [ $# -gt 0 ] || return 0
  local -A der=()
  for nid in $dids; do
    key=$(did_key_hex "$nid")
    [ ${#key} = 64 ] || continue
    # The DER form openssl reads an ed25519 public key in: a fixed 12-byte header, the key.
    unhex "302a300506032b6570032100$key" > "$w/$nid.der"
    der[$nid]=$w/$nid.der
  done
  printf '%s\n' "$@" \
    | GIT_DIR="$d" git rev-list --stdin --pretty=raw 2>/dev/null \
    | awk '
        /^commit / { if (tree != "" && sig != "") print tree, nid, sig
                     tree = ""; nid = ""; sig = ""; insig = 0; next }
        /^tree /   { tree = $2; next }
        /^author / { if (match($0, /@z[1-9A-HJ-NP-Za-km-z]+>/))
                       nid = substr($0, RSTART + 1, RLENGTH - 2)
                     next }
        /^gpgsig -----BEGIN SSH SIGNATURE-----$/ { insig = 1; next }
        insig && /^ -----END SSH SIGNATURE-----$/ { insig = 0; next }
        insig { sig = sig substr($0, 2) }
        END { if (tree != "" && sig != "") print tree, nid, sig }' \
    | while read -r tree nid sig; do
        [ -n "${der[$nid]:-}" ] || continue
        printf '%s' "$sig" | base64 -d 2>/dev/null | tail -c 64 > "$w/sig"
        unhex "$tree" > "$w/msg"
        # A signature that does not check out leaves the op uncounted, malformed or not.
        # Were it to leave the repo unjudged, one bad op would shield a dump from this rule.
        openssl pkeyutl -verify -pubin -keyform DER -inkey "${der[$nid]}" -rawin \
          -in "$w/msg" -sigfile "$w/sig" >/dev/null 2>&1 && echo "$tree"
      done
  case ${PIPESTATUS[1]} in 0) ;; *) echo torn ;; esac
}

# What the first 16 bytes say a file is, as lowercase hex, whatever its name says. Most
# signatures below hold a control byte, or one that cannot appear in UTF-8, which text does not
# start with. GIF8, ID3, fLaC, 8BPS, and RIFF or ftyp a few bytes in, are plain letters, which
# a text file is unlikely to start with but can.
# Each `?` is one hex digit, so eight of them skip 4 bytes. Defined at the top level, so a
# worker can carry a copy of it with declare -f.
is_media() {
  case "$1" in
    ffd8ff*)                       return 0 ;;   # jpeg
    89504e470d0a1a0a*)             return 0 ;;   # png
    474946383761*|474946383961*)   return 0 ;;   # gif87a, gif89a
    1a45dfa3*)                     return 0 ;;   # matroska, webm
    ????????66747970*)             return 0 ;;   # "ftyp" at byte 4: mp4, mov, m4a, heic, avif
    52494646????????57454250*)     return 0 ;;   # riff + webp
    52494646????????57415645*)     return 0 ;;   # riff + wave
    52494646????????41564920*)     return 0 ;;   # riff + avi
    4f67675300*)                   return 0 ;;   # ogg
    664c6143*)                     return 0 ;;   # flac
    494433*|fffb*|fff3*|fff2*)     return 0 ;;   # mp3, tagged or a bare frame header
    3026b275*)                     return 0 ;;   # asf, wmv
    49492a00*|4d4d002a*)           return 0 ;;   # tiff, either byte order
    38425053*)                     return 0 ;;   # psd
    474000*|474011*)               return 0 ;;   # mpeg transport stream, opening on PAT or SDT
    000001ba*|000001b3*)           return 0 ;;   # mpeg program stream, mpeg video
  esac
  is_archive "$1"
}

# Whether those first 16 bytes start an archive. An archive counts as media, but a shipped
# binary or a mirror of a release is one too, so the path that judges a repo by its share of
# media counts only images, video and audio.
is_archive() {
  case "$1" in
    504b0304*)                     return 0 ;;   # zip, and the formats built on it
    1f8b*)                         return 0 ;;   # gzip
    526172211a07*)                 return 0 ;;   # rar
    377abcaf271c*)                 return 0 ;;   # 7z
  esac
  return 1
}

# ---------------------------------------------------------------------------------------- args
# One subcommand, "quarantine", for dealing with repos an earlier run pruned. Everything else
# is a flag on the prune run itself.
CMD=""; QVERB=""; QARGS=()
if [ "${1:-}" = quarantine ]; then
  CMD=quarantine; shift
  QVERB="${1:-}"; [ "$#" = 0 ] || shift
  QARGS=("$@"); set --
fi

# What --help prints. The comment block at the top of this file is the design document, not a
# manual page: it runs to hundreds of lines, so printing it at somebody who asked for help is
# not an answer. The paths and RULES are shown resolved, since the commonest question help is
# asked is "which home is it about to read".
usage() {
  # The path's last segment, done in the shell: --help is answered before the check that names
  # a missing command, so it cannot be the thing that needs one.
  local me=${SELF##*/}
  cat <<HELPTEXT
$me $VERSION
Automatically detect and prune lower-value repos, spam and abuse from a Radicle node's storage.

USAGE
  $me [options]                    plan a prune, and with --apply carry it out
  $me quarantine <verb> [rid...]   deal with what a past run already pruned

  Dry run by default: with no options it prints the plan and changes nothing.

OPTIONS
  --apply          carry out the plan: unseed, block and quarantine every repo in it, and
                   lift the blocks last-run/undo.tsv marks unblock
  --block-peers    act on the parasite-peer rule (G) as well, asking before each peer is blocked
  --yes, -y        answer y to every prompt this run asks, so it needs nobody present
  --force          carry on past the runaway caps, and past the hold on a rule that plans far
                   more repos than usual
  --restart-node   restart the node service afterwards, to flush its inventory
  --version        print the version and exit
  --help, -h       print this and exit

QUARANTINE VERBS
  list             what is held, how long it has been held, and when each entry goes
  restore <rid>... put it back in storage, clear the block, re-seed it, and keep it after
  delete <rid>...  delete it now instead of waiting; --all deletes everything held
  purge            delete everything already past its window
  files <rid>      print its images, video, audio and archives as rows to append to
                   deny-files.tsv

CONFIGURATION
  The thresholds an operator may want to move are environment variables, and there are no
  tuning flags. The README lists them; the comment block at the top of this script says why
  each has the value it has.

  RULES=$RULES
  RAD_HOME=$RAD_HOME
  STORAGE=$STORAGE
  AUDIT_DIR=$AUDIT_DIR
HELPTEXT
}

APPLY=0; FORCE=0; RESTART=0; YES=0; BLOCK_PEERS=0
for a in "$@"; do
  case "$a" in
    --apply)        APPLY=1 ;;
    --yes|-y)       YES=1 ;;
    --force)        FORCE=1 ;;
    --restart-node) RESTART=1 ;;
    # Rule G only ever reports without this. Blocking a peer is a standing judgement
    # about a person that applies to every repo at once, so it takes its own opt-in.
    --block-peers)  BLOCK_PEERS=1 ;;
    --version)      echo "radicle-seed-prune $VERSION"; exit 0 ;;
    --help|-h)      usage; exit 0 ;;
    *) echo "unknown arg: $a (try --help)" >&2; exit 2 ;;
  esac
done

# Answered before the preflight below, the same as the main --help is answered before it: a
# reader asking what the verbs are gets an answer rather than a list of what is not installed.
case "$QVERB" in
  --help|-h) usage; exit 0 ;;
esac

# A per-repo command that fails is ordinary here - a repo can vanish or turn unreadable under
# a live node - so the calls below discard their own errors and carry on. A command that is not
# installed fails in that same shape for every repo at once, and the run then reports storage
# as unreadable when one binary is missing from PATH. Name it here, before a repo is read.
# What the quarantine verbs call, checked whatever the command is. `restore` reaches dirname,
# sync and tail through the keep file it writes. `files` adds what it reads a repo with.
need="basename cut date dirname du grep mkdir mv rm stat sync tail"
# What a scan adds on top. `nproc` is left out of both: its one call has a fallback value.
if [ "$CMD" != quarantine ]; then
  need="$need awk cat cp df find git head jq mktemp od sed sha1sum sort tail touch tr"
  need="$need uniq wc xargs"
fi
if [ "$QVERB" = files ]; then need="$need awk git jq od"; fi
if [ "$CMD" != quarantine ] && rule_on F; then need="$need base64 gzip openssl"; fi
missing=
for c in $need; do
  command -v "$c" >/dev/null 2>&1 || missing="$missing $c"
done
[ -z "$missing" ] || {
  echo "missing required command(s):$missing" >&2
  echo "PATH=$PATH" >&2
  case " $missing " in
    (*" base64 "*|*" gzip "*|*" openssl "*)
      echo "To run without the media rule (F), which needs base64, gzip and openssl," \
           "leave F out of RULES." >&2 ;;
  esac
  exit 1
}
# Rule F counts an issue or patch op only once openssl has checked its signature. An openssl
# that cannot check ed25519 (before 3.0, pkeyutl has no -rawin) would turn every op down and
# leave each repo looking as if it had none, so it is tried first on RFC 8032's second test
# vector: a key, the one-byte message 72, and its signature.
if [ "$CMD" != quarantine ] && rule_on F; then
  vec=$(mktemp -d)
  { unhex 302a300506032b6570032100
    unhex 3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c; } > "$vec/key"
  unhex 72 > "$vec/msg"
  { unhex 92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da
    unhex 085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00; } > "$vec/sig"
  openssl pkeyutl -verify -pubin -keyform DER -inkey "$vec/key" -rawin -in "$vec/msg" \
    -sigfile "$vec/sig" >/dev/null 2>&1 && ed_ok=1 || ed_ok=0
  rm -rf "$vec"
  [ "$ed_ok" = 1 ] || {
    echo "openssl here cannot check ed25519 signatures, which the media rule (F) needs. OpenSSL 3 can." >&2
    echo "To run without the media rule (F), leave F out of RULES." >&2
    exit 1
  }
fi
# rad answers for what this seed holds, who else seeds it, and what is pinned or private. With
# no rad the routing table comes back empty, and the abort that follows names seed counts
# rather than the binary that never ran. `restore` needs it too: it re-seeds what it puts back.
if [ "$CMD" != quarantine ] || [ "$QVERB" = restore ]; then
  command -v "$RAD" >/dev/null 2>&1 \
    || { echo "no rad at '$RAD' (set RAD=/path/to/rad)" >&2; exit 1; }
fi

# `quarantine list|delete|purge` read and write the quarantine alone, and an operator most
# wants to look at what is held when storage is unmounted, so only a run that scans storage is
# gated on it. `restore` needs it, since it moves a repo back in there.
if [ "$CMD" != quarantine ] || [ "$QVERB" = restore ]; then
  [ -d "$STORAGE" ] || { echo "no storage dir at $STORAGE" >&2; exit 1; }
  # Without this, an unreadable storage dir scans zero repos and reports a serene "prune 0
  # repos".
  { [ -r "$STORAGE" ] && [ -x "$STORAGE" ]; } \
    || { echo "cannot read storage dir $STORAGE (wrong user?)" >&2; exit 1; }
fi
# A pruned repo is unseeded and blocked before it leaves storage, so a storage dir or a
# quarantine this run cannot write would leave the whole plan blocked and still in storage.
# Checked before the scan, so that nothing is lifted, purged or logged on the way to a prune
# that cannot work.
if [ "$CMD" != quarantine ] && [ "$APPLY" = 1 ]; then
  [ -w "$STORAGE" ] \
    || { echo "cannot write storage dir $STORAGE (wrong user?)" >&2; exit 1; }
fi
if [ "$CMD" != quarantine ] && [ "$APPLY" = 1 ] && [ "$QUARANTINE" = 1 ]; then
  quar_err=$(mkdir -p "$quar" 2>&1) || true
  { [ -d "$quar" ] && [ -w "$quar" ] && [ -x "$quar" ]; } \
    || { echo "cannot write the quarantine at $quar (wrong user?)" >&2
         [ -z "$quar_err" ] || echo "$quar_err" >&2
         exit 1; }
fi
[ -n "$OUR_NID" ] \
  || echo "# WARN: could not determine our NID; seed counts will include us" >&2

now=$(date +%s)
fresh_cut=$(( now - FRESH_GUARD_DAYS*86400 ))
# The run's name in every file it writes: its audit log, last-run/ and history.log.
run_ts=$(date -u +%FT%TZ)

# --------------------------------------------------------------------- quarantine subcommands
# Dealing with a repo an earlier run pruned is a different job from planning a prune: it needs
# no scan, no plan and no running node, so these verbs do their work here and exit. Every repo
# in the quarantine was unseeded and blocked before it was moved there, so the node holds no
# reference to any of it: deleting the directory by hand costs the ability to restore and
# nothing else.
# Puts lines saying what a file is at the top of a file this tool keeps adding to, for somebody
# who opens the audit directory with no README at hand. A file from a version that wrote none
# gets them too. A file that already opens with "#" is left alone, so a later change of wording
# never stacks a second header on the first. The new copy is written beside the file and moved
# over it in one step, so a disk too full to write it costs the header and never the file.
# Anything but a plain file is left alone: moving a file over a symlink would undo whatever it
# points at, and over FIRST_SEEN=/dev/null, run as root, would replace /dev/null itself.
# Returns non-zero when it could not write, for the caller to say so.
add_header() {  # $1 = file, then one argument per line of the header
  local file=$1 first=""
  shift
  if [ -L "$file" ] || { [ -e "$file" ] && [ ! -f "$file" ]; }; then return 0; fi
  if [ -s "$file" ]; then
    { IFS= read -r first < "$file"; } 2>/dev/null || true
    [[ $first == '#'* ]] && return 0
  fi
  # A leftover $file.new, or a symlink planted there, is removed rather than written through.
  # cp -p starts the copy with the file's owner and mode, so a run as root does not leave a
  # file the seed user's cron can no longer append to. sync flushes the copy before the move,
  # so a crash right after it cannot leave an empty file.
  rm -f -- "$file.new" 2>/dev/null
  if { [ ! -e "$file" ] || cp -p -- "$file" "$file.new" 2>/dev/null; } \
     && { printf '# %s\n' "$@"; [ ! -e "$file" ] || cat "$file"; } > "$file.new" 2>/dev/null \
     && sync -- "$file.new" 2>/dev/null && mv -f "$file.new" "$file" 2>/dev/null; then
    return 0
  fi
  rm -f "$file.new" 2>/dev/null
  return 1
}

# Returns non-zero rather than dying, so an unwritable keep file costs one warning and the
# rest of a "restore a, b, c" still runs.
keep_add() {
  mkdir -p "$(dirname "$KEEP_FILE")" 2>/dev/null || return 1
  # Only a keep file this creates gets the lines saying what it is. One that already exists is
  # the operator's, written by hand or by their config management, and is never rewritten.
  # The lines only explain; the id below is what protects the repo, so it goes in regardless.
  if [ ! -e "$KEEP_FILE" ]; then
    add_header "$KEEP_FILE" \
      "Repos rad prune never prunes, one repo id per line. Edit it by hand at any time." \
      "A did:key: line instead stops the malware rule (H) naming that identity." \
      "rad prune quarantine restore adds each repo it puts back." \
      || echo "# WARN: could not write the header of a new $KEEP_FILE" >&2
  fi
  grep -qxF "$1" "$KEEP_FILE" 2>/dev/null && return 0
  # A last line saved without its newline, as some editors do, would run into the new id.
  if [ -s "$KEEP_FILE" ] && [ -n "$(tail -c1 "$KEEP_FILE")" ]; then
    echo >> "$KEEP_FILE" 2>/dev/null || return 1
  fi
  printf '%s\n' "$1" >> "$KEEP_FILE" 2>/dev/null || return 1
}
# Everything below builds a path from an argument, so a name that is not a repo id never gets
# to name one: "quarantine delete ../.." would otherwise be a working command.
is_rid() { [[ $1 =~ ^z[1-9A-HJ-NP-Za-km-z]+$ ]]; }

# The instant a quarantined repo becomes deletable, compared in seconds: `find -mtime +N` means
# "older than N+1 whole days", so a repo the countdown shows as due would survive the next
# purge by a day.
quar_cut=$(( now - QUARANTINE_DAYS*86400 ))
quar_expired() {                  # prints every quarantined repo past its window
  local d born
  for d in "$quar"/z*; do
    [ -d "$d" ] || continue
    born=$(stat -c %Y "$d" 2>/dev/null) || continue    # it can vanish under a parallel purge
    [ -n "$born" ] || continue
    [ "$born" -le "$quar_cut" ] && printf '%s\n' "$d"
  done
}
# Deletes what is past its window. Called by an --apply run once nothing can stop it any more,
# so a run that stops leaves the quarantine as it found it.
quar_purge_expired() {
  [ "$QUARANTINE" = 1 ] || return 0
  local d purged=0
  while IFS= read -r d; do
    rm -rf -- "$d" && purged=$((purged+1))
  done < <(quar_expired)
  [ "$purged" = 0 ] || echo "# purged $purged repo(s) out of quarantine after" \
                            "${QUARANTINE_DAYS}d; they are gone for good now."
  return 0
}
# The window is ignored outright once free space is at the critical threshold: a recovery copy
# is a luxury a full disk cannot buy. Kept as a function because the two moments that can
# afford to do this sit far apart in the apply path below.
quar_purge_all_if_critical() {
  [ "$QUARANTINE" = 1 ] && [ "$DISK_AWARE" = 1 ] \
    && awk -v a="$disk_avail" -v c="$crit_free" 'BEGIN{exit !(a <= c)}' || return 0
  local d purged=0
  for d in "$quar"/z*; do
    [ -e "$d" ] || continue
    rm -rf -- "$d" && purged=$((purged+1))
  done
  [ "$purged" = 0 ] \
    || echo "# disk is at the critical free-space threshold: emptied the whole quarantine" \
            "($purged)."
  return 0
}

if [ "$CMD" = quarantine ]; then
  case "$QVERB" in
    list)
      found=0
      for d in "$quar"/z*; do
        [ -d "$d" ] || continue
        born=$(stat -c %Y "$d" 2>/dev/null) || continue
        [ -n "$born" ] || continue
        [ "$found" = 0 ] && printf '%-34s %8s %8s %10s\n' RID SIZE 'HELD(d)' 'DELETED IN'
        held=$(( (now - born) / 86400 ))
        # Rounded up, so "1d" means it goes some time today rather than a day from now.
        if [ "$born" -le "$quar_cut" ]; then
          left=due
        else
          left="$(( (born - quar_cut + 86399) / 86400 ))d"
        fi
        printf '%-34s %8s %8s %10s\n' "$(basename "$d")" \
               "$(du -sh "$d" 2>/dev/null | cut -f1)" "$held" "$left"
        found=$((found+1))
      done
      [ "$found" -gt 0 ] || echo "# nothing in quarantine ($quar)"
      ;;
    restore)
      [ "${#QARGS[@]}" -gt 0 ] \
        || { echo "usage: $(basename "$0") quarantine restore <rid>..." >&2; exit 2; }
      for rid in "${QARGS[@]}"; do
        rid=${rid#rad:}
        is_rid "$rid" || { echo "# not a repo id: $rid" >&2; continue; }
        [ -d "$quar/$rid" ] || { echo "# not in quarantine: $rid" >&2; continue; }
        # A repo moved back by hand is still unseeded, still blocked and still condemned, so
        # only the move is skipped. Everything after it is idempotent.
        if [ -e "$STORAGE/$rid" ]; then
          echo "# already back in storage, leaving that copy alone: $rid" >&2
        else
          mv -- "$quar/$rid" "$STORAGE/$rid" \
            || { echo "# restore failed: $rid" >&2; continue; }
        fi
        # The prune blocked the repo before moving it, and a blocked repo neither replicates
        # nor comes back, so putting the directory back is only half the undo. Both commands,
        # in this order: rad seed only ever rewrites an existing policy row's SCOPE, so on a
        # blocked repo it reports success and changes nothing, and the fetch is refused later
        # by the fetch worker. rad unseed deletes the policy row whatever policy it holds, so
        # it drops the block, and it is the same verb the prune itself uses. The narrower
        # rad unblock is missing from older heartwood, and buys nothing here: the rad seed
        # below puts the seeding row back either way.
        "$RAD" unseed "rad:$rid" >/dev/null 2>&1 \
          || echo "#   WARN 'rad unseed rad:$rid' failed; it is still blocked" >&2
        "$RAD" seed "rad:$rid" >/dev/null 2>&1 \
          || echo "#   WARN back on disk but 'rad seed rad:$rid' failed; run it yourself" >&2
        keep_add "$rid" \
          || { echo "#   WARN could not write $KEEP_FILE; the next run may prune $rid" >&2
               continue; }
        echo "# restored $rid; added to $KEEP_FILE so the next run leaves it alone, and so" \
             "the malware rule (H) names none of the identities its document lists as delegates"
      done
      echo "# restart the node to announce them again: sudo systemctl restart $SERVICE"
      ;;
    delete)
      ndel=0
      if [ "${QARGS[0]:-}" = --all ]; then
        for d in "$quar"/z*; do
          [ -e "$d" ] || continue
          rm -rf -- "$d" && ndel=$((ndel+1))
        done
      else
        [ "${#QARGS[@]}" -gt 0 ] \
          || { echo "usage: $(basename "$0") quarantine delete <rid>... | --all" >&2; exit 2; }
        for rid in "${QARGS[@]}"; do
          rid=${rid#rad:}
          is_rid "$rid" || { echo "# not a repo id: $rid" >&2; continue; }
          [ -d "$quar/$rid" ] || { echo "# not in quarantine: $rid" >&2; continue; }
          rm -rf -- "$quar/$rid" && ndel=$((ndel+1))
        done
      fi
      echo "# deleted $ndel repo(s) for good."
      ;;
    purge)
      # The same window a prune run applies, on demand.
      npurge=0
      while IFS= read -r d; do
        rm -rf -- "$d" && npurge=$((npurge+1))
      done < <(quar_expired)
      echo "# purged $npurge repo(s) past the ${QUARANTINE_DAYS}d window."
      ;;
    files)
      # Rows for DENY_FILES: every media file a quarantined repo's delegates put on its
      # branches and tags, history included. These are the files the copy check counts, so a
      # row from here never names a file a stranger pushed. Printed for a person to append.
      [ "${#QARGS[@]}" = 1 ] \
        || { echo "usage: $(basename "$0") quarantine files <rid>" >&2; exit 2; }
      rid=${QARGS[0]#rad:}
      is_rid "$rid" || { echo "# not a repo id: $rid" >&2; exit 2; }
      d="$quar/$rid"
      [ -d "$d" ] || { echo "# not in quarantine: $rid" >&2; exit 1; }
      read_delegates "$d"
      [ -n "$dids" ] || { echo "# cannot read the delegates of $rid" >&2; exit 1; }
      ours=$(GIT_DIR="$d" git for-each-ref --format='%(refname)' | delegate_branches) \
        || { echo "# cannot list the refs of $rid" >&2; exit 1; }
      [ -n "$ours" ] || { echo "# $rid has no branches or tags of its delegates" >&2; exit 1; }
      listing=$(GIT_DIR="$d" git rev-list --objects --stdin --filter=object:type=blob \
                  <<<"$ours" \
                | GIT_DIR="$d" git cat-file \
                    --batch-check='%(objectname) %(objecttype) %(objectsize) %(rest)') \
        || { echo "# cannot read the history of $rid" >&2; exit 1; }
      # Printed only once every file has been read, so a failure appends nothing half-done.
      today=$(date -u +%F); nfiles=0; rows=""
      while read -r oid type size _; do
        [ "$type" = blob ] || continue
        hex=$(od -An -tx1 -N16 -v < <(GIT_DIR="$d" git cat-file blob "$oid" 2>/dev/null))
        hex=${hex//[$' \n']/}
        if [ -z "$hex" ] && [ "$size" != 0 ]; then
          echo "# cannot read file $oid of $rid; no rows printed" >&2
          exit 1
        fi
        if is_media "$hex"; then
          rows+=$(printf '%s\t%s\trad:%s\t%s' "$oid" "$size" "$rid" "$today")$'\n'
          nfiles=$((nfiles + 1))
        fi
      done <<<"$listing"
      printf '%s' "$rows"
      echo "# $nfiles media file(s) on the branches and tags of $rid's delegates, as rows" \
           "to append to $DENY_FILES" >&2
      ;;
    *)
      [ -n "$QVERB" ] && echo "unknown quarantine verb: $QVERB" >&2
      usage >&2
      exit 2 ;;
  esac
  exit 0
fi

# A brake, or the ratio path's floor, that is not a whole number stops the run. Read as a
# number, a typo turns every test against it false, which lets everything through without a
# word, and a leading zero reads as octal. Checked here, after the quarantine verbs, which use
# none of them.
for knob in MAX_PRUNE_COUNT RATCHET_FACTOR RATCHET_RUNS RATCHET_FLOOR MEDIA_RATIO_MIN_BYTES \
            UNDO_MAX_COUNT UNDO_MAX_GB; do
  case "${!knob}" in
    0) ;;
    ''|0*|*[!0-9]*) echo "# $knob must be a whole number, not '${!knob}'." >&2; exit 2 ;;
  esac
done
# A word list rule H cannot match stops the run: an upper-case letter or a hyphen in an entry
# would never match, and an empty entry would match the bare "s" of "it's". Silence there
# reads as "nobody here runs an operation".
for knob in MALWARE_STRONG_WORDS MALWARE_WEAK_WORDS; do
  [[ ${!knob} =~ ^[a-z0-9]+(\|[a-z0-9]+)*$ ]] || {
    echo "# $knob must be lower-case letters and digits, |-separated, not '${!knob}'." >&2
    exit 2
  }
done
# Any other value would switch disk pressure on and the critical purge off.
case $DISK_AWARE in
  0|1) ;;
  *) echo "# DISK_AWARE must be 0 or 1, not '$DISK_AWARE'." >&2; exit 2 ;;
esac
# Anything but 1 would read as off, so a typo meant as "on" would delete with no way back.
case $QUARANTINE in
  0|1) ;;
  *) echo "# QUARANTINE must be 0 or 1, not '$QUARANTINE'." >&2; exit 2 ;;
esac
# Anything but 0 or 1 would read as on, so a typo meant as "off" would lift blocks.
case $UNDO in
  0|1) ;;
  *) echo "# UNDO must be 0 or 1, not '$UNDO'." >&2; exit 2 ;;
esac

# disk pressure p in [0,1] on the storage filesystem
read -r disk_total disk_avail < <(df -Pk "$STORAGE" \
  | awk 'NR==2{printf "%.0f %.0f\n", $2*1024, $4*1024}')
: "${disk_total:=0}"; : "${disk_avail:=0}"
relax_free=$(awk -v t="$disk_total" -v p="$PRESSURE_RELAX_PCT" -v g="$PRESSURE_RELAX_GB" \
  'BEGIN{a=t*p/100;b=g*1e9;print (a>b)?a:b}')
crit_free=$(awk  -v t="$disk_total" -v p="$PRESSURE_CRIT_PCT"  -v g="$PRESSURE_CRIT_GB" \
  'BEGIN{a=t*p/100;b=g*1e9;print (a<b)?a:b}')
# Free-space thresholds set the wrong way round leave no band to interpolate over. The critical
# one still empties the quarantine at or under it, so pressure is full there and none above it.
p=$(awk -v av="$disk_avail" -v r="$relax_free" -v c="$crit_free" -v on="$DISK_AWARE" 'BEGIN{
  if(on=="0"){print 0;exit} if(r<=c){print (av<=c)?1:0;exit}
  x=(r-av)/(r-c); if(x<0)x=0; if(x>1)x=1; printf "%.3f",x }')
if [ "$DISK_AWARE" = 1 ] \
   && awk -v r="$relax_free" -v c="$crit_free" 'BEGIN{exit !(r<=c)}'; then
  awk -v r="$relax_free" -v c="$crit_free" 'BEGIN{printf "# WARN: the relaxed free-space" \
    " threshold (PRESSURE_RELAX_*, %.1f GB free) is not above the critical one (PRESSURE_CRIT_*," \
    " %.1f GB), so pressure is either 0%% or 100%%.\n", r/1e9, c/1e9}' >&2
fi

# interpolate each knob relaxed->aggressive by p
lerp(){ awk -v a="$1" -v b="$2" -v p="$p" 'BEGIN{printf "%d", a+(b-a)*p+0.5}'; }
eff_abs_mb=$(lerp "$ABS_SIZE_FLOOR_MB" "$ABS_SIZE_FLOOR_MB_AGG")
eff_pctl=$(lerp "$REL_PCTL" "$REL_PCTL_AGG")
eff_outlier_days=$(lerp "$OUTLIER_STALE_DAYS" "$OUTLIER_STALE_DAYS_AGG")
eff_junk_days=$(lerp "$JUNK_STALE_DAYS" "$JUNK_STALE_DAYS_AGG")
eff_spam_days=$(lerp "$SPAM_STALE_DAYS" "$SPAM_STALE_DAYS_AGG")
eff_stale_days=$(lerp "$STALE_YEARS_DAYS" "$STALE_YEARS_DAYS_AGG")
eff_seeds=$(lerp "$MIN_OTHER_SEEDS" "$MIN_OTHER_SEEDS_AGG")
[ "$eff_seeds" -lt 1 ] && eff_seeds=1

outlier_cut=$(( now - eff_outlier_days*86400 ))
junk_cut=$(( now - eff_junk_days*86400 ))
spam_cut=$(( now - eff_spam_days*86400 ))
stale_cut=$(( now - eff_stale_days*86400 ))
link_cut=$(( now - LINK_STALE_DAYS*86400 ))
media_cut=$(( now - MEDIA_STALE_DAYS*86400 ))

run_mode=$([ "$APPLY" = 1 ] && echo APPLY || echo DRY-RUN)
echo "# radicle-seed-prune $VERSION  $run_ts   mode=$run_mode"
# Named at the top and not only at the end: the plan, the per-run log and the quarantine are
# all under it, and they are what an operator goes looking for while the run is still going.
echo "# home=$RAD_HOME  audit=$AUDIT_DIR"

# The header is what a reader checks the run against, so every threshold it acted on is printed
# at its effective (post-pressure) value.
free_gb=$(awk  -v a="$disk_avail" 'BEGIN{printf "%.1f",a/1e9}')
free_pct=$(awk -v a="$disk_avail" -v t="$disk_total" 'BEGIN{printf "%.1f",(t>0)?100*a/t:0}')
press_pct=$(awk -v p="$p" 'BEGIN{printf "%.0f",p*100}')
relax_gb=$(awk -v r="$relax_free" 'BEGIN{printf "%.0f",r/1e9}')
crit_gb=$(awk  -v c="$crit_free" 'BEGIN{printf "%.0f",c/1e9}')
echo "# disk: ${free_gb}GB free (${free_pct}%)  pressure=${press_pct}%" \
     "[relax>=${relax_gb}GB crit<=${crit_gb}GB]"

rule_a="A junk(>${eff_junk_days}d, seeds>=${JUNK_MIN_SEEDS}, spare-import>${IMPORT_SPARE_DAYS}d;"
rule_a="$rule_a id-names seeds>=${JUNK_ID_MIN_SEEDS})"
rule_b="B size(>${eff_abs_mb}MB & >=P${eff_pctl}, >${eff_outlier_days}d, seeds>=${eff_seeds})"
rule_c="C stale(>${eff_stale_days}d, seeds>=${eff_seeds})"
rule_d="D spam(batch>=${SPAM_MIN_BATCH} & desc>=${SPAM_DESC_AGREE_PCT}%,"
rule_d="$rule_d >${eff_spam_days}d, seeds>=${SPAM_MIN_SEEDS})"
rule_on A || rule_a="$rule_a [DISABLED: not in RULES]"
rule_on B || rule_b="$rule_b [DISABLED: not in RULES]"
rule_on C || rule_c="$rule_c [DISABLED: not in RULES]"
rule_on D || rule_d="$rule_d [DISABLED: not in RULES]"
echo "# rules: $rule_a  $rule_b  $rule_c  $rule_d"

rule_e="E link-farm(>=${LINK_MIN_SCORE} spam domains, each linked from"
rule_e="$rule_e >=${LINK_MIN_REPOS_PCT}% of repos and from the code of"
rule_e="$rule_e <${LINK_CODE_MAX_PCT}% of them, >${LINK_STALE_DAYS}d,"
rule_e="$rule_e seeds>=${LINK_MIN_SEEDS})"
rule_on E     || rule_e="$rule_e [DISABLED: not in RULES]"
echo "# rule $rule_e"

rule_f="F media-dump(>=$((MEDIA_MIN_BYTES/1024))KB of media and"
rule_f="$rule_f <${MEDIA_TEXT_MAX_BYTES}B of anything else, no source or build file,"
rule_f="$rule_f >${MEDIA_STALE_DAYS}d, seeds>=${MEDIA_MIN_SEEDS})"
rule_f="$rule_f  media-ratio(>=$((MEDIA_RATIO_MIN_BYTES/1024))KB of images+video+audio"
rule_f="$rule_f at the tips, anything else <${MEDIA_RATIO_TEXT_PER_MILLE}/1000 of that,"
rule_f="$rule_f no archive, nothing else at the tips but <=${MEDIA_RATIO_MAX_FILES} README)"
rule_f="$rule_f  media-batch(>=$((MEDIA_MIN_BYTES/1024))KB of media"
rule_f="$rule_f held by >=${MEDIA_MIN_BATCH} repos,"
rule_f="$rule_f <${MEDIA_TEXT_CEIL_BYTES}B of anything else)"
rule_on F      || rule_f="$rule_f [DISABLED: not in RULES]"
echo "# rule $rule_f"
rule_g="G parasite-peer(one file of theirs in >=${PARASITE_MIN_REPOS} repos"
rule_g="$rule_g they are not a delegate of,"
rule_g="$rule_g >=$((PARASITE_MIN_BYTES/1048576))MB media,"
rule_g="$rule_g <${PARASITE_TEXT_MAX_BYTES}B of anything else)"
rule_on G         || rule_g="$rule_g [DISABLED: not in RULES]"
[ "$BLOCK_PEERS" = 1 ] || rule_g="$rule_g [reports only; --block-peers asks per peer]"
echo "# rule $rule_g"
rule_h="H malware-op(>=${MALWARE_MIN_WORDS} malware words, one strong, in the names and"
rule_h="$rule_h descriptions of >=${MALWARE_MIN_REPOS} and >=${MALWARE_MIN_SHARE_PCT}%"
rule_h="$rule_h of the repos an identity signed as a delegate; or one repo with a strong"
rule_h="$rule_h word in its name or description and in a file path or commit subject, first"
rule_h="$rule_h commit <=${MALWARE_ORIGINAL_DAYS}d before its rad init)"
rule_h="$rule_h [reports only]"
rule_on H || rule_h="$rule_h [DISABLED: not in RULES]"
echo "# rule $rule_h"

# ------------------------------------------------------------------------------------ progress
# Each phase that reads every repo hands its workers to xargs and waits, printing nothing until
# it is done. On a seed of this size that is minutes of stillness, which looks the same whether
# the walk is slow or hung, so operators kill runs that were working. The workers already
# append a row per repo they finish, so a ticker counting those rows says how far along the
# phase is without the workers having to report anything.
#
# On a terminal one line is redrawn in place, often enough to look alive and leaving nothing
# behind when the phase ends. Anywhere else (cron, a pipe, a log file) the same reading is
# printed as an ordinary line, sparsely enough to still be worth reading a week later. Both go
# to stderr, where the rest of the running commentary goes, so the plan on stdout stays a
# document.
#
# The count is against the phase's OWN repos, not storage's: a phase the run cache answers most
# of has little left to read, and a bar measured against all 11k would sit near zero and read
# as stuck.

# Redraw interval for a terminal. A plain constant rather than a knob: it is picked to look
# alive to a person watching, and nobody has a wish to state about it.
progress_redraw_secs=1
# The bar drawn on a terminal, at full width. A slice of it as wide as the percentage is drawn
# inside a field of the whole width, so the printf truncates it and pads the rest with spaces.
progress_bar_full='===================='
progress_bar_cells=${#progress_bar_full}
# How many walks this run will do, so a line can say which one is being watched. The two scan
# walks always run; the three content rules run only when RULES holds them.
progress_phases=2
for _r in E F G; do rule_on "$_r" && progress_phases=$((progress_phases + 1)); done
# Rule E walks a second time, over the repos that scored, to see whose links they were. That
# walk is skipped on a run where nothing scored, so this total is the most walks a run can do,
# and the last line of such a run reads one short of it.
if rule_on E && [ "$LINK_DELEGATE_CHECK" = 1 ]; then
  progress_phases=$((progress_phases + 1))
fi
# The prune is a walk too, and the only one that changes anything, so it reports like the scans
# do: silence between the confirmation and the DONE line is indistinguishable from a hang.
# A run that aborts before the prune, or answers "n", reads one phase short.
if [ "$APPLY" = 1 ]; then
  progress_phases=$((progress_phases + 1))
fi

# Seconds as a short duration, so a progress line reads at a glance rather than being counted.
duration() {
  local s=$1
  if [ "$s" -lt 60 ]; then printf '%ds' "$s"
  else                     printf '%dm%02ds' "$((s / 60))" "$((s % 60))"
  fi
}

progress_pid=""
progress_phase=""
progress_total=0
progress_started=0
progress_n=0
progress_files=()
# $1 = what to call the phase, $2 = repos it will read, $3... = the files its workers append a
# row to per finished repo.
progress_start() {
  local phase=$1 total=$2
  shift 2
  progress_phase=$phase; progress_total=$total; progress_started=$SECONDS
  # Kept for progress_stop, which counts the same rows once more to say what the phase read.
  progress_files=("$@")
  progress_n=$((progress_n + 1))
  progress_pid=""
  [ "$PROGRESS_SECS" -gt 0 ] || return 0
  [ "$total" -gt 0 ] || return 0
  local files=("$@") parent=$$ started=$SECONDS n=$progress_n
  local every=$PROGRESS_SECS live=0 cols=80
  if [ -t 2 ]; then
    every=$progress_redraw_secs; live=1
    # Held to the terminal's width, because a line that wraps cannot be redrawn: the carriage
    # return goes to the start of the LAST physical line, leaving the first one on screen.
    cols=$(tput cols 2>/dev/null) || cols=80
    case "$cols" in ''|*[!0-9]*) cols=80 ;; esac
  fi
  (
    # The wait between readings is a child process of this subshell, and it inherits the run's
    # stdout and stderr. Killed only through this trap, because killing the subshell alone
    # leaves it holding those open until it wakes on its own, and anything reading the run's
    # output as a pipe waits for it long after the run itself has ended.
    # ${napper:-} rather than $napper: the signal can arrive before the first wait has one to
    # name, and an unset variable under `set -u` would reach the error trap and print into a
    # run that is merely ending a phase.
    trap 'kill "${napper:-}" 2>/dev/null || true; exit 0' TERM
    local done_n elapsed pct rest line head tail cells napper=""
    while :; do
      sleep "$every" & napper=$!
      wait "$napper" || exit 0
      # The run is gone: killed, or ended by a signal its EXIT trap did not survive. Without
      # this the ticker outlives it and prints into a terminal that has moved on.
      kill -0 "$parent" 2>/dev/null || exit 0
      # cat's own status is dropped rather than tested: a phase whose stream file the shell has
      # not opened yet is the normal state at the first tick, and counting what it did read is
      # the right answer for a progress line either way.
      done_n=$( { cat "${files[@]}" 2>/dev/null || true; } | wc -l )
      # A count over the total would print past 100% and a negative estimate. The workers write
      # one row per repo, so it takes a bug to get here, and a wrong bar is not worth an abort.
      [ "$done_n" -le "$total" ] || done_n=$total
      elapsed=$(( SECONDS - started ))
      pct=$(( done_n * 100 / total ))
      # Nothing has finished yet, so there is no rate to project from: a phase whose first
      # chunk holds a repo with 152k refs waits here a while. Say it is starting rather than
      # project from one repo and print an estimate of hours that halves a second later.
      if [ "$done_n" -gt 0 ]; then
        rest="~$(duration "$(( elapsed * (total - done_n) / done_n ))") left"
      else
        rest="starting"
      fi
      if [ "$live" = 1 ]; then
        # The bar gives up its width before anything else does, so the counts and the estimate
        # still fit an 80-column terminal under the longest phase name. Under 5 cells it says
        # nothing the percentage does not, and is left out.
        head=$(printf '  [%d/%d] %s' "$n" "$progress_phases" "$phase")
        tail=$(printf '%3d%% %d/%d repos %s %s' "$pct" "$done_n" "$total" \
                 "$(duration "$elapsed")" "$rest")
        cells=$(( cols - ${#head} - ${#tail} - 4 ))
        [ "$cells" -le "$progress_bar_cells" ] || cells=$progress_bar_cells
        if [ "$cells" -ge 5 ]; then
          line=$(printf '%s [%-*.*s] %s' "$head" "$cells" "$(( pct * cells / 100 ))" \
                   "$progress_bar_full" "$tail")
        else
          line="$head $tail"
        fi
        printf '\r\033[K%.*s' "$cols" "$line" >&2
      else
        printf '#   [%d/%d] %s: %d of %d repos (%d%%), %s elapsed, %s\n' \
               "$n" "$progress_phases" "$phase" "$done_n" "$total" "$pct" \
               "$(duration "$elapsed")" "$rest" >&2
      fi
    done
  ) &
  progress_pid=$!
}

# Ends the ticker without saying anything. Safe to call when none is running, which is what
# the EXIT trap needs: a run aborting mid-phase must neither leave a ticker printing into a
# terminal whose script has gone, nor claim the phase it died in was finished.
progress_kill() {
  [ -n "$progress_pid" ] || return 0
  kill "$progress_pid" 2>/dev/null || true
  wait "$progress_pid" 2>/dev/null || true
  progress_pid=""
  # Take the redrawn line off the terminal, so what stays on screen is whatever is printed
  # next rather than a bar frozen at the last reading.
  if [ -t 2 ]; then printf '\r\033[K' >&2; fi
}

# A phase that prints while its ticker redraws gets its message written into the middle of the
# bar. Take the bar off first, so the message starts at column 0 and the next redraw follows
# it.
progress_warn() {
  if [ -t 2 ]; then printf '\r\033[K' >&2; fi
  echo "$@" >&2
}

# Ends the phase progress_start opened, and says what it cost. That is the one number an
# operator tuning JOBS or RULES wants, and on a terminal it is the only trace the redrawn line
# leaves behind.
progress_stop() {
  progress_kill
  local read_n cost
  if [ "$PROGRESS_SECS" -gt 0 ] && [ "$progress_total" -gt 0 ]; then
    cost=$(duration $(( SECONDS - progress_started )))
    # Counted from the rows the workers appended, not the repos the phase set out to read: a
    # phase whose workers all died still reaches its end, and its own total then reads as a
    # walk that worked. -1 when the phase named no file, which keeps the plain line below,
    # because a bare `cat` would read stdin and hang.
    read_n=-1
    if [ "${#progress_files[@]}" -gt 0 ]; then
      read_n=$( { cat "${progress_files[@]}" 2>/dev/null || true; } | wc -l )
    fi
    if [ "$read_n" -ge 0 ] && [ "$read_n" -lt "$progress_total" ]; then
      echo "# $progress_phase: $read_n of $progress_total repos in $cost" >&2
    else
      echo "# $progress_phase: $progress_total repos in $cost" >&2
    fi
  fi
  progress_phase=""; progress_total=0; progress_files=()
}

tmp=$(mktemp -d)
on_exit() {
  progress_kill
  rm -rf "$tmp"
}
trap on_exit EXIT

# ------------------------------------------------------------------------------ exclusion sets
jq -r '.web.pinned.repositories[]?' "$CONFIG" 2>/dev/null \
  | sed 's/^rad://' | sort -u > "$tmp/pinned" || true
# `rad ls` gives up on the whole listing over a single storage entry, such as a directory whose
# name is not a repo id. The activity scan finds own and private repos on disk as well, but a
# storage the node itself cannot list is not one to prune by guesswork, so a failure stops the
# run further down, once the run knows its mode.
ls_failed=""
"$RAD" ls --all --private > "$tmp/ls-private" 2> "$tmp/ls-err" \
  || ls_failed="$RAD ls --all --private"
[ -n "$ls_failed" ] || "$RAD" ls > "$tmp/ls-own" 2> "$tmp/ls-err" || ls_failed="$RAD ls"
grep -oE 'rad:z[1-9A-HJ-NP-Za-km-z]+' "$tmp/ls-private" \
  | sed 's/^rad://' | sort -u > "$tmp/private" || true
grep -oE 'rad:z[1-9A-HJ-NP-Za-km-z]+' "$tmp/ls-own" 2>/dev/null \
  | sed 's/^rad://' | sort -u > "$tmp/own" || true
# The keep list is the operator's own verdict on a repo, so it is read the same way as a pin:
# comments and blank lines out, ids in. Both spellings are taken, because every other id this
# tool prints carries the rad: prefix and this is the one list a person writes by hand. A
# byte-order mark goes too: a file saved by a Windows editor would otherwise lose its first id.
# An identity is 48 characters and a repo id under 40, as in the deny list below.
sed $'1s/^\xef\xbb\xbf//; s/#.*//; s/rad://' "$KEEP_FILE" 2>/dev/null \
  | grep -oE '^\s*z[1-9A-HJ-NP-Za-km-z]+' \
  | tr -d ' \t' | awk 'length($0) < 40' | sort -u > "$tmp/kept" || true
# An identity in the keep list is a person clearing it of rule H; its repos are not kept.
sed $'1s/^\xef\xbb\xbf//; s/#.*//; s/did:key://' "$KEEP_FILE" 2>/dev/null \
  | grep -oE '^\s*z[1-9A-HJ-NP-Za-km-z]{40,}' \
  | tr -d ' \t' | sort -u > "$tmp/kept-nids" || true
cat "$tmp/pinned" "$tmp/private" "$tmp/own" "$tmp/kept" 2>/dev/null | sort -u > "$tmp/excluded"
# The deny list, split into repo ids and identities. An identity is 48 characters and a repo id
# under 40, which is what tells the two apart once their prefixes are dropped. A line that is
# neither is said out loud: it is a verdict somebody wrote down that would otherwise do nothing.
: > "$tmp/deny-rids"; : > "$tmp/deny-nids"
deny_unreadable=0
if { [ -e "$DENY_FILE" ] || [ -L "$DENY_FILE" ]; } \
   && { [ ! -f "$DENY_FILE" ] || [ ! -r "$DENY_FILE" ]; }; then
  deny_unreadable=1
  echo "# WARN: cannot read $DENY_FILE; nothing on it is pruned or blocked this run, and no" \
       "block is lifted, since the list may name a repo whose block must stay." >&2
elif [ -e "$DENY_FILE" ]; then
  # `|| [ -n "$line" ]` reads a last line that has no newline, and the carriage return and
  # byte-order mark go so a file saved by a Windows editor reads the same as any other.
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}; line=${line#$'\xef\xbb\xbf'}
    read -ra toks <<<"${line%%#*}"
    for tok in "${toks[@]}"; do
      id=${tok#rad:}; id=${id#did:key:}
      # This node's own identity is dropped here, so neither its block nor its repos depend on
      # `rad ls` having listed them as our own. %q because the list may come from somebody
      # else, and a token is echoed to a terminal.
      if   [ "$id" = "$OUR_NID" ]; then
        echo "# WARN: $DENY_FILE lists this node's own identity; ignored." >&2
      elif [[ $id =~ ^z[1-9A-HJ-NP-Za-km-z]{40,}$ ]]; then printf '%s\n' "$id" >> "$tmp/deny-nids"
      elif [[ $id =~ ^z[1-9A-HJ-NP-Za-km-z]+$ ]];     then printf '%s\n' "$id" >> "$tmp/deny-rids"
      else printf '# WARN: %s: %q is neither a repo id nor an identity; ignored.\n' \
             "$DENY_FILE" "$tok" >&2
      fi
    done
  done < "$DENY_FILE"
fi
sort -u -o "$tmp/deny-rids" "$tmp/deny-rids"; sort -u -o "$tmp/deny-nids" "$tmp/deny-nids"
# Said every run, so a cron log shows the list was read at all.
[ ! -e "$DENY_FILE" ] \
  || echo "# deny list: $(wc -l < "$tmp/deny-rids") repo(s), $(wc -l < "$tmp/deny-nids")" \
          "identit(ies) in $DENY_FILE"
# The files denied repos carried, as "oid \t source" in $tmp/deny-oids and the ids alone in
# $tmp/deny-oid-list. A row naming a repo that was restored is dropped here, while the file
# keeps it as a record. A malformed row is named, as a bad deny.txt line is.
: > "$tmp/deny-oids"; ndenyrestored=0; ndenybad=0
if [ -e "$DENY_FILES" ] && { [ ! -f "$DENY_FILES" ] || [ ! -r "$DENY_FILES" ]; }; then
  echo "# WARN: cannot read $DENY_FILES; no repo is pruned as a copy of what it lists." >&2
elif [ -e "$DENY_FILES" ]; then
  declare -A RESTORED=()
  while IFS= read -r r; do RESTORED[$r]=1; done < "$tmp/kept"
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}; line=${line#$'\xef\xbb\xbf'}
    read -r oid bytes src _ <<<"${line%%#*}"
    [ -n "$oid" ] || continue
    oid=${oid,,}; srcid=${src#rad:}
    # A row missing its size column would read its source as the size, and slip past the
    # restore check below. The source is printed to a terminal and may be somebody else's.
    if [[ ! $oid =~ ^[0-9a-f]{40}$ ]] || [[ ! $bytes =~ ^([0-9]+|-)$ ]] \
       || [[ ! $src =~ ^[[:graph:]]+$ ]]; then
      ndenybad=$((ndenybad + 1))
      [ "$ndenybad" -gt "$top_evidence" ] \
        || printf '# WARN: %s: %q is not "%s"; ignored.\n' "$DENY_FILES" "${line%%#*}" \
                  "<object id> <bytes or -> <source> [date]" >&2
    # An empty key is an error to an associative array, and "rad:" alone would be one.
    elif [ -n "$srcid" ] && [ -n "${RESTORED[$srcid]:-}" ]; then
      ndenyrestored=$((ndenyrestored + 1))
    else
      printf '%s\t%s\n' "$oid" "$src" >> "$tmp/deny-oids"
    fi
  done < "$DENY_FILES"
  [ "$ndenybad" -le "$top_evidence" ] \
    || echo "# WARN: ...and $((ndenybad - top_evidence)) more malformed row(s)" \
            "in $DENY_FILES" >&2
fi
sort -u -o "$tmp/deny-oids" "$tmp/deny-oids"
cut -f1 "$tmp/deny-oids" | sort -u > "$tmp/deny-oid-list"
# Said every run, so a cron log shows the file was read, and what a copy has to hold.
if [ -f "$DENY_FILES" ] && [ -r "$DENY_FILES" ]; then
  copy_min_said=$(awk -v b="$COPY_MIN_BYTES" 'BEGIN {
    if (b >= 1048576) printf "%.1fMiB", b / 1048576; else printf "%.0fKiB", b / 1024 }')
  restored_note=""
  [ "$ndenyrestored" = 0 ] \
    || restored_note=", $ndenyrestored row(s) ignored as their source is in $KEEP_FILE"
  echo "# deny files: $(wc -l < "$tmp/deny-oid-list") file id(s) in" \
       "$DENY_FILES$restored_note." \
       "A repo whose delegates' branches and tags hold >=$copy_min_said of them," \
       ">=${COPY_MIN_PCT}% of all their bytes, is pruned as denied-copy."
fi
# The check below is one more walk over storage, and only runs when there is something to find.
if [ -s "$tmp/deny-oid-list" ]; then progress_phases=$((progress_phases + 1)); fi
echo "# excluded: $(wc -l < "$tmp/pinned") pinned," \
     "$(wc -l < "$tmp/private") private, $(wc -l < "$tmp/own") own," \
     "$(wc -l < "$tmp/kept") kept; $(wc -l < "$tmp/kept-nids") identity(s) cleared of the malware rule (H)"

# fail-safe: with no reachable node the exclusion sets and seed counts all come back empty.
# Under --apply that risks deleting our own/pinned repos; in dry-run it forces a plan of zero
# repos, which reads as "nothing to prune" when it means "saw nothing at all". Bail out in BOTH
# modes, up front.
mode=${run_mode,,}
"$RAD" node status >/dev/null 2>&1 \
  || { echo "# ABORT($mode): node unreachable via '$RAD' (home=$RAD_HOME)." >&2; exit 5; }
[ -n "$OUR_NID" ] \
  || { echo "# ABORT($mode): no NID from '$RAD' (home=$RAD_HOME)." >&2; exit 5; }
# A malformed NID matches none of this node's signed refs, so its own repos could be planned.
[[ $OUR_NID =~ ^z6Mk[1-9A-HJ-NP-Za-km-z]{44}$ ]] \
  || { printf '# ABORT(%s): our node id is malformed: %q\n' "$mode" "$OUR_NID" >&2; exit 5; }
[ -z "$ls_failed" ] \
  || { echo "# ABORT($mode): '$ls_failed' failed (home=$RAD_HOME):" \
            "$(head -c 300 "$tmp/ls-err" | LC_ALL=C tr -c '[:print:]' ' ')" >&2
         echo "# A directory in storage whose name is not a repo id is enough to cause it." \
              "Move any such directory out of storage." >&2
         exit 5; }

if [ "$APPLY" = 1 ]; then
  npin_cfg=$(jq -r '.web.pinned.repositories[]?' "$CONFIG" 2>/dev/null | wc -l)
  [ "$npin_cfg" -gt 0 ] && [ "$(wc -l < "$tmp/pinned")" = 0 ] \
    && { echo "# ABORT(apply): pinned in config but none parsed." >&2; exit 5; }
fi

# The audit log for this run, created by whichever act writes to it first. Lifting a block,
# pruning repos and blocking peers are separate decisions that can each happen without the
# others, so none of them owns the file.
audit=""
open_audit() {
  [ -z "$audit" ] || return 0
  mkdir -p "$AUDIT_DIR"
  audit="$AUDIT_DIR/prune-$(date -u +%Y%m%dT%H%M%SZ).log"
  { printf '# %s\n' \
      "What one rad prune run removed from storage or blocked, one repo per row, and the" \
      "blocks it lifted, on # unblocked: lines." \
      "A repo in the quarantine can be put back: rad prune quarantine restore <rid>"
    printf '# %s  version=%s  pressure=%s%%  rules=%s\n' \
           "$run_ts" "$VERSION" "$press_pct" "$RULES"; } > "$audit"
  echo "# audit log: $audit"
}

# ------------------------------------------------------------- undo: this tool's own blocks
# A block this tool made rests on a verdict, and the verdict can turn out wrong after the repo
# is gone. Here such a block is lifted, at most once per repo, so the repo comes back and the
# current rules judge it. Only a block an audit log explains is lifted: a block made by hand is
# no log's, and a deny-list block is a person's verdict. This section only plans the lifts;
# undo_apply makes them once the run goes ahead, past the prompt and the runaway caps.

# True when version $1 is older than version $2. A log from before 0.8.0 names no version, "-",
# which is older than every version.
version_older() {
  [ "$1" = "-" ] && return 0
  [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n1)" = "$1" ]
}
# "32M" as bytes. K, M and G are powers of 1024, and a bare number is bytes already.
size_bytes() {
  case $1 in
    *K) echo $(( ${1%K} * 1024 )) ;;
    *M) echo $(( ${1%M} * 1048576 )) ;;
    *G) echo $(( ${1%G} * 1073741824 )) ;;
    *)  echo "$1" ;;
  esac
}

# Every audit log, oldest first, as one row per repo this tool ever pruned: rid, reason, size,
# when and by which version of the newest prune, the delegates line written beside it ("-" when
# there is none), and 1 when this tool must leave its block alone: lifted once already, or
# blocked before rad-prune pruned it ("# was-blocked:"), which makes the block somebody else's.
undo_fold() {
  local f logs=()
  for f in "$AUDIT_DIR"/prune-*.log; do [ -r "$f" ] && logs+=("$f"); done
  [ ${#logs[@]} -gt 0 ] || return 0
  awk -F'\t' '
    FNR == 1 { when = "-"; by = "-" }
    # The run stamp, "# <when>  version=<v>  ...", the first dated line of each log.
    /^# [0-9][0-9][0-9][0-9]-/ && when == "-" {
      n = split($0, w, " "); when = w[2]
      for (i = 3; i <= n; i++) if (w[i] ~ /^version=/) by = substr(w[i], 9)
      next
    }
    /^# delegates: rad:z/ { split($0, w, " "); dl[substr(w[3], 5)] = w[4]; next }
    /^# (unblocked|was-blocked): rad:z/ {
      split($0, w, " "); nolift[substr(w[3], 5)] = 1; next
    }
    /^#/ { next }
    $1 ~ /^z[1-9A-HJ-NP-Za-km-z]+$/ && $5 != "" {
      reason[$1] = $5; size[$1] = $2 + 0; at[$1] = when; ver[$1] = by; dl[$1] = "-"
    }
    END { for (r in reason)
            printf "%s\t%s\t%.0f\t%s\t%s\t%s\t%d\n",
                   r, reason[r], size[r], at[r], ver[r], dl[r], nolift[r] + 0 }' "${logs[@]}"
}
undo_fold | sort > "$tmp/undo-fold"
cut -f1 "$tmp/undo-fold" > "$tmp/undo-pruned-before"

# Repos known to be wrongly pruned are kept from every rule while their entry stands, whether
# or not this node ever pruned them. deny.txt still prunes them: it is this operator's verdict.
# An entry past its release is said out loud, since it then keeps nothing.
: > "$tmp/undo-pardoned"
for entry in $UNDO_PARDON; do
  prid=${entry%%:*}; until=${entry#*:}
  if version_older "$VERSION" "$until"; then
    printf '%s\n' "$prid" >> "$tmp/undo-pardoned"
  else
    echo "# WARN: the built-in pardon for rad:$prid ended at version $until; it keeps nothing" \
         "now. Drop it from UNDO_PARDON, or fix the rule that still flags the repo." >&2
  fi
done
npardon_here=0
while IFS= read -r prid; do
  [ -d "$STORAGE/$prid" ] && npardon_here=$((npardon_here + 1))
done < "$tmp/undo-pardoned"
# Said on a dry run only: once a pardoned repo is back, a cron run would repeat it weekly.
[ "$npardon_here" = 0 ] || [ "$APPLY" = 1 ] \
  || echo "# pardoned: $npardon_here repo(s) in storage that rad-prune is known to have pruned by" \
          "mistake are spared by every rule, unless deny.txt names them."

# Which repos this node blocks right now, from `rad seed`: a row whose policy is "block". rc.12
# prints the scope after the policy, so the policy is the column before last; heartwood master
# leaves the scope off a blocked row, so the policy is the last column. Fails when `rad seed`
# fails, with its error in $tmp/seed-err.
blocked_now() {
  "$RAD" seed > "$tmp/seed-list" 2> "$tmp/seed-err" || return 1
  awk '/rad:z/ {
         gsub(/│/, " "); n = split($0, f, " "); rid = ""
         for (i = 1; i <= n; i++)
           if (f[i] ~ /^rad:z[1-9A-HJ-NP-Za-km-z]+$/) { rid = substr(f[i], 5); break }
         if (rid != "" && (f[n] == "block" || f[n - 1] == "block")) print rid }' \
    "$tmp/seed-list" | sort -u
}
# A listing that fails, or comes back empty while the logs name blocks, lifts nothing: a lift
# is only ever of a block seen standing.
: > "$tmp/undo-blocked"
if [ "$UNDO" = 1 ] && [ "$deny_unreadable" = 0 ] && [ -s "$tmp/undo-fold" ]; then
  if blocked_now > "$tmp/undo-blocked"; then
    # Once every block the logs name is lifted or somebody else's, no listed block is expected.
    nliftable=$(awk -F'\t' '$7 == 0' "$tmp/undo-fold" | wc -l)
    [ -s "$tmp/undo-blocked" ] || [ "$nliftable" = 0 ] \
      || echo "# WARN: '$RAD seed' listed no blocked repo, while the audit logs name" \
              "$nliftable repo(s) rad-prune pruned and blocked. No block is lifted this run." >&2
  else
    echo "# WARN: '$RAD seed' failed, so no block is lifted this run:" \
         "$(head -c 200 "$tmp/seed-err" | LC_ALL=C tr -c '[:print:]' ' ')" >&2
  fi
fi

# Repos whose delegates pushed since the prune, for the verdicts a push answers. node.db keeps
# the latest refs announcement each node made for each repo, a blocked repo's included, for
# two weeks by default (gossip_max_age), and the node checks each one's signature before
# storing it, so the node column is who announced it.
# Only a node announcing its own signed refs counts: a node may claim anything about anyone
# else's. With the delegates recorded at the prune, the announced refs must differ from what
# that delegate had then, because a node also re-announces what it already had. Without them,
# from a version that did not record them, any node announcing its own refs after the prune
# counts, once. A repo comes back for a fork that way too, and is pruned again if still junk.
: > "$tmp/undo-revived"
undo_revival() {
  local nodedb="$RAD_HOME/node/node.db" nid key
  awk -F'\t' -v reasons=" $UNDO_REVIVE_REASONS " '
      FILENAME == ARGV[1] { blocked[$1] = 1; next }
      ($1 in blocked) && $7 == 0 && index(reasons, " " $2 " ") { print $1 "\t" $4 "\t" $6 }' \
    "$tmp/undo-blocked" "$tmp/undo-fold" > "$tmp/undo-revive-cand"
  [ -s "$tmp/undo-revive-cand" ] || return 0
  # Said on a dry run only: without sqlite3 it holds on every run, and a weekly cron log would
  # repeat it forever.
  if ! command -v sqlite3 >/dev/null 2>&1; then
    [ "$APPLY" = 1 ] \
      || echo "# undo: sqlite3 is not installed, so a repo pruned for inactivity stays blocked" \
              "when someone pushes to it again." >&2
    return 0
  fi
  if [ ! -r "$nodedb" ]; then
    echo "# WARN: cannot read $nodedb; a repo pruned for inactivity stays blocked when" \
         "someone pushes to it again." >&2
    return 0
  fi
  # The rows are joined on the spelling rad uses today, rad:z... and z6Mk...; another spelling
  # would match nothing and look like nobody ever pushed.
  if ! sqlite3 -readonly -separator $'\t' "file:$nodedb?mode=ro" \
         "select count(*), coalesce(sum(repo like 'rad:z%' and node like 'z6Mk%'), 0)
          from announcements where type = 'refs';" \
         > "$tmp/undo-spelling" 2> "$tmp/undo-sql-err"; then
    echo "# WARN: could not read $nodedb, so this run unblocks no repo for a push:" \
         "$(head -c 200 "$tmp/undo-sql-err" | LC_ALL=C tr -c '[:print:]' ' ')" >&2
    return 0
  fi
  local nall nspelled
  IFS=$'\t' read -r nall nspelled < "$tmp/undo-spelling"
  if [ "${nall:-0}" -gt 0 ] && [ "${nspelled:-0}" = 0 ]; then
    echo "# WARN: $nodedb spells repos and nodes in a way this version does not read, so" \
         "this run unblocks no repo for a push." >&2
    return 0
  fi
  sqlite3 -readonly -separator $'\t' "file:$nodedb?mode=ro" \
    "create temp table cand(rid text, at text, dl text);" \
    ".mode tabs" ".import $tmp/undo-revive-cand cand" \
    "select c.rid, a.node, strftime('%s', c.at), a.timestamp, hex(a.message)
     from cand c join announcements a on a.repo = 'rad:' || c.rid and a.type = 'refs';" \
    > "$tmp/undo-ann" 2> "$tmp/undo-sql-err" \
    || { echo "# WARN: could not read $nodedb, so this run unblocks no repo for a push:" \
              "$(head -c 200 "$tmp/undo-sql-err" | LC_ALL=C tr -c '[:print:]' ' ')" >&2
         return 0; }
  [ -s "$tmp/undo-ann" ] || return 0
  # Rows too short for the remotes they declare mean the message layout moved, and every repo
  # would then look like nobody pushed to it.
  if ! awk -F'\t' '{ n = 0; hexd = "0123456789ABCDEF"
                     for (i = 45; i < 49; i++) n = n * 16 + index(hexd, substr($5, i, 1)) - 1
                     if (length($5) >= 48 + n * 108) ok = 1 }
                   END { exit !ok }' "$tmp/undo-ann"; then
    echo "# WARN: none of the refs announcements in $nodedb read as this version expects, so" \
         "this run unblocks no repo for a push." >&2
    return 0
  fi
  # The key each announcing node signs with, as the 64 hex digits a refs announcement names
  # remotes by.
  cut -f2 "$tmp/undo-ann" | sort -u | while IFS= read -r nid; do
    key=$(did_key_hex "$nid")
    if [ ${#key} = 64 ]; then printf '%s\t%s\n' "$nid" "${key^^}"; fi
  done > "$tmp/undo-keys"
  # Each announcement made after a known prune time, one row per remote it names: rid, the
  # announcing node, the remote's key and the signed refs it announced. A refs announcement is
  # 2 bytes of length and the 20-byte repo id, a 2-byte count, then per remote its 32-byte key,
  # 2 bytes of length and its 20-byte signed refs id. As hex, a remote is 108 digits from the
  # 49th on, its key the first 64 and its signed refs id the last 40.
  awk -F'\t' '
      {
        rid = $1; nid = $2; pruned = $3 + 0; ts = int($4 / 1000); msg = $5
        if (pruned == 0 || ts <= pruned) next
        n = 0; hexd = "0123456789ABCDEF"
        for (i = 45; i < 49; i++) n = n * 16 + index(hexd, substr(msg, i, 1)) - 1
        if (length(msg) < 48 + n * 108) next
        for (e = 0; e < n; e++) {
          ent = substr(msg, 49 + e * 108, 108)
          print rid "\t" nid "\t" substr(ent, 1, 64) "\t" tolower(substr(ent, 69, 40))
        }
      }' "$tmp/undo-ann" > "$tmp/undo-remotes"
  # The repos a remote revives: one from a node not on the deny list, naming the node's own key,
  # with signed refs that differ from those the audit log recorded for that node as a delegate.
  # A log that recorded no delegates ("-") takes any such remote.
  awk -F'\t' '
      FILENAME == ARGV[1] { denied[$1] = 1; next }
      FILENAME == ARGV[2] { key[$1] = $2; next }
      FILENAME == ARGV[3] { dl[$1] = $3; next }
      {
        rid = $1; nid = $2; remote = $3; announced = $4
        if (!(nid in key) || (nid in denied) || remote != key[nid]) next
        if (dl[rid] == "-") { print rid; next }
        m = split(dl[rid], pairs, ",")
        for (j = 1; j <= m; j++) {
          split(pairs[j], kv, ":")
          if (kv[1] == nid && kv[2] != announced) { print rid; next }
        }
      }' "$tmp/deny-nids" "$tmp/undo-keys" "$tmp/undo-revive-cand" "$tmp/undo-remotes" \
    | sort -u
}
if [ "$UNDO" = 1 ] && [ -s "$tmp/undo-blocked" ]; then
  undo_revival > "$tmp/undo-revived"
fi

# Every block that has a reason to be lifted, as rid, why, reason, size, when, version, and
# where the repo's copy is: still in the quarantine, or deleted. Pardoned and quarantined repos
# cost no fetch and come first; the rest come smallest first, since every wrong verdict found
# so far was a small repo, and a repo bigger than its entry allows stays blocked.
: > "$tmp/undo-cand"
if [ "$UNDO" = 1 ] && [ -s "$tmp/undo-blocked" ]; then
  declare -A UNDO_BLOCKED=() UNDO_SKIP=() UNDO_DENYNID=() UNDO_REVIVED=() UNDO_PARDONED=()
  while IFS= read -r r; do UNDO_BLOCKED[$r]=1; done < "$tmp/undo-blocked"
  while IFS= read -r r; do [ -n "$r" ] && UNDO_SKIP[$r]=1; done \
    < <(cat "$tmp/excluded" "$tmp/deny-rids")
  while IFS= read -r r; do [ -n "$r" ] && UNDO_DENYNID[$r]=1; done < "$tmp/deny-nids"
  while IFS= read -r r; do UNDO_REVIVED[$r]=1; done < "$tmp/undo-revived"
  while IFS= read -r r; do UNDO_PARDONED[$r]=1; done < "$tmp/undo-pardoned"
  while IFS=$'\t' read -r rid reason size at ver dl nolift; do
    [ -n "${UNDO_BLOCKED[$rid]:-}" ] || continue    # lifted already, or the block never held
    [ "$nolift" = 0 ] || continue                   # lifted once, or not this tool's block
    [ ! -e "$STORAGE/$rid" ] || continue            # never left storage, so never pruned
    [ -z "${UNDO_SKIP[$rid]:-}" ] || continue       # pinned, private, own, kept or denied
    case $reason in denied|denied-copy) continue ;; esac
    # A delegate added to the deny list since the prune makes the repo a person's verdict too.
    denied_delegate=0
    for pair in ${dl//,/ }; do
      did=${pair%%:*}
      [ -n "$did" ] && [ -n "${UNDO_DENYNID[$did]:-}" ] && denied_delegate=1
    done
    # A log that recorded no delegates leaves the quarantined copy to name them.
    if [ "$dl" = "-" ] && [ -d "$quar/$rid" ]; then
      read_delegates "$quar/$rid"
      for did in $dids; do
        [ -n "${UNDO_DENYNID[$did]:-}" ] && denied_delegate=1
      done
    fi
    [ "$denied_delegate" = 0 ] || continue
    copy=deleted
    [ "$QUARANTINE" = 1 ] && [ -d "$quar/$rid" ] && copy=quarantined
    why=""
    if [ -n "${UNDO_PARDONED[$rid]:-}" ]; then
      why=known-mistake
    fi
    if [ -z "$why" ]; then
      for entry in $UNDO_CHANGED; do
        IFS=: read -r cver creason cmax <<<"$entry"
        [ "$creason" = "$reason" ] && version_older "$ver" "$cver" || continue
        if [ "$copy" = deleted ] && [ "$size" -gt "$(size_bytes "$cmax")" ]; then
          why=too-big-to-fetch
        else
          why=verdict-withdrawn
        fi
        break
      done
    fi
    if [ -z "$why" ] && [ -n "${UNDO_REVIVED[$rid]:-}" ]; then
      why=active-since-prune
    fi
    [ -n "$why" ] || continue
    order=2
    [ "$copy" = quarantined ] && order=1
    [ "$why" = known-mistake ] && order=0
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
           "$order" "$rid" "$why" "$reason" "$size" "$at" "$ver" "$copy" >> "$tmp/undo-cand"
  done < "$tmp/undo-fold"
fi

# What each one gets: "unblock", "unblock-later" (over this run's count or GiB, or the disk is
# at the critical free-space threshold), or "stays-blocked" (too big to fetch again). Pardoned
# and quarantined repos cost no fetch, so the budget is spent on the deleted ones alone.
: > "$tmp/undo-states"
undo_crit=0
[ "$DISK_AWARE" = 1 ] && awk -v a="$disk_avail" -v c="$crit_free" 'BEGIN{exit !(a <= c)}' \
  && undo_crit=1
undo_n=0; undo_bytes=0; undo_max_bytes=$(( UNDO_MAX_GB * 1073741824 ))
while IFS=$'\t' read -r order rid why reason size at ver copy; do
  state=unblock
  if [ "$why" = too-big-to-fetch ]; then
    state=stays-blocked
  elif [ "$undo_crit" = 1 ]; then
    state=unblock-later
  elif [ "$order" = 2 ]; then
    if [ "$undo_n" -ge "$UNDO_MAX_COUNT" ] \
       || [ $(( undo_bytes + size )) -gt "$undo_max_bytes" ]; then
      state=unblock-later
    else
      undo_n=$((undo_n + 1)); undo_bytes=$((undo_bytes + size))
    fi
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
         "$rid" "$state" "$why" "$reason" "$size" "$at" "$ver" "$copy" >> "$tmp/undo-states"
done < <(sort -t$'\t' -k1,1n -k5,5n "$tmp/undo-cand")

undo_default=$(jq -r '.node.seedingPolicy.default // "block"' "$CONFIG" 2>/dev/null) \
  || undo_default=block
nunblock=$(awk -F'\t' '$2 == "unblock"' "$tmp/undo-states" | wc -l)
nlater=$(awk -F'\t' '$2 == "unblock-later"' "$tmp/undo-states" | wc -l)
nstays=$(awk -F'\t' '$2 == "stays-blocked"' "$tmp/undo-states" | wc -l)

# The lifts this run plans, said only when one is due or waits: a repo too big to fetch again
# stays blocked on every run, and a weekly line about it would be noise.
if [ "$nunblock" -gt 0 ] || [ "$nlater" -gt 0 ]; then
  count_why() { awk -F'\t' -v w="$1" '$2 == "unblock" && $3 == w' "$tmp/undo-states" | wc -l; }
  if [ "$undo_crit" = 1 ]; then
    later_why="free space is at or under the critical threshold."
  else
    later_why="over UNDO_MAX_COUNT ($UNDO_MAX_COUNT) or UNDO_MAX_GB ($UNDO_MAX_GB GiB)."
  fi
  if [ "$nunblock" -gt 0 ]; then
    echo "# undo: unblock $nunblock repo(s) pruned by an earlier run"
    n=$(count_why verdict-withdrawn)
    [ "$n" = 0 ] || echo "#   $n pruned under a verdict a later rad-prune release no longer trusts"
    n=$(count_why active-since-prune)
    [ "$n" = 0 ] || echo "#   $n pruned for inactivity, and announced by a node since"
    n=$(count_why known-mistake)
    [ "$n" = 0 ] || echo "#   $n known mistake(s) this rad-prune release lists"
    [ "$nlater" = 0 ] || echo "#   $nlater more held for a later run: $later_why"
  else
    echo "# undo: $nlater block(s) held for a later run: $later_why"
  fi
  if [ "$undo_crit" = 1 ]; then
    n=$(awk -F'\t' '$2 == "unblock-later" && $8 == "quarantined"' "$tmp/undo-states" | wc -l)
    [ "$n" = 0 ] || echo "#   $n of those are in the quarantine, which --apply empties at this" \
                         "free space."
  fi
  [ "$nstays" = 0 ] || echo "#   $nstays more stay blocked: too big to fetch again"
fi

# Lifts the blocks planned above. Called only once the run goes ahead, past the prompt and the
# runaway caps, so a run somebody turns down or the caps stop lifts nothing. A quarantined repo
# goes back into storage, and a later run judges it. A deleted one has its block dropped, so
# the node fetches it again when a peer next offers it. Neither is re-seeded: under a default
# policy other than "allow" that is the operator's call. Each lift is a "# unblocked:" line in
# the audit log, which is also what stops a second lift of the same repo on a later run.
undo_apply() {
  local rid state why reason size at ver copy lifted=0 failed=0
  [ "$nunblock" -gt 0 ] || return 0
  open_audit
  while IFS=$'\t' read -r rid state why reason size at ver copy; do
    [ "$state" = unblock ] || continue
    if [ "$copy" = quarantined ] \
       && { [ -e "$STORAGE/$rid" ] || ! mv -- "$quar/$rid" "$STORAGE/$rid" 2>/dev/null; }; then
      echo "# WARN: could not move rad:$rid back from the quarantine; it stays blocked." >&2
      failed=$((failed + 1)); continue
    fi
    # `rad unseed` drops whatever policy the repo has, here the block just listed. `rad
    # unblock` would write the policy database behind the running node's back.
    if ! "$RAD" unseed "rad:$rid" >/dev/null 2>&1; then
      echo "# WARN: could not lift the block on rad:$rid ('$RAD unseed' failed); it stays" \
           "blocked." >&2
      if [ "$copy" = quarantined ] && ! mv -- "$STORAGE/$rid" "$quar/$rid" 2>/dev/null; then
        echo "# WARN: could not move rad:$rid back into the quarantine; it stays blocked in" \
             "$STORAGE/$rid until $RAD unseed rad:$rid is run by hand." >&2
      fi
      failed=$((failed + 1)); continue
    fi
    [ "$ver" = "-" ] && ver=0.7.0-or-older
    printf '# unblocked: rad:%s why=%s reason=%s pruned_at=%s pruned_by=%s copy=%s\n' \
           "$rid" "$why" "$reason" "$at" "$ver" "$copy" 2>/dev/null >> "$audit" \
      || echo "# WARN: lifted the block on rad:$rid but could not record it in $audit, so a" \
              "block put back on it later could be lifted again." >&2
    lifted=$((lifted + 1))
  done < "$tmp/undo-states"
  if [ "$failed" = 0 ]; then
    echo "# undo: unblocked $lifted repo(s)."
  else
    echo "# undo: unblocked $lifted repo(s); $failed failed, see the warnings above."
  fi
  if [ "$undo_default" != allow ] && [ "$lifted" -gt 0 ]; then
    echo "#   This node's default seeding policy is '$undo_default', so it seeds none of them" \
         "by itself. To seed one, run rad seed with an id from the '# unblocked:' lines of" \
         "$audit"
  fi
}

# ------------------------------------------------------------------- rid -> name + description
# One `rad ls --all` feeds both the plan's NAME column and rule D's batch statistics, so parse
# the whole row: "| <name> rad:<rid> <visibility> <head> <description...> |". Take the FIRST
# rad: token, never the last - a description may itself quote an rid (they do: "...used for X
# in rad:z3U9...") and matching the last one files the row under a repo that isn't this one.
# Walk the trailing columns rather than counting fields, because visibility, head and
# description are each independently missing on some rows. A name and a description are
# whatever a repo's delegates wrote, and both reach the terminal, so control characters go
# first, in their UTF-8 spelling (C1) too: an escape sequence there could rewrite what the
# operator reads. Taking one C1 pair out of a run like \xc2\xc2\x9b\x9b would join the bytes
# around it into another, so the whole run goes at once.
"$RAD" ls --all 2>/dev/null | LC_ALL=C tr -d '\000-\010\013-\037\177' \
  | LC_ALL=C sed $'s/\xc2\xc2*[\x80-\x9f][\x80-\x9f]*//g' | awk '
  /rad:z[1-9A-HJ-NP-Za-km-z]+/ {
    ridi=0; for (i=1;i<=NF;i++) if ($i ~ /^rad:z[1-9A-HJ-NP-Za-km-z]+$/) { ridi=i; break }
    if (ridi<2) next
    rid=$ridi; sub(/^rad:/,"",rid)
    name=""; for (i=2;i<ridi;i++) name=name (name==""?"":" ") $i   # names with spaces survive
    d=ridi+1
    if ($d=="public" || $d=="private" || $d=="local") d++
    if (d<NF && length($d)>=7 && $d ~ /^[0-9a-f]+$/) d++   # the head oid, when the row has one
    desc=""; for (i=d;i<NF;i++) desc=desc (desc==""?"":" ") $i     # NF is the closing box char
    print rid"\t"name"\t"desc
  }' > "$tmp/meta" || true
# A description holding a line break ends its row early, and the rest reads as a row of its
# own, under any repo id its author typed. A real row names a repo in storage, so a row for any
# other id goes. A repo listed twice keeps both rows for rule D, which counts them as members
# that agree with nothing, and gets no name, since nothing says which of its rows is forged.
find "$STORAGE" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' > "$tmp/stored" 2>/dev/null \
  || true
awk -F'\t' 'FILENAME == ARGV[1] { stored[$1] = 1; next } !($1 in stored) { print $1 }' \
  "$tmp/stored" "$tmp/meta" | sort -u > "$tmp/meta-foreign"
awk -F'\t' 'FILENAME == ARGV[1] { stored[$1] = 1; next } ($1 in stored)' \
  "$tmp/stored" "$tmp/meta" > "$tmp/meta-stored"
mv "$tmp/meta-stored" "$tmp/meta"
cut -f1 "$tmp/meta" | sort | uniq -d > "$tmp/meta-twice"
awk -F'\t' 'FILENAME == ARGV[1] { twice[$1] = 1; next } !($1 in twice)' \
  "$tmp/meta-twice" "$tmp/meta" > "$tmp/meta-named"
if [ -s "$tmp/meta-twice" ]; then
  echo "# WARN: '$RAD ls --all' listed $(wc -l < "$tmp/meta-twice") repo(s) twice, such as" \
       "$(head -3 "$tmp/meta-twice" | sed 's/^/rad:/' | xargs). A description with a line" \
       "break in it forges rows, and the repo that wrote them usually sits just above them in" \
       "'$RAD ls --all'. These repos go unnamed this run, so the junk-name (A)," \
       "spam-batch (D) and malware (H) rules pass over them." >&2
fi
if [ -s "$tmp/meta-foreign" ]; then
  echo "# WARN: '$RAD ls --all' listed $(wc -l < "$tmp/meta-foreign") repo(s) that are not in" \
       "storage, such as $(head -3 "$tmp/meta-foreign" | sed 's/^/rad:/' | xargs). These are" \
       "rows forged by a line break in a description, or repos removed while '$RAD ls' ran." \
       "They are ignored." >&2
fi
# Losing this is not fatal but it is not nothing either: the plan's NAME column goes blank and
# rule D has no corpus to reason about, which would look exactly like "no spam here". Say so.
[ -s "$tmp/meta" ] \
  || echo "# WARN: '$RAD ls --all' returned no repos; the spam-batch (D) and malware (H) rules cannot run." >&2

# -------------------------------------------------------------- rule D: generated-bulk batches
# Skeletonise every name and description in storage - digit runs become #, random-id tokens
# become % - then group repos by name skeleton and keep only the groups whose members also
# agree on one description. Two independent signals; see rule D at the top of this file for why
# each is needed.
awk -F'\t' -v K="$SPAM_MIN_BATCH" -v D="$SPAM_DESC_AGREE_PCT" -v REQID="$SPAM_REQUIRE_ID" \
           -v BATCHES="$tmp/spambatch" '
  FILENAME == ARGV[1] { twice[$1] = 1; next }
  # A token is a random id if it is 6+ hex characters with both a letter and a digit. Demanding
  # a letter is what keeps a date or sequence suffix (release-202401) an enumeration rather
  # than an id.
  function cls(t) {
    if (length(t)>=6 && t ~ /^[0-9a-f]+$/ && t ~ /[a-f]/ && t ~ /[0-9]/) return "%"
    if (t ~ /^[0-9]+$/) return "#"
    gsub(/[0-9]+/,"#",t); return t     # ordinary word: only its digits vary (widget2000)
  }
  function skel(s,   i,c,out,tok,n) {
    s=tolower(s); out=""; tok=""; n=length(s)
    for (i=1;i<=n+1;i++) {
      c=(i<=n)?substr(s,i,1):""
      if (c ~ /^[0-9a-z]$/) { tok=tok c; continue }
      if (tok!="") { out=out cls(tok); tok="" }
      out=out c
    }
    gsub(/[[:space:]]+/," ",out); gsub(/^ | $/,"",out); return out
  }
  # Group on the skeleton with # and % collapsed together, because a random hex token comes out
  # all-digits about 2% of the time ("chunk-1-96180521") and that would otherwise split a batch
  # and leave those siblings behind. Whether the batch has a real id slot is then tracked per
  # batch.
  function loose(x) { gsub(/[#%]/,"*",x); return x }
  {
    N++; rid[N]=$1
    sn=skel($2); nl[N]=loose(sn); dl[N]=loose(skel($3))
    cnt[nl[N]]++
    # Either row of a repo listed twice may be forged, so it is a member that agrees with no
    # description, is never one of the batch, and does not count towards its size: it can only
    # lower the agreement.
    if ($1 in twice) { forged[N]=1; next }
    real[nl[N]]++
    if (index(sn,"%")) hasid[nl[N]]=1
    pair[nl[N] SUBSEP dl[N]]++
  }
  END {
    # awk leaves `for (k in ...)` order unspecified, so ties break on the description text
    # itself: without that, two equally common descriptions would pick a winner at random and
    # one seed could produce two different plans.
    for (k in pair) {
      split(k,q,SUBSEP)
      if (pair[k]>best[q[1]] || (pair[k]==best[q[1]] && q[2]<bestd[q[1]]))
        { best[q[1]]=pair[k]; bestd[q[1]]=q[2] }
    }
    for (n in cnt) {
      if (real[n] < K)                       continue   # too few to be a template
      if (REQID+0==1 && !(n in hasid))       continue   # no machine-generated id in it
      if (index(n,"*")==0)                   continue   # nothing varies: not a template at all
      if (bestd[n]=="")                      continue   # no description: only ONE signal
      if (best[n]*100 < D*cnt[n])            continue   # members disagree on the description
      good[n]=1
    }
    # Only the members carrying the description the batch agreed on, so a genuine outlier that
    # happens to share the name shape is left alone.
    for (i=1;i<=N;i++)
      if (!(i in forged) && nl[i] in good && dl[i]==bestd[nl[i]])
        { print rid[i]; batchsize[nl[i]]++ }
    for (n in batchsize) printf "%d\t%s\n", batchsize[n], n > BATCHES
  }' "$tmp/meta-twice" "$tmp/meta" > "$tmp/spam" || true
: >> "$tmp/spambatch"                          # awk only creates it when it finds something
nspam=$(wc -l < "$tmp/spam"); nspambatch=$(wc -l < "$tmp/spambatch")
if [ "$nspam" -gt 0 ]; then
  echo "# spam batches: $nspambatch template(s) matching $nspam repos," \
       "before the age and seed checks:"
  sort -k1,1nr "$tmp/spambatch" \
    | awk -F'\t' -v n="$top_evidence" 'NR<=n {printf "#   %5d  %s\n", $1, $2}'
  [ "$nspambatch" -gt "$top_evidence" ] \
    && echo "#   ...and $((nspambatch - top_evidence)) more (PLAN_FULL=1 lists them)"
fi

# --------------------------------------------------------------------- rid -> other-seed count
"$RAD" node routing --json 2>/dev/null \
  | jq -r --arg us "$OUR_NID" 'select(.nid != $us) | (.rid|sub("^rad:";""))' \
  | sort | uniq -c | awk '{print $2"\t"$1}' > "$tmp/seeds" || true
# Every rule requires a minimum other-seed count, so an empty routing table can only ever
# produce an empty plan. Say so, instead of scanning the whole seed to report a misleading
# "prune 0 repos".
[ -s "$tmp/seeds" ] || {
  echo "# ABORT($mode): routing table empty via '$RAD' (home=$RAD_HOME)." >&2
  echo "# Every rule requires a minimum other-seed count, so no repo could qualify." >&2
  exit 5
}

# ----------------------------------------------------------------- scan: size, mtime, activity
# Batch the cheap per-repo work into one process each (size via a single du, mtime via a single
# find), and fan the one unavoidable per-repo call - `git for-each-ref` for last activity -
# across $JOBS workers. Everything then goes into bash maps so the classify loop spawns nothing
# per repo. The scan races a live node: a repo dir can vanish or turn unreadable mid-walk, and
# find/du then exit non-zero. Collect those errors instead of discarding them, and never let
# one abort the run. The counting walk below races the same way.
scanerr="$tmp/scan-errors"; : > "$scanerr"; : > "$tmp/hosts-fail"
nrepos=$(find "$STORAGE" -mindepth 1 -maxdepth 1 -type d 2>>"$scanerr" | wc -l) || true
echo "# scanning $nrepos repos (size + activity), $JOBS parallel workers..." >&2

progress_start "sizes" "$nrepos" "$tmp/du"
find "$STORAGE" -mindepth 1 -maxdepth 1 -type d -print0 2>>"$scanerr" \
  | xargs -0r -P "$JOBS" -n 64 du -sb --apparent-size 2>>"$scanerr" > "$tmp/du" || true
progress_stop
find "$STORAGE" -mindepth 1 -maxdepth 1 -type d -printf '%f\t%T@\n' 2>>"$scanerr" \
  > "$tmp/mtimes" || true

# Every per-repo worker after the scan is fed through this. Repos the cache already answers
# for are dropped here rather than inside each worker, so what a rule reads and what it reuses
# stay visible in one place. An empty list leaves the walk exactly as it was.
#
# Feeding the workers biggest-repo-first in smaller chunks was tried and reverted: on the real
# seed it cost 56s of a 538s run, since the giants then contend for IO all at once and the
# smaller chunks buy more process spawns than they save in tail latency.
repos_to_read() {                 # $1 = file listing rids the cache already answers for
  # The storage prefix is glued on by a shell loop rather than a sed expression, because
  # $STORAGE is an operator-supplied path: a '#' in it would end sed's own delimiter and a '&'
  # would expand to the match, and either one yields a list that excludes nothing, so every
  # repo is walked again AND its cached rows are appended beside the fresh ones.
  local rid
  while IFS= read -r rid; do printf '%s/%s\n' "$STORAGE" "$rid"; done \
    < "$1" > "$tmp/cached-paths"
  find "$STORAGE" -mindepth 1 -maxdepth 1 -type d -print0 2>>"$scanerr" \
    | grep -zvxFf "$tmp/cached-paths"
}
{ printf '#!/usr/bin/env bash\n'; declare -f read_delegates
  printf 'our_nid=%q\n' "$OUR_NID"; cat <<'LIFE'
# The ref listing is written to a file rather than a shell variable because one repo on a real
# seed has 152k refs. It is read once for the dates and the signed refs, and once for the
# fingerprint the run cache keys on.
t=$(mktemp) || exit 1
trap 'rm -f "$t"' EXIT
re_private='"visibility":\{("allow":\[[^]]*\],)?"type":"private"\}\}$'
for d; do
  GIT_DIR="$d" git for-each-ref --sort=creatordate \
    --format='%(creatordate:unix) %(objectname) %(refname)' 2>/dev/null > "$t" || true
  # Only a numeric creatordate counts. refs/rad/sigrefs points at a blob, which has no
  # creatordate at all, so its line starts with the separator and awk reads the OBJECT ID as
  # field 1. Left unfiltered that 40-hex string becomes the repo's birth date and reaches an
  # arithmetic comparison, which errors and leaves every age rule unable to judge the repo.
  # A ref without a date carries no age information, so skipping it loses nothing. --sort
  # keeps what is left in date order, so the first is still the oldest and the last the newest.
  # The length bound is what makes the digit test enough: an all-decimal object id would pass
  # /^[0-9]+$/ and become a date 30 digits long. Eleven digits reach the year 5138.
  #
  # The same pass lists every node that signed refs of its own here, which only that node
  # can do. The ref name is the last field and holds no space, whatever the date field holds.
  # One awk for both, because this walk reads every repo on every run, warm cache or not, and
  # each process per repo costs about a millisecond of CPU.
  read -r birth last signed < <(awk '
      $1 ~ /^[0-9]+$/ && length($1) <= 11 { if (b == "") b = $1; l = $1 }
      $NF ~ /^refs\/namespaces\/[^\/]+\/refs\/rad\/sigrefs$/ {
        split($NF, p, "/"); signed = signed " " p[3] }
      END { if (b == "") printf "0 0%s\n", signed; else printf "%s %s%s\n", b, l, signed }' \
    "$t")
  refhash=$(sha1sum < "$t"); refhash=${refhash%% *}
  # The repo's delegates, comma-separated, for the deny list.
  read_delegates "$d"
  # The delegates who signed refs of their own here, for rule H. An identity document can name
  # anybody as a delegate, but only that delegate can sign refs under their own namespace.
  signers=""
  for nid in $signed; do
    case " $dids " in (*" $nid "*) signers="$signers${signers:+,}$nid" ;; esac
  done
  # Whether the repo is ours or private, read from the repo itself, so that a `rad ls` this
  # run misreads is not the only thing keeping it from the rules. Ours when this node has
  # signed refs in it, which nobody else can sign. A delegate list naming us is not enough,
  # since anybody can publish one.
  # Private when the document ends on a private visibility, written the way rad writes it.
  # Only the top-level object's last member can end right before the document's final "}",
  # because a JSON string cannot hold an unescaped quote, so a payload cannot say it instead.
  # A document written some other way is asked of jq, when it can say private at all: it has
  # to spell the word, or escape it.
  vis=-
  if [[ " $signed " == *" $our_nid "* ]]; then vis=ours
  elif [[ $iddoc =~ $re_private ]]; then vis=private
  elif [[ $iddoc == *private* || $iddoc == *\\* ]] \
       && jq -e '.visibility.type == "private"' <<<"$iddoc" >/dev/null 2>&1; then vis=private
  fi
  # The delegates go last: they may be empty, and `read` with a tab IFS folds an empty field
  # into the next one.
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "${d##*/}" "${birth:-0}" "${last:-0}" "$refhash" \
         "$vis" "${signers:--}" "${dids// /,}"
done
LIFE
} > "$tmp/life.sh"
progress_start "activity" "$nrepos" "$tmp/lives"
find "$STORAGE" -mindepth 1 -maxdepth 1 -type d -print0 2>>"$scanerr" \
  | xargs -0r -P "$JOBS" -n 64 "$BASH_BIN" "$tmp/life.sh" > "$tmp/lives" || true
progress_stop

# ------------------------------------------------------------------------------- the run cache
# Rules E and F walk the contents of every repo, which is most of a run. On a seed that has
# caught up almost nothing changes from one week to the next, so their per-repo output is kept
# and reused for any repo whose refs and size are both untouched since the run that wrote it.
# A repo whose key differs is walked again, so a rule never judges a repo on stale evidence.
#
# The key is the ref listing's hash plus the repo's size on disk. Refs alone would miss objects
# that arrive without one (rule E reads unreachable objects too); size alone would miss a
# branch deleted or force-pushed onto objects already there. Anything that moves either one
# recomputes, which is the direction that costs time rather than correctness.
# FILENAME rather than the usual NR == FNR: when the first file is empty that test is true
# for the second file's first line too, and it would eat a repo.
awk -F'\t' -v du="$tmp/du" \
    'FILENAME == du { n = split($2, a, "/"); size[a[n]] = $1; next }
     { print $1 "\t" $4 "-" (size[$1] + 0) }' "$tmp/du" "$tmp/lives" \
  | sort > "$tmp/keys"

# The whole cache is dropped when the script or the settings it reads change, rather than
# folding that into every key: a threshold the operator tuned must not leave last week's
# verdicts standing, and one comparison is easier to be sure of than 11,000.
#
# The settings are the knobs this script itself reads, found by grepping the file for the
# environment variables it takes a default for, so a knob added later is covered without
# anyone remembering to list it here. Hashing the whole environment instead was tried and went
# cold on any variable the CALLER happened to differ on: systemd stamps a fresh INVOCATION_ID
# on every start, so a hand run and a cron run invalidated each other's cache in both
# directions, which on an 11k-repo seed is a full uncached run every time. The names below are
# left out because none of them can change a verdict: they say how the work is done, how it is
# printed, which service gets restarted, and which bash runs the workers (a hand run and cron
# may resolve different paths to the same shell).
skip='JOBS|CACHE|PLAN_FULL|PLAN_COLLAPSE_ROWS|SERVICE|PROGRESS_SECS|BASH'
knobs=$(grep -oE '\$\{[A-Z_][A-Z0-9_]*[:-]' "$SELF" 2>/dev/null \
        | tr -d '${:-' | grep -vxE "$skip" | sort -u)
fingerprint=$( { sha1sum < "$SELF"
                 for k in $knobs; do printf '%s=%s\n' "$k" "${!k-}"; done; } \
               | sha1sum | cut -c1-40 )

cache_ok=0
if [ "$CACHE" = 1 ]; then
  [ "$(cat "$CACHE_DIR/fingerprint" 2>/dev/null)" = "$fingerprint" ] && cache_ok=1
  # An unreadable script leaves the fingerprint resting on the knob values alone, which would
  # let an edited script reuse the verdicts it was edited to change.
  [ -r "$SELF" ] || { cache_ok=0; echo "# cache: cannot read $SELF; not reusing" >&2; }
  [ "$cache_ok" = 1 ] \
    || echo "# cache: cold (the script or its settings changed); reading every repo" >&2
fi

# The stamp goes down HERE, before any rule runs, and the stale key files go with it, so a rule
# that never finishes is left with no key file and its repos are read again next run. Stamped
# per rule instead, a run that dies between two rules would leave a cache that reads as warm
# while the unfinished rules still carry keys measured under the previous settings.
if [ "$CACHE" = 1 ] && [ "$cache_ok" = 0 ] && mkdir -p "$CACHE_DIR" 2>/dev/null; then
  rm -f "$CACHE_DIR"/keys-* 2>/dev/null || true
  printf '%s\n' "$fingerprint" > "$CACHE_DIR/fingerprint" 2>/dev/null \
    || echo "# WARN: could not write $CACHE_DIR/fingerprint; the cache stays cold" >&2
fi

# Each rule keeps its own key file, listing the repos IT answered for. A worker that died
# part-way through a chunk therefore leaves its repos without a key, so the next run reads
# them again instead of treating silence as a verdict.
cache_hits() {                      # $1 = rule's cache name; writes the rids it can reuse
  : > "$tmp/cached-$1"
  [ "$cache_ok" = 1 ] || return 0
  awk -F'\t' -v old="$CACHE_DIR/keys-$1" \
      'FILENAME == old { k[$1] = $2; next } ($1 in k) && k[$1] == $2 { print $1 }' \
      "$CACHE_DIR/keys-$1" "$tmp/keys" > "$tmp/cached-$1" 2>/dev/null || : > "$tmp/cached-$1"
  echo "# cache: $1 reuses $(wc -l < "$tmp/cached-$1") of $(wc -l < "$tmp/keys") repos" >&2
}
# What is left for the rule to read, which is what its progress line counts against.
repos_left() {                      # $1 = rule's cache name, after cache_hits has run for it
  echo $(( $(wc -l < "$tmp/keys") - $(wc -l < "$tmp/cached-$1") ))
}
cache_reuse() {   # $1 = stream name, $2 = field holding the rid, $3 = rule whose hits to use
  [ "$cache_ok" = 1 ] && [ -s "$CACHE_DIR/$1" ] || return 0
  awk -F'\t' -v f="$2" -v hits="$tmp/cached-$3" \
      'FILENAME == hits { c[$0] = 1; next } ($f in c)' \
      "$tmp/cached-$3" "$CACHE_DIR/$1" 2>/dev/null || true
}
# A failed data write is recorded here so the key write below can refuse. Without that the key
# file certifies rows the data file never received, and the next run skips the repo and reuses
# a measurement that has stopped being true. The trigger is ordinary: AUDIT_DIR defaults to
# the same filesystem as storage, and this tool runs when that filesystem is filling, so the
# big data write hits ENOSPC while the small key write still fits.
cache_failed=""
cache_save() {                      # $1 = stream name, $2 = file holding this run's version
  [ "$CACHE" = 1 ] || return 0
  mkdir -p "$CACHE_DIR" 2>/dev/null || { cache_failed="$cache_failed $1"; return 0; }
  cat "$2" > "$CACHE_DIR/$1.new" 2>/dev/null && mv "$CACHE_DIR/$1.new" "$CACHE_DIR/$1" \
    || { cache_failed="$cache_failed $1"
         rm -f "$CACHE_DIR/$1.new" 2>/dev/null      # the trigger for this is a filling disk
         echo "# WARN: could not write the run cache at $CACHE_DIR" >&2; }
}
cache_save_keys() {                 # $1 = rule's cache name, $2 = rids it answered for
  [ "$CACHE" = 1 ] || return 0
  # Any stream failing drops this rule's keys entirely, so the next run reads those repos
  # again. Losing a cache costs one slow run; keeping a key that outlives its data can prune
  # a repo on evidence two runs old.
  if [ -n "$cache_failed" ]; then
    rm -f "$CACHE_DIR/keys-$1" 2>/dev/null || true
    echo "# WARN: cache write failed ($cache_failed); next run re-reads every repo" >&2
    return 0
  fi
  mkdir -p "$CACHE_DIR" 2>/dev/null || return 0
  awk -F'\t' -v ans="$2" 'FILENAME == ans { a[$0] = 1; next } ($1 in a)' \
      "$2" "$tmp/keys" \
    > "$CACHE_DIR/keys-$1.new" 2>/dev/null \
    && mv "$CACHE_DIR/keys-$1.new" "$CACHE_DIR/keys-$1" \
    || { rm -f "$CACHE_DIR/keys-$1.new" 2>/dev/null
         echo "# WARN: could not write the run cache at $CACHE_DIR" >&2; return 0; }
}

# ----------------------------------------------------------------------- rule F: measure trees
# Adds up, per repo, how many bytes of media it carries and how many bytes of everything else.
# Extensions are only a fast path: what a file IS decides, read from its first bytes, so
# renaming a video to .dat does not hide it. Reading is bounded hard: a file is looked at only
# while the repo could still be a dump, and only its first 16 bytes. A repo we could not read
# is reported on fd 4 and dropped, never judged on a partial listing.
: > "$tmp/media"; : > "$tmp/media-fail"
mkdir -p "$tmp/blobs"
if rule_on F; then
  echo "# measuring repo trees for the media rule (F) ($JOBS workers)..." >&2
  cat > "$tmp/media.sh" <<MEDIA
#!/usr/bin/env bash
$(declare -f read_delegates is_media is_archive unhex did_key_hex delegate_ops)
media_exts='$MEDIA_EXTS'
text_exts='$MEDIA_TEXT_EXTS'
text_names='$MEDIA_TEXT_NAMES'
# The wider of the two budgets: text over it means neither verdict can fire.
text_ceil=$(( MEDIA_TEXT_MAX_BYTES > MEDIA_TEXT_CEIL_BYTES ? MEDIA_TEXT_MAX_BYTES \
                                                           : MEDIA_TEXT_CEIL_BYTES ))
sniff_big=$MEDIA_SNIFF_TEXT_BYTES
sniff_max=$MEDIA_SNIFF_MAX_FILES
text_max=$MEDIA_TEXT_MAX_BYTES
max_refs=$MEDIA_MAX_REFS
tip_bytes=$MEDIA_TIP_BYTES
archive_exts='$MEDIA_ARCHIVE_EXTS'
source_exts='$MEDIA_SOURCE_EXTS'
build_names='$MEDIA_BUILD_NAMES'
media_min=$MEDIA_MIN_BYTES
# One file per worker, so parallel writers appending blob ids cannot interleave a line.
blobs=$tmp/blobs/\$\$
# Where delegate_ops writes the keys and signatures it hands to openssl.
work=$tmp/ops.\$\$
mkdir -p "\$work"
MEDIA
  cat >> "$tmp/media.sh" <<'MEDIA'
# The files the given trees hold, as "<oid> <size> <path>". A branch or tag comes in as
# "<ref>^{tree}", which lists what it holds now and nothing before it. An issue or patch comes
# in as the trees of its ops: a COB gains one commit per op and each commit's tree holds only
# that op's own files, so its tip alone shows the newest comment's attachment and nothing
# earlier. A tree that is missing fails the walk, and the repo goes unjudged: skipping it would
# read as a repo holding less. %(rest) hands each object's path from rev-list straight through
# cat-file, which knows the sizes.
files_in() {
  local d=$1; shift
  [ $# -gt 0 ] || return 0
  # The refs go in on stdin, not as arguments: a COB-heavy repo has thousands, and argv has a
  # size limit a ref list can reach. The filter keeps trees and commits out of the reader,
  # which is two thirds of what walking a COB emits and none of what we want.
  printf '%s\n' "$@" \
    | GIT_DIR="$d" git rev-list --objects --stdin --filter=object:type=blob 2>/dev/null \
    | GIT_DIR="$d" git cat-file \
        --batch-check='%(objectname) %(objecttype) %(objectsize) %(rest)' 2>/dev/null \
    | awk '$2 == "blob" { path = $0; sub(/^[^ ]+ [^ ]+ [^ ]+ /, "", path)
                          printf "%s %.0f %s\n", $1, $3, path }'
  # A lister that dies part-way through a repo emits a SHORT list rather than an error, and a
  # short list reads as a repo holding less: less text, which is the direction that condemns.
  # Say so on the stream instead, and the classifier below drops the repo. 141 is SIGPIPE: the
  # classifier stops reading once the repo has more text than any verdict allows, and that
  # short circuit is not a tear.
  local lister=${PIPESTATUS[1]} reader=${PIPESTATUS[2]}
  case $lister in 0|141) ;; *) echo torn; return ;; esac
  case $reader in 0|141) ;; *) echo torn ;; esac
}
# The totals for the given trees of repo $d, as "= <media> <text> <unknown> <av>" on the last
# line, after a line per file still to be looked at ("? <oid> <size>", or "z" for compressed
# data) and per media file ("m <oid> <size>"). av is the media that is not an archive.
# Sorts files into three: known media, known text, and everything else, which gets looked at.
# A recognised text file bigger than sniff_big is looked at too, or naming a video README.md
# would both hide it and blow the text budget that spares the repo.
measure() {
  files_in "$d" "$@" \
    | awk -v m="$media_exts" -v t="$text_exts" -v tn="$text_names" -v big="$sniff_big" \
          -v ceil="$text_ceil" -v arc="$archive_exts" '
        # index, not a regex: a file literally called "[" would not compile as one.
        function known(list, key) { return index("|" list "|", "|" key "|") > 0 }
        $1 == "torn" { torn = 1; next }
        {
          oid = $1; size = $2 + 0
          if (oid in seen) next
          seen[oid] = 1
          # A path may hold spaces, so take everything past the first two fields rather
          # than the last one: a file called "clip.mp4 0" must not read as the digit name
          # that a COB op payload carries.
          base = $0; sub(/^[^ ]+ [^ ]+ /, "", base)
          sub(/^.*\//, "", base); base = tolower(base)
          ext = ""; if (match(base, /\.[a-z0-9]+$/)) ext = substr(base, RSTART + 1)
          # Data shipped compressed, a .csv.gz or a .json.gz, is read before it is judged: by
          # its .gz alone a gzipped CSV would count as media, and by the name inside it a
          # gzipped video called clip.csv.gz would pass as text.
          if (ext == "gz" && match(base, /\.[a-z0-9]+\.gz$/) &&
              known(t, substr(base, RSTART + 1, RLENGTH - 4)))
            { printf "z %s %.0f\n", oid, size; unk += size; next }
          if (ext != "" && known(m, ext) && size > 0) {
            media += size; if (!known(arc, ext)) av += size
            printf "m %s %.0f\n", oid, size; next
          }
          # A COB op names its payload 0, 1, 2 and so on; those are JSON, there are millions
          # of them on a seed, and reading each one is most of what this rule costs. Anything
          # over sniff_big is still read, whatever it is called.
          if (size < big && (base ~ /^[0-9]+$/ || known(tn, base) ||
                             (ext != "" && known(t, ext)))) {
            text += size
            # Past the widest budget any verdict allows, nothing still unread can change the
            # answer, so stop the walk here. On a mirror of a real project that is the first
            # few files out of a million. exit runs END, which prints the totals as usual.
            if (text >= ceil) exit 0
            next
          }
          printf "? %s %.0f\n", oid, size; unk += size
        }
        END { if (torn) exit 1
              printf "= %.0f %.0f %.0f %.0f\n", media, text, unk, av }'
}
for d; do
  rid=${d##*/}
  # --count stops the read one ref past the cap, which is both how we notice we hit it and
  # what keeps a 152k-ref repo from being read into a variable at all. First, so a repo over
  # the cap costs this one call and nothing else.
  allrefs=$(GIT_DIR="$d" git for-each-ref --count=$(( max_refs + 1 )) \
              --format='%(refname)' 2>/dev/null) || { echo "$rid" >&4; continue; }
  mapfile -t refs <<<"$allrefs"
  [ "${#refs[@]}" -le "$max_refs" ] || { echo "$rid" >&4; continue; }
  # A dump hides as well in an issue attachment as in a commit, so the repo's OWN COBs count
  # too. "Own" is decided by refs/rad/id, the identity document, which the local node writes
  # only after verifying its signatures; a stranger's push can never move it.
  read_delegates "$d"
  # Collect the refs this repo's own delegates control, and only those. That is the canonical
  # branches and tags, which only a delegate can move, plus the delegates' own namespaces and
  # COBs. Any other peer's namespace is left out of the walk entirely: what a stranger pushed
  # is not evidence about this repo, so it must not condemn the repo, and it cannot be used to
  # spare one either. A branch or tag gets the "^{tree}" suffix here, so that files_in lists
  # what it holds now and not its whole history. An issue or patch ref goes to delegate_ops,
  # which hands back the trees of the ops a delegate signed: for a COB the history is the
  # content, but that history also reaches what everybody else wrote.
  # $tips is the branches and tags among them, without Radicle's own refs/rad/ metadata: the
  # files a person would call the project's.
  ours=""; tips=""; cobs=()
  for ref in "${refs[@]}"; do
    case $ref in
      refs/heads/*|refs/tags/*) ours="$ours $ref^{tree}"; tips="$tips $ref^{tree}"; continue ;;
      refs/cobs/*)              cobs+=("$ref"); continue ;;
      refs/namespaces/*)
        nid=${ref#refs/namespaces/}; nid=${nid%%/*}
        case " $dids " in (*" $nid "*) ;; (*) continue ;; esac ;;
      *) continue ;;
    esac
    case $ref in
      */refs/cobs/*)                cobs+=("$ref") ;;
      */refs/heads/*|*/refs/tags/*) ours="$ours $ref^{tree}"; tips="$tips $ref^{tree}" ;;
      *)                            ours="$ours $ref^{tree}" ;;
    esac
  done
  if [ -z "${ours// /}" ] && [ "${#cobs[@]}" = 0 ]; then
    printf '%s\t0\t0\t0\t-\t-\t-\t0\t0\n' "$rid"; continue
  fi
  sums=$(measure $ours)
  read -r tag media text unk av <<<"${sums##*$'\n'}"
  # The issues and patches come second, and only while the branches leave room for a verdict:
  # past text_ceil nothing they hold can change it, and checking each op's signature is most
  # of what a repo with thousands of ops costs.
  if [ "$tag" = "=" ] && [ "$text" -lt "$text_ceil" ] && [ "${#cobs[@]}" -gt 0 ]; then
    ops=$(delegate_ops "$d" "$work" "${cobs[@]}")
    case $'\n'$ops$'\n' in (*$'\n'torn$'\n'*) echo "$rid" >&4; continue ;; esac
    sums=$(measure $ours $ops)
    read -r tag media text unk av <<<"${sums##*$'\n'}"
  fi
  # measure prints "=" last, so anything else there means it died part-way and the totals are
  # a fragment. A fragment is not evidence: report the repo, and leave it out of the batch
  # corpus below as well as out of its own verdict.
  [ "$tag" = "=" ] || { echo "$rid" >&4; continue; }
  # The media this repo holds, as the rows the batch corpus below is built from.
  held=$(awk -v rid="$rid" '$1=="m" { printf "%s\t%s\t%s\n", $2, rid, $3 }' <<<"$sums")
  # Reading only pays off while the repo could still be a dump: once the text it already has
  # clears the widest budget any path allows, nothing an unread file turns out to be can
  # change the verdict.
  if [ "$text" -lt "$text_ceil" ]; then
    n=0; unread=0
    while read -r kind oid size; do
      n=$((n+1))
      # The biggest files are read first, so the cap leaves only the smallest unread.
      if [ "$n" -gt "$sniff_max" ]; then unread=$((unread+size)); continue; fi
      # od closes the pipe after 16 bytes and git dies of SIGPIPE, so a 500MB video costs a few
      # pipe buffers rather than 500MB. Stripping the spaces in bash saves a fork per file.
      hex=""; unpacked=""
      if [ "$kind" = z ]; then
        # A compressed file is judged by what it unpacks to. Only its first 64 KiB is unpacked,
        # because a few KiB of gzip can unpack to gigabytes, and only 512 unpacked bytes are
        # kept: enough to see a media signature, or the NUL bytes no text file has.
        unpacked=$(GIT_DIR="$d" git cat-file blob "$oid" 2>/dev/null | head -c 65536 \
                     | gzip -dc 2>/dev/null | head -c 512 | od -An -tx1 -v)
        unpacked=${unpacked//[$' \n']/}
        hex=${unpacked:0:32}
      fi
      # A file that does not unpack is judged by its own bytes.
      if [ -z "$hex" ]; then
        hex=$(GIT_DIR="$d" git cat-file blob "$oid" 2>/dev/null | od -An -tx1 -N16 -v)
        hex=${hex//[$' \n']/}
      fi
      if is_media "$hex"; then
        media=$((media+size))
        is_archive "$hex" || av=$((av+size))
        held="$held${held:+$'\n'}$oid"$'\t'"$rid"$'\t'"$size"
      elif [[ $unpacked =~ ^(..)*00 ]] \
           && [[ $unpacked != fffe* && $unpacked != feff* && $unpacked != 0000feff* ]]; then
        # Binary data behind a text name, such as a tar of videos named notes.txt.gz. It counts
        # as media the way an archive does, so a dump cannot hide behind the name. UTF-16 and
        # UTF-32 text holds NUL bytes too; one that opens with a byte-order mark says so, and
        # counts as text.
        media=$((media+size))
        held="$held${held:+$'\n'}$oid"$'\t'"$rid"$'\t'"$size"
      else
        text=$((text+size))
      fi
    done < <(awk '$1=="?" || $1=="z"' <<<"$sums" | sort -k3,3nr)
    # What the cap left unread may be media or text. Counting it as text never condemns a
    # repo, but it could hide a dump behind its smallest files, so it is done only where it
    # cannot: the text stays under MEDIA_TEXT_MAX_BYTES even with those files in it, so the
    # dump verdict comes out the same; the text read already clears the widest budget; or
    # those files as media would still leave the repo under MEDIA_MIN_BYTES. Anywhere else
    # the repo goes unjudged, since left out, a project would be judged on what nobody read.
    if [ "$unread" -gt 0 ]; then
      if [ $(( text + unread )) -lt "$text_max" ] || [ "$text" -ge "$text_ceil" ] \
         || [ $(( media + unread )) -lt "$media_min" ]; then
        text=$(( text + unread ))
      else
        echo "$rid" >&4; continue
      fi
    fi
  else
    text=$((text + unk))
  fi
  # A file joins the batch corpus only from a repo whose text leaves room for a batch verdict.
  # Counting holders the listing happened to reach before stopping would make a stock icon
  # common or rare depending on how a project's files sort.
  if [ "$text" -lt "$text_ceil" ] && [ -n "$held" ]; then
    printf '%s\n' "$held" >> "$blobs"
  fi
  # The files at the tips of the branches and tags, by path: whether a source file and a build
  # file are among them, and, for the ratio path, how many files that are not media there are,
  # how many of those are READMEs, and how many bytes of media the tips hold. measure cannot
  # tell: rev-list names a blob once, by the first path it met, so an empty Makefile goes by
  # the name of whichever empty file came first, and two copies of one README count once.
  # Listed only where a verdict could still fire, and a listing that fails leaves the repo
  # unjudged, because a missed name is the direction that condemns. "-" means not listed.
  src=0; build=0; others=-; readmes=-; tipmedia=-
  if [ "$text" -lt "$text_ceil" ] && [ "$media" -ge "$media_min" ] && [ -n "${tips// /}" ]
  then
    # Delegates mostly hold the same branches, so each distinct tree is listed once. -z,
    # because ls-tree otherwise quotes a name holding a non-ASCII byte, and "café/main.py"
    # would end in a quote instead of its extension. The listing streams into awk: a thousand
    # releases of one big tree list it a thousand times, more than a variable should hold.
    trees=$(GIT_DIR="$d" git rev-parse $tips 2>/dev/null) || { echo "$rid" >&4; continue; }
    printf '%s\n' "$held" | cut -f1,3 > "$work/media-oids"
    # A line is "<mode> <type> <oid>", a tab, and the path; "!" is a tree that did not list.
    read -r src build others readmes tipmedia < <(
      for t in $(sort -u <<<"$trees"); do
        GIT_DIR="$d" git ls-tree -r -z "$t" 2>/dev/null || printf '!\0'
      done | tr '\0' '\n' \
        | awk -F'\t' -v src="$source_exts" -v bld="$build_names" -v cap="$tip_bytes" '
        function known(list, key) { return index("|" list "|", "|" key "|") > 0 }
        FILENAME == ARGV[1] { media[$1] = $2; next }
        $0 == "!" { failed = 1; next }
        (listed += length($0) + 1) > cap { failed = 1; exit }
        {
          split($1, head, " "); oid = head[3]; path = substr($0, index($0, "\t") + 1)
          if (oid in media) {
            if (!(oid in weighed)) { weighed[oid] = 1; m += media[oid] }
            next
          }
          base = path; sub(/^.*\//, "", base); base = tolower(base)
          ext = ""; if (match(base, /\.[a-z0-9]+$/)) ext = substr(base, RSTART + 1)
          if (ext != "" && known(src, ext)) s = 1
          if (known(bld, base)) b = 1
          if (path in seen) next
          seen[path] = 1
          # A README.html is a page and a README.sh a script, both something somebody built.
          if (base ~ /^readme(\.(md|markdown|txt|rst|adoc|org))?$/) r++; else o++
        }
        END { if (failed) print "-"; else printf "%d %d %d %d %.0f\n", s, b, o, r, m }' \
        "$work/media-oids" -)
    case $tipmedia in
      (''|-) echo "$rid" >&4; continue ;;
    esac
  fi
  printf '%s\t%d\t%d\t%d\t%s\t%s\t%s\t%d\t%d\n' \
         "$rid" "$media" "$text" "$av" "$others" "$readmes" "$tipmedia" "$src" "$build"
done
MEDIA
  cache_hits media
  # Both files, because a repo the worker could not read writes only to the failure one, and a
  # phase full of unreadable repos would otherwise look stalled.
  progress_start "media rule (F)" "$(repos_left media)" "$tmp/media" "$tmp/media-fail"
  repos_to_read "$tmp/cached-media" \
    | xargs -0r -P "$JOBS" -n 32 "$BASH_BIN" "$tmp/media.sh" \
        > "$tmp/media" 4> "$tmp/media-fail" || true
  progress_stop
  # The reused rows go back beside the ones just measured, so everything downstream (the
  # media-batch corpus above all) sees every repo, not only the ones this run read. A repo
  # that has since left storage is absent from this run's keys, so its rows cannot come back.
  cache_reuse "media" 1 media      >> "$tmp/media"
  cache_reuse "media-fail" 1 media >> "$tmp/media-fail"
  cache_reuse "blobs" 2 media       > "$tmp/blobs/cached"
  cache_save  "media" "$tmp/media"
  cache_save  "media-fail" "$tmp/media-fail"
  # Through a real file, not a process substitution: cache_save checks cat's status, and cat
  # succeeds even when the sort feeding it died, which would save a truncated blob corpus as
  # though it were complete.
  sort -u "$tmp/blobs"/* 2>/dev/null > "$tmp/blobs-all" || : > "$tmp/blobs-all"
  cache_save  "blobs" "$tmp/blobs-all"
  # Every repo the worker reads yields either a measurement or a failure line, so these two
  # files are the honest record of what rule F actually answered for.
  cut -f1 "$tmp/media" "$tmp/media-fail" | sort -u > "$tmp/answered-media"
  cache_save_keys media "$tmp/answered-media"
  nmediafail=$(sort -u "$tmp/media-fail" | wc -l)
  # Which repos these are is said where the file holding them is written, near the end of the
  # run. Naming it here would name a path that a run aborting in between never creates.
  [ "$nmediafail" = 0 ] \
    || echo "# WARN: the media rule (F) left $nmediafail repo(s) unjudged: unreadable, over" \
            "MEDIA_MAX_REFS ($MEDIA_MAX_REFS) refs, listing over MEDIA_TIP_BYTES" \
            "($MEDIA_TIP_BYTES) bytes at their tips, or with more files of unknown type than" \
            "MEDIA_SNIFF_MAX_FILES ($MEDIA_SNIFF_MAX_FILES) and too many unread bytes to judge." >&2

fi

# ------------------------------------------------------------- copies of denied files: check
# Which repos hold the files DENY_FILES lists. Two steps per repo. First its object store is
# asked for every listed id at once, which covers every ref and every leftover, but proves
# nothing about the repo: any peer's push lands in that store. It costs about 15us an id in
# each repo, so a list of 10,000 ids takes about half an hour of CPU over 11,000 repos, again
# each time the list changes. A repo whose store holds at least COPY_MIN_BYTES of listed media
# is then walked, across the whole history of its delegates' branches and tags, because that
# is what ties a file to the repo's delegates. A listed file those branches do not reach
# condemns nothing, or pushing one into a repo would be a way to get it deleted.
: > "$tmp/copy"; : > "$tmp/copy-fail"; : > "$tmp/copy-done"; : > "$tmp/copies"
if [ -s "$tmp/deny-oid-list" ]; then
  echo "# checking repos for copies of denied files ($JOBS workers)..." >&2
  cat > "$tmp/copy.sh" <<COPY
#!/usr/bin/env bash
set -o pipefail
$(declare -f read_delegates delegate_branches is_media is_archive)
ids='$tmp/deny-oid-list'
max_refs=$MEDIA_MAX_REFS
min_bytes=$COPY_MIN_BYTES
COPY
  cat >> "$tmp/copy.sh" <<'COPY'
t=$(mktemp) || exit 1
trap 'rm -f "$t" "$t.hits" "$t.n" "$t.walk"' EXIT
# Rows, each with the rid in field 2 for the run cache: "h" a listed file the delegates'
# branches reach, with its size; "n" a listed id that counts for nothing, with why; "p" a repo
# holding listed files none of those branches reach; "=" the end of a repo, with the bytes of
# every file its delegates' branches reach. A repo's rows are printed only once it has been
# checked to the end, so one that fails part-way leaves nothing behind but its name on fd 4.
for d; do
  rid=${d##*/}
  # Every listed id the store holds, by whatever route it arrived. A missing one prints as
  # "<oid> missing".
  GIT_DIR="$d" git cat-file --batch-check='%(objectname) %(objecttype) %(objectsize)' \
    < "$ids" > "$t" 2>/dev/null || { echo "$rid" >&4; continue; }
  # An id naming a commit, a tree or a tag is a row copied from the wrong place.
  awk -v rid="$rid" '$2 != "blob" && $2 != "missing" {
                       printf "n\t%s\t%s\ta %s, not a file\n", rid, $1, $2 }' "$t" > "$t.n"
  # A row is only as good as whoever wrote it. One naming a text file by mistake would make
  # every repo holding that file a copy, so a listed file has to read as media to count. It is
  # read before any history is walked, so a listed file that is not media costs one read in
  # each repo holding it. An empty read of a file that is not empty is a broken store.
  : > "$t.hits"; broken=0; stored=0
  while read -r oid size; do
    hex=$(od -An -tx1 -N16 -v < <(GIT_DIR="$d" git cat-file blob "$oid" 2>/dev/null))
    hex=${hex//[$' \n']/}
    if [ -z "$hex" ] && [ "$size" != 0 ]; then broken=1; break; fi
    if is_media "$hex"; then
      echo "$oid" >> "$t.hits"; stored=$((stored + size))
    else
      printf 'n\t%s\t%s\tnot a known media format\n' "$rid" "$oid" >> "$t.n"
    fi
  done < <(awk '$2 == "blob" { print $1, $3 }' "$t")
  [ "$broken" = 0 ] || { echo "$rid" >&4; continue; }
  # The branches can hold no more of the listed media than the whole store does, so a repo
  # whose store holds less than the bar is no copy, and is not walked. A stock icon shared with
  # a denied repo would otherwise send every repo holding it through a walk on each change.
  if [ "$stored" -lt "$min_bytes" ]; then
    [ ! -s "$t.n" ] || cat "$t.n"; printf '=\t%s\t0\n' "$rid"; echo "$rid" >&3; continue
  fi
  # --count stops the listing one past rule F's cap, so a repo with 152k refs never reaches a
  # variable. Over it the repo goes unjudged, as it does for rule F.
  allrefs=$(GIT_DIR="$d" git for-each-ref --count=$(( max_refs + 1 )) \
              --format='%(refname)' 2>/dev/null) || { echo "$rid" >&4; continue; }
  [ "$(wc -l <<<"$allrefs")" -le "$max_refs" ] || { echo "$rid" >&4; continue; }
  read_delegates "$d"
  ours=$(delegate_branches <<<"$allrefs")
  # Whole histories, not only tips: a file committed and then deleted is still in the repo,
  # and every node that fetches the repo gets it. The awk keeps the listed files and adds up
  # the bytes of every file, which is what the listed ones are measured against.
  printf '=\t%s\t0\n' "$rid" > "$t.walk"
  if [ -n "$ours" ]; then
    # No --ignore-missing: a ref whose commit is gone would drop out of the walk, and its bytes
    # out of the share, leaving the repo judged on the rest.
    GIT_DIR="$d" git rev-list --objects --stdin \
        --filter=object:type=blob <<<"$ours" 2>/dev/null \
      | GIT_DIR="$d" git cat-file \
          --batch-check='%(objectname) %(objecttype) %(objectsize) %(rest)' 2>/dev/null \
      | awk -v hits="$t.hits" -v rid="$rid" '
          FILENAME == hits { listed[$1] = 1; next }
          $2 != "blob"     { next }
          { total += $3 }
          $1 in listed     { printf "h\t%s\t%s\t%s\n", rid, $1, $3 }
          END              { printf "=\t%s\t%.0f\n", rid, total }' "$t.hits" - > "$t.walk"
    # A listing that dies part-way reads as a repo holding less, which raises the share the
    # listed files make up. Not judged at all is the safe reading of that.
    case "${PIPESTATUS[*]}" in (*[1-9]*) echo "$rid" >&4; continue ;; esac
  fi
  cat "$t.n"
  grep -q '^h' "$t.walk" || printf 'p\t%s\t%s\n' "$rid" "$(wc -l < "$t.hits")"
  cat "$t.walk"; echo "$rid" >&3
done
COPY
  # The cached rows answer for the list they were checked against. A changed list re-checks
  # every repo without touching rule E and F's cache, which folding it into the fingerprint
  # would throw away, costing a full cold run for every row added.
  copy_set=$(sha1sum < "$tmp/deny-oid-list" | cut -c1-40)
  copy_set_saved=1
  if [ "$CACHE" = 1 ] && [ "$(cat "$CACHE_DIR/copy-set" 2>/dev/null)" = "$copy_set" ]; then
    cache_hits copy
  else
    : > "$tmp/cached-copy"
    # The old keys go before the new list is written down, so a run that dies in between
    # checks everything again and never reuses rows checked against the old list. Keys
    # saved under a list that could not be written down would be reused under the old one.
    copy_set_saved=0
    if [ "$CACHE" = 1 ] && mkdir -p "$CACHE_DIR" 2>/dev/null \
       && rm -f "$CACHE_DIR/keys-copy" 2>/dev/null \
       && printf '%s\n' "$copy_set" > "$CACHE_DIR/copy-set" 2>/dev/null; then
      copy_set_saved=1
    fi
  fi
  progress_start "copies" "$(repos_left copy)" "$tmp/copy-done" "$tmp/copy-fail"
  repos_to_read "$tmp/cached-copy" \
    | xargs -0r -P "$JOBS" -n 32 "$BASH_BIN" "$tmp/copy.sh" \
        > "$tmp/copy" 3> "$tmp/copy-done" 4> "$tmp/copy-fail" || true
  progress_stop
  cache_reuse "copy" 2 copy >> "$tmp/copy"
  cache_save  "copy" "$tmp/copy"
  # Only a repo with its closing row was checked to the end. One that failed is not cached, so
  # the next run tries it again.
  awk -F'\t' '$1 == "=" { print $2 }' "$tmp/copy" | sort -u > "$tmp/answered-copy"
  if [ "$copy_set_saved" = 1 ]; then cache_save_keys copy "$tmp/answered-copy"; fi

  # rid \t listed bytes \t total bytes \t % \t files \t source \t other sources, for every
  # repo whose delegates' branches hold a listed file. Only ids on this run's list count. The
  # cache already checks every repo again when the list changes, and this holds should a cached
  # row from a longer list ever get through. The source named is the one most of its
  # files came from, ties broken by name so the same storage always prints the same plan.
  awk -F'\t' -v src="$tmp/deny-oids" '
      FILENAME == src            { if (!($1 in from)) from[$1] = $2; next }
      $1 == "=" && $3 > 0        { total[$2] = $3 }
      $1 == "h" && ($3 in from)  { held[$2] += $4; files[$2]++; per[$2 SUBSEP from[$3]]++ }
      END {
        for (key in per) {
          split(key, k, SUBSEP); nsrc[k[1]]++
          if (per[key] > most[k[1]] || (per[key] == most[k[1]] && k[2] < top[k[1]]))
            { most[k[1]] = per[key]; top[k[1]] = k[2] }
        }
        for (r in held) if (r in total)
          printf "%s\t%.0f\t%.0f\t%d\t%d\t%s\t%d\n", r, held[r], total[r],
                 int(held[r] * 100 / total[r]), files[r], top[r], nsrc[r] - 1
      }' "$tmp/deny-oids" "$tmp/copy" | sort -t$'\t' -k2,2nr -k1,1 > "$tmp/copies"

  # Sorted into a file first: head leaving a long pipe early would fail it under pipefail.
  sort -u -o "$tmp/copy-fail" "$tmp/copy-fail"
  ncopyfail=$(wc -l < "$tmp/copy-fail")
  if [ "$ncopyfail" -gt 0 ]; then
    echo "# WARN: could not check $ncopyfail repo(s) for copies of denied files: unreadable," \
         "or over MEDIA_MAX_REFS ($MEDIA_MAX_REFS) refs. None of them is pruned as one:" >&2
    head -n "$top_evidence" "$tmp/copy-fail" | sed 's/^/#   /' >&2
    [ "$ncopyfail" -le "$top_evidence" ] \
      || echo "#   ...and $((ncopyfail - top_evidence)) more (PLAN_FULL=1 lists them)" >&2
  fi
  # A listed file in an issue, a patch, a stranger's push or an old leftover. Whose it is takes
  # a human to tell.
  # A repo in the keep file was already looked at by a person, so it is not named again.
  awk -F'\t' -v kept="$tmp/kept" 'FILENAME == kept { k[$1] = 1; next }
                                  $1 == "p" && !($2 in k) { printf "%s\t%s\n", $2, $3 }' \
      "$tmp/kept" "$tmp/copy" | sort -u > "$tmp/copy-planted"
  nplanted=$(wc -l < "$tmp/copy-planted")
  if [ "$nplanted" -gt 0 ]; then
    echo "# WARN: $nplanted repo(s) hold $copy_min_said or more of listed files, but not on" \
         "their own branches or tags, so they are not pruned as copies. Check them by hand:" >&2
    head -n "$top_evidence" "$tmp/copy-planted" \
      | awk -F'\t' '{ printf "#   %-34s %d file(s)\n", $1, $2 }' >&2
    [ "$nplanted" -le "$top_evidence" ] \
      || echo "#   ...and $((nplanted - top_evidence)) more (PLAN_FULL=1 lists them)" >&2
  fi
  # A listed id that counts for nothing is a row somebody should fix. Sorted first, so the
  # same storage names the same repo for it on every run.
  awk -F'\t' '$1 == "n" { printf "%s\t%s\t%s\n", $3, $2, $4 }' "$tmp/copy" | sort -u \
    | awk -F'\t' '!($1 in seen) { seen[$1] = 1; print }' > "$tmp/copy-notmedia"
  nnotmedia=$(wc -l < "$tmp/copy-notmedia")
  if [ "$nnotmedia" -gt 0 ]; then
    echo "# WARN: $nnotmedia id(s) in $DENY_FILES count for nothing: they are not files, or" \
         "do not start like any image, video, audio or archive format this tool knows." \
         "Check those rows:" >&2
    head -n "$top_evidence" "$tmp/copy-notmedia" \
      | awk -F'\t' '{ printf "#   %s  %s (in %s)\n", $1, $3, $2 }' >&2
    [ "$nnotmedia" -le "$top_evidence" ] \
      || echo "#   ...and $((nnotmedia - top_evidence)) more (PLAN_FULL=1 lists them)" >&2
  fi
  # Enough listed media on a repo's own branches, but under the share. Padding the branches
  # with bytes of their own is how a copy would get there, so a person should look. A repo in
  # the keep file already has been.
  awk -F'\t' -v kept="$tmp/kept" -v b="$COPY_MIN_BYTES" -v p="$COPY_MIN_PCT" '
      FILENAME == kept { k[$1] = 1; next }
      $2 >= b && $4 < p && !($1 in k)' "$tmp/kept" "$tmp/copies" > "$tmp/copy-under"
  nunder=$(wc -l < "$tmp/copy-under")
  if [ "$nunder" -gt 0 ]; then
    echo "# WARN: $nunder repo(s) hold enough listed files on their own branches to be" \
         "copies, but too small a share of the repo. Check them by hand:" >&2
    head -n "$top_evidence" "$tmp/copy-under" \
      | awk -F'\t' 'BEGIN { fmt = "#   %-34s %.1f MiB in %d file(s), "
                            fmt = fmt "%d%% of the bytes on its branches\n" }
                    { printf fmt, $1, $2 / 1048576, $5, $4 }' >&2
    [ "$nunder" -le "$top_evidence" ] \
      || echo "#   ...and $((nunder - top_evidence)) more (PLAN_FULL=1 lists them)" >&2
  fi
fi

# --------------------------------------------------------------- rule G: parasite peers, scan
# Records, per repo, what each NON-delegate peer has put there that the repo's own refs do not
# hold. `--not` hands the exclusion to git, which stops walking at the first shared commit, so
# a peer who merely replicates the repo produces no output at all and costs almost nothing.
# One combined listing runs first and most repos end there, because most have no stranger
# media; only where that finds some is the work repeated per peer to learn whose it is.
: > "$tmp/peer"
if rule_on G; then
  echo "# looking for parasite peers for the parasite-peer rule (G) ($JOBS workers)..." >&2
  cat > "$tmp/peer.sh" <<PEER
#!/usr/bin/env bash
$(declare -f read_delegates)
media_exts='$MEDIA_EXTS'
max_refs=$MEDIA_MAX_REFS
PEER
  cat >> "$tmp/peer.sh" <<'PEER'
# Prints "<oid> <bytes> <path>" for every blob reachable from the refs in $2 but not from any
# ref in $3, both newline-separated lists. They go in on stdin rather than as arguments, since
# a widely replicated repo has thousands of refs and argv has a size limit a ref list reaches.
# `^ref` is how rev-list spells "and not this one", and it stops the walk at the first commit
# the two sides share, so a peer who only mirrors the repo costs almost nothing to rule out.
only_in() {
  local d=$1 want=$2 exclude=$3
  { printf '%s\n' $want; printf '^%s\n' $exclude; } \
    | GIT_DIR="$d" git rev-list --objects --ignore-missing --stdin \
        --filter=object:type=blob 2>/dev/null \
    | GIT_DIR="$d" git cat-file \
        --batch-check='%(objectname) %(objecttype) %(objectsize) %(rest)' 2>/dev/null \
    | awk '$2 == "blob" { path = $0; sub(/^[^ ]+ [^ ]+ [^ ]+ /, "", path)
                          printf "%s %.0f %s\n", $1, $3, path }'
  # A listing that died halfway still prints a plausible number of blobs. Reported as if it
  # were the whole set, it lowers this peer's non-media byte total, and a low non-media total
  # is the last bar an accusation has to clear, so a torn listing accuses. Say it failed.
  case "${PIPESTATUS[*]}" in (*[1-9]*) return 1 ;; esac
  return 0
}
# Splits a blob listing into the media bytes and the other bytes it holds. Extension only: rule
# G accuses a person, so it leans on the same file appearing again and again rather than on a
# guess about one file's type, and a sniffer here would cost a read per blob across the seed.
split_bytes() {
  awk -v m="$media_exts" '
    function known(list, key) { return index("|" list "|", "|" key "|") > 0 }
    { oid = $1; size = $2 + 0
      base = $0; sub(/^[^ ]+ [^ ]+ /, "", base); sub(/^.*\//, "", base); base = tolower(base)
      ext = ""; if (match(base, /\.[a-z0-9]+$/)) ext = substr(base, RSTART + 1)
      if (ext != "" && known(m, ext)) { printf "b %s %.0f\n", oid, size; media += size }
      else                                                              other += size }
    END { printf "= %.0f %.0f\n", media, other }'
}
# Judges one repo. Returns 0 once it has said everything it has to say about that repo,
# whether that is a stack of rows or nothing at all, and non-zero when a git listing came back
# torn, so the caller can leave the repo unanswered rather than bank a partial total.
walk_repo() {
  local d=$1 rid=$2 dids nid allrefs ref own strangers combined media_here mine
  local refs=()
  # refs/rad/id is written by the local node only after it verifies the identity document's
  # signatures, so a stranger's push cannot make itself a delegate.
  # This runs before any skip below, because a delegate is never blocked and that protection
  # must not depend on whether the rest of this repo turned out to be worth walking.
  read_delegates "$d"
  # Every row this worker prints carries the rid in field 2, whatever its kind, because the
  # run cache reuses rows by repo and can only look in one field.
  if [ -z "$dids" ]; then printf 'u\t%s\n' "$rid"; return 0; fi
  for nid in $dids; do printf 'd\t%s\t%s\n' "$rid" "$nid"; done
  # --count stops the listing one past the cap, so a repo with 152k refs never reaches a shell
  # variable. The cap is rule F's MEDIA_MAX_REFS: both rules pay the same cost, walking every
  # peer's refs, and a second knob for one number nobody would set differently is noise.
  allrefs=$(GIT_DIR="$d" git for-each-ref --count=$(( max_refs + 1 )) \
              --format='%(refname)' 2>/dev/null) || return 1
  mapfile -t refs <<<"$allrefs"
  [ "${#refs[@]}" -le "$max_refs" ] || return 0
  # OWN is everything the delegates control, and it is the exclusion set. Whole histories go in
  # here rather than tips, because a wider exclusion can only ever spare a peer.
  own=""; strangers=""; combined=""
  for ref in "${refs[@]}"; do
    case $ref in
      refs/heads/*|refs/tags/*|refs/cobs/*|refs/rad/*) own="$own"$'\n'"$ref"; continue ;;
      refs/namespaces/*) nid=${ref#refs/namespaces/}; nid=${nid%%/*} ;;
      *) continue ;;
    esac
    case " $dids " in
      (*" $nid "*) own="$own"$'\n'"$ref" ;;
      (*)          strangers="$strangers"$'\n'"$nid"$'\t'"$ref"
                   combined="$combined"$'\n'"$ref" ;;
    esac
  done
  [ -n "$strangers" ] || return 0
  # The cheap tier: one listing for every stranger at once. Most repos stop here. Each listing
  # lands in a file rather than a pipe, so its exit status is still there to be read. A peer
  # who only mirrors the repo lists nothing, and an empty listing holds no media to weigh.
  only_in "$d" "$combined" "$own" > "$blobs" || return 1
  [ -s "$blobs" ] || return 0
  media_here=$(split_bytes < "$blobs" | awk '$1 == "=" { print $2 }')
  [ "${media_here:-0}" -gt 0 ] || return 0
  # Something is there, so pay to learn whose. One listing per peer, and the peers with
  # nothing of their own drop out having cost one walk that ends at the first shared commit.
  for nid in $(cut -f1 <<<"${strangers#$'\n'}" | sort -u); do
    mine=$(awk -F'\t' -v n="$nid" '$1 == n { print $2 }' <<<"${strangers#$'\n'}")
    only_in "$d" "$mine" "$own" > "$blobs" || return 1
    split_bytes < "$blobs" \
      | awk -v nid="$nid" -v rid="$rid" '
          $1 == "b" { printf "b\t%s\t%s\t%s\t%s\n", rid, nid, $2, $3 }
          $1 == "=" { printf "=\t%s\t%s\t%s\t%s\n", rid, nid, $2, $3 }'
  done
  return 0
}
blobs=$(mktemp) || exit 1
trap 'rm -f "$blobs"' EXIT
for d; do
  # The marker below says this repo was judged to the end. A worker killed part-way through
  # one, or a git listing that came back torn, leaves the marker out, and the run cache then
  # reads the repo again next week instead of banking totals that stopped short of some of
  # its bytes. Rows this repo already printed are harmless: the next run reprints them, and
  # nothing reuses the rows of a repo that has no key.
  # The marker goes to the plan stream, which the run cache reads alongside the other row
  # kinds, and to fd 3, where one line means one repo and the progress ticker can just count.
  walk_repo "$d" "${d##*/}" \
    && { printf 'x\t%s\n' "${d##*/}"; printf '%s\n' "${d##*/}" >&3; }
done
PEER
  cache_hits peer
  progress_start "parasite-peer rule (G)" "$(repos_left peer)" "$tmp/peer-done"
  repos_to_read "$tmp/cached-peer" \
    | xargs -0r -P "$JOBS" -n 32 "$BASH_BIN" "$tmp/peer.sh" \
        > "$tmp/peer" 3> "$tmp/peer-done" || true
  progress_stop
  # The reused rows go back beside the ones just walked, because the verdict is corpus-wide:
  # a peer's spread is counted across all of storage, and a delegate row from any repo is what
  # keeps that peer from ever being accused.
  cache_reuse "peer" 2 peer >> "$tmp/peer"
  cache_save  "peer" "$tmp/peer"
  # Only the end-of-repo marker counts as an answer. Taking every rid that appears in any row
  # would have counted a repo the worker died in the middle of, since its delegate rows are
  # printed before the walk that produces the byte totals.
  awk -F'\t' '$1 == "x" { print $2 }' "$tmp/peer" | sort -u > "$tmp/answered-peer"
  cache_save_keys peer "$tmp/answered-peer"
fi


# ----------------------------------------------------------------------- rule E: collect hosts
# Collects the hostnames each repo mentions, folded to domains later. Reading file content is
# slow, so a RULES without E turns it off, and each repo is walked in two steps: list blob ids
# sizes without reading them, then read only the ones under the size cap. Where a link sits
# does not matter here: issues, patches, comments and committed files all count.
: > "$tmp/hosts"
if rule_on E; then
  echo "# harvesting referenced hosts from repo contents ($JOBS workers)..." >&2
  cat > "$tmp/hosts.sh" <<HOSTS
#!/usr/bin/env bash
ceiling=$LINK_BLOB_PREFIX
budget=$LINK_REPO_BUDGET
HOSTS
  cat >> "$tmp/hosts.sh" <<'HOSTS'
# Reads blob ids on stdin. Prints "<rid>\t<hostname>" for each hostname those blobs mention,
# without repeats. $1 = the repo's git dir, $2 = its rid. One sed lowercases the line and swaps
# the scheme for the rid: every line carries the same rid, so sorting after it changes neither
# which lines are repeats nor their order, and it saves two processes per pass per repo.
hosts_of() {
  GIT_DIR="$1" git cat-file --batch 2>/dev/null \
    | head -c "$budget" \
    | grep -aoE 'https?://[A-Za-z0-9._-]+' \
    | sed -E "y/ABCDEFGHIJKLMNOPQRSTUVWXYZ/abcdefghijklmnopqrstuvwxyz/; s#^https?://#$2\t#" \
    | sort -u
}
for d; do
  rid=${d##*/}
  # Every file in the repo, wherever it lives. A repo we cannot list is reported on fd 4 rather
  # than returning an empty host list, which would be indistinguishable from a repo with no
  # links.
  # NOT --unordered, though it would skip a sort: the per-repo budget below stops the read
  # part-way, so the emission order decides WHICH files get scanned. Sorted by object id, that
  # choice is the same on every run; in pack order it changes whenever git repacks, and a repo
  # would be judged on different evidence for no reason anyone could see.
  GIT_DIR="$d" git cat-file --batch-all-objects \
       --batch-check='%(objectname) %(objecttype) %(objectsize)' 2>/dev/null \
    | awk -v c="$ceiling" '$2=="blob" && $3+0<=c {print $1}' \
    | hosts_of "$d" "$rid"
  # A repo bigger than the budget closes the pipe early, which kills the lister with SIGPIPE
  # (141). That is the cap doing its job. Any other failure means we could not read the repo.
  st=${PIPESTATUS[0]}
  { [ "$st" = 0 ] || [ "$st" = 141 ]; } || echo "$rid" >&4
  # Same again, restricted to the CANONICAL branches and tags, written to fd 3. Those are the
  # refs only a delegate can move, so a stranger cannot make a host look like this repo's
  # dependency. A host enough repos link to from their own code is a dependency, and stops
  # counting as spam.
  # Filtered and capped like pass 1 above, so the budget goes on blobs alone and a link in a
  # commit MESSAGE, which pass 1 never sees, is not counted: the two streams have to agree on
  # what this repo's own code links to.
  GIT_DIR="$d" git rev-list --objects --branches --tags \
       --filter=object:type=blob 2>/dev/null \
    | cut -d' ' -f1 \
    | GIT_DIR="$d" git cat-file \
        --batch-check='%(objectname) %(objecttype) %(objectsize)' 2>/dev/null \
    | awk -v c="$ceiling" '$2=="blob" && $3+0<=c {print $1}' \
    | hosts_of "$d" "$rid" >&3
  # This repo has been read to the end. A repo that links to nothing writes no host line at
  # all, so without this the run cache could not tell that from a repo nobody ever read.
  printf '%s\n' "$rid" >&5
done
HOSTS
  cache_hits hosts
  # The done stream alone: the worker writes it for every repo it finishes, a repo it could
  # not read included, so adding the failure stream would count those repos twice. The host
  # stream holds one line per LINK, which would race ahead and then stall on a repo that
  # links nowhere.
  progress_start "link-farm rule (E)" "$(repos_left hosts)" "$tmp/hosts-done"
  repos_to_read "$tmp/cached-hosts" \
    | xargs -0r -P "$JOBS" -n 32 "$BASH_BIN" "$tmp/hosts.sh" \
        > "$tmp/hosts" 3> "$tmp/hosts-code" 4> "$tmp/hosts-fail" 5> "$tmp/hosts-done" || true
  progress_stop
  cache_reuse "hosts" 1 hosts      >> "$tmp/hosts"
  # The consumer counts a repo per line, so a duplicated line would count that repo twice and
  # lower the bar a domain has to clear to be called spam. Enforced here rather than assumed.
  sort -u "$tmp/hosts" -o "$tmp/hosts"
  cache_reuse "hosts-code" 1 hosts >> "$tmp/hosts-code"
  cache_reuse "hosts-fail" 1 hosts >> "$tmp/hosts-fail"
  cache_save  "hosts" "$tmp/hosts"
  cache_save  "hosts-code" "$tmp/hosts-code"
  cache_save  "hosts-fail" "$tmp/hosts-fail"
  # A repo that links to nothing emits no host line at all, so the worker marks each repo it
  # finished on its own stream. Without that, "read it, found nothing" and "never read it"
  # would look the same and the second would be cached as the first.
  { cat "$tmp/cached-hosts"; cut -f1 "$tmp/hosts-done" "$tmp/hosts-fail"; } \
    | sort -u > "$tmp/answered-hosts"
  cache_save_keys hosts "$tmp/answered-hosts"
  echo "# harvested $(wc -l < "$tmp/hosts") repo/host pairs over" \
       "$(cut -f1 "$tmp/hosts" | sort -u | wc -l) repos" >&2
  nhostfail=$(sort -u "$tmp/hosts-fail" | wc -l)
  [ "$nhostfail" = 0 ] \
    || echo "# WARN: could not read $nhostfail repo(s); excluded from the plan." >&2
fi

# A repo we could not fully read has an untrustworthy size and age, so exclude it from the plan
# rather than judge it on partial data. find and du name the offending path, so take the
# component right after $STORAGE/ instead of pattern-matching a rid: exact for any rid length,
# and literal even where the path itself holds glob characters.
while IFS= read -r line; do
  rid=${line#*"$STORAGE/"}
  [ "$rid" = "$line" ] && continue          # this error is not about a repo dir
  rid=${rid%%/*}; rid=${rid%%\'*}           # first component, minus find/du's closing quote
  case "$rid" in ?*) printf '%s\n' "$rid" ;; esac
done < "$scanerr" | cat - "$tmp/hosts-fail" | sort -u > "$tmp/scanfail"
nscanerr=$(wc -l < "$scanerr"); nscanfail=$(wc -l < "$tmp/scanfail")
if [ "$nscanerr" -gt 0 ]; then
  echo "# WARN: $nscanerr scan error(s); $nscanfail repo(s) unreadable, excluded:" >&2
  head -n "$top_scanerr" "$scanerr" | sed 's/^/#   /' >&2
  [ "$nscanerr" -gt "$top_scanerr" ] \
    && echo "#   ...and $((nscanerr - top_scanerr)) more (PLAN_FULL=1 lists them)" >&2
fi

# ------------------------------------------------------------------- rule E: find spam domains
# A spam domain is one that at least $minrepos repos link to and under LINK_CODE_MAX_PCT% of
# those link to from their own code. The second condition tells a site the spam advertises
# apart from github.com: hundreds of repos link to each, but nearly every github.com linker
# also has it in source or a README. Both are counted from storage on every run, so there is no
# blocklist.
#
# It takes two passes, because a code link only counts when the repo it comes from is not
# itself suspect. Pass 1 marks the suspects: repos rule D already calls generated, plus repos
# that reach LINK_MIN_SCORE against a looser reading of what a spam domain is. Pass 2 is the
# real test and ignores their code links. Otherwise a spammer clears their own domain by
# committing the link in one repo in ten, using repos they already have.
minrepos=$(awk -v n="$nrepos" -v pct="$LINK_MIN_REPOS_PCT" -v floor="$LINK_MIN_REPOS" \
               'BEGIN{ s=n*pct/100; printf "%d", (s>floor)?s:floor }')
: > "$tmp/linkfarm"; : > "$tmp/linktop"
if [ -s "$tmp/hosts" ]; then
  awk -F'\t' -v MINREPOS="$minrepos" -v MINSCORE="$LINK_MIN_SCORE" \
             -v CODEPCT="$LINK_CODE_MAX_PCT" -v LOOSEPCT="$LINK_CODE_LOOSE_PCT" \
             -v TOP="$tmp/linktop" '
    # Count by registrable domain, not by hostname: a wildcard DNS record and one subdomain per
    # repo would otherwise keep every name below the linker bar for free. Three labels when the
    # last is a two-letter country code behind a short one (co.uk, com.br, ne.jp), two
    # otherwise.
    function reg(h,   n,a) {
      n = split(h, a, ".")
      if (n <= 2) return h
      if (length(a[n])==2 && length(a[n-1])<=3) return a[n-2] "." a[n-1] "." a[n]
      return a[n-1] "." a[n]
    }
    FILENAME==ARGV[1] { suspect[$1]=1; next }        # rule D calls these repos generated
    FILENAME==ARGV[2] { d=reg($2); codepair[$1 SUBSEP d]=1; allcode[d]++; next }  # from code
    { d=reg($2); links[d]++; pair[$1 SUBSEP d]=1 }   # one line per repo/domain: counts repos
    END {
      # Pass 1: the same test at the looser cap, used only to add to the suspect list.
      for (h in links)
        if (links[h] >= MINREPOS && (allcode[h]+0)*100 < LOOSEPCT*links[h]) loose[h]=1
      for (k in pair) { split(k,q,SUBSEP); if (q[2] in loose) loosescore[q[1]]++ }
      for (r in loosescore) if (loosescore[r] >= MINSCORE) suspect[r]=1
      # Pass 2: the real test. Only links[] counts every repo, on purpose - the spam repos are
      # exactly the linkers that make a host stand out, so filtering them would erase the
      # signal.
      for (k in codepair) { split(k,q,SUBSEP); if (!(q[1] in suspect)) vouch[q[2]]++ }
      for (h in links)
        if (links[h] >= MINREPOS && (vouch[h]+0)*100 < CODEPCT*links[h])
          { spamdom[h]=1; printf "%d\t%s\n", links[h], h > TOP }
      for (k in pair) { split(k,q,SUBSEP); if (q[2] in spamdom) score[q[1]]++ }
      for (r in score) if (score[r] >= MINSCORE) printf "%s\t%d\n", r, score[r]
    }' "$tmp/spam" "$tmp/hosts-code" "$tmp/hosts" > "$tmp/linkfarm" || true
  # Reported whenever the corpus yields any spam domain, even if no repo then crosses the score
  # bar: what the rule saw is worth knowing on a run where it decides to flag nothing.
  nfarm=$(wc -l < "$tmp/linkfarm"); nspamdom=$(wc -l < "$tmp/linktop")
  if [ "$nspamdom" -gt 0 ]; then
    echo "# spam domains: $nspamdom domain(s) linked from >=$minrepos repos," \
         "<$LINK_CODE_MAX_PCT% from code;"
    echo "#   $nfarm repo(s) link to >=$LINK_MIN_SCORE of them," \
         "before the age and seed checks:"
    sort -k1,1nr "$tmp/linktop" \
      | awk -F'\t' -v n="$top_evidence" 'NR<=n {printf "#   %5d repos  %s\n", $1, $2}'
    [ "$nspamdom" -gt "$top_evidence" ] \
      && echo "#   ...and $((nspamdom - top_evidence)) more (PLAN_FULL=1 lists them)"
  fi
fi

# ---------------------------------------------------------------- rule E: whose links are they
# Any peer may push an issue or a comment to any public repo, and it lands in that repo's
# storage here, so the harvest above counts a stranger's links as the repo's own. Left alone
# that turns rule E into a weapon: five spam links in five issues and somebody else's repo is
# in the plan. Every repo that scored is therefore re-read across the refs its DELEGATES
# control - the canonical branches and each delegate's namespace - and keeps its score only if
# it survives there. A repo whose delegates cannot be read is dropped from the plan, not kept.
if [ "$LINK_DELEGATE_CHECK" = 1 ] && [ -s "$tmp/linkfarm" ]; then
  cut -f2 "$tmp/linktop" | sort -u > "$tmp/spamdomains"
  cat > "$tmp/owned.sh" <<OWNED
#!/usr/bin/env bash
RAD=$(printf %q "$RAD"); STORAGE=$(printf %q "$STORAGE")
ceiling=$LINK_BLOB_PREFIX
budget=$LINK_REPO_BUDGET
OWNED
  cat >> "$tmp/owned.sh" <<'OWNED'
for rid in "$@"; do
  d="$STORAGE/$rid"
  # `rad inspect` gives the CURRENT identity revision, not the union of every revision ever
  # signed. Here a delegate list is what lets a link condemn a repo, so the narrower list is
  # the one that errs toward sparing.
  nids=$("$RAD" inspect "rad:$rid" --delegates 2>/dev/null \
         | grep -oE 'z[1-9A-HJ-NP-Za-km-z]{40,}' | tr '\n' ' ')
  # No delegate list, so the repo's own links cannot be told from a stranger's. The done
  # marker goes out on this path too, so the progress count below is repos finished rather
  # than repos that turned out to be readable.
  [ -n "$nids" ] || { echo "$rid" >&3; printf '%s\n' "$rid" >&4; continue; }
  # The blob filter keeps trees out of the reader below, which only ever wanted blobs.
  GIT_DIR="$d" git for-each-ref --format='%(objectname) %(refname)' 2>/dev/null \
    | awk -v ok="$nids" '
        BEGIN { n=split(ok,a," "); for (i=1;i<=n;i++) keep[a[i]]=1 }
        { if ($2 ~ /^refs\/namespaces\//) { split($2,p,"/"); if (!(p[3] in keep)) next }
          print $1 }' \
    | GIT_DIR="$d" git rev-list --objects --stdin --filter=object:type=blob 2>/dev/null \
    | cut -d' ' -f1 \
    | GIT_DIR="$d" git cat-file \
        --batch-check='%(objectname) %(objecttype) %(objectsize)' 2>/dev/null \
    | awk -v c="$ceiling" '$2=="blob" && $3+0<=c {print $1}' \
    | GIT_DIR="$d" git cat-file --batch 2>/dev/null \
    | head -c "$budget" \
    | grep -aoE 'https?://[A-Za-z0-9._-]+' \
    | sed -E 's#^https?://##' | tr '[:upper:]' '[:lower:]' | sort -u | sed "s#^#$rid\t#"
  # This repo has been re-read to the end. One line per repo, which is what the progress
  # ticker counts; the stream above holds one line per repo/host pair instead.
  printf '%s\n' "$rid" >&4
done
OWNED
  # Every flagged repo is read again here, in full, so this walk is slow whenever rule E
  # flagged many of them. It announces itself and reports progress rather than going quiet.
  nflagged=$(wc -l < "$tmp/linkfarm")
  echo "# re-reading $nflagged flagged repo(s) across their delegates' refs" \
       "($JOBS workers)..." >&2
  progress_start "delegates" "$nflagged" "$tmp/owned-done"
  cut -f1 "$tmp/linkfarm" | tr '\n' '\0' \
    | xargs -0r -P "$JOBS" -n 8 "$BASH_BIN" "$tmp/owned.sh" \
        > "$tmp/owned" 3> "$tmp/owned-fail" 4> "$tmp/owned-done" || true
  progress_stop
  # reg() below must fold exactly as the harvest pass does, or a domain counted there would
  # score differently here. Kept as its own copy so each awk program reads on its own.
  awk -F'\t' -v MINSCORE="$LINK_MIN_SCORE" '
    function reg(h,   n,a) {
      n = split(h, a, ".")
      if (n <= 2) return h
      if (length(a[n])==2 && length(a[n-1])<=3) return a[n-2] "." a[n-1] "." a[n]
      return a[n-1] "." a[n]
    }
    FILENAME==ARGV[1] { spam[$1]=1; next }
    { d=reg($2); if (d in spam) pair[$1 SUBSEP d]=1 }
    END {
      for (k in pair) { split(k,q,SUBSEP); score[q[1]]++ }
      for (r in score) if (score[r] >= MINSCORE) printf "%s\t%d\n", r, score[r]
    }' "$tmp/spamdomains" "$tmp/owned" > "$tmp/linkfarm.owned" || true
  # Two different outcomes, counted apart: a repo whose own peers turned out not to be linking
  # the spam, and a repo we could not attribute at all. Both leave the plan, for different
  # reasons.
  nunreadable=$(sort -u "$tmp/owned-fail" | wc -l)
  nspared=$(( $(wc -l < "$tmp/linkfarm") - $(wc -l < "$tmp/linkfarm.owned") - nunreadable ))
  mv "$tmp/linkfarm.owned" "$tmp/linkfarm"
  [ "$nspared" -le 0 ] \
    || echo "# the link-farm rule (E): $nspared repo(s) spared, the spam links were pushed by peers" \
            "that are not their delegates"
  [ "$nunreadable" = 0 ] \
    || echo "# WARN: the link-farm rule (E): $nunreadable repo(s) spared," \
            "their delegates could not be read" >&2
fi

declare -A SIZE MTIME LIFE BIRTH NAME SEEDS EXCL SCANFAIL SPAM LINKSCORE MEDIA SHARED \
           FIRSTSEEN MEDIABYTES DELEGATES SIGNERS DENY_RID DENY_NID COPY COPYHELD COPYPCT COPYROW
while IFS=$'\t' read -r sz path; do SIZE[${path##*/}]=$sz; done < "$tmp/du"
while IFS=$'\t' read -r rid mt;   do MTIME[$rid]=${mt%.*}; done < "$tmp/mtimes"
# Anything that is not a plain number becomes 0, which the classify loop reads as "age
# unknown" and leaves the repo alone. The worker above already filters, so this is a second
# check: a non-number reaching an arithmetic comparison would leave a repo either
# unjudgeable or judged on nonsense.
ncoerced=0
while IFS=$'\t' read -r rid bt lf _ _ sg dl; do
  case $bt in ''|*[!0-9]*) bt=0; ncoerced=$((ncoerced + 1)) ;; esac
  case $lf in ''|*[!0-9]*) lf=0; ncoerced=$((ncoerced + 1)) ;; esac
  BIRTH[$rid]=$bt; LIFE[$rid]=$lf; DELEGATES[$rid]=$dl; SIGNERS[$rid]=$sg
done < "$tmp/lives"
# What the scan found to be ours or private and nothing above excluded yet. `rad ls` lists only
# repos this node seeds and can read, so a stopped seed explains an own one, but a release
# that changes its table would explain them all, so they are kept and named.
awk -F'\t' 'FILENAME == ARGV[1] { gone[$1] = 1; next }
            ($5 == "ours" || $5 == "private") && !($1 in gone) { print $1 "\t" $5 }' \
  "$tmp/excluded" "$tmp/lives" | sort > "$tmp/unlisted"
if [ -s "$tmp/unlisted" ]; then
  nunlisted=$(wc -l < "$tmp/unlisted")
  echo "# WARN: $nunlisted repo(s) are ours or private on disk, but '$RAD ls' did not list" \
       "them; they are kept. 'rad seed' the ones marked ours that you want, 'rad rm' what you" \
       "do not, or add them to $KEEP_FILE:" >&2
  head -n "$top_evidence" "$tmp/unlisted" | sed 's/^/#   /; s/\t/  /' >&2
  [ "$nunlisted" -le "$top_evidence" ] \
    || echo "#   ...and $((nunlisted - top_evidence)) more (PLAN_FULL=1 lists them)" >&2
  cut -f1 "$tmp/unlisted" | sort -u - "$tmp/excluded" > "$tmp/excluded.new"
  mv "$tmp/excluded.new" "$tmp/excluded"
fi
while read -r r; do DENY_RID[$r]=1; done < "$tmp/deny-rids"
while read -r r; do DENY_NID[$r]=1; done < "$tmp/deny-nids"
# Reaching this lock at all means the worker's filter let something through, and the repos it
# fires on go unjudged by every age rule. Silence there reads exactly like a clean scan.
[ "$ncoerced" = 0 ] \
  || echo "# WARN: $ncoerced repo date(s) were not numbers and were read as unknown," \
          "so those repos are outside the age rules; the ref scan may be broken" >&2
while IFS=$'\t' read -r rid nm _; do NAME[$rid]=$nm; done < "$tmp/meta-named"
while IFS=$'\t' read -r rid s;    do SEEDS[$rid]=$s; done < "$tmp/seeds"
while read -r r; do [ -n "$r" ] && EXCL[$r]=1; done < "$tmp/excluded"
declare -A PARDON=()
while read -r r; do [ -n "$r" ] && PARDON[$r]=1; done < "$tmp/undo-pardoned"
while read -r r; do [ -n "$r" ] && SCANFAIL[$r]=1; done < "$tmp/scanfail"
while read -r r; do [ -n "$r" ] && SPAM[$r]=1; done < "$tmp/spam"
while IFS=$'\t' read -r rid sc; do [ -n "$rid" ] && LINKSCORE[$rid]=$sc; done < "$tmp/linkfarm"
# When this seed first saw each repo. Every date inside a repo is set by whoever pushed it, so
# a spammer who rewrites all their refs resets the age rules D, E and F measure from. This
# ledger cannot be reached from outside, so those rules use whichever of the two is older.
# The file is appended to on every run, dry or not; without it the tool still works, on ref
# dates alone. Non-numeric timestamps are skipped rather than trusted: this file is appended to
# for years, and a crash mid-write leaves a torn last line that would otherwise reach an
# arithmetic comparison.
[ -r "$FIRST_SEEN" ] && while IFS=$'\t' read -r rid ts; do
  [ -n "$rid" ] || continue
  case $ts in ''|*[!0-9]*) continue ;; esac
  FIRSTSEEN[$rid]=$ts
done < "$FIRST_SEEN"
if mkdir -p "$AUDIT_DIR" 2>/dev/null && { : >> "$FIRST_SEEN"; } 2>/dev/null; then
  add_header "$FIRST_SEEN" \
    "The day this seed first saw each repo: repo id, then Unix time. It tells the spam-batch" \
    "(D), link-farm (E) and media (F) rules how old a repo really is. Deleting it leaves" \
    "them only the commit dates, which whoever pushed the repo can set to anything." \
    || echo "# WARN: could not add a header to $FIRST_SEEN; its rows are unaffected." >&2
  for rid in "${!SIZE[@]}"; do
    [ -n "${FIRSTSEEN[$rid]:-}" ] && continue
    FIRSTSEEN[$rid]=$now; printf '%s\t%s\n' "$rid" "$now" >> "$FIRST_SEEN"
  done
else
  echo "# WARN: cannot write $FIRST_SEEN; ages come from ref dates, which a pusher sets." >&2
fi

# The same file published again and again is evidence no single repo can manufacture. Blobs
# MEDIA_MIN_BATCH or more repos hold are a campaign, and per repo this adds up the bytes it
# keeps in them. Only repos with too little text to be spared by it are holders (the worker
# writes no others), so a stock icon that every real project ships does not make a campaign.
# The EARLIEST holder is left out of its own batch: without that, reposting somebody's photos
# into five repos of your own would put THEIR repo in the plan. Earliest is by first-seen, the
# one date a pusher cannot backdate, so on a seed whose ledger starts today the exemption falls
# to whichever repo sorts first until the ledger has some history.
# `|| true` because with rule F off no worker ran, so the glob below matches no file and
# sort exits non-zero on it, which under `pipefail` would end the run.
{ sort -u "$tmp/blobs"/* 2>/dev/null || true; } \
  | awk -F'\t' -v k="$MEDIA_MIN_BATCH" -v now="$now" -v seenfile="$FIRST_SEEN" '
      BEGIN { while ((getline line < seenfile) > 0) {
                split(line, f, "\t")
                if (f[2] ~ /^[0-9]+$/) seen[f[1]] = f[2]
              } }
      { n++; oid[n]=$1; rid[n]=$2; size[n]=$3; holders[$1]++
        age = ($2 in seen) ? seen[$2] : now
        if (!($1 in first) || age < firstage[$1]) { first[$1]=$2; firstage[$1]=age } }
      END { for (i=1;i<=n;i++)
              if (holders[oid[i]] >= k && rid[i] != first[oid[i]]) shared[rid[i]] += size[i]
            for (r in shared) printf "%s\t%.0f\n", r, shared[r] }' > "$tmp/media-shared"
while IFS=$'\t' read -r rid b; do [ -n "$rid" ] && SHARED[$rid]=$b; done < "$tmp/media-shared"

# Rule F decides here rather than in the scan, so the thresholds it uses sit next to every
# other rule's. A repo whose tree could not be listed never enters the map. MEDIA holds the
# verdict word, so the plan says which path reached the repo. Per repo the worker gives: media
# bytes, other bytes, image, video and audio bytes, how many files at the tips are neither
# media nor a README and how many are READMEs, how many bytes of media they hold ("-" for all
# three when not listed), and whether it saw a source file and a build file.
while IFS=$'\t' read -r rid mb ob av others readmes tipmedia src build; do
  [ -n "$rid" ] || continue
  [ "$mb" -ge "$MEDIA_MIN_BYTES" ] || continue
  MEDIABYTES[$rid]=$mb
  name=${NAME[$rid]:-}
  # A seed's logo, under a name like the seed's hostname. A name ending in a media extension,
  # such as wallpapers.png, is shaped like a hostname too, but it names a file. A repo this run
  # has no name for, because `rad ls` left it out or listed it twice, may be such a logo.
  if [ -z "$name" ] && [ "$mb" -lt "$MEDIA_HOST_MAX_BYTES" ]; then continue; fi
  if [[ ${name,,} =~ $MEDIA_HOST_NAME_RE ]] && [ "$mb" -lt "$MEDIA_HOST_MAX_BYTES" ]; then
    case "|$MEDIA_EXTS|" in
      (*"|${BASH_REMATCH[2]}|"*) ;;
      (*) continue ;;
    esac
  fi
  # On its own a repo has to carry no project at all: next to no text, or a README and nothing
  # else beside a great deal of media. Where other repos hold the very same files, a token
  # README no longer clears it. An archive among the media is a release more often than a
  # dump, so any archive spares the repo from the ratio path. The ratio weighs only the media
  # at the tips: a project whose branch holds a README, and whose issues hold its screen
  # recordings, is a project.
  archives=$((mb - av))
  is_ratio=0
  if [ "$others" = 0 ] && [ "$readmes" -le "$MEDIA_RATIO_MAX_FILES" ] \
     && [ "$archives" = 0 ] && [ "$tipmedia" -ge "$MEDIA_RATIO_MIN_BYTES" ] \
     && [ $((ob * 1000)) -lt $((tipmedia * MEDIA_RATIO_TEXT_PER_MILLE)) ]; then
    is_ratio=1
  fi
  if [ "$src" = 0 ] && [ "$build" = 0 ] && [ "$ob" -lt "$MEDIA_TEXT_MAX_BYTES" ]; then
    MEDIA[$rid]=media-dump
  elif [ "$src" = 0 ] && [ "$build" = 0 ] && [ "$is_ratio" = 1 ]; then
    MEDIA[$rid]=media-ratio
  elif [ "$build" = 0 ] && [ "$ob" -lt "$MEDIA_TEXT_CEIL_BYTES" ] \
       && [ "${SHARED[$rid]:-0}" -ge "$MEDIA_MIN_BYTES" ]; then
    MEDIA[$rid]=media-batch
  fi
done < "$tmp/media"
# No unset pass over media-fail: every worker path that writes a rid there continues before
# printing that repo's totals, so a failed repo is never in $tmp/media and never reached MEDIA.

# A copy of denied files has to clear both bars. The two measures are kept for every repo
# holding any, so the NEAR column can say which bar was close, and the whole row for the
# report. Only digits are let through, because these reach arithmetic inside the classify loop.
while IFS= read -r row; do
  IFS=$'\t' read -r rid held _ pct _ <<<"$row"
  [[ $held =~ ^[0-9]+$ && $pct =~ ^[0-9]+$ ]] || continue
  COPYHELD[$rid]=$held; COPYPCT[$rid]=$pct; COPYROW[$rid]=$row
  if [ "$held" -ge "$COPY_MIN_BYTES" ] && [ "$pct" -ge "$COPY_MIN_PCT" ]; then COPY[$rid]=1; fi
done < "$tmp/copies"

# ------------------------------------------------------------------- rule G: judge the peers
# Folds the per-repo evidence into one verdict per peer. The accusation is a single file, byte
# for byte, that this peer put into PARASITE_MIN_REPOS repos it is not a delegate of. Totals
# across different files are deliberately NOT enough on their own: someone active on many
# repos accumulates those honestly, while the same oid landing in unrelated repos does not
# happen by accident. A peer who is a delegate anywhere in storage is never accused, because
# blocking a delegate stops the repos they are a delegate of from replicating (the node
# filters delegate refs through the same block list before it checks the signature threshold).
: > "$tmp/parasites"; nunknown=0
if rule_on G && [ -s "$tmp/peer" ]; then
  nunknown=$(awk -F'\t' '$1 == "u"' "$tmp/peer" | sort -u | wc -l)
  awk -F'\t' -v k="$PARASITE_MIN_REPOS" -v minb="$PARASITE_MIN_BYTES" \
             -v maxt="$PARASITE_TEXT_MAX_BYTES" -v us="$OUR_NID" '
      $1 == "d" { delegate[$3] = 1; next }
      # One repo can list the same oid twice (two refs, one blob), so count each repo once.
      $1 == "b" { if (!((($3 SUBSEP $4) SUBSEP $2) in pair)) {
                    pair[($3 SUBSEP $4) SUBSEP $2] = 1; spread[$3 SUBSEP $4]++ }
                  next }
      # One peer, one repo, one row. Two rows for the same pair would double the byte totals
      # of that peer, and bytes are two of the three bars an accusation has to clear.
      $1 == "=" { if (($3 SUBSEP $2) in seen) next
                  seen[$3 SUBSEP $2] = 1
                  media[$3] += $4; other[$3] += $5
                  if ($4 > 0) repos[$3]++
                  next }
      END {
        for (key in spread) {
          split(key, f, SUBSEP)
          if (spread[key] > widest[f[1]]) { widest[f[1]] = spread[key]; worst[f[1]] = f[2] }
        }
        for (nid in widest) {
          if (nid == us || nid in delegate) continue
          if (widest[nid] < k || media[nid] < minb || other[nid] >= maxt) continue
          printf "%s\t%d\t%d\t%.0f\t%.0f\t%s\n",
                 nid, widest[nid], repos[nid], media[nid], other[nid], worst[nid]
        }
      }' "$tmp/peer" | sort -k2,2nr > "$tmp/parasites"
fi
nparasite=$(wc -l < "$tmp/parasites")

# -------------------------------------------------------- rule H: malware operations, judge
# Rows, one per repo hit, sorted: nid, repos hit, repos it signed, rid, the words matched, and
# the repo's name.
: > "$tmp/malware"
if rule_on H; then
  # The words each repo's name and description use, one row per repo that uses any: rid, the
  # words, whether one is strong, and the name. Words are matched whole, after cutting at every
  # character that is not a letter or a digit: as a substring, "rat" alone sits in a thousand
  # repo names. A word that misses is tried again without one trailing "s".
  awk -F'\t' -v strong="$MALWARE_STRONG_WORDS" -v weak="$MALWARE_WEAK_WORDS" '
    function known(list, key) { return index("|" list "|", "|" key "|") > 0 }
    function malware(word) { return word != "" && (known(strong, word) || known(weak, word)) }
    {
      text = tolower($2 " " $3); gsub(/[^a-z0-9]+/, " ", text); n = split(text, w, " ")
      split("", seen); found = ""; isstrong = 0
      for (i = 1; i <= n; i++) {
        word = w[i]
        if (!malware(word) && word ~ /s$/) word = substr(word, 1, length(word) - 1)
        if ((word in seen) || !malware(word)) continue
        seen[word] = 1; found = found (found == "" ? "" : ",") word
        if (known(strong, word)) isstrong = 1
      }
      if (found != "") printf "%s\t%s\t%d\t%s\n", $1, found, isstrong, $2
    }' "$tmp/meta-named" > "$tmp/malware-words"
  # Identities rule H leaves out. A delegate of a pinned, kept or our own repo is one this seed
  # already vouches for, the one who never signed there included, since the deny list would not
  # block them either. A private repo vouches for nobody: its delegates chose this seed, not
  # the other way round. An identity in the keep list was cleared by a person, and one the deny
  # list names is already dealt with.
  { cat "$tmp/pinned" "$tmp/own" "$tmp/kept"
    awk -F'\t' '$2 == "ours" { print $1 }' "$tmp/unlisted"; } | sort -u > "$tmp/vouched"
  { awk -F'\t' 'FILENAME == ARGV[1] { vouched[$1] = 1; next }
                ($1 in vouched) { n = split($7, d, ",")
                                  for (i = 1; i <= n; i++) print d[i] }' \
      "$tmp/vouched" "$tmp/lives"
    cat "$tmp/kept-nids" "$tmp/deny-nids"
    echo "$OUR_NID"; } | sort -u > "$tmp/malware-skip"
  # Each identity's repos, counted only where it is a delegate and signed refs of its own, so
  # naming somebody as a co-delegate of a malware repo does not put them here. Then the bars.
  awk -F'\t' -v minwords="$MALWARE_MIN_WORDS" -v minrepos="$MALWARE_MIN_REPOS" \
      -v share="$MALWARE_MIN_SHARE_PCT" '
    FILENAME == ARGV[1] { skip[$1] = 1; next }
    FILENAME == ARGV[2] { words[$1] = $2; strong[$1] = $3; name[$1] = $4; next }
    $6 != "-" {
      n = split($6, signer, ",")
      for (i = 1; i <= n; i++) {
        d = signer[i]
        if (d in skip) continue
        repos[d]++
        if (!($1 in words)) continue
        hits[d]++; row[d, hits[d]] = $1 "\t" words[$1] "\t" name[$1]
        if (strong[$1]) anystrong[d] = 1
        nw = split(words[$1], w, ",")
        for (j = 1; j <= nw; j++)
          if (!((d, w[j]) in counted)) { counted[d, w[j]] = 1; distinct[d]++ }
      }
    }
    END {
      for (d in hits) {
        if (!(d in anystrong) || distinct[d] < minwords || hits[d] < minrepos) continue
        if (hits[d] * 100 < repos[d] * share) continue
        for (i = 1; i <= hits[d]; i++)
          printf "%s\t%d\t%d\t%s\n", d, hits[d], repos[d], row[d, i]
      }
    }' "$tmp/malware-skip" "$tmp/malware-words" "$tmp/lives" \
    | sort -t$'\t' -k1,1 -k4,4 > "$tmp/malware"
fi
nmalware=$(cut -f1 "$tmp/malware" | sort -u | wc -l)

: > "$tmp/repos"   # rid \t size \t mtime \t life \t birth
for rid in "${!SIZE[@]}"; do
  printf '%s\t%s\t%s\t%s\t%s\n' \
    "$rid" "${SIZE[$rid]}" "${MTIME[$rid]:-0}" "${LIFE[$rid]:-0}" "${BIRTH[$rid]:-0}"
done > "$tmp/repos"
total_repos=$(wc -l < "$tmp/repos")

# percentiles for the relative size cut, and for the header line that prints them
read -r p50 p90 p95 p99 < <(cut -f2 "$tmp/repos" | sort -n | awk '
  {a[NR]=$1} END{
    i50=int(0.50*NR); if(i50<1)i50=1; i90=int(0.90*NR); if(i90<1)i90=1
    i95=int(0.95*NR); if(i95<1)i95=1; i99=int(0.99*NR); if(i99<1)i99=1
    printf "%d %d %d %d\n", a[i50], a[i90], a[i95], a[i99] }')
relcut=$(cut -f2 "$tmp/repos" | sort -n \
  | awk -v p="$eff_pctl" '{a[NR]=$1} END{ i=int(p/100*NR); if(i<1)i=1; print a[i] }')
abscut=$(( eff_abs_mb * 1024 * 1024 ))
echo "# repos=$total_repos  sizes P50=$((p50/1048576))M P90=$((p90/1048576))M" \
     "P95=$((p95/1048576))M P99=$((p99/1048576))M" \
     "rel-cut(P${eff_pctl})=$((relcut/1048576))M  abs-cut=${eff_abs_mb}M"

# ------------------------------------------------------------------ near-threshold markers
# A verdict that cleared its thresholds by a hair is the one a reviewer should read first, and
# nothing else in the plan distinguishes it from one that cleared by a mile. Each branch below
# reports what it measured through these helpers, which append a word to $near and always
# succeed, so no branch can end on a failed test and trip `set -e`. They are pure bash
# arithmetic, so a marker costs nothing per repo.
NEAR_PCT="${NEAR_PCT:-20}"        # % of the threshold that still counts as near; 0 marks none
near_age() {   # $1 = the date the rule measured, $2 = the instant it had to be older than
  [ "$NEAR_PCT" -gt 0 ] && [ "$2" -lt "$now" ] \
    && [ $(( (now - $1) * 100 )) -lt $(( (now - $2) * (100 + NEAR_PCT) )) ] \
    && near="$near+age"
  return 0
}
near_min() {   # $1 = the value measured, $2 = the minimum it had to reach, $3 = its label
  [ "$NEAR_PCT" -gt 0 ] && [ "$2" -gt 0 ] \
    && [ $(( $1 * 100 )) -lt $(( $2 * (100 + NEAR_PCT) )) ] \
    && near="$near+$3"
  return 0
}
near_max() {   # $1 = the value measured, $2 = the maximum it had to stay under, $3 = its label
  [ "$NEAR_PCT" -gt 0 ] && [ "$2" -gt 0 ] \
    && [ $(( $1 * 100 )) -gt $(( $2 * (100 - NEAR_PCT) )) ] \
    && near="$near+$3"
  return 0
}

# The columns of a plan row, spelled once for the two files that carry those rows out of the
# run. A reader of either file has to be able to tell field 4 from field 7, and a header that
# said something different from the other file's would be worse than none.
plan_header(){
  printf '# rid\tsize_bytes\tother_seeds\tlast_activity_unix\treason\tname'
  printf '\tage_from_unix\tnear_threshold\n'
}

# Rule A's word branch spares an imported project: one whose oldest commit is more than
# IMPORT_SPARE_DAYS older than its `rad init`. This prints that gap in seconds, or nothing when
# either date does not read. Author dates, because they survive a rebase or a conversion from
# another VCS. It walks every commit on the branches: 22 s on a 1.3M-commit mirror without a
# commit-graph, well under a second for most repos. Commit dates are the pusher's to set, so
# backdating spares a repo, which is harmless: rule A's word list catches people who forgot a
# repo, not people trying to keep one. --no-show-signature, because `git log` honours
# log.showSignature from the caller's config and would print a line before the date.
import_gap() {   # $1 = rid
  local d="$STORAGE/$1" init oldest
  init=$(GIT_DIR="$d" git log --no-show-signature --format=%ct --max-parents=0 refs/rad/id \
           2>/dev/null | sort -n | head -1) || true
  oldest=$(GIT_DIR="$d" git log --no-show-signature --branches --format=%at --max-parents=0 \
             2>/dev/null | sort -n | head -1) || true
  # Anything but digits would end the classify loop part-way through inside $(( )).
  [[ $init =~ ^[0-9]+$ && $oldest =~ ^[0-9]+$ ]] || return 0
  echo $(( init - oldest ))
}
import_cut=$(( IMPORT_SPARE_DAYS * 86400 ))
: > "$tmp/imports"   # rid \t name, for every repo the import spare kept
: > "$tmp/import-blind"   # junk-named repos whose commit dates did not read

# ------------------------------------------------ rule H: malware operations, one repo, judge
# The first file path at the tips of the canonical branches and tags, or else the first commit
# subject on them, holding a strong word whole or with one trailing "s". Canonical refs only,
# since a peer's namespace is anybody's to push to. Each distinct tree is listed once, branches
# before tags, and only the first MALWARE_TREES of them, so thousands of tags cost no more than
# a few and cannot push the branches out. Paths and subjects are whatever the repo's authors
# wrote, and the line found reaches the terminal, so control characters go first. awk stops at
# the first match and head at MALWARE_BYTES, the listing then stops on the broken pipe, and the
# caller ignores the status that leaves. Path quoting and subject encoding are pinned, because
# git takes both from the caller's config, and the same repo would read differently by user.
malware_evidence() {   # $1 = rid
  local d="$STORAGE/$1" tree
  { GIT_DIR="$d" git for-each-ref --format='%(objectname)^{tree}' refs/heads refs/tags \
        2>/dev/null \
      | GIT_DIR="$d" git cat-file --batch-check='%(objectname)' 2>/dev/null \
      | grep -E '^[0-9a-f]{40,64}$' | awk '!seen[$0]++' | head -n "$MALWARE_TREES" \
      | while read -r tree; do
          GIT_DIR="$d" git -c core.quotePath=true ls-tree -r --name-only "$tree" 2>/dev/null \
            | sed 's/^/path: /' \
            || break
        done
    GIT_DIR="$d" git log --no-show-signature --encoding=UTF-8 --branches --tags \
      --format='subject: %s' -n "$MALWARE_SUBJECTS" 2>/dev/null
  } | head -c "$MALWARE_BYTES" | LC_ALL=C tr -d '\000-\010\011\013-\037\177' \
    | LC_ALL=C sed $'s/\xc2\xc2*[\x80-\x9f][\x80-\x9f]*//g' \
    | awk -v strong="$MALWARE_STRONG_WORDS" '
      function known(list, key) { return key != "" && index("|" list "|", "|" key "|") > 0 }
      {
        text = tolower($0); gsub(/[^a-z0-9]+/, " ", text); n = split(text, w, " ")
        for (i = 1; i <= n; i++) {
          word = w[i]
          if (!known(strong, word) && word ~ /s$/) word = substr(word, 1, length(word) - 1)
          if (!known(strong, word)) continue
          # A long line is cut around the word, so what is shown still holds it. The space put
          # in front makes the first character a word boundary too.
          at = match(" " tolower($0), "[^a-z0-9]" word "s?([^a-z0-9]|$)")
          from = (at > 60) ? at - 40 : 1
          print (from > 1 ? "..." : "") substr($0, from, 100); exit
        }
      }'
}
# Rows: rid, the words in its name and description, the path or subject found, and the name.
# A repo the identity judge named is left to that review. The identities that judge leaves out
# keep the repos they signed refs in out of this one, and only those: anybody can name this
# seed's own identity in their document.
: > "$tmp/malware-repos"
: > "$tmp/malware-undated"   # the same rows, for repos whose commit dates did not read
if rule_on H; then
  malware_cut=$(( MALWARE_ORIGINAL_DAYS * 86400 ))
  cut -f4 "$tmp/malware" | sort -u > "$tmp/malware-named"
  while IFS=$'\t' read -r rid found isstrong rname; do
    [ "$isstrong" = 1 ] || continue
    [ -z "${EXCL[$rid]:-}" ] && [ -z "${DENY_RID[$rid]:-}" ] || continue
    grep -qxF "$rid" "$tmp/malware-named" && continue
    skipped=0
    IFS=, read -ra signers <<<"${SIGNERS[$rid]:-}"
    for sg in "${signers[@]}"; do grep -qxF "$sg" "$tmp/malware-skip" && skipped=1; done
    # A listed identity among its delegates, signed or not, has the deny list prune it.
    IFS=, read -ra dels <<<"${DELEGATES[$rid]:-}"
    for dl in "${dels[@]}"; do [ -n "${DENY_NID[$dl]:-}" ] && skipped=1; done
    [ "$skipped" = 0 ] || continue
    evidence=$(malware_evidence "$rid") || true
    [ -n "$evidence" ] || continue
    # The first commit's date is the pusher's to set, so backdating it keeps a repo off this
    # list. That costs a review list one entry, since rule H prunes nothing.
    gap=$(import_gap "$rid")
    row=$(printf '%s\t%s\t%s\t%s' "$rid" "$found" "$evidence" "$rname")
    if [ -z "$gap" ]; then printf '%s\n' "$row" >> "$tmp/malware-undated"; continue; fi
    [ "$gap" -le "$malware_cut" ] || continue
    printf '%s\n' "$row" >> "$tmp/malware-repos"
  done < "$tmp/malware-words"
fi
nmalware_repos=$(wc -l < "$tmp/malware-repos")
nmalware_undated=$(wc -l < "$tmp/malware-undated")
if [ "$nmalware_undated" -gt 0 ]; then
  echo "# WARN: $nmalware_undated repo(s) hold a strong malware word in the name or" \
       "description and in a file path or commit subject, but the malware rule (H) could not" \
       "read their commit dates to tell an original from a mirror. Read them. Adding a line below to" \
       "$DENY_FILE prunes and blocks its repo. In $KEEP_FILE the line keeps the repo and" \
       "clears all its delegates of the malware rule (H):" >&2
  head -n "$top_evidence" "$tmp/malware-undated" \
    | while IFS=$'\t' read -r rid found evidence rname; do
        printf '#   rad:%s  # %s (%s; %s)\n' "$rid" "$rname" "$found" "$evidence"
      done >&2
  [ "$nmalware_undated" -gt "$top_evidence" ] \
    && echo "#   ...and $((nmalware_undated - top_evidence)) more (PLAN_FULL=1 lists them)" >&2
fi

# ---------- classify (map lookups + native bash regex; git only for rule A's import spare)
: > "$tmp/plan"   # rid \t size \t seeds \t life \t reason \t name \t age_from \t near
: > "$tmp/media-review"
nblind=0; nfresh=0; nnoage=0
: > "$tmp/deny-kept"        # rid \t why, for every denied repo an exclusion kept
: > "$tmp/deny-nids-kept"   # listed identities that delegate one of those kept repos
: > "$tmp/deny-why"         # rid \t why, for every denied repo in the plan
: > "$tmp/copy-why"         # the $tmp/copies row of every copy in the plan
while IFS=$'\t' read -r rid sz mt life birth; do
  # The deny list comes first, because it asks nothing the checks below exist to establish: no
  # readable size, no age, no settled fetch. A listed identity condemns only the repos it is a
  # DELEGATE of. A stranger's namespace inside somebody else's repo does not count, or anyone
  # could get a repo pruned by commenting on it from an identity already on the list.
  denied=""
  [ -n "${DENY_RID[$rid]:-}" ] && denied="listed"
  IFS=, read -ra dls <<<"${DELEGATES[$rid]:-}"
  # A repo listed by id keeps "listed" as its cause even when a delegate is listed too.
  for nid in "${dls[@]}"; do
    [ -z "$denied" ] || break
    [ -n "${DENY_NID[$nid]:-}" ] && denied="delegate $nid"
  done
  if [ -n "$denied" ]; then
    if [ -n "${EXCL[$rid]:-}" ]; then
      printf '%s\t%s\n' "$rid" "$denied" >> "$tmp/deny-kept"
      # Blocking a delegate stops their repos receiving updates, this kept one included, so
      # every listed delegate of it is spared the block as well.
      for nid in "${dls[@]}"; do
        [ -n "${DENY_NID[$nid]:-}" ] && printf '%s\n' "$nid" >> "$tmp/deny-nids-kept"
      done
    else
      dname=${NAME[$rid]:-}; [ -z "$dname" ] && dname='(?)'
      # Column 7 is the date the verdict measured age from. The deny list measures none, so
      # it is 0, which the plan prints as "-" rather than as an age nobody measured.
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$rid" "${sz:-0}" "${SEEDS[$rid]:-0}" "$life" "denied" "$dname" 0 "" \
        >> "$tmp/plan"
      printf '%s\t%s\n' "$rid" "$denied" >> "$tmp/deny-why"
    fi
    continue
  fi
  [ -n "${PARDON[$rid]:-}" ] && continue              # wrongly pruned before (UNDO_PARDON)
  # A copy of files a denied repo carried. It asks for no age and no settled fetch either:
  # what condemns it is files on its own delegates' branches, and a copy of a leak is worth
  # catching in the week it lands. It is the tool's inference, not a person's verdict, so it
  # gets a reason of its own, which the runaway caps and the ratchet both count.
  if [ -n "${COPY[$rid]:-}" ]; then
    if [ -n "${EXCL[$rid]:-}" ]; then
      # A repo put back with "quarantine restore" is a person overruling this inference, which
      # is not worth a warning every week. A pinned, private or own one is named.
      grep -qxF "$rid" "$tmp/kept" \
        || printf '%s\t%s\n' "$rid" "copy of denied files" >> "$tmp/deny-kept"
    else
      dname=${NAME[$rid]:-}; [ -z "$dname" ] && dname='(?)'
      near=""
      near_min "${COPYHELD[$rid]}" "$COPY_MIN_BYTES" bytes
      near_min "${COPYPCT[$rid]}" "$COPY_MIN_PCT" share
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$rid" "${sz:-0}" "${SEEDS[$rid]:-0}" "$life" "denied-copy" "$dname" 0 \
        "${near:+${near#+}}" >> "$tmp/plan"
      printf '%s\n' "${COPYROW[$rid]}" >> "$tmp/copy-why"
    fi
    continue
  fi
  [ -n "${SCANFAIL[$rid]:-}" ] && { nblind=$((nblind+1)); continue; }  # size and age unusable
  [ -n "${EXCL[$rid]:-}" ] && continue                # pinned / private / own
  # Freshness is read before age, because a repo whose fetch is still in flight has no refs
  # yet and would otherwise count as ageless against the scan guard below.
  [ "$mt" -ge "$fresh_cut" ] && { nfresh=$((nfresh+1)); continue; }   # in-flight fetch
  [ "$life" = 0 ] && { nnoage=$((nnoage+1)); continue; }               # unknown age: leave it

  # Rules D, E and F measure age from here: the older of the repo's own oldest ref date and
  # the day this seed first saw it. A pusher controls the first and cannot reach the second.
  origin=$birth
  [ -n "${FIRSTSEEN[$rid]:-}" ] && [ "${FIRSTSEEN[$rid]}" -lt "$origin" ] \
    && origin=${FIRSTSEEN[$rid]}

  name=${NAME[$rid]:-}; [ -z "$name" ] && name='(?)'
  seeds=${SEEDS[$rid]:-0}

  lname=${name,,}
  # The two branches cannot both match, because no word in JUNK_WORD_REGEX is spellable in
  # [0-9a-f] alone, so a pure-hex name never hits the word regex. Order here is for reporting,
  # not logic. Adding a hex-spellable word to that list (dead, beef, cafe) would break the
  # assumption.
  is_junk=0     # a disposable WORD in the name: a guess, so it keeps the last-copy floor
  is_junkid=0   # the name is ONLY a random hex id: generated, so it may prune the last copy
  if [[ $lname =~ $JUNK_WORD_REGEX ]] || [[ $lname =~ $JUNK_EXACT_REGEX ]]; then is_junk=1; fi
  if [ "$JUNK_ID_MIN_LEN" -gt 0 ] && [ "${#lname}" -ge "$JUNK_ID_MIN_LEN" ] \
     && [[ $lname =~ ^[0-9a-f]+$ ]] && [[ $lname =~ [a-f] ]] && [[ $lname =~ [0-9] ]]; then
    is_junkid=1
  fi
  # A disposable word in the name of a project that predates its `rad init` is no evidence it
  # was thrown away. Asked of every repo the word branch's other tests would let through, since
  # it reads the repo's history; rules D, E and F below may still prune some of them first.
  gap=""; is_import=0
  if [ "$is_junk" = 1 ] && rule_on A && [ "$life" -lt "$junk_cut" ] \
     && [ "$seeds" -ge "$JUNK_MIN_SEEDS" ]; then
    gap=$(import_gap "$rid")
    if [ -z "$gap" ]; then printf '%s\n' "$rid" >> "$tmp/import-blind"
    elif [ "$gap" -gt "$import_cut" ]; then is_import=1; fi
  fi
  is_big=0; [ "$sz" -gt "$abscut" ] && [ "$sz" -ge "$relcut" ] && is_big=1

  reason=""
  # D, E and F come first, so a repo the corpus shows to be generated bulk or to be selling
  # links, or whose own tree is nothing but media, reads as that rather than as ordinary
  # staleness.
  #
  # They measure $origin. None of their evidence is about time, so the window is only a grace
  # period in case the evidence was wrong, and measured from LAST ACTIVITY that grace period
  # never expires: the spammer appends a COB to their own repos every few days and resets it.
  #
  # $age_from records the date the matching rule measured, so the plan's AGE column explains
  # its own verdict. Without it a spam-batch row touched yesterday prints AGE 1 beside a 7-day
  # minimum.
  #
  # Each branch asks rule_on first, so a rule left out of RULES cannot claim a repo and then
  # have its row dropped later: that would hide the repo from the rules still running. Rule D
  # needs this most, because its corpus scan runs even when D is off, since rule E reads it.
  age_from=$life
  near=""
  if   rule_on D && [ -n "${SPAM[$rid]:-}" ] && [ "$origin" != 0 ] \
       && [ "$origin" -lt "$spam_cut" ] && [ "$seeds" -ge "$SPAM_MIN_SEEDS" ]; then
    reason="spam-batch"; age_from=$origin
    near_age "$origin" "$spam_cut"; near_min "$seeds" "$SPAM_MIN_SEEDS" seeds
  elif rule_on E && [ -n "${LINKSCORE[$rid]:-}" ] && [ "$origin" != 0 ] \
       && [ "$origin" -lt "$link_cut" ] && [ "$seeds" -ge "$LINK_MIN_SEEDS" ]; then
    reason="link-farm"; age_from=$origin
    near_age "$origin" "$link_cut"; near_min "$seeds" "$LINK_MIN_SEEDS" seeds
    near_min "${LINKSCORE[$rid]}" "$LINK_MIN_SCORE" score
  elif rule_on F && [ -n "${MEDIA[$rid]:-}" ] && [ "$origin" != 0 ] \
       && [ "$origin" -lt "$media_cut" ] && [ "$seeds" -ge "$MEDIA_MIN_SEEDS" ]; then
    reason=${MEDIA[$rid]}; age_from=$origin
    near_age "$origin" "$media_cut"; near_min "$seeds" "$MEDIA_MIN_SEEDS" seeds
    near_min "${MEDIABYTES[$rid]}" "$MEDIA_MIN_BYTES" media
  elif rule_on A && [ "$is_junkid" = 1 ] && [ "$life" -lt "$junk_cut" ] \
       && [ "$seeds" -ge "$JUNK_ID_MIN_SEEDS" ]; then
    reason="junk-id"
    near_age "$life" "$junk_cut"; near_min "$seeds" "$JUNK_ID_MIN_SEEDS" seeds
  elif rule_on A && [ "$is_junk" = 1 ] && [ "$life" -lt "$junk_cut" ] \
       && [ "$seeds" -ge "$JUNK_MIN_SEEDS" ] && [ "$is_import" = 0 ]; then
    reason="junk-name"
    near_age "$life" "$junk_cut"; near_min "$seeds" "$JUNK_MIN_SEEDS" seeds
    near_max "${gap:-0}" "$import_cut" import
  elif rule_on B && [ "$is_big" = 1 ] && [ "$life" -lt "$outlier_cut" ] \
       && [ "$seeds" -ge "$eff_seeds" ]; then
    reason="size-outlier"
    near_age "$life" "$outlier_cut"; near_min "$seeds" "$eff_seeds" seeds
    # Both size bars have to be cleared, so the tighter of the two is the one worth reporting.
    if [ "$abscut" -gt "$relcut" ]; then near_min "$sz" "$abscut" size
    else                                 near_min "$sz" "$relcut" size; fi
  elif rule_on C && [ "$life" -lt "$stale_cut" ] && [ "$seeds" -ge "$eff_seeds" ]; then
    reason="stale"
    near_age "$life" "$stale_cut"; near_min "$seeds" "$eff_seeds" seeds
  fi
  # What a raised MEDIA_MIN_SEEDS spared, listed rather than passed over in silence, because a
  # seed floor nobody sees is a standing exemption for anyone who makes sure nobody else seeds
  # their dump. Empty at the default floor of 0, where nothing is spared for want of a seed.
  # Only repos nothing else prunes are listed, so the line can say they were kept.
  if [ -z "$reason" ] && rule_on F && [ -n "${MEDIA[$rid]:-}" ] && [ "$origin" != 0 ] \
     && [ "$origin" -lt "$media_cut" ] && [ "$seeds" -lt "$MEDIA_MIN_SEEDS" ]; then
    printf '%s\t%s\t%s\n' "$rid" "${MEDIA[$rid]}" "$name" >> "$tmp/media-review"
  fi
  # Listed only when no other rule matched the repo, so the list can say it was kept.
  if [ -z "$reason" ] && [ "$is_import" = 1 ]; then
    printf '%s\t%s\n' "$rid" "$name" >> "$tmp/imports"
  fi
  [ -z "$reason" ] && continue
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$rid" "$sz" "$seeds" "$life" "$reason" "$name" "$age_from" "${near:+${near#+}}" \
    >> "$tmp/plan"
done < "$tmp/repos"

# A scan that missed a big share of storage produces a small plan, not an accurate one, and a
# small plan reads like good news. Refuse to report one. Three ways to miss a repo, equally
# blind: it vanished mid-walk and never reached $tmp/repos, find or du failed on it so its
# numbers are untrustworthy, or its refs would not list, which leaves it ageless and outside
# every age rule. Ageless belongs in this sum at the same limit as the other two: it is not a
# background rate, and four weekly runs over a 12.5k-repo seed each reported zero of it.
echo "# skipped: $nblind unreadable, $nfresh written in the last ${FRESH_GUARD_DAYS}d," \
     "$nnoage with no readable refs"
# Rule A's import spare reads each candidate's history, and a repo where that read failed is
# treated as though it had no history before its `rad init`. Named, so it can be checked by hand.
nimportblind=$(wc -l < "$tmp/import-blind")
if [ "$nimportblind" -gt 0 ]; then
  echo "# WARN: could not read the commit dates of $nimportblind junk-named repo(s), so the" \
       "junk-name rule (A) treats them as not imported:" >&2
  head -n "$top_evidence" "$tmp/import-blind" | sed 's/^/#   /' >&2
  [ "$nimportblind" -gt "$top_evidence" ] \
    && echo "#   ...and $((nimportblind - top_evidence)) more (PLAN_FULL=1 lists them)" >&2
fi
# Two people's words disagree here, and the one that keeps the repo wins, since a prune is the
# one of the two that cannot be taken back. Named, so the disagreement gets settled by hand.
if [ -s "$tmp/deny-kept" ]; then
  echo "# WARN: $(wc -l < "$tmp/deny-kept") repo(s) on the deny list or holding copies of" \
       "denied files are kept anyway, because they are pinned, private, our own or in" \
       "$KEEP_FILE:" >&2
  sed 's/^/#   /; s/\t/  /' "$tmp/deny-kept" >&2
fi
# A repo can reach $tmp/repos without being one of the directories counted at the top of the
# walk, so this subtraction can come out below zero and must not then credit the scan.
vanished=$(( nrepos - total_repos )); [ "$vanished" -lt 0 ] && vanished=0
blind=$(( vanished + nblind + nnoage ))
[ "$blind" -le $(( nrepos * MAX_SCAN_FAIL_PCT / 100 )) ] || {
  echo "# ABORT($mode): could not judge $blind of $nrepos repos" \
       "(limit ${MAX_SCAN_FAIL_PCT}%):" \
       "$vanished vanished, $nblind unreadable," \
       "$nnoage with no readable refs." >&2
  echo "# A plan from a scan this blind would look small for the wrong reason." >&2
  echo "# The three counts come from find, du and git, so check those first. To let a run go" \
       "ahead over a storage that is genuinely like this: MAX_SCAN_FAIL_PCT=<percent>." >&2
  exit 5
}

# -------------------------------------------------------------------------------------- report
sort -t$'\t' -k2,2nr "$tmp/plan" > "$tmp/plan.sorted"
nplan=$(wc -l < "$tmp/plan.sorted")
bytes=$(awk -F'\t' '{s+=$2} END{printf "%.0f", s}' "$tmp/plan.sorted")
gib=$(awk -v b="$bytes" 'BEGIN{printf "%.2f", b/1073741824}')

# ------------------------------------------------------------------------- the history ratchet
# Each rule's share of the plan is measured against the median of what that rule pruned in the
# last RATCHET_RUNS applied runs, and a rule over RATCHET_FACTOR times that is held back. It is
# per rule so that one rule's wave holds back that rule alone: the others' verdicts are as sound
# as they were the week before, and a whole-plan ratchet would make them wait for a human too.
#
# The past comes from the audit logs history.log names, since those list every verdict an
# applied run acted on with its reason. Only worked out here, so a dry run can show it; whether
# it holds anything back is decided at apply time, where --force and an interactive yes both
# get past it.
#
# Which rule each verdict belongs to. spam-family is rule D's verdict under an older name, still
# in audit logs written before it was renamed. A reason missing here is ratcheted on its own,
# under its own name, so a new verdict is never one the ratchet cannot see.
RULE_OF_REASON="junk-name:A junk-id:A size-outlier:B stale:C"
RULE_OF_REASON="$RULE_OF_REASON spam-batch:D spam-family:D link-farm:E"
RULE_OF_REASON="$RULE_OF_REASON media-dump:F media-ratio:F media-batch:F"
# rule \t how many verdicts that rule has in the file named by $1, one line per rule.
count_by_rule() {
  awk -F'\t' -v map="$RULE_OF_REASON" '
    BEGIN { n = split(map, pairs, " ")
            for (i = 1; i <= n; i++) { split(pairs[i], kv, ":"); rule[kv[1]] = kv[2] } }
    # A denied repo is a verdict a person already reviewed, so it is never held back for one.
    !/^#/ && NF >= 5 && $5 != "denied" { c[($5 in rule) ? rule[$5] : $5]++ }
    END { for (r in c) printf "%s\t%d\n", r, c[r] }' "$1" | sort
}

# Logs that were rotated or deleted are skipped before the last RATCHET_RUNS are taken, so the
# baseline is the most recent past that can still be read. Said out loud, since a ratchet with
# fewer than three logs holds nothing back.
grep -oE 'audit=[^[:space:]]+' "$AUDIT_DIR/history.log" 2>/dev/null | sed 's/^audit=//' \
  > "$tmp/ratchet-named" || true
while IFS= read -r log; do
  [ -r "$AUDIT_DIR/$log" ] && printf '%s\n' "$AUDIT_DIR/$log"
done < "$tmp/ratchet-named" | tail -n "$RATCHET_RUNS" > "$tmp/ratchet-logs" || true
nratchet=$(wc -l < "$tmp/ratchet-logs")
tail -n "$RATCHET_RUNS" "$tmp/ratchet-named" > "$tmp/ratchet-recent"
nrecent=$(wc -l < "$tmp/ratchet-recent")
ngone=0
while IFS= read -r log; do
  [ -r "$AUDIT_DIR/$log" ] || ngone=$((ngone + 1))
done < "$tmp/ratchet-recent"
[ "$ngone" = 0 ] \
  || echo "# WARN: cannot read $ngone of the $nrecent most recent audit logs history.log" \
          "names. They tell an unattended run what each rule usually prunes, so it now goes" \
          "by $nratchet, older ones filling in, and with fewer than 3 holds nothing back." >&2

# rule \t repos, one line per past run and rule this run plans. A run in which a rule pruned
# nothing counts as 0, because that is part of what the rule usually does. A run in which the
# rule was off, or held back, is no sample at all: it pruned none of that rule's verdicts
# because it was not allowed to, and counting that as 0 would pull the usual down every week
# the rule waits, until the ratchet held even an ordinary week. Audit logs older than 0.8.0 do
# not say which rules were on, and are read as all of them.
# A repo this tool pruned before and pruned again, after an undo let it back, is no sign that a
# rule went wrong, so it does not count towards a hold. The runaway caps still count it.
awk -F'\t' 'FILENAME == ARGV[1] { before[$1] = 1; next } !($1 in before)' \
  "$tmp/undo-pruned-before" "$tmp/plan.sorted" > "$tmp/plan.new-verdicts"
count_by_rule "$tmp/plan.new-verdicts" > "$tmp/ratchet-planned"
: > "$tmp/ratchet-past"
while IFS= read -r log; do
  rules_then=$(sed -n '/^# [0-9].*  rules=/ { s/.*  rules=//p; q }' "$log")
  count_by_rule "$log" > "$tmp/ratchet-onelog"
  while IFS=$'\t' read -r letter _; do
    case $letter in
      [A-Z]) [ -z "$rules_then" ] || [[ $rules_then == *$letter* ]] || continue ;;
    esac
    grep -q "^# held back: rule $letter," "$log" && continue
    past=$(awk -F'\t' -v l="$letter" '$1 == l { print $2 }' "$tmp/ratchet-onelog")
    printf '%s\t%s\n' "$letter" "${past:-0}" >> "$tmp/ratchet-past"
  done < "$tmp/ratchet-planned"
done < "$tmp/ratchet-logs"

# rule \t planned \t usual \t limit, for every rule this run would hold back. Fewer than three
# past runs is no baseline at all, and then nothing is held. --force holds nothing either, so
# nothing here claims a hold that will not happen.
#
# A rule with fewer than three samples of its own, one that was off or held for most of the
# window, has a usual of 0, so RATCHET_FLOOR is its limit. Its median would otherwise come from
# one or two runs, and the one forced run that let a held wave through would set a limit three
# times that wave.
: > "$tmp/held"
if [ "$nratchet" -ge 3 ] && [ "$FORCE" = 0 ]; then
  while IFS=$'\t' read -r letter planned; do
    usual=$(awk -F'\t' -v l="$letter" '$1 == l { print $2 }' "$tmp/ratchet-past" | sort -n \
            | awk '{ v[NR] = $1 }
                   END { if (NR < 3) print 0
                         else if (NR % 2) print v[(NR + 1) / 2]
                         else print int((v[NR / 2] + v[NR / 2 + 1]) / 2) }')
    limit=$(( usual * RATCHET_FACTOR ))
    [ "$limit" -ge "$RATCHET_FLOOR" ] || limit=$RATCHET_FLOOR
    if [ "$planned" -gt "$limit" ]; then
      printf '%s\t%s\t%s\t%s\n' "$letter" "$planned" "$usual" "$limit" >> "$tmp/held"
    fi
  done < "$tmp/ratchet-planned"
fi

# One awk for the whole table rather than one per row: a plan can run to hundreds of lines.
# It makes two passes: the first counts each verdict so the second knows what to fold.
awk -F'\t' -v now="$now" -v collapse="$PLAN_COLLAPSE_ROWS" -v full="$PLAN_FULL" '
     function size(b,   s, u, a, i) {
       s = b; u = "B"; split("KB MB GB", a, " ")
       for (i = 1; i <= 3 && s >= 1024; i++) { s /= 1024; u = a[i] }
       return sprintf("%.1f%s", s, u)
     }
     # The corpus verdicts. Each one is decided by a pattern across MANY repos, so reading its
     # rows one by one tells a reader nothing the group line does not already say.
     BEGIN { split("spam-batch link-farm media-batch", c, " ")
             for (i = 1; i in c; i++) corpus[c[i]] = 1 }
     NR == FNR { n[$5]++; b[$5] += $2; if ($8 != "") near[$5]++; next }
     FNR == 1 { for (r in n) if (corpus[r] && !full && n[r] >= collapse) fold[r] = 1
                printf "\n%-34s %9s %6s %8s %-13s %-15s %s\n",
                       "RID", "SIZE", "SEEDS", "AGE(d)", "REASON", "NEAR", "NAME" }
     { if ($5 in fold) next
       printf "%-34s %9s %6s %8s %-13s %-15s %s\n",
              $1, size($2), $3, ($7 == 0 ? "-" : int((now - $7) / 86400)), $5,
              ($8 == "" ? "-" : $8), $6 }
     # In the order c was split, not `for (r in fold)`: awk leaves that order unspecified, and
     # a plan that prints its rows differently from one run to the next cannot be diffed.
     END { for (i = 1; i in c; i++) if (c[i] in fold)
             printf "%-34s %9s %6s %8s %-13s %-15s %s\n",
                    sprintf("(%d repos)", n[c[i]]), size(b[c[i]]), "", "", c[i],
                    sprintf("%d near", near[c[i]] + 0),
                    "same pattern across many repos; PLAN_FULL=1 lists them"
     }' "$tmp/plan.sorted" "$tmp/plan.sorted"

# Not a plan line: rule F saw the evidence and the seed floor held it back. A human decides.
nreview=$(wc -l < "$tmp/media-review")
if [ "$nreview" -gt 0 ]; then
  echo
  echo "# review: $nreview media dump(s) no other node seeds, kept:"
  head -n "$top_evidence" "$tmp/media-review" \
    | awk -F'\t' '{printf "#   %-34s %-12s %s\n", $1, $2, $3}'
  [ "$nreview" -gt "$top_evidence" ] \
    && echo "#   ...and $((nreview - top_evidence)) more (PLAN_FULL=1 lists them)"
fi
nimports=$(wc -l < "$tmp/imports")
if [ "$nimports" -gt 0 ]; then
  echo
  echo "# kept as imports: $nimports junk-named repo(s) with history from before their rad init:"
  head -n "$top_evidence" "$tmp/imports" | awk -F'\t' '{printf "#   %-34s %s\n", $1, $2}'
  [ "$nimports" -gt "$top_evidence" ] \
    && echo "#   ...and $((nimports - top_evidence)) more (PLAN_FULL=1 lists them)"
fi
# What each copy holds and where its files came from, which the plan row cannot say.
ncopies=$(wc -l < "$tmp/copy-why")
if [ "$ncopies" -gt 0 ]; then
  echo
  echo "# copies of denied files: $ncopies repo(s) in the plan:"
  head -n "$top_evidence" "$tmp/copy-why" \
    | awk -F'\t' '{ others = ($7 > 0) ? sprintf(" and %d other source(s)", $7) : ""
                    printf "#   %-34s %.1f MiB in %d file(s), %d%% of the bytes on its" \
                           " branches, from %s%s\n", $1, $2 / 1048576, $5, $4, $6, others }'
  [ "$ncopies" -gt "$top_evidence" ] \
    && echo "#   ...and $((ncopies - top_evidence)) more (PLAN_FULL=1 lists them)"
fi

echo
# The plan promises only what the run will actually deliver, and says it the same way the DONE
# line below does. Under quarantine no disk is freed today, so a forecast saying "reclaim"
# would be an overclaim, and one saying "the disk comes back then" leaves a reader working out
# both when and from where.
if [ "$QUARANTINE" = 1 ]; then
  echo "# PLAN: prune $nplan repos, ${gib} GiB out of storage but still on disk" \
       "for ${QUARANTINE_DAYS}d, until a later --apply run deletes them"
else
  echo "# PLAN: prune $nplan repos, reclaim ${gib} GiB"
fi
awk -F'\t' '{ c[$5]++; b[$5]+=$2 }
     END { for (r in c) printf "#   %-13s %5d repos  %8.2f GiB\n",
                               r, c[r], b[r]/1073741824 }' "$tmp/plan.sorted" | sort
# Says which rows to read first. Without it the NEAR column is only visible to somebody who
# already scrolled the whole table, which on a plan of hundreds of rows is nobody.
nnear=$(awk -F'\t' '$8 != ""' "$tmp/plan.sorted" | wc -l)
[ "$nnear" = 0 ] \
  || echo "#   $nnear of them cleared a threshold by under ${NEAR_PCT}%: see the NEAR column,"\
          "which names the threshold that was close. Read those rows first."
# Printed by a dry run too, which is when an operator decides whether to let a wave through.
if [ -s "$tmp/held" ]; then
  echo "#   HELD BACK unless --force or a yes at the prompt, as each rule is far over its usual:"
  while IFS=$'\t' read -r letter planned usual limit; do
    echo "#     $(rule_label "$letter"): $planned repos, where its median over the last" \
         "$nratchet runs is $usual a run (limit $limit)"
  done < "$tmp/held"
fi

# What deny_block_ahead will block under --apply, printed by a dry run too: a block lands with
# no row in the plan above, so without this a dry run would not show it.
: > "$tmp/deny-ahead"
while IFS= read -r id; do
  [ -d "$STORAGE/$id" ] || grep -qxF "$id" "$tmp/excluded" || printf 'rad:%s\n' "$id"
done < "$tmp/deny-rids" >> "$tmp/deny-ahead"
grep -vxF -f "$tmp/deny-nids-kept" "$tmp/deny-nids" >> "$tmp/deny-ahead" || true
if [ -s "$tmp/deny-ahead" ]; then
  echo "#   deny list: block $(wc -l < "$tmp/deny-ahead") id(s), unless already blocked:"
  head -n "$top_evidence" "$tmp/deny-ahead" | sed 's/^/#     /'
  nmore=$(( $(wc -l < "$tmp/deny-ahead") - top_evidence ))
  [ "$nmore" -le 0 ] || echo "#     ...and $nmore more (PLAN_FULL=1 lists them)"
fi

# Rule G's verdicts are about peers, so they get their own section rather than a row in the
# plan: nothing here deletes a repo, and blocking one peer touches every repo at once.
if [ "$nparasite" -gt 0 ]; then
  echo
  echo "# PARASITE PEERS: $nparasite, from the parasite-peer rule (G)"
  echo "#   the count is repos reached by ONE file of theirs, not repos they touched"
  while IFS=$'\t' read -r nid widest npeerrepos mb ob oid; do
    printf '#   %s  %3d repos  %6.1f MB media  %6d B text  blob %s\n' \
           "$nid" "$widest" "$(awk -v b="$mb" 'BEGIN{printf "%.1f", b/1048576}')" \
           "$ob" "${oid:0:12}"
  done < "$tmp/parasites"
  [ "$nunknown" = 0 ] \
    || echo "#   NB: $nunknown repo(s) had an unreadable identity, so a peer who delegates" \
            "one of those was not spared by the delegate check."
  # Printed whether or not --block-peers was passed, so the operator can act on one peer
  # without handing the tool a standing licence over the whole list.
  echo "#   Blocking is permanent, invisible to the peer, and applies to every repo at once."
  echo "#   Check the evidence first, then run whichever of these you agree with:"
  cut -f1 "$tmp/parasites" | sed 's/^/#     rad block /'
  echo "#   Or --block-peers, which asks for each peer; add --yes to answer for them."
fi

# Rule H judges an identity, and a person decides what happens to it: the deny list both prunes
# its repos and blocks it, so the review points there.
if [ "$nmalware" -gt 0 ]; then
  echo
  echo "# REVIEW, MALWARE OPERATIONS: $nmalware identity(s), from the malware rule (H)." \
       "Nothing here is pruned or blocked."
  echo "#   repos named or described like a malware operation; read them before acting"
  for nid in $(cut -f1 "$tmp/malware" | sort -u); do
    grep "^$nid"$'\t' "$tmp/malware" > "$tmp/malware-one"
    IFS=$'\t' read -r _ nhit nall _ < "$tmp/malware-one"
    printf '#   %s, %d of the %d repos it is a delegate of and signed refs in:\n' \
           "$nid" "$nhit" "$nall"
    head -n "$top_evidence" "$tmp/malware-one" \
      | while IFS=$'\t' read -r _ _ _ rid found rname; do
          printf '#       rad:%s  # %s (%s)\n' "$rid" "$rname" "$found"
        done
    if [ "$nhit" -gt "$top_evidence" ]; then
      echo "#       ...and $((nhit - top_evidence)) more (PLAN_FULL=1 lists them)"
    fi
  done
  echo "#   last-run/H-malware-identities.tsv lists every matching repo. Adding an identity's"
  echo "#   line to $DENY_FILE prunes every repo the identity is a delegate of except private"
  echo "#   ones, and blocks the identity unless it is a delegate of a private repo. The same"
  echo "#   line in $KEEP_FILE stops the identity being named and keeps none of its repos:"
  cut -f1 "$tmp/malware" | sort -u | sed 's/^/#     did:key:/'
fi
# Each line is the one to act on: the deny list and the keep list both read what follows a #
# as a comment, so the evidence rides along when a line is copied.
if [ "$nmalware_repos" -gt 0 ]; then
  echo
  echo "# REVIEW, MALWARE REPOS: $nmalware_repos repo(s), from the malware rule (H). Nothing here is pruned" \
       "or blocked."
  echo "#   a strong word in the name or description, one in a file path or commit subject,"
  echo "#   and a history that starts with the repo; read them before acting. Adding a line"
  echo "#   below to $DENY_FILE prunes and blocks its repo. In $KEEP_FILE the line stops the"
  echo "#   repo being named, keeps it out of every rule, and clears all its delegates of"
  echo "#   the malware rule (H), including any who never signed it:"
  head -n "$top_evidence" "$tmp/malware-repos" \
    | while IFS=$'\t' read -r rid found evidence rname; do
        printf '#     rad:%s  # %s (%s; %s)\n' "$rid" "$rname" "$found" "$evidence"
      done
  if [ "$nmalware_repos" -gt "$top_evidence" ]; then
    echo "#     ...and $((nmalware_repos - top_evidence)) more in" \
         "last-run/H-malware-repos.tsv (PLAN_FULL=1 lists them)"
  fi
fi

# What the report above printed is trimmed to what a terminal can hold: corpus verdicts folded
# to one line, five spam domains out of a hundred and fifty. The lists it was rendered from go
# out whole here, so the evidence behind a verdict outlives the scroll buffer and can be read
# by something other than a human. Written by a dry run as much as by an apply, since a dry run
# is exactly when somebody is deciding whether the verdicts are right.
#
# Overwritten every run rather than kept per run: a directory of them grows without bound on a
# weekly cron, and a run that changes anything already leaves a dated audit log behind.
#
# Every write here is checked and none of them is allowed to end the run. This directory sits
# on the filesystem storage is on, and this tool is what runs when that filesystem is filling,
# so a full disk must cost the report and not the reclaim it was written about.
lastrun="$AUDIT_DIR/last-run"
staging="$lastrun.new"

# Each file opens with a line saying what it holds, for somebody who opens the directory with
# no README at hand, and then a line naming the run that wrote it. Read on its own a month
# later, a plan.tsv is otherwise a list of repo ids with no date, no mode and no way to tell
# which rules were even on; and a run that aborts before this point leaves the previous run's
# files standing with nothing to say they are old.
lr_head() {  # each argument is one line of what the file holds, in plain words
  printf '# %s\n' "$@"
  printf '# %s  version=%s  mode=%s  rules=%s  storage=%s\n' \
         "$run_ts" "$VERSION" "$run_mode" "$RULES" "$STORAGE"
}

lr_ok=1
rm -rf "$staging" 2>/dev/null
mkdir -p "$staging" 2>/dev/null || lr_ok=0
if [ "$lr_ok" = 1 ]; then
  { lr_head "Every repo the last run planned to prune. A dry run prunes none of them;" \
            "what an applying run removed is in its prune-*.log."
    plan_header
    cat "$tmp/plan.sorted"; } > "$staging/plan.tsv" 2>/dev/null || lr_ok=0
  { lr_head "Name patterns the spam-batch rule (D) found shared by many repos," \
            "and how many repos match each."
    printf '# repos\ttemplate\n'
    sort -k1,1nr "$tmp/spambatch"; } \
    > "$staging/D-spam-batch-templates.tsv" 2>/dev/null || lr_ok=0
  { lr_head "Domains the link-farm rule (E) treats as spam, and how many repos link to each."
    printf '# repos\tdomain\n'
    sort -k1,1nr "$tmp/linktop"; } > "$staging/E-link-farm-domains.tsv" 2>/dev/null || lr_ok=0
  # The verdict, not a size: this column says which of rule F's two readings the repo matched.
  { lr_head "Media dumps the media rule (F) found but kept, because fewer than" \
            "MEDIA_MIN_SEEDS other nodes seed them. Nothing here was pruned."
    printf '# rid\tverdict\tname\n'
    cat "$tmp/media-review"; } > "$staging/F-media-kept-few-seeds.tsv" 2>/dev/null || lr_ok=0
  { lr_head "Junk-named repos, like demo or test, that the junk-name rule (A) kept because" \
            "their history starts well before they came to Radicle. None were pruned."
    printf '# rid\tname\n'
    cat "$tmp/imports"; } > "$staging/A-junk-name-kept-imports.tsv" 2>/dev/null || lr_ok=0
  # A block is permanent and the peer is never told, so the evidence behind one has to be
  # readable after the terminal that printed it has gone.
  { lr_head "Peers the parasite-peer rule (G) found pushing one file into many repos they" \
            "are not a delegate of, with the evidence. Only --block-peers blocks them."
    printf '# peer_nid\trepos_sharing_blob\trepos_touched\tmedia_bytes\ttext_bytes\tblob\n'
    cat "$tmp/parasites"; } > "$staging/G-parasite-peers.tsv" 2>/dev/null || lr_ok=0
  # A person decides on these, and the terminal shows only the first few repos of each.
  { lr_head "Identities the malware rule (H) named, one row per repo of theirs that" \
            "matched. Nothing here is pruned or blocked unless you add it to deny.txt."
    printf '# nid\trepos_hit\trepos_signed\trid\twords\tname\n'
    cat "$tmp/malware"; } > "$staging/H-malware-identities.tsv" 2>/dev/null || lr_ok=0
  { lr_head "Single repos the malware rule (H) named, with the words it found and where." \
            "Nothing here is pruned unless you add it to deny.txt."
    printf '# rid\twords\tevidence\tname\n'
    cat "$tmp/malware-repos"; } > "$staging/H-malware-repos.tsv" 2>/dev/null || lr_ok=0
  # The repos rule F could not read. Without them the run's own warning names a count and
  # nothing to go and look at.
  { lr_head "Repos the media rule (F) could not check: unreadable, over MEDIA_MAX_REFS refs," \
            "or with too many files of unknown type to read. It did not prune them. The" \
            "other rules still judged them."
    printf '# rid\n'
    sort -u "$tmp/media-fail"; } > "$staging/F-media-unjudged.tsv" 2>/dev/null || lr_ok=0
  # plan.tsv still lists a held rule's repos, because without --force or a yes at the prompt
  # nobody knows yet whether they will be pruned. This says which rules are waiting on that.
  { lr_head "Rules an unattended run holds back for planning far more repos than usual." \
            "Their repos are in plan.tsv; only --force or a y at the prompt prunes them."
    printf '# rule\tplanned\tusual\tlimit\n'
    cat "$tmp/held"; } > "$staging/held.tsv" 2>/dev/null || lr_ok=0
  # The repos the run output counts under "# undo:", one per row, for the operator who wants to
  # check why one is unblocked or stays blocked. Like plan.tsv it is the plan: what a lift
  # actually did is in the audit log's "# unblocked:" lines.
  { lr_head "Blocks rad-prune made that this run plans to lift, holds for a later run, or" \
            "leaves blocked, and why. An --apply run lifts the rows marked unblock once it goes" \
            "ahead."
    printf '# rid\tstate\twhy\treason\tbytes_when_pruned\tpruned_at\tpruned_by\tcopy\n'
    awk -F'\t' -v OFS='\t' '$7 == "-" { $7 = "0.7.0-or-older" } { print }' \
      "$tmp/undo-states"; } > "$staging/undo.tsv" 2>/dev/null || lr_ok=0
  # Which deny-list entry each denied repo was pruned for, so a dry run can trace a row to its
  # line.
  { lr_head "Repos in the plan because of deny.txt, with the line that names each."
    printf '# rid\tcause\n'
    cat "$tmp/deny-why"; } > "$staging/deny-repos.tsv" 2>/dev/null || lr_ok=0
  { lr_head "Repos in the plan for holding copies of files listed in deny-files.tsv:" \
            "how much of each repo they make up, and where they came from."
    printf '# rid\tdenied_bytes\tbranch_bytes\tpct\tfiles\tsource\tother_sources\n'
    cat "$tmp/copy-why"; } > "$staging/deny-copies.tsv" 2>/dev/null || lr_ok=0
  # Every listed file each copy holds, so a wrong copy can be traced to the rows behind it.
  { lr_head "Each listed file that each repo in deny-copies.tsv holds."
    printf '# rid\toid\tbytes\n'
    awk -F'\t' -v why="$tmp/copy-why" -v src="$tmp/deny-oid-list" '
        FILENAME == why  { copy[$1] = 1; next }
        FILENAME == src  { listed[$1] = 1; next }
        $1 == "h" && ($2 in copy) && ($3 in listed) { print $2 "\t" $3 "\t" $4 }' \
        "$tmp/copy-why" "$tmp/deny-oid-list" "$tmp/copy" | sort; } \
    > "$staging/deny-copy-files.tsv" 2>/dev/null || lr_ok=0
  { lr_head "Everything the last run could not read."
    cat "$scanerr"; } > "$staging/scan-errors.txt" 2>/dev/null || lr_ok=0
fi

# Moved onto the old directory in one step, so a reader never finds three files from this run
# beside three from the last one, and a run that dies half way through writing leaves the
# previous run's evidence whole rather than a mixture nothing marks as mixed.
if [ "$lr_ok" = 1 ]; then
  rm -rf "$lastrun" 2>/dev/null
  mv -T "$staging" "$lastrun" 2>/dev/null || lr_ok=0
fi
if [ "$lr_ok" = 1 ]; then
  echo "# the untrimmed plan and the evidence behind it: $lastrun/"
  # Printed here rather than beside rule F's count, because this is where the file holding
  # them is known to have been written: a run aborting in between never creates it.
  [ "${nmediafail:-0}" = 0 ] \
    || echo "#   the $nmediafail repo(s) the media rule (F) left unjudged:" \
            "$lastrun/F-media-unjudged.tsv"
  [ "$nunblock" = 0 ] && [ "$nlater" = 0 ] \
    || echo "#   the blocks to lift, and why: $lastrun/undo.tsv"
else
  rm -rf "$staging" 2>/dev/null
  # Losing this loses no verdict, but it does lose the only copy of the evidence for one, so it
  # is said out loud rather than left for somebody to find the directory missing or stale.
  echo "# WARN: could not write $lastrun; this run's evidence is only what is above." >&2
fi

blocked=0

# A repo's delegates and the signed refs each had pushed, as "<did>:<oid>,<did>:<oid>", with
# "-" for a delegate who had pushed nothing here, and "-" alone when the identity document did
# not read. The audit log keeps it beside the prune, for revival on a later run.
prune_delegates() {
  local did oid line=""
  local -A sigrefs=()
  read_delegates "$1"
  [ -n "$dids" ] || { echo "-"; return 0; }
  while read -r did oid; do
    sigrefs[$did]=$oid
  done < <(GIT_DIR="$1" git for-each-ref --format='%(refname) %(objectname)' \
             'refs/namespaces/*/refs/rad/sigrefs' 2>/dev/null \
           | sed -n 's|^refs/namespaces/\([^/]*\)/refs/rad/sigrefs |\1 |p')
  for did in $dids; do
    line="$line${line:+,}$did:${sigrefs[$did]:--}"
  done
  echo "$line"
}

# The deny list's ids that no repo in storage stands for: repo ids not fetched yet, and
# identities. Blocked now, so the node never fetches the repo and never follows the identity.
# A repo id still in storage is left to the prune, and one the prune moved out was blocked by
# it, so blocking it again here logs nothing. An excluded repo is left alone, and so is an
# identity that delegates one. `rad block` prints a line on stdout only when it changes a
# policy, which is what keeps a standing list from writing the same blocks into every week's
# audit log.
deny_block_ahead() {
  local id said nblocked=0
  while IFS= read -r id; do
    [ -d "$STORAGE/$id" ] && continue
    grep -qxF "$id" "$tmp/excluded" && continue
    said=$("$RAD" block "rad:$id" 2>"$tmp/block-err") \
      || { echo "# WARN: could not block denied repo rad:$id: $(head -1 "$tmp/block-err")" >&2
           continue; }
    [ -n "$said" ] || continue
    open_audit; printf 'blocked-denied\trad:%s\n' "$id" >> "$audit"
    nblocked=$((nblocked+1))
  done < "$tmp/deny-rids"
  while IFS= read -r id; do
    if grep -qxF "$id" "$tmp/deny-nids-kept"; then
      echo "# WARN: not blocking $id, a delegate of a kept repo; rad unblock it if blocked." >&2
      continue
    fi
    said=$("$RAD" block "$id" 2>"$tmp/block-err") \
      || { echo "# WARN: could not block denied identity $id: $(head -1 "$tmp/block-err")" >&2
           continue; }
    [ -n "$said" ] || continue
    open_audit; printf 'blocked-denied\t%s\n' "$id" >> "$audit"
    nblocked=$((nblocked+1))
  done < "$tmp/deny-nids"
  [ "$nblocked" = 0 ] || echo "# blocked $nblocked id(s) from $DENY_FILE"
  return 0
}

# Rule G's action. A block is permanent, it is invisible to the person blocked, and it applies
# to every repo at once, so rule G never blocks without a human in the room: --block-peers
# refuses outright when nothing can be asked, and asks again per peer.
# Blocking is what makes it stick, since the node filters every namespaced ref it receives
# through the block list whatever the seeding scope is, so refs dropped here do not come back.
# Dropping them frees no disk until git gc runs, which this tool does not do, so none of it is
# counted as reclaimed.
if [ "$BLOCK_PEERS" = 1 ] && [ "$nparasite" -gt 0 ]; then
  # --yes stands in for every answer, which is what makes this usable from cron. Blocking then
  # happens with nobody in the room, so it takes both flags: --block-peers to look, --yes to
  # act on what it found. Without --yes the answers come in on fd 9, opened once here; reading
  # them from /dev/stdin instead would find the loop's own input file below, since that loop
  # redirects stdin to read the verdicts.
  asked=1
  if [ "$YES" = 1 ]; then :
  elif [ -t 0 ]; then exec 9<&0
  elif { : >/dev/tty; } 2>/dev/null; then exec 9</dev/tty
  else asked=0; fi
  if [ "$asked" = 0 ]; then
    echo "# --block-peers has nobody to ask: no terminal, and no --yes standing in." >&2
    echo "# Nobody was blocked. The commands are listed above; run them yourself." >&2
  else
    while IFS=$'\t' read -r nid widest npeerrepos mb ob oid; do
      if [ "$YES" = 1 ]; then
        printf '# Blocking %s (--yes): it put %s in %s repos it is not a delegate of\n' \
               "$nid" "${oid:0:12}" "$widest"
        reply=y
      else
        printf '# Block %s? it put %s in %s repos it is not a delegate of [y/N] ' \
               "$nid" "${oid:0:12}" "$widest"
        reply=""; IFS= read -r reply <&9 || reply=""
      fi
      case "$reply" in [yY]) ;; *) echo "#   skipped $nid"; continue ;; esac
      "$RAD" block "$nid" >/dev/null 2>&1 \
        || { echo "#   WARN block failed, leaving refs alone: $nid" >&2; continue; }
      blocked=$((blocked+1))
      open_audit
      # The evidence goes in the audit log beside the block, because a standing judgement
      # about a person that nobody can later explain is one nobody can later undo either.
      printf 'blocked-peer\t%s\tblob=%s\trepos=%s\tmedia_bytes=%s\tother_bytes=%s\n' \
             "$nid" "$oid" "$widest" "$mb" "$ob" >> "$audit"
      # Only the repos where this peer put content of its own. Where it merely mirrors a repo,
      # its refs hold that repo's own blobs, so removing them would free nothing and the block
      # already stops anything new arriving. Excluded repos are left alone here too: "never
      # touched" has to mean the same thing whichever action is running, and the block itself
      # already stops the peer writing anything new into them.
      while IFS=$'\t' read -r _ rid _ _ _; do
        d="$STORAGE/$rid"
        [ -d "$d" ] || continue
        grep -qxF "$rid" "$tmp/excluded" && { echo "#   kept $rid: excluded"; continue; }
        GIT_DIR="$d" git for-each-ref --format='delete %(refname)' \
            "refs/namespaces/$nid/" 2>/dev/null \
          | GIT_DIR="$d" git update-ref --stdin 2>/dev/null \
          || echo "#   WARN could not drop $nid refs from $rid" >&2
      done < <(awk -F'\t' -v n="$nid" '$1 == "=" && $3 == n && $4 > 0' "$tmp/peer")
    done < "$tmp/parasites"
    echo "# blocked $blocked of $nparasite peer(s); run git gc to reclaim their objects."
  fi
fi

if [ "$APPLY" = 0 ]; then
  if [ "$blocked" -gt 0 ]; then
    echo "# DRY-RUN: no repos were pruned; $blocked peer(s) blocked, as answered above."
  else
    echo "# DRY-RUN: nothing in storage changed. Re-run with --apply to execute."
  fi
  exit 0
fi

# --apply: the (slow) scan above ran ONCE. In a terminal, ask before deleting;
# non-interactively (cron, a pipe) just apply. --yes skips the prompt.
#
# Puts the question $1 to the person at the terminal and sets reply to the answer. Returns 1
# when there is no terminal (cron, CI, a pipe), so nobody to ask.
ask() {
  reply=""
  if [ -t 0 ]; then                                   # stdin is a terminal
    printf '%s' "$1"; IFS= read -r reply || reply=""
  elif { : >/dev/tty; } 2>/dev/null; then             # piped input but a terminal exists
    printf '%s' "$1" >/dev/tty; IFS= read -r reply </dev/tty || reply=""
  else
    return 1
  fi
}

# An empty plan nobody turns down still empties the quarantine of what is past its window, and of
# everything at the critical free-space threshold: a seed that has caught up has an empty plan
# every week, and quarantined disk that only comes back on a week with something to prune is
# quarantined disk that never comes back.
if [ "$nplan" = 0 ]; then
  # Lifting a block changes the node as much as pruning does, so a person present is asked. A
  # no stops the run here, purging nothing, since a run somebody turned down is the one they
  # will look into.
  if [ "$YES" = 0 ] && [ "$nunblock" -gt 0 ] \
     && ask "# Apply now? unblock $nunblock repo(s) pruned before [y/N] "; then
    case "$reply" in
      [yY]|[yY][eE][sS]) echo "# confirmed." ;;
      *)                 echo "# aborted; no block was lifted, and the quarantine was left as it is."
                         exit 0 ;;
    esac
  fi
  undo_apply
  quar_purge_expired
  quar_purge_all_if_critical
  deny_block_ahead
  echo "# nothing to prune"
  exit 0
fi
# A yes to this prompt is the human sign-off that lets a run bypass the ratchet and the runaway
# caps below.
CONFIRMED=0
if [ "$YES" = 0 ]; then
  # The line a human actually answers, so it says what the run will really do. Under
  # quarantine nothing is deleted today and the disk does not come back until the window
  # passes; promising "reclaiming" here would be the overclaim the plan line avoids.
  if [ "$QUARANTINE" = 1 ]; then
    prompt="# Apply now? unseed + block + quarantine $nplan repos, ${gib} GiB"
    prompt="$prompt (deleted for good in ${QUARANTINE_DAYS}d)"
  else
    prompt="# Apply now? unseed + block + DELETE $nplan repos, reclaiming ${gib} GiB"
  fi
  [ "$nunblock" = 0 ] || prompt="$prompt, and unblock $nunblock repo(s) pruned before"
  prompt="$prompt [y/N] "
  if ask "$prompt"; then
    case "$reply" in
      [yY]|[yY][eE][sS]) CONFIRMED=1; echo "# confirmed." ;;
      *)                 echo "# aborted; no repos were pruned or unblocked."; exit 0 ;;
    esac
  fi
fi

# --------------------------------------------------------------------------------------- apply
# The ratchet's verdict, worked out with the plan above. An interactive yes is a human
# confirming the exact numbers just printed, so a confirmed run bypasses it; --yes and cron do
# not. The rules it holds back leave this run's plan, and every number below is recounted from
# what is left, so the caps, the audit log and the DONE line all describe what is pruned.
nheld=0
if [ "$CONFIRMED" = 0 ] && [ -s "$tmp/held" ]; then
  while IFS=$'\t' read -r letter planned usual limit; do
    echo "# HELD BACK $(rule_label "$letter"): $planned repos, where its median over the last" \
         "$nratchet runs is $usual a run (limit $limit). None of them is pruned this run." >&2
  done < "$tmp/held"
  echo "# Review them in the plan above, then re-run with --force (unattended), or confirm" \
       "interactively. The rest of the plan goes ahead." >&2
  awk -F'\t' -v map="$RULE_OF_REASON" -v heldfile="$tmp/held" '
      BEGIN { n = split(map, pairs, " ")
              for (i = 1; i <= n; i++) { split(pairs[i], kv, ":"); rule[kv[1]] = kv[2] }
              while ((getline line < heldfile) > 0) { split(line, f, "\t"); held[f[1]] = 1 } }
      !((($5 in rule) ? rule[$5] : $5) in held)' "$tmp/plan.sorted" > "$tmp/plan.kept"
  mv "$tmp/plan.kept" "$tmp/plan.sorted"
  # Counted from the plan, since a held rule's re-pruned repos leave it too (see the ratchet).
  nheld=$(( nplan - $(wc -l < "$tmp/plan.sorted") ))
  nplan=$(wc -l < "$tmp/plan.sorted")
  bytes=$(awk -F'\t' '{s+=$2} END{printf "%.0f", s}' "$tmp/plan.sorted")
  gib=$(awk -v b="$bytes" 'BEGIN{printf "%.2f", b/1073741824}')
fi

# Runaway caps guard unattended runs, measured on what the ratchet left, so a held wave does
# not take the rest of the plan down with it. Bypassed the same two ways as the ratchet.
# Denied repos are left out of the measure: the caps catch a rule gone wrong, and the deny list
# is a person's verdict. Counted in, one listed identity with a thousand repos would stop
# every unattended run, and every rule with it, until somebody forced one through.
if [ "$FORCE" = 0 ] && [ "$CONFIRMED" = 0 ]; then
  nruled=$(awk -F'\t' '$5 != "denied"' "$tmp/plan.sorted" | wc -l)
  ruled_bytes=$(awk -F'\t' '$5 != "denied" { s += $2 } END { printf "%.0f", s }' \
                  "$tmp/plan.sorted")
  ruled_gib=$(awk -v b="$ruled_bytes" 'BEGIN{printf "%.2f", b/1073741824}')
  over_gb=$(awk -v b="$ruled_bytes" -v m="$MAX_PRUNE_GB" \
              'BEGIN{print (b/1073741824 > m) ? 1 : 0}')
  if [ "$nruled" -gt "$MAX_PRUNE_COUNT" ] || [ "$over_gb" = 1 ]; then
    echo "# ABORT: the rules' plan ($nruled repos, ${ruled_gib} GiB) trips runaway caps" \
         "(count=$MAX_PRUNE_COUNT gb=$MAX_PRUNE_GB)." >&2
    echo "# Review it, then re-run with --force (unattended), or confirm interactively." >&2
    exit 3
  fi
fi

# Past the caps and the prompt, the run has gone ahead, so this is where the quarantine gives up
# what is past its window, and everything if the disk is critical. A run the caps stop or a
# human turns down leaves it standing, since that run is the one somebody will look into. A run
# the ratchet held keeps its held repos in storage, not in quarantine, so it purges as usual:
# otherwise a rule held week after week would also hold the disk the quarantine owes back.
# Before this run puts its own copies there, so what it quarantines today keeps its full window.
# The lifts go first, so a repo due back from the quarantine is not purged on its way out.
undo_apply
quar_purge_expired
quar_purge_all_if_critical

if [ "$nplan" = 0 ]; then
  deny_block_ahead
  echo "# nothing pruned: every verdict in the plan was held back (see HELD BACK above)." >&2
  exit 4
fi

# Repos blocked before this run prunes them: such a block is somebody else's, an operator's or
# a person's list, and the undo leaves it alone. When the listing fails, every repo pruned
# here is recorded as blocked already, since a block kept by mistake is the safe side to be
# wrong on.
was_blocked_ok=1
blocked_now > "$tmp/blocked-before" || was_blocked_ok=0
[ "$was_blocked_ok" = 1 ] \
  || echo "# WARN: '$RAD seed' failed, so every repo this run prunes is recorded as blocked" \
          "already, and no later run lifts its block:" \
          "$(head -c 200 "$tmp/seed-err" | LC_ALL=C tr -c '[:print:]' ' ')" >&2

open_audit
# A held rule's rows are not in the plan below, so the log names what was held and why: the
# ratchet reads these logs to learn what each rule usually prunes, and a reader of this one
# needs to know that rule C's absence was the ratchet and not a quiet week.
{ printf '# plan=%s repos / %s GiB\n' "$nplan" "$gib"
  if [ "$nheld" -gt 0 ]; then
    while IFS=$'\t' read -r letter planned usual limit; do
      printf '# held back: rule %s, %s repos (usual %s, limit %s)\n' \
             "$letter" "$planned" "$usual" "$limit"
    done < "$tmp/held"
  fi
  # Which line of the deny list each denied repo was pruned for, so one bad line can be traced.
  sed 's/^/# denied: /; s/\t/ /' "$tmp/deny-why"
  # And how much of each copy is listed files, and from which source. A copy the ratchet held
  # is not in this run's plan.
  awk -F'\t' -v plan="$tmp/plan.sorted" '
      FILENAME == plan { kept[$1] = 1; next }
      $1 in kept { printf "# denied-copy: %s %s bytes in %s file(s), %s%% of the bytes" \
                          " on its branches, from %s\n", $1, $2, $5, $4, $6 }' \
      "$tmp/plan.sorted" "$tmp/copy-why"
  # Ahead of the plan rows and before any repo is touched: a row with no such line reads as
  # this tool's own block later, and a failed write here stops the run first.
  awk -F'\t' -v ok="$was_blocked_ok" '
      FILENAME == ARGV[1] { blocked[$1] = 1; next }
      ok == 0 || ($1 in blocked) { print "# was-blocked: rad:" $1 }' \
    "$tmp/blocked-before" "$tmp/plan.sorted"
  plan_header
  cat "$tmp/plan.sorted"; } >> "$audit"

if [ "$QUARANTINE" = 1 ]; then
  echo "# unseed + block + quarantine $nplan repos (recoverable for ${QUARANTINE_DAYS}d)..."
  # Brings back a quarantine deleted by hand while the scan ran, which the README allows.
  mkdir -p "$quar" 2>/dev/null || true
else
  echo "# unseed + block + delete $nplan repos..."
fi
deleted=0
undated=0
# One line per repo that is really gone from storage, which is what the ticker counts and what
# its closing line reports. Repos attempted would print a full count above the WARN below.
: > "$tmp/pruned"
ticks_ok=1
progress_start "pruning" "$nplan" "$tmp/pruned"
while IFS=$'\t' read -r rid _; do
  # Emptied per repo, so a failure below that says nothing is not reported with the last
  # repo's message. A $tmp this cannot write is a $tmp the redirections below cannot write
  # either, and then no repo is touched at all.
  : > "$tmp/prune-err" 2>/dev/null || true
  # Who can bring the repo back by pushing to it, and what each of them had pushed, read while
  # the repo is still here. A later run lifts the block when a delegate's node announces
  # something else: a node announcing what it already had is no push. Unrecorded, the repo
  # would come back for any node's announcement, so it is left untouched.
  delegates_line=$(prune_delegates "$STORAGE/$rid")
  { printf '# delegates: rad:%s %s\n' "$rid" "$delegates_line" >> "$audit"; } 2>/dev/null \
    || { progress_warn "#   WARN not pruned, could not record its delegates in $audit: $rid"
         continue; }
  "$RAD" unseed "rad:$rid" >/dev/null 2>&1 || true     # clear any policy FIRST
  "$RAD" block  "rad:$rid" >/dev/null 2>&1 \
    || { progress_warn "#   WARN block failed, skipping delete: $rid"; continue; }
  d="$STORAGE/$rid"
  case "$d" in
    "$STORAGE"/z*)
      if [ "$QUARANTINE" = 1 ]; then
        # A repo pruned twice (re-fetched, pruned again) would otherwise fail to move onto
        # its own older copy, so the older copy goes first.
        rm -rf -- "$quar/$rid" 2>/dev/null
        if mv -- "$d" "$quar/$rid" 2>"$tmp/prune-err"; then
          deleted=$((deleted+1))
          printf '%s\n' "$rid" >> "$tmp/pruned" || ticks_ok=0
          # The purge measures the window by directory mtime and mv keeps the old one, so a
          # copy that could not be re-dated counts its window from a date this run did not
          # choose and may already be past it. Rules B and C select repos nothing has touched
          # for 90 to 730 days, and they read ref dates rather than mtime, so how much window
          # is left is not something this loop can work out. The repo has left storage either
          # way, which makes this a shortened undo and not a failed prune.
          touch "$quar/$rid" 2>/dev/null \
            || { undated=$((undated+1))
                 progress_warn "#   WARN $rid kept its own date in quarantine, so its window" \
                               "runs from that date and may already have passed"; }
        else
          # The tool's own message names the path, so the rid is only the fallback for a
          # failure that said nothing.
          err=$(head -1 "$tmp/prune-err" 2>/dev/null) || true
          progress_warn "#   WARN quarantine failed: ${err:-$rid}"
        fi
      else
        if rm -rf -- "$d" 2>"$tmp/prune-err"; then
          deleted=$((deleted+1))
          printf '%s\n' "$rid" >> "$tmp/pruned" || ticks_ok=0
        else
          err=$(head -1 "$tmp/prune-err" 2>/dev/null) || true
          progress_warn "#   WARN delete failed: ${err:-$rid}"
        fi
      fi ;;
    *) progress_warn "#   SKIP unsafe path: $d" ;;
  esac
done < "$tmp/plan.sorted"
progress_stop
# $deleted below is counted in this shell and stands whatever happened here, so this costs the
# progress line alone. Said out loud so the short count above is not read as failed prunes.
[ "$ticks_ok" = 1 ] \
  || echo "# WARN: could not write $tmp/pruned; the pruning line above undercounts." >&2

# The audit log and the GiB total were both written from the PLAN. If deletions failed, saying
# nothing here would leave a record claiming disk was reclaimed that never was.
[ "$deleted" = "$nplan" ] || {
  echo "# WARN: $((nplan - deleted)) of $nplan deletions failed;" \
       "less than ${gib} GiB was reclaimed." >&2
  echo "# The audit log lists the plan, not what actually got deleted." >&2
}

deny_block_ahead

if [ "$RESTART" = 1 ]; then
  echo "# restarting $SERVICE (clears the stale inventory-announce warning)..."
  systemctl restart "$SERVICE" 2>&1 || sudo systemctl restart "$SERVICE" 2>&1 \
    || echo "# WARN restart failed; run: sudo systemctl restart $SERVICE" >&2
fi

# one appended line per run: the index into the per-run audit logs
add_header "$AUDIT_DIR/history.log" \
  "One line per applying run: when, repos pruned, GiB moved out of storage, quarantine on or" \
  "off, disk pressure, and the name of that run's own log. Unattended runs read it to learn" \
  "what each rule usually prunes." \
  || echo "# WARN: could not add a header to $AUDIT_DIR/history.log." >&2
printf '%s\tdeleted=%s\treclaimed_gib=%s\tquarantine=%s\tpressure=%s%%\taudit=%s\n' \
  "$run_ts" "$deleted" "$gib" "$([ "$QUARANTINE" = 1 ] && echo on || echo off)" \
  "$press_pct" "$(basename "$audit")" \
  >> "$AUDIT_DIR/history.log"

# The GiB figure is what LEAVES storage. With quarantine on it is not free space yet, and
# saying "reclaimed" of disk still occupied is the kind of report that gets believed.
if [ "$QUARANTINE" = 1 ]; then
  echo "# DONE: quarantined $deleted repos, ~${gib} GiB out of storage but still on disk" \
       "for ${QUARANTINE_DAYS}d."
  # The line above is what an operator reads before deciding whether they still have an undo,
  # so the repos it is not true of are named right under it rather than 20 warnings back.
  [ "$undated" = 0 ] \
    || echo "# $undated of them kept their own date, so their window runs from it and may" \
            "already have passed."
  # Both lines are about what this run just put there, so neither is printed when it put
  # nothing there and the quarantine holds only what earlier runs left.
  if [ "$deleted" -gt 0 ]; then
    echo "# See them with: $(basename "$0") quarantine list" \
         "   put one back with: $(basename "$0") quarantine restore <rid>"
    # The GiB above are still occupied until the window passes, and where the disk went is the
    # next question a big prune is asked. --all empties the whole quarantine, which is more
    # than this run put in it, so the line says so rather than reading as "finish up here".
    echo "# To free the disk now, giving up the undo for this run and every earlier one:" \
         "$(basename "$0") quarantine delete --all"
  fi
  echo "# Audit: $audit"
else
  echo "# DONE: deleted $deleted repos, reclaimed ~${gib} GiB. Audit: $audit"
fi
[ "$RESTART" = 1 ] \
  || echo "# tip: run 'sudo systemctl restart $SERVICE' once to clear the stale" \
          "inventory-announce log warning."
# Non-zero so whatever runs this unattended sees that verdicts are waiting on a human. Not 3,
# which says the caps stopped the whole run and nothing was pruned.
if [ "$nheld" -gt 0 ]; then
  echo "# $nheld repo(s) held back are still in storage; see HELD BACK above." >&2
  exit 4
fi
